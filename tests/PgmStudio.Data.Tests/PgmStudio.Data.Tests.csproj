<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PgmStudio.Data\PgmStudio.Data.csproj" />
    <ProjectReference Include="..\..\src\PgmStudio.Migrations\PgmStudio.Migrations.csproj" />
  </ItemGroup>

  <!-- Linked rather than folded into tests/Directory.Build.props: it needs MySqlConnector and the
       migrations, which only the two database-touching test projects reference. -->
  <ItemGroup>
    <Compile Include="..\TestSchema.cs" Link="TestSchema.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.53.0" />
  </ItemGroup>

</Project>
