<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared colour tables: served under wwwroot for the JS (render/palette.js) AND embedded so the C#
         (Models/GameColors.cs) reads the exact same file — one source of truth, no drift. -->
    <EmbeddedResource Include="wwwroot\js\studio\render\game-colors.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PgmStudio.Contracts\PgmStudio.Contracts.csproj" />
    <!-- Dependency-free spatial leaf: the canonical Symmetry transforms (orbit previews + assignment). -->
    <ProjectReference Include="..\PgmStudio.Geom\PgmStudio.Geom.csproj" />
  </ItemGroup>

</Project>
