@namespace PgmStudio.Client.Features.Configure
@using PgmStudio.Client.Models
@using W = PgmStudio.Client.Features.Configure.WoolAuthoring
@using Ctx = PgmStudio.Client.Features.Configure.AuthoringContext
@using PgmStudio.Vocabulary

@* Wools · spawn: confirm/adjust each wool's source point (where it dispenses), seeded by detection. The
   point tool moves it; an anchor-team wool re-derives its symmetric partners; the side-view sets the Y. A wool
   whose room holds a chest of its colour can take the chest as its supply instead, and then has no point to move. *@

<Workspace>

  <Sidebar>
      <Section Title="Wool spawn" Description="Where each wool spawns, starting at the wool found in the world, or the chest in its room that holds it.">
        <div class="panel-list">
          @if (wools.Count == 0) { <EmptyState>No wools yet. Confirm them in the Objectives step first.</EmptyState> }
          @foreach (var w in wools)
          {
            <ListRow Compact Selected="selectedColor == w.Color"
                 @key="w.Color" OnClick="() => SelectWool(w.Color)">
              <span class="geo-type-icon" style="--icon-tint: @W.Hex(w.Color)"><i data-lucide="dot"></i></span>
              <span class="list-label">@W.Name(w.Color)</span>
              <Badge Class="@(IsAuthored(w) ? "badge--success" : "badge--dim")">@(IsAuthored(w) ? "Main" : "Copy")</Badge>
            </ListRow>
          }
        </div>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <WorldCanvas @ref="canvas" Slug="@Slug" PointPick="true" Category="__wool_spawn__"
                OnPointPick="OnPointPick" OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="sel.Color" Description="@(IsAuthored(sel) ? "Moving it also moves its symmetry copies." : null)">
          <Header>
            <DetailHeader Icon="dot" IconTint="@W.Hex(sel.Color)" Label="@($"{W.Name(sel.Color)} wool")">
              <Badge Class="@(IsAuthored(sel) ? "badge--success" : "badge--dim")">@(IsAuthored(sel) ? "Main" : "Copy")</Badge>
            </DetailHeader>
          </Header>
          <ChildContent>
          <div class="section-body">
            <Readout>@(string.IsNullOrEmpty(sel.Owner) ? "No team set." : $"Owned by {TeamName(sel.Owner)}.")</Readout>
            @if (ChestOf(sel) is not null || FromChest(sel))
            {
              <Field Label="Supply" Note="@(FromChest(sel) && ChestOf(sel) is null ? "No chest in the room holds this wool, so choose a spawner." : null)">
                <Select Slim="false" Options="SupplyOptions" Value="@(sel.Supply ?? WoolSupplies.Spawner)"
                        ValueChanged="@(supply => SetSupply(sel, supply))" />
              </Field>
            }
            @if (FromChest(sel))
            {
              @if (ChestOf(sel) is { } chest)
              {
                <Readout>From the chest at @chest.X, @chest.Y, @chest.Z, holding @chest.Count @W.Name(sel.Color).ToLowerInvariant() wool.</Readout>
              }
            }
            else
            {
              <Field Label="Spawn location" Note="Floored to a whole block.">
                <ChildContent>
                <div class="ctrl-row">
                  <CoordField Prefix="X" Value="@sel.SpawnX" OnChange="@(e => SetCoord(sel, "x", e))" />
                  <CoordField Prefix="Y" Value="@sel.SpawnY" OnChange="@(e => SetCoord(sel, "y", e))" />
                  <CoordField Prefix="Z" Value="@sel.SpawnZ" OnChange="@(e => SetCoord(sel, "z", e))" />
                </div>
                </ChildContent>
              </Field>
              <SliceView Slug="@Slug" Node="@SpawnNode(sel)" OnYChanged="@(y => SetY(sel, y))" SeatOnFloor="true" />
            }
          </div>
          </ChildContent>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="dot" IconMuted Label="Wool spawn" />
          <EmptyState>No wool selected. Pick one to place its spawn.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>
