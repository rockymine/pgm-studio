@namespace PgmStudio.Client.Features.Configure
@using PgmStudio.Client.Layout

@* Shared layout for the new-map Configure wizard + its /maps/new import: the editor bar (the path, the save
   status, Back/Next) · the chapter rail (the phases, the open one's steps under it, and on the import its own
   chapter first) · a body slot for the three-panel workspace. A parameterized frame (not a Blazor layout
   directive); the page owns the state machine. See new-map-authoring.md §12. *@

<StudioShell Focused="true">
  <Bar>
    <EditorBar MapName="@(string.IsNullOrEmpty(MapName) ? "New map" : MapName)" Slug="@Slug" Stage="@MapStage.Configure" StageLabel="@StageLabel"
               PhaseTitle="@PhaseTitle" Steps="@Steps" CurrentStep="@CurrentStep"
               BackEnabled="@BackEnabled" NextEnabled="@NextEnabled" NextLabel="@NextLabel"
               NextBusy="@NextBusy" NextBusyLabel="@NextBusyLabel" NextWrites="@NextWrites" NextBuilds="@NextBuilds"
               OnBack="OnBack" OnNext="OnNext">
      <State>
        @if (!string.IsNullOrEmpty(SaveStatus))
        {
          <span>@SaveStatus</span>
        }
      </State>
    </EditorBar>
  </Bar>
  <Rail>
    <NavRail FoldKey="configure" Label="Configure chapters">
      @if (ActivePhaseId == ConfigurePhases.ImportId)
      {
        <NavButton Icon="import" Title="@PhaseTitle" Active Steps="@Steps" CurrentStep="@CurrentStep" MaxStep="@MaxStep" OnStep="OnStep" />
      }
      @for (var i = 0; i < Phases.Count; i++)
      {
        var p = Phases[i];
        // The current phase is never locked — you can walk one step past the slice-derived frontier
        // (a not-yet-completed phase) and still see where you are; only forward jumps stay gated.
        var locked = i > Math.Max(Furthest, Reach) && p.Id != ActivePhaseId;
        <NavButton Icon="@p.Icon" Title="@p.Title" Active="p.Id == ActivePhaseId"
                   Status="@(i < Furthest ? "green" : "")" Disabled="locked"
                   Steps="@Steps" CurrentStep="@CurrentStep" MaxStep="@MaxStep" OnStep="OnStep"
                   OnClick="() => OnJumpPhase.InvokeAsync(p.Id)" />
      }
    </NavRail>
  </Rail>
  <ChildContent>
      <div class="phase-body">
        @ChildContent

      </div>
  </ChildContent>
</StudioShell>
