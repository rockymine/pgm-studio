@namespace PgmStudio.Client.Features.Configure

@* Identity phase body: the map's identity slice — name + authors/contributors → intent meta.
   Version / mode / objective are auto-derived by the generator and shown locked. A username resolves on
   blur to its head + canonical name, and an unknown one is flagged and kept out of the intent. Edits patch the wizard's working Intent and mark it dirty. *@

<Workspace>
  <ContentColumn MaxWidth="720">

    <Section Title="Identity">
      <div class="section-body">
        <Field Label="Map name" Required>
          <input class="field-input" type="text" placeholder="e.g. Harbour Run" value="@name" @oninput="OnName" />
        </Field>
        <div class="field-row">
          <Field Label="Version" Class="field--short">
            <input class="field-input" type="text" value="@Version" disabled title="Set automatically" />
          </Field>
          <Field Label="Mode" Class="field--compact">
            <input class="field-input" type="text" value="@Mode" disabled title="Set automatically" />
          </Field>
        </div>
        <Field Label="Objective">
          <textarea class="field-input field-input--textarea" rows="2" disabled
                    title="Set automatically from the game mode">@Objective</textarea>
        </Field>
        <p class="section-desc">Version, mode, and objective are set automatically.</p>
      </div>
    </Section>

    <AuthorsEditor Authors="authors" Contributors="contributors" OnChanged="Sync" />

  </ContentColumn>
</Workspace>
