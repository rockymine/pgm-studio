@namespace PgmStudio.Client.Features.Configure

@* Export · Regions step: read-only view of the full generated region tree.
   Reuses the editor's RegionTree component (collapse · type icons · synthetic-id styling). Writes nothing. *@

<Workspace>
  <ContentColumn MaxWidth="760">
    <Section Title="Regions" Description="Every region written for this map. To change one, go back to the phase that sets it. Dimmed regions combine the others.">
      <Actions>
        <Badge Kind="dim">Read-only@(RegionCount > 0 ? $" · {RegionCount} regions" : "")</Badge>
      </Actions>
      <ChildContent>
        @if (loading)
        {
          <StatusLine />
        }
        else if (error is not null)
        {
          <StatusLine>Couldn't load the regions. Reload the page to try again.</StatusLine>
        }
        else
        {
          <RegionTree Groups="groups" />
        }
      </ChildContent>
    </Section>
  </ContentColumn>
</Workspace>
