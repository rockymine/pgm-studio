@namespace PgmStudio.Client.Features.Configure
@using PgmStudio.Client.Models

@* Teams · step 1: create teams (symmetry suggests the count) + tag islands to them. Writes the
   intent's teams / maxPlayers slice + the islandTeams aid. Canvas = reused WorldCanvas in island-select
   mode (base layer only): pick a team, click islands to tint them that team's colour. *@

<Workspace>

  <Sidebar>

      @if (ShowSuggestion)
      {
        <SmartSuggestion Header="Suggestion" Badge="@SymmetryInfo.Label(symMode)" AcceptLabel="@($"Create {SuggestedCount} teams")"
                         RejectLabel="Dismiss" OnAccept="CreateSuggestedTeams" OnReject="() => dismissedSuggestion = true">
          <p class="smart-suggestion__text">The map's @SymmetryInfo.ShortLabel(symMode) symmetry suggests @SuggestedCount teams.</p>
          <div class="smart-suggestion-teams">
            @foreach (var c in SuggestedColors)
            {
              <div class="smart-suggestion-team"><span class="list-swatch list-swatch--sm" style="--swatch: @c.Hex"></span>@c.Label</div>
            }
          </div>
        </SmartSuggestion>
      }

      <Section Title="Teams" Description="@(teams.Count > 0 && SuggestedCount > 0 ? "Set up the first team. Every other team gets a symmetry copy." : null)">
        <ChildContent>
        <div class="panel-list">
          @if (teams.Count == 0) { <EmptyState>No teams yet. Accept the suggestion or pick a colour below.</EmptyState> }
          @for (var i = 0; i < teams.Count; i++)
          {
            var t = teams[i];
            var idx = i;
            <ListRow Compact Selected="selectedTeamId == t.Id" @key="t.Id" OnClick="() => Select(t.Id)">
              <span class="list-swatch" style="--swatch: @Hex(t.Color)"></span>
              <span class="list-label">@(t.Name.Length > 0 ? t.Name : t.Id)</span>
              <Badge Class="@(idx == 0 ? "badge--success" : "badge--dim")">@(idx == 0 ? "Main" : "Copy")</Badge>
            </ListRow>
          }
        </div>
        @if (AddableColors.Count > 0)
        {
          <Field Label="New team">
            <SwatchRow TKey="string" Writes OnPick="AddTeam"
                       Swatches="@AddableColors.Select(c => new SwatchRow<string>.Swatch(c.Value, c.Hex, c.Label)).ToList()" />
          </Field>
        }
        </ChildContent>
      </Section>

      <Section Title="Island owners" Description="Pick a team, then click its islands on the canvas. An island with no owner stays neutral, such as a shared mid.">
        <Actions><Badge Kind="dim">Optional</Badge></Actions>
        <ChildContent>
        @if (disagreements.Count > 0)
        {
          <div class="callout">
            <span class="callout-icon"><i data-lucide="triangle-alert"></i></span>
            <div>
              <p>The objectives no longer match the islands' teams:</p>
              <ul>@foreach (var line in disagreements) { <li>@line</li> }</ul>
              <Button Writes Variant="primary" Icon="refresh-cw" OnClick="ReassignObjectives">Reassign the objectives</Button>
            </div>
          </div>
        }
        @if (teams.Count > 0)
        {
          <div class="panel-list">
            @foreach (var t in teams)
            {
              <ListRow Compact Class="list-row--muted">
                <span class="list-swatch" style="--swatch: @Hex(t.Color)"></span>
                <span class="list-label">@(t.Name.Length > 0 ? t.Name : t.Id)</span>
                <span class="list-tag">@IslandsFor(t.Id) islands</span>
              </ListRow>
            }
          </div>
        }
        </ChildContent>
      </Section>

      <Section Title="Size and kit" Writes>
        <div class="section-body">
          <Field Label="Team size" Unit="players">
            <NumberField Value="maxPlayers" ValueChanged="SetMaxPlayers" Min="1" />
          </Field>
          <Field Label="Spawn kit" Note="The studio sets it.">
            <input class="field-input" type="text" value="Standard" disabled />
          </Field>
        </div>
      </Section>

  </Sidebar>

  <div class="sidebar-handle"></div>

  @* Reused edit canvas in island-select mode — click islands to tag the selected team. *@
  <WorldCanvas @ref="canvas" Slug="@Slug" IslandSelect="true" OnIslandSelect="OnAssignIsland" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="sel.Id">
          <DetailHeader Icon="users" IconMuted Label="@(sel.Name.Length > 0 ? sel.Name : sel.Id)">
            <Badge Class="@(teams.IndexOf(sel) == 0 ? "badge--success" : "badge--dim")">@(teams.IndexOf(sel) == 0 ? "Main" : "Copy")</Badge>
          </DetailHeader>
          <div class="section-body">
            <Field Label="Name">
              <input class="field-input" value="@sel.Name" @onchange="SetName" />
            </Field>
            <Field Label="Colour">
              <SwatchRow TKey="string" Selected="@sel.Color" OnPick="SetColor"
                         Swatches="@GameColors.ChatColors.Select(c => new SwatchRow<string>.Swatch(c.Value, c.Hex, c.Label)).ToList()" />
            </Field>
            <Field Label="Islands">
              <div class="field-pick-row"><Badge Kind="neutral">@IslandsFor(sel.Id)</Badge><span class="list-tag">assigned</span></div>
            </Field>
            @if (SuggestedCount > 0 && teams.IndexOf(sel) > 0)
            {
              <Readout>@($"Its spawn and protection are symmetry copies of {teams[0].Name}'s.")</Readout>
            }
          </div>
        </Section>
        <InspectorDelete Title="Delete this team" OnClick="() => RemoveTeam(sel)" />
      }
      else
      {
        <Section>
          <DetailHeader Icon="users" IconMuted Label="Teams" />
          <EmptyState>No team selected. Pick one to edit its name and colour.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>

