@namespace PgmStudio.Client.Features.Configure

@* World · Islands step: review detected islands, exclude the stray ones. Select from the list
   or by clicking the canvas; the selection's centre / block count / exclude toggle show in the inspector.
   The canvas is the reused WorldCanvas in island-select mode (island base layer + the Blocks overlay toggle). *@

<Workspace>

  <Sidebar>
      <Section Title="Islands" Description="Exclude islands that aren't part of the playable map, such as an observer platform or decoration. Symmetry is detected again without them.">
        <Actions><Badge Kind="dim">@islands.Count detected</Badge></Actions>
        <ChildContent>
        <div class="panel-list">
          @if (Included.Count == 0) { <EmptyState>No islands found.</EmptyState> }
          @foreach (var isl in Included)
          {
            <ListRow Compact Selected="selectedId == isl.Id"
                 @key="isl.Id" OnClick="() => Select(isl.Id)">
              <span class="geo-type-icon"><i data-lucide="layers"></i></span>
              <span class="list-label">@Label(isl)</span>
              <span class="list-tag">@isl.BlockCount.ToString("N0")</span>
            </ListRow>
          }
        </div>
        </ChildContent>
      </Section>
      <Section Title="Excluded islands">
        <div class="panel-list">
          @if (ExcludedList.Count == 0) { <EmptyState>No islands excluded.</EmptyState> }
          @foreach (var isl in ExcludedList)
          {
            <ListRow Compact Selected="selectedId == isl.Id"
                 @key="isl.Id" OnClick="() => Select(isl.Id)">
              <span class="geo-type-icon"><i data-lucide="layers"></i></span>
              <span class="list-label">@Label(isl)</span>
              <span class="list-tag">@isl.BlockCount.ToString("N0")</span>
            </ListRow>
          }
        </div>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  @* Reused edit canvas in island-select mode — base layer only, click an island to select it. *@
  <WorldCanvas @ref="canvas" Slug="@Slug" IslandSelect="true"
                OnIslandSelect="Select" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="sel.Id">
          <DetailHeader Icon="layers" IconMuted Label="@Label(sel)" />
          <div class="section-body">
            <Field Label="Centre">
              <div class="ctrl-row">
                <CoordField Prefix="X" Value='@sel.CentreX().ToString("0.#")' disabled />
                <CoordField Prefix="Z" Value='@sel.CentreZ().ToString("0.#")' disabled />
              </div>
            </Field>
            <Field Label="Blocks">
              <div class="field-pick-row">
                <span class="field-value">@sel.BlockCount.ToString("N0")</span>
              </div>
            </Field>
            <Field Label="In the map">
              <WriteGate Context="closed">
                <div class="filter-group-options">
                  <Chip Active="!IsExcluded(sel)" Disabled="@(closed is not null)" Title="@closed"
                        OnClick="@(async () => { if (IsExcluded(sel)) await ToggleExclude(sel); })">Included</Chip>
                  <Chip Active="IsExcluded(sel)" Disabled="@(closed is not null)" Title="@closed"
                        OnClick="@(async () => { if (!IsExcluded(sel)) await ToggleExclude(sel); })">Excluded</Chip>
                </div>
              </WriteGate>
            </Field>
          </div>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="layers" IconMuted Label="Islands" />
          <EmptyState>No island selected. Pick one in the list or on the canvas.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>
