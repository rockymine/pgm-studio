@namespace PgmStudio.Client.Features.Configure

@* Teams · spawn step: the point tool drops team 0's spawn; the confirmed symmetry orbit-fills the rest
   (island-aware). The select tool picks a placed marker to inspect/adjust it. Canvas = reused WorldCanvas
   in point-pick mode (base layer only); markers show each team's spawn (placed = bright, orbit = faint).
   The reused side-view sets each spawn's Y on its terrain. *@

<Workspace>

  <Sidebar>
      <Section Title="Spawns" Description="Click an island with the point tool to place a spawn. Every other team gets a symmetry copy.">
        <div class="panel-list">
          @if (spawns.Count == 0) { <EmptyState>No spawns yet. Click an island with the point tool.</EmptyState> }
          @foreach (var s in spawns)
          {
            <ListRow Compact Selected="selectedTeamId == s.Team" @key="s.Team" OnClick="() => SelectTeam(s.Team)">
              <span class="list-swatch" style="--swatch: @Hex(s.Team)"></span>
              <span class="geo-type-icon"><i data-lucide="@PointIcon"></i></span>
              <span class="list-label">@TeamName(s.Team) spawn</span>
              <Badge Class="@(s.Authored ? "badge--success" : "badge--dim")">@(s.Authored ? "Main" : "Copy")</Badge>
            </ListRow>
          }
          @if (observer is not null)
          {
            <ListRow Compact Selected="selectedTeamId == ObserverId" @key="ObserverId" OnClick="() => SelectTeam(ObserverId)">
              <span class="list-swatch" style="--swatch: @ObserverHex"></span>
              <span class="geo-type-icon"><i data-lucide="@PointIcon"></i></span>
              <span class="list-label">Observer spawn</span>
              <Badge Kind="dim">Default</Badge>
            </ListRow>
          }
        </div>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  @* Reused edit canvas — the point tool places a spawn; spawns render as point dummy regions (markers),
     picked by the normal select hit-test. Category is a non-matching sentinel so the generated tree stays
     hidden (only the island base + the spawn markers show). *@
  <WorldCanvas @ref="canvas" Slug="@Slug" PointPick="true" Category="__spawn_authoring__"
                OnPointPick="OnPointPick" OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="sel.Team" Description="@(IsObserver(sel) ? "Where observers wait before the match. Moving it turns it to face a team spawn." : "Every team's spawn shares its height. Moving it turns it to face the mid.")">
          <Header>
            <DetailHeader Icon="@PointIcon" IconMuted Label="@(IsObserver(sel) ? "Observer spawn" : $"{TeamName(sel.Team)} spawn")">
              @if (IsObserver(sel))
              {
                <Badge Kind="dim">Default</Badge>
              }
              else
              {
                <Badge Class="@(sel.Authored ? "badge--success" : "badge--dim")">@(sel.Authored ? "Main" : "Copy")</Badge>
              }
            </DetailHeader>
          </Header>
          <ChildContent>
          <div class="section-body">
            @if (!IsObserver(sel))
            {
              <Readout>Owned by @TeamName(sel.Team).</Readout>
            }
            <Field Label="Location">
              <div class="ctrl-row">
                <CoordField Prefix="X"><NumberField Value="sel.X" ValueChanged="@(v => SetCoord(sel, "x", v))" Step="0.5" CssClass="coord-input" /></CoordField>
                <CoordField Prefix="Y"><NumberField Value="sel.Y" ValueChanged="@(v => SetCoord(sel, "y", v))" Step="0.5" CssClass="coord-input" /></CoordField>
                <CoordField Prefix="Z"><NumberField Value="sel.Z" ValueChanged="@(v => SetCoord(sel, "z", v))" Step="0.5" CssClass="coord-input" /></CoordField>
              </div>
            </Field>
            <Field Label="Facing" Unit="°">
              <div class="ctrl-row">
                <CoordField Prefix="°"><NumberField Value="sel.Yaw" ValueChanged="@(v => SetCoord(sel, "yaw", v))" Step="any" CssClass="coord-input" /></CoordField>
              </div>
            </Field>
            <SliceView Slug="@Slug" Node="@SpawnNode(sel)" OnYChanged="@(y => SetY(sel, y))" SeatOnFloor="true" />
          </div>
          </ChildContent>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="@PointIcon" IconMuted Label="Spawn" />
          <EmptyState>No spawn selected. Click an island to place one, or pick a spawn to adjust it.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>
