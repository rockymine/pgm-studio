@namespace PgmStudio.Client.Features.Configure
@using W = PgmStudio.Client.Features.Configure.WoolAuthoring
@using Ctx = PgmStudio.Client.Features.Configure.AuthoringContext

@* Wools · room: draw the rectangle(s) each wool lives in — a room is a union of rectangles, listed flat
   (one row per rectangle, authored or orbit) and edited one at a time. The right panel shows coordinates. *@

<Workspace>

  <Sidebar>
      <Section Title="Wool rooms" Description="Drag a rectangle around a wool's spawn with the rectangle tool. Several rectangles make one larger room. Every other team gets a symmetry copy.">
        @{ var rows = Rows(); }
        <div class="panel-list">
          @if (wools.Count == 0) { <EmptyState>No wools yet. Confirm them in the Objectives step first.</EmptyState> }
          else if (rows.Count == 0) { <EmptyState>No wool rooms yet. Drag a rectangle around a wool's spawn.</EmptyState> }
          @foreach (var row in rows)
          {
            <ListRow Compact Selected="selectedRegionId == row.RegionId"
                 @key="row.RegionId" OnClick="() => SelectRow(row.RegionId)">
              <span class="list-swatch" style="--swatch: @W.Hex(row.Color)"></span>
              <span class="geo-type-icon"><i data-lucide="rectangle-horizontal"></i></span>
              <span class="list-label">@row.Name</span>
              <Badge Class="@(row.Authored ? "badge--success" : "badge--dim")">@(row.Authored ? "Main" : "Copy")</Badge>
            </ListRow>
          }
        </div>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <WorldCanvas @ref="canvas" Slug="@Slug" RectDraw="true" Category="__wool_room__"
                OnRectDrawn="OnRectDrawn" OnGeometrySaved="OnGeometrySaved" OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <div class="panel-stack" @key="sel.RegionId">
          <Section Description="@(sel.Authored ? "Drag the handles on the canvas to resize it." : null)">
            <Header>
              <DetailHeader Icon="rectangle-horizontal" IconTint="@W.Hex(sel.Color)" Label="@sel.Name">
                <Badge Class="@(sel.Authored ? "badge--success" : "badge--dim")">@(sel.Authored ? "Main" : "Copy")</Badge>
              </DetailHeader>
            </Header>
            <ChildContent>
            <div class="section-body">
              <Field Label="Min">
                <div class="ctrl-row">
                  <CoordField Prefix="X" Value="@sel.MinX" ReadOnly tabindex="-1" />
                  <CoordField Prefix="Z" Value="@sel.MinZ" ReadOnly tabindex="-1" />
                </div>
              </Field>
              <Field Label="Max">
                <div class="ctrl-row">
                  <CoordField Prefix="X" Value="@sel.MaxX" ReadOnly tabindex="-1" />
                  <CoordField Prefix="Z" Value="@sel.MaxZ" ReadOnly tabindex="-1" />
                </div>
              </Field>
              @if (sel.Authored)
              {
                <Readout>Owned by @TeamName(OwnerSlug(sel.Color)).</Readout>
              }
              else
              {
                <Readout>@(AuthoringContext.CopyOf($"the {W.Name(sel.Color).ToLowerInvariant()} wool room"))</Readout>
              }
            </div>
            </ChildContent>
          </Section>

          @if (sel.Authored)
          {
            <Section Title="Rules">
              <Actions><Badge Kind="dim">Automatic</Badge></Actions>
              <ChildContent>
              <div class="panel-list">
                <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="link"></i></span><span class="list-label">Only other teams may enter</span></ListRow>
                <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="link"></i></span><span class="list-label">Only other teams may build</span></ListRow>
                @if (WoolOf(sel.Color) is { } sw)
                {
                  <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="link"></i></span><span class="list-label">Captured at @sw.Monuments.Count wool monuments</span></ListRow>
                }
              </div>
              </ChildContent>
            </Section>
            <InspectorDelete Title="Delete this rectangle" OnClick="() => Remove(sel.RegionId)" />
          }
        </div>
      }
      else
      {
        <Section>
          <DetailHeader Icon="rectangle-horizontal" IconMuted Label="Wool room" />
          <EmptyState>No rectangle selected. Draw one around a wool's spawn, or pick one to resize it.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>
