@namespace PgmStudio.Client.Features.Configure

@* Cores · casing: what each core's structure is, read off the world that holds it or the plan that will
   build it, and the one attribute that lives only in the XML — how far the lava must fall to count. *@

<Workspace>

  <Sidebar>
      <Section Title="Casings">
        <p class="section-desc">The casing comes from the plan or from the imported world. This step changes
          only the <code>map.xml</code>, never the blocks.</p>
        <div class="panel-list">
          @if (cores.Count == 0) { <div class="list-empty">No cores yet. Add one in the Objectives step first.</div> }
          @for (var i = 0; i < cores.Count; i++)
          {
            var index = i;
            var core = cores[index];
            <ListRow Compact Selected="selected == index" @key="index" OnClick="() => Select(index)">
              <span class="geo-type-icon" style="--icon-tint: @TeamHex(core.Owner)"><i data-lucide="flame"></i></span>
              <span class="list-label">@(string.IsNullOrEmpty(core.Name) ? "Core" : core.Name)</span>
              <Badge Kind="dim">@core.Size×@core.Height</Badge>
            </ListRow>
          }
        </div>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <WorldCanvas @ref="canvas" Slug="@Slug" Category="__cores__"
                OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="selected">
          <DetailHeader Icon="flame" IconTint="@TeamHex(sel.Owner)" Label="@(string.IsNullOrEmpty(sel.Name) ? "Core" : sel.Name)">
            <Badge Kind="@(string.IsNullOrEmpty(sel.Owner) ? "dim" : "neutral")">@(string.IsNullOrEmpty(sel.Owner) ? "No team" : TeamName(sel.Owner))</Badge>
          </DetailHeader>
          <div class="section-body">

            <Field Label="Casing">
              <LabelHint>(read-only)</LabelHint>
              <ChildContent>
                <div class="field-value">
                  @sel.Size×@sel.Size×@sel.Height of obsidian around @sel.Lava×@sel.Lava×@sel.LavaHeight of lava.
                  @(sel.OpenTop ? "Open at the top." : "Closed at the top.")
                  Floats @sel.Float block@(sel.Float == 1 ? "" : "s") above the ground.
                </div>
              </ChildContent>
            </Field>

            <Field Label="Region">
              <ChildContent>
                @if (sel.Volume is { } vol)
                {
                  <div class="field-value list-label--mono">@vol.MinX, @vol.MinY, @vol.MinZ → @vol.MaxX, @vol.MaxY, @vol.MaxZ</div>
                }
                else
                {
                  <div class="field-value">Placed when the world is built.</div>
                }
              </ChildContent>
            </Field>

            <Field Label="Leak">
              <LabelHint>(blocks the lava must fall)</LabelHint>
              <ChildContent>
                <NumberField Min="0" Max="64" Value="sel.Leak" ValueChanged="@(value => SetLeak(sel, (int)value))" />
              </ChildContent>
            </Field>
            <p class="section-desc">
              @if (sel.DigDepth > 0)
              {
                <text>Leaking it means breaking the casing <strong>and</strong> digging @sel.DigDepth block@(sel.DigDepth == 1 ? "" : "s") out of the ground below it.</text>
              }
              else
              {
                <text>The lava leaks as soon as the casing is broken. No digging is needed.</text>
              }
            </p>
            <p class="section-desc">This step can't change the casing's size, walls, top, or height. On a map made from a plan,
              edit the core in the <strong>plan</strong>.</p>

          </div>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="flame" IconMuted Label="Casing" />
          <p class="section-desc">Select a core to see its casing and set how far its lava must fall.</p>
        </Section>
      }
  </Inspector>

</Workspace>
