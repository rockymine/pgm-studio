@namespace PgmStudio.Client.Features.Configure

@* Cores · casing: what each core's structure is, read off the world that holds it or the plan that will
   build it, and the one attribute that lives only in the XML — how far the lava must fall to count. *@

<Workspace>

  <Sidebar>
      <Section Title="Casings" Description="The casing comes from the game settings or the imported world. This step sets only the leak, in the map.xml.">
        <div class="panel-list">
          @if (cores.Count == 0) { <EmptyState>No cores yet. Add one in the Objectives step first.</EmptyState> }
          @for (var i = 0; i < cores.Count; i++)
          {
            var index = i;
            var core = cores[index];
            <ListRow Compact Selected="selected == index" @key="index" OnClick="() => Select(index)">
              <span class="geo-type-icon" style="--icon-tint: @TeamHex(core.Owner)"><i data-lucide="flame"></i></span>
              <span class="list-label">@(string.IsNullOrEmpty(core.Name) ? "Core" : core.Name)</span>
              <Badge Kind="dim">@core.Size × @core.Height</Badge>
            </ListRow>
          }
        </div>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <WorldCanvas @ref="canvas" Slug="@Slug" Category="__cores__"
                OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="selected">
          <DetailHeader Icon="flame" IconTint="@TeamHex(sel.Owner)" Label="@(string.IsNullOrEmpty(sel.Name) ? "Core" : sel.Name)">
            <Badge Kind="@(string.IsNullOrEmpty(sel.Owner) ? "dim" : "neutral")">@(string.IsNullOrEmpty(sel.Owner) ? "No team" : TeamName(sel.Owner))</Badge>
          </DetailHeader>
          <div class="section-body">

            <Field Label="Casing" Note="@(sel.OpenTop ? "Lava flush with the rim." : "A lid over the lava.")">
              <ChildContent>
                <div class="field-value">@sel.Size×@sel.Size×@sel.Height of obsidian around @sel.Lava×@sel.Lava×@sel.LavaHeight of lava.</div>
              </ChildContent>
            </Field>
            <Field Label="Float" Unit="blocks" Note="Air left under the casing.">
              <div class="field-value">@sel.Float</div>
            </Field>

            <Field Label="Region">
              <ChildContent>
                @if (sel.Volume is { } vol)
                {
                  <div class="field-value list-label--mono">@vol.MinX, @vol.MinY, @vol.MinZ to @vol.MaxX, @vol.MaxY, @vol.MaxZ</div>
                }
                else
                {
                  <div class="field-value">Placed when the world is built.</div>
                }
              </ChildContent>
            </Field>

            <Field Label="Leak" Unit="blocks" Note="How far the lava falls before the core counts as leaked.">
              <NumberField Min="0" Max="64" Value="sel.Leak" ValueChanged="@(value => SetLeak(sel, (int)value))" />
            </Field>
            <Readout>@DigReadout(sel)</Readout>

          </div>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="flame" IconMuted Label="Casing" />
          <EmptyState>No core selected. Pick one to see its casing and set its leak.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>
