@namespace PgmStudio.Client.Features.Configure

@* World · Scan step: review of the extracted world. The centre panel is WorldCanvas with its navigation
   toolbar (pan/zoom · fit island · reset) and its island-base ↔ surface layer toggle ("Blocks"). The side
   panels summarise the cleaned-base detection, and an imported map can replace its world from a new link. *@

<Workspace>

  <Sidebar>
      <Section Title="Scan" Description="Islands are found from the lowest solid blocks of the world, leaving out the blocks below.">
        <Actions><Badge Kind="success">Automatic</Badge></Actions>
        <ChildContent>
        <div class="panel-list">
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="droplet"></i></span><span class="list-label">Water and lava</span></ListRow>
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="trees"></i></span><span class="list-label">Leaves and logs</span></ListRow>
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="zap"></i></span><span class="list-label">Redstone lines</span></ListRow>
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="grip"></i></span><span class="list-label">Cobweb</span></ListRow>
        </div>
        </ChildContent>
      </Section>
      @if (imported)
      {
        <Section Title="World replacement"
                 Help="Downloads the world again from a link and reads it in place of the one this map was imported from."
                 Description="Everything set here stays, but islands are found again, so check the Islands and Teams steps afterwards.">
          <ChildContent>
          <Field Label="Link">
            <div class="ctrl-row">
              <input class="field-input" type="text" @bind="urlInput" @bind:event="oninput"
                     disabled="@reimporting"
                     @onkeydown="@(e => { if (e.Key == "Enter") _ = Reimport(); })" />
              <Button Variant="primary" OnClick="Reimport" Busy="@reimporting" BusyLabel="Downloading…" Writes
                      Disabled="@(string.IsNullOrWhiteSpace(urlInput))">
                <i data-lucide="download"></i><span>Import</span>
              </Button>
            </div>
          </Field>
          @if (reimportError is not null) { <div class="panel-warning">@reimportError</div> }
          @if (reimported) { <Readout>Read the world again and found @islandCount islands.</Readout> }
          </ChildContent>
        </Section>
      }
      <Section Title="Layer view" Description="The canvas shows the island outlines. Blocks in the toolbar shows the whole surface of the world." />
  </Sidebar>

  <div class="sidebar-handle"></div>

  @* The world canvas with no mode set — move/select only. *@
  <WorldCanvas @key="worldVersion" Slug="@Wizard.Slug" />

  <div class="sidebar-handle"></div>

  <Inspector>
      <Section>
        <DetailHeader Icon="layers" IconMuted Label="Scan summary">
          <Badge Kind="success">Cleaned</Badge>
        </DetailHeader>
        <div class="section-body">
          <Field Label="Blocks read">
            <div class="field-pick-row"><span class="field-value">Lowest solid</span><span class="list-tag">noise removed</span></div>
          </Field>
          <Field Label="Islands">
            <div class="field-pick-row"><span class="field-value">@islandCount</span><span class="list-tag">10 blocks or more</span></div>
          </Field>
          <Field Label="Symmetry">
            <div class="field-pick-row">
              <span class="field-value">@SymmetryInfo.Label(symType)</span>
              @if (symType is not null) { <Badge Kind="success">@symConfidence.ToString("P0")</Badge> }
            </div>
          </Field>
        </div>
      </Section>
  </Inspector>

</Workspace>
