@namespace PgmStudio.Client.Features.Configure

@* World · Scan step: read-only review of the extracted world. The centre panel is WorldCanvas with its
   navigation toolbar (pan/zoom · fit island · reset) and its island-base ↔ surface layer toggle
   ("Blocks"). The side panels summarise the cleaned-base detection. *@

<Workspace>

  <Sidebar>
      <Section Title="Scan">
        <Actions><Badge Kind="success">Automatic</Badge></Actions>
        <ChildContent>
        <p class="section-desc">Islands were found from the lowest solid blocks of the world. This view is
          read-only.</p>
        <div class="panel-list">
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="droplet"></i></span><span class="list-label">Water · lava</span><span class="list-tag">excluded</span></ListRow>
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="trees"></i></span><span class="list-label">Leaves and logs</span><span class="list-tag">excluded</span></ListRow>
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="zap"></i></span><span class="list-label">Redstone lines</span><span class="list-tag">excluded</span></ListRow>
          <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="grip"></i></span><span class="list-label">Cobweb</span><span class="list-tag">excluded</span></ListRow>
        </div>
        </ChildContent>
      </Section>
      <Section Title="Layer view">
        <p class="section-desc">The canvas shows the island outlines. Turn on <strong>Blocks</strong> in the
          toolbar to see the full surface of the world.</p>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  @* The world canvas with no mode set — move/select only. *@
  <WorldCanvas Slug="@Wizard.Slug" />

  <div class="sidebar-handle"></div>

  <Inspector>
      <Section>
        <DetailHeader Icon="layers" IconMuted Label="Scan summary">
          <Badge Kind="success">Cleaned</Badge>
        </DetailHeader>
        <div class="section-body">
          <Field Label="Layer">
            <div class="field-pick-row"><span class="field-value">Lowest solid</span><span class="list-tag">noise removed</span></div>
          </Field>
          <Field Label="Islands">
            <div class="field-pick-row"><span class="field-value">@islandCount</span><span class="list-tag">≥ 10 blocks</span></div>
          </Field>
          <Field Label="Symmetry">
            <div class="field-pick-row">
              <span class="field-value">@SymmetryInfo.Label(symType)</span>
              @if (symType is not null) { <Badge Kind="success">@symConfidence.ToString("P0")</Badge> }
            </div>
          </Field>
          <p class="section-desc">These outlines become the islands in the next step. The surface layer is
            for reference only.</p>
        </div>
      </Section>
  </Inspector>

</Workspace>
