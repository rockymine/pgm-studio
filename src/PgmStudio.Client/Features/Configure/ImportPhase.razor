@namespace PgmStudio.Client.Features.Configure

@* Import phase (Configure phase-zero) — the Source → Found → Plan flow that creates a map from a
   terrain-only world and hands off to the Configure wizard. Hosted by ConfigureTool on the slug-less
   /maps/new route (a map has no id until the world is imported); once a world is imported it navigates to
   /maps/{slug}/configure, which skips straight to Identity. Source lists importable world folders; Next
   scans the chosen world; Found shows the detection brief over the reused world canvas; Plan starts the
   wizard. The rail's later phases stay locked until Start. *@

<ConfigureLayout MapName="@(importedSlug ?? selected?.Slug)" Crumb="Import" ActivePhaseId="" Furthest="@(-1)"
              PhaseIcon="import" PhaseTitle="Import"
              Steps="@Steps" CurrentStep="@step" MaxStep="@MaxStep"
              BackEnabled="@BackEnabled" NextEnabled="@NextEnabled" NextLabel="@NextLabel"
              NextBusy="@importing" NextBusyLabel="Scanning…"
              OnStep="JumpStep" OnBack="Back" OnNext="Next">

  @* ── Step 1 · Source — pick an xml-less world folder (panel only) ─────────── *@
  @if (OnSource)
  {
    <Workspace @key="step">
      <ContentColumn MaxWidth="760">

        <Section Title="World folders">
          <Actions><Badge Kind="success">No map.xml needed</Badge></Actions>
          <ChildContent>
          <p class="section-desc">Worlds with terrain but no <code>map.xml</code> yet. Pick one to scan it.</p>

          @if (candidates.Count == 0)
          {
            <p class="panel-empty-msg panel-empty-msg--left">
              No worlds to import yet. Add a Minecraft world folder that has terrain but no
              <code>map.xml</code>.
            </p>
          }
          else
          {
            <div class="panel-list panel-list--separated">
              @foreach (var c in candidates)
              {
                <ListRow Compact Selected="c == selected" OnClick="() => Select(c)">
                  <span class="geo-type-icon"><i data-lucide="@(c == selected ? "folder-open" : "folder")"></i></span>
                  <span class="list-label list-label--mono">@c.Folder</span>
                  <span class="list-tag">@c.RegionFiles region files</span>
                  @if (c == selected) { <Badge Kind="success">Selected</Badge> }
                </ListRow>
              }
            </div>
          }

          @if (selected is not null)
          {
            <div class="section-footer">
              <span class="panel-save-status">
                <code>@selected.Folder</code> · @selected.RegionFiles region files · no <code>map.xml</code>
              </span>
            </div>
          }
          </ChildContent>
        </Section>

        <Section Title="Download link">
          <Actions><Badge Kind="dim">Overcast or S3 zip</Badge></Actions>
          <ChildContent>
          <p class="section-desc">Paste a link to a zipped world, such as an Overcast <code>…/download</code>
            link. Only approved hosts can be used.</p>
          <Field Label="Download URL">
            <div class="ctrl-row">
              <input class="field-input" type="text" @bind="urlInput" @bind:event="oninput"
                     placeholder="https://…/maps/your-world/download" disabled="@importingUrl"
                     @onkeydown="@(e => { if (e.Key == "Enter") _ = ImportFromUrl(); })" />
              <Button Variant="primary" OnClick="ImportFromUrl" Busy="@importingUrl" BusyLabel="Downloading…"
                      Disabled="@(string.IsNullOrWhiteSpace(urlInput))">
                <i data-lucide="download"></i><span>Import</span>
              </Button>
            </div>
          </Field>
          </ChildContent>
        </Section>

      </ContentColumn>
    </Workspace>
  }

  @* ── Step 2 · Found — the import brief over the reused world canvas ──────── *@
  else if (OnFound)
  {
    <Workspace @key="step">

      <Sidebar>
          <Section Title="Files">
            <div class="panel-list">
              <ListRow Compact Class="list-row--muted">
                <span class="geo-type-icon"><i data-lucide="folder-open"></i></span>
                <span class="list-label list-label--mono">@SourceFolder/</span>
              </ListRow>
              <ListRow Compact Class="list-row--muted">
                <span class="geo-type-icon"><i data-lucide="box"></i></span>
                <span class="list-label list-label--mono">region/ · @SourceRegionFiles .mca</span>
              </ListRow>
              <ListRow Compact Class="list-row--muted">
                <span class="geo-type-icon"><i data-lucide="file-x"></i></span>
                <span class="list-label list-label--mono">map.xml</span>
                <Badge Kind="dim">None</Badge>
              </ListRow>
            </div>
          </Section>

          <Section Title="Detected">
            <div class="panel-list">
              @foreach (var f in Findings.Where(f => f.Group == "detected"))
              {
                <ListRow Compact Selected="selectedFinding == f.Key" OnClick="() => SelectFinding(f.Key)">
                  <span class="geo-type-icon"><i data-lucide="@f.Icon"></i></span>
                  <span class="list-label">@f.Label</span>
                  <span class="list-tag">@FindingTag(f.Key)</span>
                </ListRow>
              }
            </div>
            @if (symType is not null)
            {
              <p class="section-desc">Symmetry: <Badge Kind="success">@SymmetryInfo.Label(symType)</Badge>.
                Suggested teams: <Badge Kind="success">@SuggestedTeams</Badge>. You confirm both in the World and
                Teams phases.</p>
            }
            else
            {
              <p class="section-desc">No symmetry found. You set up teams in the Teams phase.</p>
            }
          </Section>

          <Section Title="Already built">
            <div class="panel-list">
              @foreach (var f in Findings.Where(f => f.Group == "built"))
              {
                <ListRow Compact Selected="selectedFinding == f.Key" OnClick="() => SelectFinding(f.Key)">
                  <span class="geo-type-icon"><i data-lucide="@f.Icon"></i></span>
                  <span class="list-label">@f.Label</span>
                  <span class="list-tag">@FindingTag(f.Key)</span>
                </ListRow>
              }
            </div>
          </Section>
      </Sidebar>

      <div class="sidebar-handle"></div>

      <div class="workspace-canvas">
        <div class="canvas-subbar">
          <span class="canvas-cursor">Top-down</span>
        </div>
        <div @ref="wrapRef" class="svg-area">
          <svg @ref="svgRef" class="map-canvas-svg" xmlns="http://www.w3.org/2000/svg"></svg>
        </div>
      </div>

      <div class="sidebar-handle"></div>

      <Inspector>
          <Section @key="selectedFinding">
            <DetailHeader Icon="@FindingIcon(selectedFinding)" IconMuted Label="@FindingLabel(selectedFinding)">
              <Badge Kind="dim">@FindingTag(selectedFinding)</Badge>
            </DetailHeader>
            <div class="section-body">
              <p class="section-desc">@FindingExplanation(selectedFinding)</p>

              @if (selectedFinding == "wool" && woolColors.Count > 0)
              {
                <Field Label="Colours found">
                  <div class="panel-list">
                    @foreach (var w in woolColors)
                    {
                      <ListRow Compact Class="list-row--muted">
                        <span class="list-swatch" style="--swatch: @w.Hex"></span>
                        <span class="list-label">@w.Name</span>
                        <span class="list-tag">@w.Count</span>
                      </ListRow>
                    }
                  </div>
                </Field>
              }
              else if (selectedFinding == "islands" && islands.Count > 0)
              {
                <Field Label="Island sizes">
                  <div class="panel-list">
                    @for (var i = 0; i < islands.Count; i++)
                    {
                      <ListRow Compact Class="list-row--muted">
                        <span class="list-label">Island @(i + 1)</span>
                        <span class="list-tag">@islands[i].BlockCount blocks</span>
                      </ListRow>
                    }
                  </div>
                </Field>
              }
              else if (selectedFinding == "resources" && resourceTypes.Count > 0)
              {
                <Field Label="Types found">
                  <div class="panel-list">
                    @foreach (var r in resourceTypes)
                    {
                      <ListRow Compact Class="list-row--muted">
                        <span class="list-label">@r.Name</span>
                        <span class="list-tag">@r.Count</span>
                      </ListRow>
                    }
                  </div>
                </Field>
              }
            </div>
          </Section>
      </Inspector>

    </Workspace>
  }

  @* ── Step 3 · Plan — the six phases, then Start (panel only) ─────────────── *@
  else
  {
    <Workspace @key="step">
      <ContentColumn MaxWidth="920">
        <Section Title="What happens next">
          <Actions><Badge Kind="dim">@importedSlug · @islandCount islands@(symType is not null ? $" · {SymmetryInfo.Label(symType)}" : "")</Badge></Actions>
          <ChildContent>
          <p class="section-desc">These phases take <strong>@importedSlug</strong> from terrain to a finished
            <code>map.xml</code>.</p>

          <div class="card-grid">
            @foreach (var (p, i) in ConfigurePhases.All.Select((p, i) => (p, i)))
            {
              <div class="card">
                <div class="card-head">
                  <span class="card-icon"><i data-lucide="@p.Icon"></i></span>
                  <span class="card-title">@p.Title</span>
                  <span class="card-step">@(i + 1)</span>
                </div>
                <p class="card-desc">@PlanBlurb(p.Id)</p>
              </div>
            }
          </div>

          <div class="callout">
            <span class="callout-icon"><i data-lucide="repeat"></i></span>
            <p><strong>Playability check.</strong> Before export, the studio checks that every team can
              reach every wool. If a path is missing, it sends you back to Build to add a bridge.</p>
          </div>

          </ChildContent>
        </Section>
      </ContentColumn>
    </Workspace>
  }

  @if (error is not null)
  {
    <Toast Message="@error" />
  }

</ConfigureLayout>
