@namespace PgmStudio.Client.Features.Configure
@using PgmStudio.Client.Models
@using W = PgmStudio.Client.Features.Configure.WoolAuthoring
@using Ctx = PgmStudio.Client.Features.Configure.AuthoringContext

@* Wools · objectives: the world scan names the objectives (signed monuments) and their owners (island of
   the source / complement of the capturing team); physical wool that no monument names is decorative and
   excluded by default. The author confirms/rejects, fixes an owner, or adds a missing wool. *@

<Workspace>

  <Sidebar>
      <Section Title="Objective wools">
        <Actions><Badge Class="@(Included > 0 ? "badge--success" : "badge--dim")">@Included objective@(Included == 1 ? "" : "s")</Badge></Actions>
        <ChildContent>
        <p class="section-desc">Found in the world. Monument signs name each wool and the team that captures
          it. Wool that no monument names is treated as decoration.</p>
        @if (disagreements.Count > 0)
        {
          <div class="callout">
            <span class="callout-icon"><i data-lucide="triangle-alert"></i></span>
            <div>
              <p>The objectives no longer match the islands' teams:</p>
              <ul>@foreach (var line in disagreements) { <li>@line</li> }</ul>
              <Button Writes Variant="primary" Icon="refresh-cw" OnClick="ReassignFromIslands">Take the teams from the islands</Button>
            </div>
          </div>
        }
        @if (loading)
        {
          <div class="list-empty">Scanning the world…</div>
        }
        else
        {
          <div class="panel-list">
            @if (candidates.Count == 0) { <div class="list-empty">No wool found in the world. Add one below.</div> }
            @foreach (var c in candidates)
            {
              <ListRow Compact Selected="selectedColor == c.Color" Class="@(c.Included ? null : "list-row--muted")"
                   @key="c.Color" OnClick="() => Select(c)">
                <span class="list-swatch" style="--swatch: @W.Hex(c.Color)"></span>
                <span class="list-label list-label--mono">@c.Color</span>
                @if (c.Included)
                {
                  <Badge Class="badge--team" style="@($"--swatch: {(string.IsNullOrEmpty(c.Owner) ? "transparent" : W.Hex(TeamColorOf(c.Owner)))}")">@(string.IsNullOrEmpty(c.Owner) ? "No owner" : TeamName(c.Owner))</Badge>
                }
                else
                {
                  <Badge Kind="dim" title="@c.ExcludeReason">Excluded</Badge>
                }
              </ListRow>
            }
          </div>
          @if (AddableColors.Count > 0)
          {
            <Field Label="Add a wool">
              <SwatchRow TKey="string" Writes OnPick="AddWool"
                         Swatches="@AddableColors.Select(d => new SwatchRow<string>.Swatch(W.NormColor(d.Value), d.Hex, d.Label)).ToList()" />
            </Field>
          }
        }
        </ChildContent>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <WorldCanvas @ref="canvas" Slug="@Slug" Category="__wool_objectives__"
                OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="sel.Color">
          <DetailHeader Icon='@(sel.Signed ? "sparkles" : "square")' IconTint="@W.Hex(sel.Color)" Mono Label="@sel.Color">
            <Badge Class="@(sel.Included ? "badge--success" : "badge--dim")">@(sel.Included ? "Objective" : "Excluded")</Badge>
          </DetailHeader>
          <div class="section-body">
            <Field Label="Colour">
              <SwatchRow TKey="string" Selected="@sel.Color" OnPick="@(c => SetColor(sel, c))"
                         Swatches="@GameColors.DyeColors.Select(d => new SwatchRow<string>.Swatch(W.NormColor(d.Value), d.Hex, d.Label)).ToList()" />
            </Field>
            <Field Label="Defending team">
              <LabelHint>(owns it)</LabelHint>
              <ChildContent>
                <div class="field-pick-row">
                  <span class="field-swatch" style="--swatch: @(string.IsNullOrEmpty(sel.Owner) ? "transparent" : W.Hex(TeamColorOf(sel.Owner)))"></span>
                  <Select Slim="false" Options="@AuthoringContext.TeamOptions(teams)" Placeholder="Choose a team"
                          Value="@sel.Owner" ValueChanged="@(team => SetOwner(sel, team))" />
                </div>
              </ChildContent>
            </Field>

            @if (sel.Signed && !string.IsNullOrEmpty(sel.Evidence))
            {
              <Field Label="Sign">
                <ChildContent>
                  <div class="field-value field-value--wrap">@sel.Evidence.Replace("\n", " ")</div>
                  <div class="meter meter--separated"><div class="meter-fill" style="--meter-level: @((int)(sel.Confidence * 100))%"></div></div>
                </ChildContent>
              </Field>
            }

            <Field Label="Source">
              <div class="field-value">
                @if (sel.HasSource) { <text>@sel.Count wool block@(sel.Count == 1 ? "" : "s") · centre @Fmt(sel.X), @Fmt(sel.Y), @Fmt(sel.Z)</text> }
                else { <text>No wool blocks in the world. Place it in the Spawn step.</text> }
              </div>
            </Field>
            <Field Label="Captured by">
              <LabelHint>(every other team, at its own monument)</LabelHint>
              <ChildContent>
                <div class="field-value field-value--wrap">
                  @if (string.IsNullOrEmpty(sel.Owner)) { <text>Choose the defending team first.</text> }
                  else
                  {
                    @foreach (var cap in Capturers(sel))
                    {
                      var monument = sel.Monuments.FirstOrDefault(m => m.Team == cap.Id);
                      <div>@cap.Name: @(monument is null ? "no monument yet. Place it in the Monuments step." : $"monument at {Fmt(monument.X)}, {Fmt(monument.Y)}, {Fmt(monument.Z)}")</div>
                    }
                    @foreach (var stray in sel.Monuments.Where(m => !Capturers(sel).Any(cap => cap.Id == m.Team)))
                    {
                      <div class="field-error">A monument at @Fmt(stray.X), @Fmt(stray.Y), @Fmt(stray.Z) has @(string.IsNullOrEmpty(stray.Team) ? "no team" : $"{TeamName(stray.Team)}, which defends this wool"). Fix it in the Monuments step.</div>
                    }
                  }
                </div>
              </ChildContent>
            </Field>

            <div class="ctrl-row ctrl-row--separated">
              @if (sel.Included)
              {
                <Button Writes Fill OnClick="() => Toggle(sel)"><i data-lucide="x"></i> Exclude</Button>
              }
              else
              {
                <Button Writes Variant="primary" Fill OnClick="() => Toggle(sel)"><i data-lucide="check"></i> Include@(string.IsNullOrEmpty(sel.ExcludeReason) ? "" : " anyway")</Button>
              }
              <Button Writes Fill OnClick="() => Remove(sel)" Title="Remove"><i data-lucide="trash-2"></i></Button>
            </div>
            @if (!sel.Included && !string.IsNullOrEmpty(sel.ExcludeReason))
            {
              <p class="section-desc">Excluded. @sel.ExcludeReason</p>
            }
          </div>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="goal" IconMuted Label="Wool" />
          <p class="section-desc">Select a wool to change its owner or exclude it. Included wools become the
            map's objectives.</p>
        </Section>
      }
  </Inspector>

</Workspace>

@code {
    private string TeamColorOf(string id) => TeamOf(id)?.Color ?? "";
    private static string Fmt(double v) => v.ToString("0.#");
}
