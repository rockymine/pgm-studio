@page "/maps/{Slug}/configure"
@page "/maps/new"
@layout StudioLayout
@inject HttpClient Http
@inject IJSRuntime JS

@* Configure tool. Phase zero is the conditional Import phase (the slug-less /maps/new route — a map has
   no id until its world is imported); once imported it navigates to /maps/{slug}/configure, which skips
   Import and opens the wizard at Identity. The wizard is an activity rail + flow bar + three-panel
   workspace with a phase/step state machine and an intent-slice-gated rail. Built phase bodies render
   their own workspace; the rest are scaffold placeholders. See new-map-authoring.md §12 + tool-consistency.md. *@

@if (ImportMode)
{
  <ImportPhase />
}
else
{
<ConfigureLayout MapName="@mapName" Slug="@Slug" ActivePhaseId="@Phase.Id" Phases="@phases" Furthest="@furthest"
              PhaseIcon="@Phase.Icon" PhaseTitle="@Phase.Title"
              Steps="@Phase.Steps" CurrentStep="@step" SaveStatus="@SaveStatus"
              BackEnabled="@BackEnabled" NextEnabled="@NextEnabled" NextLabel="@NextLabel"
              NextBusy="@exporting" NextBusyLabel="Exporting…" NextBuilds="@AtEnd"
              OnJumpPhase="JumpPhase" OnStep="JumpStep" OnBack="Back" OnNext="Next">

  @* Phase bodies render inside this cascade: they patch their slice on Intent and call MarkDirty(), and
     the wizard persists it on the next phase-advance. *@
  <CascadingValue Value="this" IsFixed="true">
  @if (!ready)
  {
    @* Hold the phase bodies until the intent has loaded — they read it once on init, so mounting them
       mid-load would capture an empty intent (blank Identity even when the map has a name/authors). *@
    <div class="workspace" @key="@("loading")">
      <div class="workspace-scroll"><p class="panel-empty-msg">Loading…</p></div>
    </div>
  }
  else if (Phase.Id == "info")
  {
    <IdentityPhase @key="@Phase.Id" />
  }
  else if (Phase.Id == "world" && step == 0)
  {
    <WorldScanStep @key="@("world-scan")" />
  }
  else if (Phase.Id == "world" && step == 1)
  {
    <WorldIslandsStep @key="@("world-islands")" />
  }
  else if (Phase.Id == "world" && step == 2)
  {
    <WorldSymmetryStep @key="@("world-symmetry")" />
  }
  else if (Phase.Id == "teams" && step == 0)
  {
    <TeamAssignStep @key="@("teams-assign")" />
  }
  else if (Phase.Id == "teams" && step == 1)
  {
    <SpawnStep @key="@("teams-spawn")" />
  }
  else if (Phase.Id == "teams" && step == 2)
  {
    <ProtectionStep @key="@("teams-protect")" />
  }
  else if (Phase.Id == "build" && step == 0)
  {
    <BuildHeightStep @key="@("build-height")" />
  }
  else if (Phase.Id == "build" && step == 1)
  {
    <BuildLayerStep @key="@("build-layer")" />
  }
  @* Keyed on the step label, not its index: sketch-origin maps drop the Monuments step, which
     shifts Room's index down (ConfigureTool.razor.cs LoadOriginAsync). *@
  else if (Phase.Id == "wools" && StepLabel == "Objectives")
  {
    <WoolObjectivesStep @key="@("wools-objectives")" />
  }
  else if (Phase.Id == "wools" && StepLabel == "Spawn")
  {
    <WoolSpawnStep @key="@("wools-spawn")" />
  }
  else if (Phase.Id == "wools" && StepLabel == "Monuments")
  {
    <WoolMonumentsStep @key="@("wools-monuments")" />
  }
  else if (Phase.Id == "wools" && StepLabel == "Room")
  {
    <WoolRoomStep @key="@("wools-room")" />
  }
  else if (Phase.Id == "dtm" && step == 0)
  {
    <DestroyableObjectivesStep @key="@("dtm-objectives")" />
  }
  else if (Phase.Id == "cores" && step == 0)
  {
    <CoreObjectivesStep @key="@("cores-objectives")" />
  }
  else if (Phase.Id == "cores" && step == 1)
  {
    <CoreCasingStep @key="@("cores-casing")" />
  }
  else if (Phase.Id == "review" && step == 0)
  {
    <ReviewPreflightStep @key="@("review-preflight")" />
  }
  else if (Phase.Id == "review" && step == 1)
  {
    <ReviewTreeStep @key="@("review-tree")" />
  }
  else if (Phase.Id == "review" && step == 2)
  {
    <ReviewXmlStep @key="@("review-xml")" />
  }
  else
  {
  <Workspace @key="@Phase.Id">
    <Sidebar>
        <Section Title="@Phase.Title">
          <ChildContent>
          <p class="section-desc">
            @if (Phase.Steps.Length == 0)
            {
              <text>This phase has one step.</text>
            }
            else
            {
              <text>Step @(step + 1) of @Phase.Steps.Length: <strong>@StepLabel</strong>.</text>
            }
          </p>
          <p class="panel-empty-msg panel-empty-msg--left">
            This phase isn't available yet.
          </p>
          </ChildContent>
        </Section>
    </Sidebar>

    <div class="sidebar-handle"></div>

    <div class="workspace-canvas">
      <div class="canvas-surface canvas-surface--centered">
        <p class="panel-empty-msg">@Phase.Title · @StepLabel</p>
      </div>
    </div>

    <div class="sidebar-handle"></div>

    <Inspector>
        <Section>
          <DetailHeader Icon="@Phase.Icon" IconMuted Label="Inspector" />
          <p class="section-desc">Nothing to show yet.</p>
        </Section>
    </Inspector>
  </Workspace>
  }
  </CascadingValue>

</ConfigureLayout>
}
