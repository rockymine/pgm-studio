@namespace PgmStudio.Client.Features.Configure

@* Build · height step: the max-build-height cap, set on the BuildHeightSideview. Writes the build slice's maxHeight; the generator applies it. *@

<Workspace>

  <Sidebar>
      <Section Title="Build height">
        <p class="section-desc">Players can't place blocks above this Y level. Drag the line in the side view
          or type a value up to 100. Leave it blank for no limit.</p>
        <Field Label="Y level">
          <input class="field-input" type="number" min="0" max="100" step="1" placeholder="None"
                 value="@height" @onchange="OnHeightInput" />
        </Field>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <BuildHeightSideview Slug="@Slug" Height="@height" HeightChanged="OnSideviewHeight" />

</Workspace>
