@namespace PgmStudio.Client.Features.Configure

@* Build · ceiling step: the build ceiling, set on the BuildHeightSideview. Writes the build slice's maxHeight; the generator applies it. *@

<Workspace>

  <Sidebar>
      <Section Title="Build ceiling" Description="Drag the line in the side view or type a value up to 100." Writes>
        <Field Label="Build ceiling" Unit="world y" Term="build ceiling">
          <NumberField Min="0" Max="MaxHeight" Value="height" ValueChanged="OnHeightInput" OnCleared="ClearHeight"
                       placeholder="No ceiling" />
        </Field>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <BuildHeightSideview Slug="@Slug" Height="@height" HeightChanged="OnSideviewHeight" />

</Workspace>
