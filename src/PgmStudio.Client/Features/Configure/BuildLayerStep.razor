@namespace PgmStudio.Client.Features.Configure

@* Build · buildable-layer step: draw the over-void bridges/platforms (areas) and optional no-build holes
   with the rectangle tool. Each is a dummy region on the reused canvas (selectable + resizable). Writes the
   build slice's areas/holes; the generator unions the areas, subtracts the holes, and wires void enforcement. *@

<Workspace>

  <Sidebar>
      <Section Title="Buildable layer">
        <p class="section-desc">Use the <strong>rectangle tool</strong> to mark where players may build over the
          void, such as bridges and platforms. Island ground is already buildable. Switch to
          <strong>Hole</strong> to cut out areas where building is not allowed.</p>
        <div class="panel-list">
          @if (boxes.Count == 0) { <div class="list-empty">Nothing drawn yet. Pick a tool and drag a rectangle.</div> }
          @foreach (var b in boxes)
          {
            <ListRow Compact Selected="selectedId == b.Id"
                 @key="b.Id" OnClick="() => SelectBox(b.Id)">
              <span class="list-swatch" style="background:@(b.Hole ? HoleColor : AreaColor)"></span>
              <span class="geo-type-icon"><i data-lucide="rectangle-horizontal"></i></span>
              <span class="list-label list-label--mono">@Label(b)</span>
              <Badge Kind="dim">@(b.Hole ? "Hole" : "Bridge")</Badge>
            </ListRow>
          }
        </div>
        @if (MirrorActive && boxes.Count > 0)
        {
          <p class="section-desc">The faint shapes on the canvas are symmetry copies. They are created
            automatically, so they aren't listed here.</p>
        }
        @if (boxes.Any(x => x.Hole) && !boxes.Any(x => !x.Hole))
        {
          <p class="section-desc">A hole only cuts into a bridge. Add a bridge for it to take effect.</p>
        }
      </Section>

      @if (overlayOn)
      {
      <Section Title="Edit zones">
        <p class="section-desc"><strong>Editable</strong> colours the map by where players can place or break
          blocks.</p>
        <div class="panel-list">
          <ListRow Compact><span class="list-swatch" style="background:#4caf50"></span><span class="list-label">Build zone</span><Badge Kind="dim">A rectangle you drew</Badge></ListRow>
          <ListRow Compact><span class="list-swatch" style="background:#8bc34a"></span><span class="list-label">Ground</span><Badge Kind="dim">Terrain at y=0</Badge></ListRow>
          <ListRow Compact><span class="list-swatch" style="background:#fbc02d"></span><span class="list-label">Behind a filter</span><Badge Kind="dim">A spawn or wool room</Badge></ListRow>
          <ListRow Compact><span class="list-swatch" style="background:#c62828"></span><span class="list-label">Nobody</span><Badge Kind="dim">Draw a bridge</Badge></ListRow>
        </div>
        <p class="section-desc">Draw a bridge across red void to connect your islands. The colours update
          when the step is saved.</p>
      </Section>
      }
  </Sidebar>

  <div class="sidebar-handle"></div>

  @* Reused edit canvas in rectangle-draw mode — draws report to the intent (no region is created); the
     bridges/holes render as dummy regions. Category is non-matching so the generated tree stays hidden.
     Which of the two a drag makes is armed on the canvas dock rather than in this sidebar: it decides what
     the very next drag does, so it belongs beside the tool that drags, wearing the colour the rectangle will
     take — the same reading Sketch's Build/Carve gives. *@
  <WorldCanvas @ref="canvas" Slug="@Slug" RectDraw="true" Category="__build_authoring__" ShowEditZones="true"
                DrawAccent="@(HoleMode ? HoleColor : AreaColor)"
                OnEditZonesToggled="OnEditZonesToggled"
                OnRectDrawn="OnRectDrawn" OnGeometrySaved="OnGeometrySaved" OnSelect="OnCanvasSelect" OnReady="OnCanvasReady">
    <DrawMode>
      <DockModeButton Pressed="@HoleMode" Title="@DrawModeTitle" OnClick="ToggleDrawMode">@(HoleMode ? "Hole" : "Bridge")</DockModeButton>
    </DrawMode>
  </WorldCanvas>

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="sel.Id">
          <DetailHeader Icon="rectangle-horizontal" IconMuted Mono Label="@Label(sel)">
            <Badge Kind="dim">@(sel.Hole ? "Hole" : "Bridge")</Badge>
          </DetailHeader>
          <div class="section-body">
            <Field Label="Min">
              <div class="ctrl-row">
                <CoordField Prefix="X" Value="@sel.MinX" ReadOnly tabindex="-1" />
                <CoordField Prefix="Z" Value="@sel.MinZ" ReadOnly tabindex="-1" />
              </div>
            </Field>
            <Field Label="Max">
              <div class="ctrl-row">
                <CoordField Prefix="X" Value="@sel.MaxX" ReadOnly tabindex="-1" />
                <CoordField Prefix="Z" Value="@sel.MaxZ" ReadOnly tabindex="-1" />
              </div>
            </Field>
            <p class="section-desc">Drag the handles on the canvas to resize it.</p>
            <div class="section-footer section-footer--separated">
              <Button Variant="danger" Fill OnClick="() => Remove(sel.Id)">Remove @(sel.Hole ? "hole" : "bridge")</Button>
            </div>
          </div>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="rectangle-horizontal" IconMuted Label="Buildable layer" />
          <p class="section-desc">Draw a bridge or hole, or select one to resize it.</p>
        </Section>
      }
  </Inspector>

</Workspace>
