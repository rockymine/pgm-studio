@namespace PgmStudio.Client.Features.Configure

@* Build · buildable-layer step: draw the over-void bridges/platforms (areas) and optional no-build holes
   with the rectangle tool. Each is a dummy region on the reused canvas (selectable + resizable). Writes the
   build slice's areas/holes; the generator unions the areas, subtracts the holes, and wires void enforcement. *@

<Workspace>

  <Sidebar>
      <Section Title="Build regions" Description="Draw where players may build over the void, such as bridges. Island ground is already buildable. Every other team gets a symmetry copy.">
        <div class="panel-list">
          @if (boxes.Count == 0) { <EmptyState>No build regions yet. Drag a rectangle with the rectangle tool.</EmptyState> }
          @foreach (var b in Rows)
          {
            <ListRow Compact Selected="selectedId == b.Id"
                 @key="b.Id" OnClick="() => SelectBox(b.Id)">
              <span class="list-swatch" style="--swatch: @(b.Hole ? HoleColor : AreaColor)"></span>
              <span class="geo-type-icon"><i data-lucide="rectangle-horizontal"></i></span>
              <span class="list-label">@Label(b)</span>
              <Badge Class="@(b.Authored ? "badge--success" : "badge--dim")">@(b.Authored ? "Main" : "Copy")</Badge>
            </ListRow>
          }
        </div>
        @if (boxes.Any(x => x.Hole) && !boxes.Any(x => !x.Hole))
        {
          <div class="panel-warning">A hole only cuts into a bridge. Add a bridge for it to take effect.</div>
        }
      </Section>

      @if (overlayOn)
      {
      <Section Title="Buildable key" Description="Buildable colours the map by where players may place or break blocks. Bridge any red void between islands. Colours update on save.">
        <div class="panel-list">
          <ListRow Compact><span class="list-swatch" style="--swatch: @EditZone.Colors[EditZone.BuildZone]"></span><span class="list-label">Build region</span><Badge Kind="dim">A bridge you drew</Badge></ListRow>
          <ListRow Compact><span class="list-swatch" style="--swatch: @EditZone.Colors[EditZone.Ground]"></span><span class="list-label">Ground</span><Badge Kind="dim">Island ground</Badge></ListRow>
          <ListRow Compact><span class="list-swatch" style="--swatch: @EditZone.Colors[EditZone.Filtered]"></span><span class="list-label">Behind a filter</span><Badge Kind="dim">A spawn or wool room</Badge></ListRow>
          <ListRow Compact><span class="list-swatch" style="--swatch: @EditZone.Colors[EditZone.Sealed]"></span><span class="list-label">Nobody</span><Badge Kind="dim">Void</Badge></ListRow>
        </div>
      </Section>
      }
  </Sidebar>

  <div class="sidebar-handle"></div>

  @* Reused edit canvas in rectangle-draw mode — draws report to the intent (no region is created); the
     bridges/holes render as dummy regions. Category is non-matching so the generated tree stays hidden.
     Which of the two a drag makes is armed on the canvas dock rather than in this sidebar: it decides what
     the very next drag does, so it belongs beside the tool that drags, wearing the colour the rectangle will
     take — the same reading Sketch's Build/Carve gives. *@
  <WorldCanvas @ref="canvas" Slug="@Slug" RectDraw="true" Category="__build_authoring__" ShowEditZones="true"
                DrawAccent="@(HoleMode ? HoleColor : AreaColor)"
                OnEditZonesToggled="OnEditZonesToggled"
                OnRectDrawn="OnRectDrawn" OnGeometrySaved="OnGeometrySaved" OnSelect="OnCanvasSelect" OnReady="OnCanvasReady">
    <DrawMode>
      <DockModeButton Pressed="@HoleMode" Title="@DrawModeTitle" OnClick="ToggleDrawMode">@(HoleMode ? "Hole" : "Bridge")</DockModeButton>
    </DrawMode>
  </WorldCanvas>

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="sel.Id" Description="@(sel.Source is null ? "Drag the handles on the canvas to resize it." : null)">
          <Header>
            <DetailHeader Icon="rectangle-horizontal" IconMuted Label="@Label(sel)">
              <Badge Class="@(sel.Authored ? "badge--success" : "badge--dim")">@(sel.Authored ? "Main" : "Copy")</Badge>
            </DetailHeader>
          </Header>
          <ChildContent>
          <div class="section-body">
            <Field Label="Min">
              <div class="ctrl-row">
                <CoordField Prefix="X" Value="@sel.MinX" ReadOnly tabindex="-1" />
                <CoordField Prefix="Z" Value="@sel.MinZ" ReadOnly tabindex="-1" />
              </div>
            </Field>
            <Field Label="Max">
              <div class="ctrl-row">
                <CoordField Prefix="X" Value="@sel.MaxX" ReadOnly tabindex="-1" />
                <CoordField Prefix="Z" Value="@sel.MaxZ" ReadOnly tabindex="-1" />
              </div>
            </Field>
            @if (sel.Source is { } source)
            {
              <Readout>@(AuthoringContext.CopyOf(Label(source)))</Readout>
            }
          </div>
          </ChildContent>
        </Section>
        @if (sel.Source is null)
        {
          <InspectorDelete Title="@(sel.Hole ? "Delete this hole" : "Delete this bridge")" OnClick="() => Remove(sel.Id)" />
        }
      }
      else
      {
        <Section>
          <DetailHeader Icon="rectangle-horizontal" IconMuted Label="Build regions" />
          <EmptyState>No bridge or hole selected. Draw one, or pick one to resize it.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>
