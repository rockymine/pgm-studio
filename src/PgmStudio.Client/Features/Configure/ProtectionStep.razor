@namespace PgmStudio.Client.Features.Configure

@* Teams · protection: draw the rectangle(s) around a spawn — a zone is a union of rectangles, listed flat
   (one row per rectangle, authored or orbit) and edited one at a time. The right panel shows coordinates. *@

<Workspace>

  <Sidebar>
      <Section Title="Spawn protection" Description="Drag a rectangle around a spawn with the rectangle tool. Several rectangles make one larger zone. Every other team gets a symmetry copy.">
        @{ var rows = Rows(); }
        <div class="panel-list">
          @if (authored.Count == 0) { <EmptyState>No protection yet. Drag a rectangle around a spawn.</EmptyState> }
          @foreach (var row in rows)
          {
            <ListRow Compact Selected="selectedRegionId == row.RegionId"
                 @key="row.RegionId" OnClick="() => SelectRow(row.RegionId)">
              <span class="list-swatch" style="--swatch: @Hex(row.Team)"></span>
              <span class="geo-type-icon"><i data-lucide="rectangle-horizontal"></i></span>
              <span class="list-label">@row.Name</span>
              <Badge Class="@(row.Authored ? "badge--success" : "badge--dim")">@(row.Authored ? "Main" : "Copy")</Badge>
            </ListRow>
          }
        </div>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  @* Reused edit canvas in rectangle-draw mode — draws report to the intent (no region is created); the zones
     render as dummy regions. Category is non-matching so the generated tree stays hidden. *@
  <WorldCanvas @ref="canvas" Slug="@Slug" RectDraw="true" Category="__protection_authoring__"
                OnRectDrawn="OnRectDrawn" OnGeometrySaved="OnGeometrySaved" OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <div class="panel-stack" @key="sel.RegionId">
          <Section Description="@(sel.Authored ? "Drag the handles on the canvas to resize it." : null)">
            <Header>
              <DetailHeader Icon="rectangle-horizontal" IconTint="@Hex(sel.Team)" Label="@sel.Name">
                <Badge Class="@(sel.Authored ? "badge--success" : "badge--dim")">@(sel.Authored ? "Main" : "Copy")</Badge>
              </DetailHeader>
            </Header>
            <ChildContent>
            <div class="section-body">
              <Field Label="Min">
                <div class="ctrl-row">
                  <CoordField Prefix="X" Value="@sel.MinX" ReadOnly tabindex="-1" />
                  <CoordField Prefix="Z" Value="@sel.MinZ" ReadOnly tabindex="-1" />
                </div>
              </Field>
              <Field Label="Max">
                <div class="ctrl-row">
                  <CoordField Prefix="X" Value="@sel.MaxX" ReadOnly tabindex="-1" />
                  <CoordField Prefix="Z" Value="@sel.MaxZ" ReadOnly tabindex="-1" />
                </div>
              </Field>
              @if (sel.Authored)
              {
                <Readout>Owned by @TeamName(sel.Team).</Readout>
              }
              else
              {
                <Readout>@(AuthoringContext.CopyOf($"{TeamName(authoredTeam ?? string.Empty)} protection"))</Readout>
              }
            </div>
            </ChildContent>
          </Section>

          <Section Title="Rules">
            <Actions><Badge Kind="dim">Automatic</Badge></Actions>
            <ChildContent>
            <div class="panel-list">
              <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="link"></i></span><span class="list-label">Only @TeamName(sel.Team) may enter</span></ListRow>
              <ListRow Compact Class="list-row--muted"><span class="geo-type-icon"><i data-lucide="link"></i></span><span class="list-label">Nobody may place or break blocks</span></ListRow>
            </div>
            </ChildContent>
          </Section>
          @if (sel.Authored)
          {
            <InspectorDelete Title="Delete this rectangle" OnClick="() => Remove(sel.RegionId)" />
          }
        </div>
      }
      else
      {
        <Section>
          <DetailHeader Icon="rectangle-horizontal" IconMuted Label="Spawn protection" />
          <EmptyState>No rectangle selected. Draw one around a spawn, or pick one to resize it.</EmptyState>
        </Section>
      }
  </Inspector>

</Workspace>
