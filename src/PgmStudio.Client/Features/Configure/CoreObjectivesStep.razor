@namespace PgmStudio.Client.Features.Configure
@using C = PgmStudio.Client.Features.Configure.CoreAuthoring

@* Cores · objectives: the ingest scan proposed this map's cores from their lava-in-obsidian signature.
   Confirm a proposal to make it an objective, or box a casing on the canvas to author one the scan missed. *@

<Workspace>

  <Sidebar>
      <Section Title="Cores">
        <Actions><Badge Class="@(cores.Count > 0 ? "badge--success" : "badge--dim")">@cores.Count core@(cores.Count == 1 ? "" : "s")</Badge></Actions>
        <ChildContent>
        <p class="section-desc">One team defends a core and the others try to make it leak. Confirm a
          suggested core below, or drag a box around a casing on the canvas to add one.</p>

        @if (loading)
        {
          <div class="list-empty">Loading suggestions…</div>
        }
        else
        {
          <div class="panel-list">
            @if (cores.Count == 0) { <div class="list-empty">No cores yet.</div> }
            @for (var i = 0; i < cores.Count; i++)
            {
              var index = i;
              var core = cores[index];
              <ListRow Compact Selected="selected == index" @key="index" OnClick="() => Select(index)">
                <span class="geo-type-icon" style="--icon-tint: @TeamHex(core.Owner)"><i data-lucide="flame"></i></span>
                <span class="list-label">@(string.IsNullOrEmpty(core.Name) ? "Core" : core.Name)</span>
                <Badge Kind="@(string.IsNullOrEmpty(core.Owner) ? "dim" : "neutral")">@(string.IsNullOrEmpty(core.Owner) ? "No team" : TeamName(core.Owner))</Badge>
              </ListRow>
            }
          </div>

          var proposals = Unconfirmed.ToList();
          @if (proposals.Count > 0)
          {
            <p class="section-desc section-desc--separated">
              <strong>@proposals.Count</strong> suggested core@(proposals.Count == 1 ? "" : "s") to confirm. Click one
              to add it.
            </p>
            <div class="panel-list">
              @foreach (var proposal in proposals)
              {
                <ListRow Compact @key="proposal" OnClick="() => Confirm(proposal)">
                  <span class="geo-type-icon text-muted"><i data-lucide="scan-search"></i></span>
                  <span class="list-label list-label--mono">@Where(proposal)</span>
                  <Badge Kind="dim">@proposal.Lava lava</Badge>
                </ListRow>
              }
            </div>
            <Button Writes Full Class="action-btn--separated" Variant="primary" OnClick="ConfirmAll">
              <i data-lucide="check"></i> Confirm all @proposals.Count
            </Button>
          }

          <Button Writes Full Class="action-btn--separated" Disabled="@loading" OnClick="DetectMapWide">
            <i data-lucide="scan-search"></i> Find suggestions again
          </Button>
        }
        </ChildContent>
      </Section>
  </Sidebar>

  <div class="sidebar-handle"></div>

  <WorldCanvas @ref="canvas" Slug="@Slug" RectDraw="true" Category="__cores__"
                OnRectDrawn="OnBoxDrawn" OnSelect="OnCanvasSelect" OnReady="OnCanvasReady" />

  <div class="sidebar-handle"></div>

  <Inspector>
      @if (Selected is { } sel)
      {
        <Section @key="selected">
          <DetailHeader Icon="flame" IconTint="@TeamHex(sel.Owner)" Label="@(string.IsNullOrEmpty(sel.Name) ? "Core" : sel.Name)">
            <Badge Class="@(sel.Volume is null ? "badge--warning" : "badge--success")">@(sel.Volume is null ? "Not built yet" : "In the world")</Badge>
          </DetailHeader>
          <div class="section-body">
            <Field Label="Defending team">
              <LabelHint>(the others attack it)</LabelHint>
              <ChildContent>
                <div class="field-pick-row">
                  <span class="field-swatch" style="--swatch: @(string.IsNullOrEmpty(sel.Owner) ? "transparent" : TeamHex(sel.Owner))"></span>
                  <Select Slim="false" Options="@AuthoringContext.TeamOptions(teams)" Placeholder="Choose a team"
                          Value="@sel.Owner" ValueChanged="@(team => SetOwner(sel, team))" />
                </div>
              </ChildContent>
            </Field>

            <Field Label="Name">
              <LabelHint>(optional)</LabelHint>
              <ChildContent>
                <input class="field-input" value="@sel.Name" placeholder="e.g. Core"
                       @onchange="@(e => SetName(sel, e.Value?.ToString() ?? string.Empty))" />
              </ChildContent>
            </Field>

            <Field Label="Casing">
              <div class="field-value">
                @if (sel.Volume is { } vol)
                {
                  <text>@vol.Width×@vol.Height×@vol.Depth at @vol.MinX, @vol.MinY, @vol.MinZ</text>
                }
                else
                {
                  <text>Placed when the world is built.</text>
                }
              </div>
            </Field>
            @if (sel.Lava > 0)
            {
              <Field Label="Why it was suggested">
                <ChildContent>
                  <div class="field-value">@sel.Lava lava block@(sel.Lava == 1 ? "" : "s") sealed in obsidian</div>
                </ChildContent>
              </Field>
            }

            <div class="ctrl-row ctrl-row--separated">
              <Button Writes Fill OnClick="() => Remove(sel)" Title="Remove core"><i data-lucide="trash-2"></i> Remove</Button>
            </div>
          </div>
        </Section>
      }
      else
      {
        <Section>
          <DetailHeader Icon="flame" IconMuted Label="Core" />
          <p class="section-desc">Select a core to set the team that defends it. A map can have wools and cores
            at the same time.</p>
        </Section>
      }
  </Inspector>

</Workspace>

@code {
    private static string Where(C.Core core) =>
        core.Volume is { } v ? $"{v.MinX}, {v.MinY}, {v.MinZ}" : "Not placed";
}
