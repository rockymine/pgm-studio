@namespace PgmStudio.Client.Features.Plan
@inject HttpClient Http

@* Plan Info phase — two steps: Identity (the plan's name, and on a map-backed plan the authors, saved to
   the map metadata via GET/PATCH api/map/{slug}) and Settings (the plan globals: symmetry mode +
   cell/surface/max-players, which drive the live plan document through the host's callbacks). A plan row has
   no map to credit authors on, so its name is all Identity holds and the topbar's Save stores it with the
   plan. Continue on the last step advances to Draw. *@

<div class="phase-body">
  <FlowBar Class="flow-bar--flush" PhaseIcon="book-open-text" PhaseTitle="Info"
           Steps="@Steps" CurrentStep="@step"
           BackEnabled="@(step > 0)" NextLabel="@(step == Steps.Length - 1 ? "Continue" : "Next")"
           OnStep="@(i => step = i)" OnBack="@(() => step = 0)" OnNext="OnNextStep" />
  <Workspace>
    <ContentColumn MaxWidth="720">
      @if (step == 0)
      {
        <Section Title="Details">
          <Field Label="Plan name" Required For="pl-name">
            <input id="pl-name" class="field-input" type="text" placeholder="Untitled plan"
                   value="@Name" @oninput="OnNameInput" />
          </Field>
        </Section>

        @if (MapBacked)
        {
        <AuthorsEditor Authors="authors" OnChanged="Dirty" />

        <Section>
          <div class="panel-actions">
            <Button Variant="primary" Disabled="@(!dirty)" Writes OnClick="Save">Save changes</Button>
            <span class="panel-save-status">@saveStatus</span>
          </div>
        </Section>
        }
      }
      else
      {
        <Section Title="Symmetry and grid">
          <p class="section-desc">Symmetry is how the part you design is copied for the other teams: rotated
            or mirrored. Surface values are heights in blocks.</p>
          <Field Label="Symmetry">
            <Select Slim="false" Options="SymmetryOptions" Value="@Symmetry" ValueChanged="OnSymmetryChanged" />
          </Field>
          <Field Label="Cell size (blocks)">
            <NumberField Value="Cell" ValueChanged="OnCellChanged" Min="1" />
          </Field>
          <Field Label="Base surface (y)">
            <NumberField Value="Surface" ValueChanged="OnSurfaceChanged" Min="0" />
          </Field>
          <Field Label="Surface step (y)">
            <NumberField Value="SurfaceStep" ValueChanged="OnSurfaceStepChanged" Min="1" />
          </Field>
          <Field Label="Max players per team">
            <NumberField Value="MaxPlayers" ValueChanged="OnMaxPlayersChanged" Min="1" />
          </Field>
        </Section>
      }
    </ContentColumn>
  </Workspace>
</div>
