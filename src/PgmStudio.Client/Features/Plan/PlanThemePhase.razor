@namespace PgmStudio.Client.Features.Plan

@* Terrain-paint theming (docs/world-export/terrain-painting.md TP10), two steps: Create defines named themes
   — a paintbrush per bucket, each switchable between a solid, a stack, a team tint and the patterns, previewed
   as it is edited; Apply picks the map default, assigns themes to pieces/boxes, and shows the themed map
   top-down. Edits funnel through the plan-bridge onto the plan doc (compiled into the intent's theme scopes and
   painted at export); previews are server-rendered SVG through the real materials + palette. *@

<div class="phase-body">
  <FlowBar Class="flow-bar--flush" PhaseIcon="palette" PhaseTitle="Theme"
           Steps="@Steps" CurrentStep="@step" BackEnabled="true"
           NextLabel="@(step == 0 ? "Apply →" : "Done")"
           OnStep="Goto" OnBack="OnBackStep" OnNext="OnNextStep" />
  <Workspace>
    <ContentColumn MaxWidth="720">
      @if (State is null)
      {
        <Section><p class="section-desc">Loading themes…</p></Section>
      }
      else if (step == 0)
      {
        @* ── Create: the theme registry, then a paintbrush per bucket ── *@
        <Section Title="Themes">
          <p class="section-desc">A theme is a full terrain-paint recipe — one material per bucket, plus how
            deep each reaches. Define one here, then apply it to the map in the next step.</p>

          @foreach (var id in State.Themes.Keys)
          {
            <ListRow Compact Selected="@(id == Selected)" @key="id" OnClick="() => Select(id)">
              <span class="list-label list-label--mono">@id</span>
              @if (State.MapTheme == id) { <Badge Kind="neutral">map default</Badge> }
            </ListRow>
          }
          @if (State.Themes.Count == 0)
          {
            <p class="section-desc">No themes yet — the whole map paints the built-in default.</p>
          }

          <Field Label="New theme">
            <div class="panel-actions">
              <input class="field-input" placeholder="name" @bind="NewName" @bind:event="oninput" />
              <Button Icon="plus" OnClick="AddTheme">Add</Button>
            </div>
          </Field>
        </Section>

        @if (Selected is not null && Theme is not null)
        {
          @* the four paintbrushes: a toggle, a depth, a material, and what that material paints like *@
          @foreach (var bucket in Buckets)
          {
            <Section Title="@bucket.Title" @key="bucket.Id">
              <Actions>
                @if (bucket.CanDisable)
                {
                  <Chip Active="@bucket.Enabled" OnClick="@bucket.Toggle">@(bucket.Enabled ? "Painting" : "Off")</Chip>
                }
                else
                {
                  <Badge Kind="dim">always paints</Badge>
                }
              </Actions>
              <ChildContent>
                <p class="section-desc">@bucket.Blurb</p>
                @if (bucket.Enabled)
                {
                  <div class="bucket-editor">
                    <div class="bucket-editor-form">
                      @if (bucket.HasDepth)
                      {
                        <Field Label="Courses deep">
                          <input class="field-input field-input--slim" type="number" min="1" step="1"
                                 value="@bucket.Depth" @onchange="@bucket.SetDepth" />
                        </Field>
                      }
                      <MaterialEditor Node="@bucket.Material" Blocks="Blocks" OnChanged="ThemeEdited" />
                    </div>
                    <figure class="bucket-editor-swatch">
                      <div class="theme-swatch-img">@((MarkupString)(Swatches.GetValueOrDefault(bucket.Id) ?? ""))</div>
                      <figcaption>neutral · team</figcaption>
                    </figure>
                  </div>
                }
                else
                {
                  <p class="section-desc">Off — its blocks fall through to @bucket.FallsTo.</p>
                }
              </ChildContent>
            </Section>
          }

          <Section Title="Ground and edges">
            <p class="section-desc">How far down the paint reaches, and which faces count as an edge worth capping.</p>
            <Field Label="Bedrock floor">
              <div class="panel-actions">
                <select class="field-input field-input--slim" value="@BedrockMode" @onchange="SetBedrockMode">
                  <option value="@AbsoluteBedrock">blocks up from the bottom</option>
                  <option value="@RelativeBedrock">everything under the painted depth</option>
                </select>
                <input class="field-input field-input--slim" type="number" min="0" step="1"
                       value="@BedrockValue" @onchange="SetBedrockValue" />
              </div>
            </Field>
            <Field Label="Where the rim runs">
              <Chip Active="@Flag(ThemeFields.Closed, false)" OnClick="ToggleClosed">
                @(Flag(ThemeFields.Closed, false) ? "Every plateau boundary" : "Only where the ground drops")
              </Chip>
            </Field>
            <Field Label="Where the wall runs">
              <Chip Active="@Flag(ThemeFields.WallOnTerrainFaces, true)" OnClick="ToggleWallFaces">
                @(Flag(ThemeFields.WallOnTerrainFaces, true) ? "Terrain and void risers" : "Only risers facing the void")
              </Chip>
            </Field>
          </Section>

          <Section Title="This theme">
            <Field Label="Rename">
              <div class="panel-actions">
                <input class="field-input" placeholder="@Selected" @bind="RenameTo" />
                <Button OnClick="RenameTheme">Rename</Button>
                <Button Variant="danger" Icon="trash-2" OnClick="DeleteSelected">Delete</Button>
              </div>
            </Field>
            <details class="theme-json-details">
              <summary>Theme JSON</summary>
              <Field Error="@JsonError">
                <textarea class="field-input theme-json" spellcheck="false" @bind="ThemeJsonText"></textarea>
              </Field>
              <div class="panel-actions">
                <Button Variant="primary" OnClick="ApplyThemeJson">Apply JSON</Button>
              </div>
            </details>
          </Section>
        }
      }
      else
      {
        @* ── Apply: map default + assignment + the themed map top-down ── *@
        <Section Title="Applied map">
          <p class="section-desc">The plan's terrain, painted through the theme scopes and rendered top-down.</p>
          <div class="theme-map-preview">
            @if (MapLoading) { <p class="section-desc">Rendering…</p> }
            else if (MapSvg is not null) { @((MarkupString)MapSvg) }
            else { <p class="section-desc">No preview.</p> }
          </div>
          <div class="panel-actions"><Button OnClick="LoadMapPreview">Refresh</Button></div>
        </Section>

        <Section Title="Map default">
          <p class="section-desc">The lowest layer — paints every cell no scope claims.</p>
          <Field>
            <select class="field-input" value="@State.MapTheme" @onchange="OnMapThemeChanged">
              <option value="">(built-in default)</option>
              @foreach (var id in State.Themes.Keys) { <option value="@id">@id</option> }
            </select>
          </Field>
        </Section>

        <Section Title="Assign to boxes">
          <p class="section-desc">A box paints all its member pieces — the collection layer, under per-piece overrides.</p>
          @foreach (var box in State.Boxes)
          {
            <Field Label="@($"{box.Id} — {box.Kind}, {box.Members.Count} pcs")" @key="box.Id">
              <select class="field-input" value="@State.BoxThemes.GetValueOrDefault(box.Id, "")"
                      @onchange="e => AssignBox(box.Id, (string?)e.Value)">
                <option value="">— none —</option>
                @foreach (var id in State.Themes.Keys) { <option value="@id">@id</option> }
              </select>
            </Field>
          }
          @if (State.Boxes.Count == 0) { <p class="section-desc">No boxes drawn.</p> }
        </Section>

        <Section Title="Assign to pieces">
          <p class="section-desc">A per-piece theme is the top layer — it wins over the piece's box and the map default.</p>
          @foreach (var piece in State.Pieces)
          {
            <Field Label="@($"{piece.Id} ({piece.Role})")" @key="piece.Id">
              <select class="field-input" value="@State.PieceThemes.GetValueOrDefault(piece.Id, "")"
                      @onchange="e => AssignPiece(piece.Id, (string?)e.Value)">
                <option value="">— none —</option>
                @foreach (var id in State.Themes.Keys) { <option value="@id">@id</option> }
              </select>
            </Field>
          }
          @if (State.Pieces.Count == 0) { <p class="section-desc">No pieces drawn.</p> }
        </Section>
      }
    </ContentColumn>
  </Workspace>
</div>
