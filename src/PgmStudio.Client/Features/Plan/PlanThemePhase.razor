@namespace PgmStudio.Client.Features.Plan

@* Terrain-paint theming (docs/world-export/terrain-painting.md TP10), two steps: Create defines named themes
   and previews their materials; Apply picks the map default, assigns themes to pieces/boxes, and shows the
   themed map top-down. Edits funnel through the plan-bridge onto the plan doc (compiled into the intent's
   theme scopes and painted at export); previews are server-rendered SVG through the real materials + palette. *@

<div class="phase-body">
  <FlowBar Class="flow-bar--flush" PhaseIcon="palette" PhaseTitle="Theme"
           Steps="@Steps" CurrentStep="@step" BackEnabled="true"
           NextLabel="@(step == 0 ? "Apply →" : "Done")"
           OnStep="Goto" OnBack="OnBackStep" OnNext="OnNextStep" />
  <Workspace>
    <ContentColumn MaxWidth="720">
      @if (State is null)
      {
        <Section><p class="section-desc">Loading themes…</p></Section>
      }
      else if (step == 0)
      {
        @* ── Create: the theme registry + material previews ── *@
        <Section Title="Themes">
          <p class="section-desc">A theme is a full terrain-paint recipe — rim, wall, surface and fill materials.
            Define one here, then apply it to the map in the next step.</p>

          @foreach (var id in State.Themes.Keys)
          {
            <ListRow Compact Selected="@(id == Selected)" @key="id" OnClick="() => Select(id)">
              <span class="list-label list-label--mono">@id</span>
              @if (State.MapTheme == id) { <Badge Kind="neutral">map default</Badge> }
            </ListRow>
          }
          @if (State.Themes.Count == 0)
          {
            <p class="section-desc">No themes yet — the whole map paints the built-in default.</p>
          }

          <Field Label="New theme">
            <div class="panel-actions">
              <input class="field-input" placeholder="name" @bind="NewName" @bind:event="oninput" />
              <Button OnClick="AddTheme">Add</Button>
            </div>
          </Field>
        </Section>

        @if (Selected is not null && State.Themes.ContainsKey(Selected))
        {
          <Section Title="@($"Preview “{Selected}”")">
            <p class="section-desc">The theme's materials, rendered over a sample with the real block palette —
              a left-neutral / right-team split so a team tint shows both, and the perimeter arc across x so a
              wall-run's stripes read.</p>
            <div class="theme-swatches">
              @foreach (var bucket in new[] { "rim", "wall", "surface", "fill" })
              {
                <figure class="theme-swatch" @key="bucket">
                  <div class="theme-swatch-img">@((MarkupString)(Swatches.GetValueOrDefault(bucket) ?? ""))</div>
                  <figcaption>@bucket</figcaption>
                </figure>
              }
            </div>
          </Section>

          <Section Title="@($"Edit “{Selected}”")">
            <Field Label="Rename">
              <div class="panel-actions">
                <input class="field-input" placeholder="@Selected" @bind="RenameTo" />
                <Button OnClick="RenameTheme">Rename</Button>
                <Button Variant="danger" OnClick="() => DeleteTheme(Selected)">Delete</Button>
              </div>
            </Field>
            <Field Label="Theme JSON" Error="@JsonError">
              <textarea class="field-input theme-json" spellcheck="false" @bind="ThemeJsonText"></textarea>
            </Field>
            <div class="panel-actions">
              <Button Variant="primary" OnClick="ApplyThemeJson">Apply</Button>
            </div>
          </Section>
        }
      }
      else
      {
        @* ── Apply: map default + assignment + the themed map top-down ── *@
        <Section Title="Applied map">
          <p class="section-desc">The plan's terrain, painted through the theme scopes and rendered top-down.</p>
          <div class="theme-map-preview">
            @if (MapLoading) { <p class="section-desc">Rendering…</p> }
            else if (MapSvg is not null) { @((MarkupString)MapSvg) }
            else { <p class="section-desc">No preview.</p> }
          </div>
          <div class="panel-actions"><Button OnClick="LoadMapPreview">Refresh</Button></div>
        </Section>

        <Section Title="Map default">
          <p class="section-desc">The lowest layer — paints every cell no scope claims.</p>
          <Field>
            <select class="field-input" value="@State.MapTheme" @onchange="OnMapThemeChanged">
              <option value="">(built-in default)</option>
              @foreach (var id in State.Themes.Keys) { <option value="@id">@id</option> }
            </select>
          </Field>
        </Section>

        <Section Title="Assign to boxes">
          <p class="section-desc">A box paints all its member pieces — the collection layer, under per-piece overrides.</p>
          @foreach (var box in State.Boxes)
          {
            <Field Label="@($"{box.Id} — {box.Kind}, {box.Members.Count} pcs")" @key="box.Id">
              <select class="field-input" value="@State.BoxThemes.GetValueOrDefault(box.Id, "")"
                      @onchange="e => AssignBox(box.Id, (string?)e.Value)">
                <option value="">— none —</option>
                @foreach (var id in State.Themes.Keys) { <option value="@id">@id</option> }
              </select>
            </Field>
          }
          @if (State.Boxes.Count == 0) { <p class="section-desc">No boxes drawn.</p> }
        </Section>

        <Section Title="Assign to pieces">
          <p class="section-desc">A per-piece theme is the top layer — it wins over the piece's box and the map default.</p>
          @foreach (var piece in State.Pieces)
          {
            <Field Label="@($"{piece.Id} ({piece.Role})")" @key="piece.Id">
              <select class="field-input" value="@State.PieceThemes.GetValueOrDefault(piece.Id, "")"
                      @onchange="e => AssignPiece(piece.Id, (string?)e.Value)">
                <option value="">— none —</option>
                @foreach (var id in State.Themes.Keys) { <option value="@id">@id</option> }
              </select>
            </Field>
          }
          @if (State.Pieces.Count == 0) { <p class="section-desc">No pieces drawn.</p> }
        </Section>
      }
    </ContentColumn>
  </Workspace>
</div>
