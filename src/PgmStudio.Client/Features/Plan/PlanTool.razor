@page "/plans/new"
@page "/plans/{PlanId:long}"
@page "/maps/{Slug}/plan"
@layout StudioLayout
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

@* Plan editor — a coarse cell-grid layout tool, on one of two bindings: a map's plan artifact
   (/maps/{slug}/plan) or a plan row (/plans/{id}, /plans/new). Both render the same tool: the rail's Info and
   Draw phases, the flow bar, and a collapsible sidebar whose chips switch between Settings, Checks and,
   for an admin, Generator check. Only the editor bar follows the binding, because only saving differs: a map-backed plan saves
   into its map, a plan row saves as a row and forks when it was generated or imported. The PlanCanvas JS
   (via bridge/plan-bridge.js) owns the plan document, the pointer tools and the live symmetry mirror ghost. *@

<StudioShell>
  <Bar>
    @* A map-backed plan is the Plan stage of its map. A plan row has no map to switch within, so its stage word
       is plain text, and what a row needs — starting one, importing a file, opening a saved one, and the origin
       that decides whether Save writes in place or makes a copy — sits with Save. *@
    <EditorBar MapName="@planName" Slug="@(MapBacked ? Slug : null)" Stage="@MapStage.Plan"
               PhaseIcon="@(InfoActive ? "book-open-text" : "pencil-ruler")" PhaseTitle="@(InfoActive ? "Info" : "Draw")"
               Steps="@(InfoActive ? PlanInfoPhase.Steps : [])" CurrentStep="@infoStep"
               BackEnabled="@(!InfoActive || infoStep > 0)"
               NextLabel="@(!InfoActive ? "Compile" : infoStep == PlanInfoPhase.Steps.Count - 1 ? "Continue" : "Next")"
               NextBusy="@(!InfoActive && !documentLoaded)" NextBusyLabel="Loading…" NextWrites="@(!InfoActive)"
               OnStep="StepInfo" OnBack="BarBack" OnNext="BarNext" LabelledCommands>
      <State>
        @if (importError is not null) { <span>@importError</span> }
        @if (saveState is not null) { <span>@saveState</span> }
      </State>
      <Commands>
        @if (!MapBacked)
        {
          if (planOrigin is not null)
          {
            <Badge Kind="neutral" title="@OriginTitle">@planOrigin</Badge>
          }
          <Button OnClick="NewPlan" Title="Start a blank plan" Writes>New</Button>
          <WriteGate Context="closed">
            <label class="action-btn" title="@(closed ?? "Import a *.plan.json file")" aria-disabled="@(closed is not null ? "true" : null)">
              Import
              <InputFile OnChange="OnImport" accept=".json" class="control-input--hidden" disabled="@(closed is not null)" />
            </label>
          </WriteGate>
          <Button OnClick="OpenDbBrowser" Title="Open a saved plan">Open</Button>
        }
        <Button OnClick="SavePlan" Busy="@saving" BusyLabel="Saving…" Title="Save (Ctrl+S)" Writes>Save</Button>
      </Commands>
    </EditorBar>
  </Bar>
  <Rail>
    <NavRail>
      <NavButton Icon="book-open-text" Title="Info" Active="@InfoActive" OnClick="GoInfo" />
      <NavButton Icon="pencil-ruler" Title="Draw" Active="@DrawActive" OnClick="GoDraw" />
    </NavRail>
  </Rail>
  <ChildContent>
      <WriteGate OnChanged="OnWriteReason" />
      @if (InfoActive)
      {
        <PlanInfoPhase @key="@Slug" Slug="@Slug" Step="infoStep"
                       Name="@planName" Symmetry="@symmetry" Cell="cell" Surface="surface"
                       SurfaceStep="surfaceStep" MaxPlayers="maxPlayers"
                       OnNameChanged="OnNameChanged" OnSymmetryChanged="OnSymmetryChanged"
                       OnCellChanged="OnCell" OnSurfaceChanged="OnSurface" OnSurfaceStepChanged="OnSurfaceStep"
                       OnMaxPlayersChanged="OnMaxPlayers" />
      }
      @* Draw stays mounted (hidden, not removed) so the plan-canvas bridge + zoom survive a trip to Info;
         the canvas re-measures itself when it un-hides. *@
      <div class="phase-body" hidden="@DrawHidden">
      <Workspace>
        @if (sidebarOpen)
        {
        <Sidebar>
            <div class="plan-panel-switch">
              <div class="panel-tabs" role="tablist">
                @if (showReference)
                {
                <button type="button" role="tab" class="@PanelTab("settings")" aria-selected="@(leftPanel == "settings")"
                        @onclick='() => SetPanel("settings")'>Settings</button>
                }
                <button type="button" role="tab" class="@PanelTab("validation")" aria-selected="@(leftPanel == "validation")"
                        @onclick='() => SetPanel("validation")'>Checks</button>
                @if (showBoxes)
                {
                <button type="button" role="tab" class="@PanelTab("feasibility")" aria-selected="@(leftPanel == "feasibility")"
                        title="Generator check" @onclick='() => SetPanel("feasibility")'>Generator</button>
                }
              </div>
              <Button Variant="icon" Icon="panel-left-close" Title="Hide panel" OnClick="ToggleSidebar" />
            </div>
            @if (showReference && leftPanel == "settings")
            {
            <Section Title="Reference" Writes>
              <Field Label="Map">
                <Select Slim="false" Options="TraceMapOptions" Placeholder="None" Value="@(refMap ?? "")"
                        ValueChanged="OnPickReferenceMap" />
              </Field>
              @if (refError is not null) { <p class="section-desc plan-compile-draft-error">@refError</p> }
              @if (refMap is not null)
              {
                <Field Label="Opacity">
                  <RangeField Min="0" Max="1" Step="0.05" Value="refOpacity" ValueChanged="OnRefOpacity" />
                </Field>
                <Field Label="Offset X (cells)">
                  <NumberField Value="refOffsetX" ValueChanged="OnRefOffsetX" Step="1" />
                </Field>
                <Field Label="Offset Z (cells)">
                  <NumberField Value="refOffsetZ" ValueChanged="OnRefOffsetZ" Step="1" />
                </Field>
                <Field Label="Scale">
                  <NumberField Value="refScale" ValueChanged="OnRefScale" Min="0.1" Step="0.1" />
                </Field>
                <div class="ctrl-row">
                  <Button Full OnClick="RecenterReference" Title="Reset offset and scale">Recenter</Button>
                  <Button Full OnClick="ClearReference" Title="Remove the backdrop">Clear</Button>
                </div>
              }
              <p class="section-desc">Displays the selected map as a backdrop image on the canvas.</p>
            </Section>

            }
            else if (showBoxes && leftPanel == "feasibility")
            {
            @* Producibility, grouped per box with the unit-level findings pinned above them: a box can be
               unbuildable on its own geometry AND the unit unbuildable in how its boxes are arranged, so both
               are shown rather than the first failure. Clicking a box paints the cells by which it misses the
               nearest thing the emitters can build. *@
            <Section Title="Generator check">
              <Actions>
                @if (feasibility is not null)
                {
                  <Badge Class="@(feasibility.Producible ? "badge--success" : "badge--error")"
                         title="Whether the generator could build this plan">
                    @(feasibility.Producible ? "buildable" : "not buildable")
                  </Badge>
                }
              </Actions>
              <ChildContent>
                @if (feasibility is null)
                {
                  <p class="section-desc">Shows whether the generator could build this layout. Draw a box around each part to check it.</p>
                }
                else if (feasibility.Boxes.Count == 0 && feasibility.Unit.Count == 0)
                {
                  <p class="section-desc">No boxes drawn. Draw a box around each part (a hub, a wool, a spawn, the front line, or the middle) to check it.</p>
                }
                else
                {
                  @if (feasibility.Unit.Count > 0)
                  {
                    <div class="plan-feas-unit">
                      <div class="plan-feas-unit-title">Arrangement</div>
                      @foreach (var f in feasibility.Unit)
                      {
                        <div class="plan-feas-finding">
                          <span class="plan-lint-chip">@f.Rule</span>
                          <span class="plan-lint-msg">@f.Message</span>
                        </div>
                      }
                    </div>
                  }
                  @foreach (var box in feasibility.Boxes)
                  {
                    var b = box;
                    <div class="plan-feas-box">
                      <button class="plan-feas-head @(isolatedBox == b.BoxId ? "plan-feas-head--active" : null)"
                              disabled="@(b.Nearest is null)"
                              title="@(b.Nearest is null ? "Nothing to compare against" : "Show the cells that differ")"
                              @onclick="() => IsolateBox(b)">
                        <span class="plan-lint-dot @(b.Producible ? "plan-lint-dot--ok" : "plan-lint-dot--error")"></span>
                        <span class="plan-feas-id">@b.BoxId</span>
                        <span class="list-tag">@b.Kind</span>
                        <span class="plan-feas-identity" title="What the shape looks like. A hint only.">@b.Identity</span>
                      </button>
                      @if (b.Producible)
                      {
                        <div class="plan-feas-finding plan-feas-finding--ok">@b.ProducibleAs <span class="list-tag">cw @b.Cw</span></div>
                      }
                      else if (b.Nearest is not null)
                      {
                        <div class="plan-feas-finding">
                          <span class="plan-lint-msg">Closest: @b.Nearest.Label</span>
                          <span class="list-tag">@b.Nearest.DifferingCells cell@(b.Nearest.DifferingCells == 1 ? "" : "s")</span>
                        </div>
                      }
                      @foreach (var f in b.Findings)
                      {
                        <div class="plan-feas-finding">
                          <span class="plan-lint-chip">@f.Rule</span>
                          <span class="plan-lint-msg">@f.Message</span>
                        </div>
                      }
                    </div>
                  }
                }
              </ChildContent>
            </Section>
            }
            else
            {
            <Section Title="Checks">
              <Actions>
                @if (evaluation is not null)
                {
                  <Badge Class="@(CheckProblems > 0 ? "badge--error" : "badge--success")"
                         title="@(CheckProblems == 1 ? "1 problem" : $"{CheckProblems} problems")">@CheckProblems</Badge>
                }
              </Actions>
              <ChildContent>
                @if (evaluation is null)
                {
                  <p class="section-desc">Checks the plan against the layout rules. Open a problem to show it on the canvas.</p>
                }
                else if (checks.Count == 0)
                {
                  <div class="plan-lint-ok"><i data-lucide="check-circle-2"></i> No problems found</div>
                  <p class="problems-foot">Score @evaluation.Score.ToString("0.#"), the generator’s ranking; lower is better.</p>
                }
                else
                {
                  <ProblemList Problems="checks" OnLight="LightChecks">
                    <Head>
                      <p class="problems-verdict">@CheckVerdict</p>
                    </Head>
                    <Foot>
                      <p class="problems-foot">Score @evaluation.Score.ToString("0.#"), the generator’s ranking; lower is better.</p>
                    </Foot>
                  </ProblemList>
                }
              </ChildContent>
            </Section>
            }
        </Sidebar>
        <div class="sidebar-handle"></div>
        }
        else
        {
        <div class="plan-sidebar-stub">
          <Button Variant="icon" Icon="panel-left-open" Title="Show panel" OnClick="ToggleSidebar" />
        </div>
        }

        <div class="workspace-canvas">
          <div @ref="wrapRef" class="svg-area">
            <svg @ref="svgRef" class="map-canvas-svg" xmlns="http://www.w3.org/2000/svg"></svg>
          </div>

          <CanvasReadout @ref="readout" ZoomText="@zoomLabel" />

          @* The derived-structure overlays are what the canvas shows, so they are chips on the canvas rather
             than settings a scroll away from the drawing they annotate. In 3-D there is nothing to overlay —
             the isometric preview is one rendering of the finished heights — so the row collapses to the
             rotate and the toggle back out. *@
          <CanvasLayerBar>
            @if (!iso.ThreeD)
            {
              <LayerChip Icon="spline" Active="overlayInterfaces"
                         Title="Where pieces touch: shared edges in green (thinner where narrow), corners in red"
                         OnClick='() => ToggleOverlay("interfaces")'>Interfaces</LayerChip>
              <LayerChip Icon="shield" Active="overlayFrontline" Title="Piece edges facing a build area"
                         OnClick='() => ToggleOverlay("frontline")'>Front line</LayerChip>
              <LayerChip Icon="type" Active="overlayLabels"
                         Title="Names of pieces and build areas, and the distances between build areas"
                         OnClick='() => ToggleOverlay("labels")'>Labels</LayerChip>
              <LayerChip Icon="mountain" Active="heightMap" Title="Colour pieces by height"
                         OnClick="ToggleHeightMap">Heights</LayerChip>
              <CanvasRoundButton Icon="scan" Title="Zoom to fit (F)" OnClick="Fit" />
            }
            else
            {
              <CanvasRoundButton Icon="rotate-cw" Title="Rotate the preview 90°" OnClick="iso.RotateAsync" />
            }
            <IsoToggle View="iso" />
          </CanvasLayerBar>

          @if (!iso.ThreeD)
          {
          @* Four families, four slots. Every drawing tool the plan editor has is one of four questions —
             which piece role · which technical annotation · which marker · which box kind — and within a
             family only one is ever armed, so each shows the option in hand and keeps the rest a chevron
             away. Nineteen buttons become six, and the six that remain say what was last drawn with.

             They share one box: with each family down to an option and a chevron, a rule between them would
             separate less than the pairs already do. *@
          <CanvasDock FlyoutOpen="@(openFlyout is not null)" OnDismissFlyout="CloseFlyouts">
            <DockGroup Viewing>
              <DockButton Icon="mouse-pointer-2" Title="Select" Active="@(tool == "select")"
                          OnClick='() => PickTool("select")' />
              <DockButton Icon="hand" Title="Move" Active="@(tool == "pan")"
                          OnClick='() => PickTool("pan")' />
            </DockGroup>
            <DockGroup>
              @* The land — the roles that produce terrain. *@
              <DockFlyoutGroup Items="TerrainItems" ActiveKey="@terrainActive" Label="Pieces"
                               Armed="@(tool == "piece" && role == terrainActive)"
                               Open="@(openFlyout == "terrain")" OnToggleOpen='() => ToggleFlyout("terrain")'
                               OnPick="PickTerrain" />
              @* The build area and the annotations that reserve or connect — none of them generate terrain. *@
              <DockFlyoutGroup Items="TechnicalItems" ActiveKey="@technicalActive" Label="Zones"
                               Armed="@TechnicalArmed"
                               Open="@(openFlyout == "technical")" OnToggleOpen='() => ToggleFlyout("technical")'
                               OnPick="PickTechnical" />
              @* What is put on the land. *@
              <DockFlyoutGroup Items="MarkerItems" ActiveKey="@markerActive" Label="Markers"
                               Armed="@(tool == markerActive)"
                               Open="@(openFlyout == "markers")" OnToggleOpen='() => ToggleFlyout("markers")'
                               OnPick="PickMarker" />
              @* Box envelopes: drawing one states what the pieces inside it realize. Annotation only — a box
                 never compiles, and dragging it carries its members. Admin only: boxes are the composer's
                 model, kept in the plan and hidden from members. *@
              @if (showBoxes)
              {
              <DockFlyoutGroup Items="BoxItems" ActiveKey="@boxActive" Label="Boxes"
                               Armed="@(tool == "box" && boxKind == boxActive)"
                               Open="@(openFlyout == "boxes")" OnToggleOpen='() => ToggleFlyout("boxes")'
                               OnPick="PickBox" />
              }
            </DockGroup>
          </CanvasDock>
          }
        </div>
        <div class="sidebar-handle"></div>
        <PlanInspector Handle="handle" Selection="sel" Vocabulary="vocabulary"
                       SurfaceStep="surfaceStep" OnSurfaceStep="OnSurfaceStep" />
      </Workspace>
      </div>

  <PlanBuildDrawer @ref="buildDrawer" Handle="handle" Slug="@Slug" PlanName="@planName" Document="Document" />

  <SideDrawer Open="showOpenDb" Title="Open plan" Icon="folder-open" OnClose="CloseDbBrowser">
    <Body>
      @if (dbBusy)
      {
        <p class="section-desc">Loading…</p>
      }
      else if (dbError is not null)
      {
        <div class="plan-compile-errors"><p class="section-desc">@dbError</p></div>
      }
      else if (dbPlans.Count == 0)
      {
        <p class="section-desc">No saved plans yet. Save a plan to see it here.</p>
      }
      else
      {
        <div class="plan-lint-list">
          @foreach (var p in dbPlans)
          {
            <button class="plan-lint-row" @onclick="() => OpenFromDb(p.Id)" title="Open this plan">
              <span class="plan-lint-chip">@p.Origin</span>
              <span class="plan-lint-msg plan-db-name">@(string.IsNullOrWhiteSpace(p.Name) ? "Untitled plan" : p.Name)</span>
              @if (p.StaleComposer)
              {
                <span class="plan-db-stale" title="@StaleTitle(p)">@(p.ComposerVersion ?? "No version")</span>
              }
              <span class="plan-db-date">@p.UpdatedAt.ToLocalTime().ToString("MMM d")</span>
            </button>
          }
        </div>
      }
    </Body>
  </SideDrawer>
  </ChildContent>
</StudioShell>
