@page "/plan-editor"
@page "/maps/{Slug}/plan"
@layout StudioLayout
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

@* Plan editor (the seed studio) — a coarse cell-grid layout tool. Blazor renders the topbar, a thin
   rail that folds the collapsible left settings panel (plan name · globals · reference · overlays), the
   canvas shell whose toolbar holds the draw tools (pieces · build · markers · technical), and the right
   inspector; the PlanCanvas JS (via bridge/plan-bridge.js) owns the plan document, the pointer tools and
   the live symmetry mirror ghost. Plans import/export as *.plan.json; a map-backed plan is stored by Save. *@

<StudioShell>
  <Bar>
    @if (MapBacked)
    {
    <Topbar HomeHref="maps?stage=plan" HomeLabel="Plans" HomeTitle="Back to plans">
      <Crumbs>
        <Crumb>@Slug!.Replace('-', ' ')</Crumb>
        <Crumb Dim>Plan</Crumb>
      </Crumbs>
      @* Save only. A map-backed plan runs under the flow bar, whose Next IS Compile, and the drawer that
         opens carries every download — a second copy of either in the bar says the same thing twice. *@
      <Right>
        @if (importError is not null) { <span class="topbar-crumb topbar-crumb--dim">@importError</span> }
        @if (saveState is not null) { <span class="topbar-crumb topbar-crumb--dim">@saveState</span> }
        <Button OnClick="SavePlan" Busy="@saving" BusyLabel="Saving…" Title="Save (Ctrl+S)">Save</Button>
      </Right>
    </Topbar>
    }
    else
    {
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>Plan editor</Crumb></Crumbs>
      <Right>
        @if (importError is not null) { <span class="topbar-crumb topbar-crumb--dim">@importError</span> }
        @if (saveState is not null) { <span class="topbar-crumb topbar-crumb--dim">@saveState</span> }
        @if (planOrigin is not null) { <span class="topbar-crumb topbar-crumb--dim" title="Saving a generated or imported plan creates a new copy">@planOrigin</span> }
        <Button OnClick="NewPlan" Title="Start a blank plan">New</Button>
        <label class="action-btn" title="Import a *.plan.json file">
          Import
          <InputFile OnChange="OnImport" accept=".json" style="display:none" />
        </label>
        <Button OnClick="ExportPlan" Title="Download this plan as *.plan.json">Export</Button>
        <Button OnClick="SavePlan" Busy="@saving" BusyLabel="Saving…" Title="Save (Ctrl+S)">Save</Button>
        <Button OnClick="OpenDbBrowser" Title="Open a saved plan">Open</Button>
        <Button Variant="primary" OnClick="OpenCompile" Busy="@(!documentLoaded)" BusyLabel="Loading…"
                Title="Compile the plan, then build a draft map">
          <i data-lucide="play"></i> Compile
        </Button>
      </Right>
    </Topbar>
    }
  </Bar>
  <Rail>
    <NavRail>
      @if (MapBacked)
      {
        <NavButton Icon="book-open-text" Title="Info" Active="@InfoActive" OnClick="GoInfo" />
        <NavButton Icon="pencil-ruler" Title="Draw" Active="@DrawActive" OnClick="GoDraw" />
      }
      else
      {
        <NavButton Icon="sliders-horizontal" Title="Settings" Active="@(leftPanel == "settings" && leftOpen)" OnClick='() => SelectActivity("settings")' />
        <NavButton Icon="shield-check" Title="Checks" Active="@(leftPanel == "validation" && leftOpen)" OnClick='() => SelectActivity("validation")' />
        <NavButton Icon="factory" Title="Generator check" Active="@(leftPanel == "feasibility" && leftOpen)" OnClick='() => SelectActivity("feasibility")' />
      }
    </NavRail>
  </Rail>
  <ChildContent>
      @if (InfoActive)
      {
        <PlanInfoPhase Slug="@Slug" OnNext="GoDraw"
                       Name="@planName" Symmetry="@symmetry" Cell="cell" Surface="surface"
                       SurfaceStep="surfaceStep" MaxPlayers="maxPlayers"
                       OnNameChanged="OnNameChanged" OnSymmetryChanged="OnSymmetryChanged"
                       OnCellChanged="OnCell" OnSurfaceChanged="OnSurface" OnSurfaceStepChanged="OnSurfaceStep"
                       OnMaxPlayersChanged="OnMaxPlayers" />
      }
      @* Draw stays mounted (hidden, not removed) so the plan-canvas bridge + zoom survive a trip to Info
         on a map-backed plan; SetPhase re-measures the canvas on return. The bare route has no Info phase. *@
      <div class="phase-body" hidden="@DrawHidden">
      @if (MapBacked)
      {
        <FlowBar Class="flow-bar--flush" PhaseIcon="pencil-ruler" PhaseTitle="Draw"
                 BackEnabled="true" NextLabel="Compile" NextBusy="@(!documentLoaded)" NextBusyLabel="Loading…"
                 OnBack="GoInfo" OnNext="OpenCompile" />
      }
      <Workspace>
        @if (SidebarOpen)
        {
        <Sidebar>
            @if (MapBacked)
            {
            <div class="plan-panel-switch">
              <Chip Active="@(leftPanel == "settings")" OnClick='() => SetPanel("settings")'>Settings</Chip>
              <Chip Active="@(leftPanel == "validation")" OnClick='() => SetPanel("validation")'>Checks</Chip>
              <Chip Active="@(leftPanel == "feasibility")" OnClick='() => SetPanel("feasibility")'>Generator check</Chip>
            </div>
            }
            @if (leftPanel == "settings")
            {
            @if (!MapBacked)
            {
            <Section>
              <Field Label="Plan name">
                <input class="field-input" value="@planName" @onchange="OnName" placeholder="Untitled plan" />
              </Field>
            </Section>

            <Section Title="Symmetry and grid">
              <Field Label="Symmetry">
                <select class="field-input" value="@symmetry" @onchange="OnSymmetry">
                  <option value="rot_180">Rotate 180°</option>
                  <option value="rot_90">Rotate 90°</option>
                  <option value="mirror_x">Mirror X</option>
                  <option value="mirror_z">Mirror Z</option>
                  <option value="none">None</option>
                </select>
              </Field>
              <Field Label="Cell size (blocks)">
                <NumberField Value="cell" ValueChanged="OnCell" Min="1" />
              </Field>
              <Field Label="Base surface (y)">
                <NumberField Value="surface" ValueChanged="OnSurface" Min="0" />
              </Field>
              <Field Label="Surface step (y)">
                <NumberField Value="surfaceStep" ValueChanged="OnSurfaceStep" Min="1" />
              </Field>
              <Field Label="Max players per team">
                <NumberField Value="maxPlayers" ValueChanged="OnMaxPlayers" Min="1" />
              </Field>
            </Section>
            }

            <Section Title="Reference">
              <Field Label="Trace over map">
                <select class="field-input" value="@refMap" @onchange="OnPickReferenceMap">
                  <option value="">None</option>
                  @foreach (var m in traceMaps) { <option value="@m.Slug">@m.Name</option> }
                </select>
              </Field>
              @if (refError is not null) { <p class="section-desc plan-compile-draft-error">@refError</p> }
              @if (refMap is not null)
              {
                <Field Label="Opacity">
                  <input type="range" class="field-input" min="0" max="1" step="0.05" value="@refOpacity" @oninput="OnRefOpacity" />
                </Field>
                <Field Label="Offset X (cells)">
                  <NumberField Value="refOffsetX" ValueChanged="OnRefOffsetX" Step="1" />
                </Field>
                <Field Label="Offset Z (cells)">
                  <NumberField Value="refOffsetZ" ValueChanged="OnRefOffsetZ" Step="1" />
                </Field>
                <Field Label="Scale">
                  <NumberField Value="refScale" ValueChanged="OnRefScale" Min="0.1" Step="0.1" />
                </Field>
                <div class="ctrl-row">
                  <Button Full OnClick="RecenterReference" Title="Reset offset and scale">Recenter</Button>
                  <Button Full OnClick="ClearReference" Title="Remove the backdrop">Clear</Button>
                </div>
              }
              <p class="section-desc">Trace over another map's top-down view. The backdrop is saved with the plan but not built.</p>
            </Section>

            }
            else if (leftPanel == "feasibility")
            {
            @* Producibility, grouped per box with the unit-level findings pinned above them: a box can be
               unbuildable on its own geometry AND the unit unbuildable in how its boxes are arranged, so both
               are shown rather than the first failure. Clicking a box paints the cells by which it misses the
               nearest thing the emitters can build. *@
            <Section Title="Generator check">
              <Actions>
                @if (feasibility is not null)
                {
                  <Badge Class="@(feasibility.Producible ? "badge--success" : "badge--error")"
                         title="Whether the generator could build this plan">
                    @(feasibility.Producible ? "buildable" : "not buildable")
                  </Badge>
                }
              </Actions>
              <ChildContent>
                @if (feasibility is null)
                {
                  <p class="section-desc">Shows whether the generator could build this layout. Draw a box around each part to check it.</p>
                }
                else if (feasibility.Boxes.Count == 0 && feasibility.Unit.Count == 0)
                {
                  <p class="section-desc">No boxes drawn. Draw a box around each part (a hub, an approach, a spawn, or the front line) to check it.</p>
                }
                else
                {
                  @if (feasibility.Unit.Count > 0)
                  {
                    <div class="plan-feas-unit">
                      <div class="plan-feas-unit-title">Arrangement</div>
                      @foreach (var f in feasibility.Unit)
                      {
                        <div class="plan-feas-finding">
                          <span class="plan-lint-chip">@f.Rule</span>
                          <span class="plan-lint-msg">@f.Message</span>
                        </div>
                      }
                    </div>
                  }
                  @foreach (var box in feasibility.Boxes)
                  {
                    var b = box;
                    <div class="plan-feas-box">
                      <button class="plan-feas-head @(isolatedBox == b.BoxId ? "plan-feas-head--active" : null)"
                              disabled="@(b.Nearest is null)"
                              title="@(b.Nearest is null ? "Nothing to compare against" : "Show the cells that differ")"
                              @onclick="() => IsolateBox(b)">
                        <span class="plan-lint-dot @(b.Producible ? "plan-lint-dot--ok" : "plan-lint-dot--error")"></span>
                        <span class="plan-feas-id">@b.BoxId</span>
                        <span class="list-tag">@b.Kind</span>
                        <span class="plan-feas-identity" title="What the shape looks like. A hint only.">@b.Identity</span>
                      </button>
                      @if (b.Producible)
                      {
                        <div class="plan-feas-finding plan-feas-finding--ok">@b.ProducibleAs <span class="list-tag">cw @b.Cw</span></div>
                      }
                      else if (b.Nearest is not null)
                      {
                        <div class="plan-feas-finding">
                          <span class="plan-lint-msg">Closest: @b.Nearest.Label</span>
                          <span class="list-tag">@b.Nearest.DifferingCells cell@(b.Nearest.DifferingCells == 1 ? "" : "s")</span>
                        </div>
                      }
                      @foreach (var f in b.Findings)
                      {
                        <div class="plan-feas-finding">
                          <span class="plan-lint-chip">@f.Rule</span>
                          <span class="plan-lint-msg">@f.Message</span>
                        </div>
                      }
                    </div>
                  }
                }
              </ChildContent>
            </Section>
            }
            else
            {
            <Section Title="Checks">
              <Actions>
                @if (evaluation is not null)
                {
                  <Badge Class="@(evaluation.Valid ? "badge--success" : "badge--error")" title="Score. Lower is better, and 0 is best.">@evaluation.Score.ToString("0.##")</Badge>
                }
              </Actions>
              <ChildContent>
                @if (evaluation is null)
                {
                  <p class="section-desc">Checks the plan against the layout rules. Click a problem to show it on the canvas.</p>
                }
                else if (evaluation.Violations.Count == 0)
                {
                  <div class="plan-lint-ok"><i data-lucide="check-circle-2"></i> No problems found</div>
                }
                else
                {
                  <div class="plan-lint-list">
                    @for (var i = 0; i < evaluation.Violations.Count; i++)
                    {
                      var idx = i;
                      var v = evaluation.Violations[i];
                      <button class="plan-lint-row @(selectedViolation == idx ? "plan-lint-row--active" : null)" @onclick="() => SelectViolation(idx)" title="Show on the canvas">
                        <span class="plan-lint-dot @(v.Kind == "hard" ? "plan-lint-dot--error" : "plan-lint-dot--lint")"></span>
                        <span class="plan-lint-chip">@v.Finding.Rule</span>
                        <span class="plan-lint-msg">@v.Finding.Message</span>
                        @if (v.Kind == "soft") { <span class="list-tag">@v.Distance.ToString("0.#")</span> }
                      </button>
                    }
                  </div>
                }
              </ChildContent>
            </Section>
            }
        </Sidebar>
        <div class="sidebar-handle"></div>
        }

        <div class="workspace-canvas">
          <div @ref="wrapRef" class="svg-area">
            <svg @ref="svgRef" class="map-canvas-svg" xmlns="http://www.w3.org/2000/svg"></svg>
          </div>

          <CanvasReadout @ref="readout" ZoomText="@zoomLabel" />

          @* The derived-structure overlays are what the canvas shows, so they are chips on the canvas rather
             than settings a scroll away from the drawing they annotate. In 3-D there is nothing to overlay —
             the isometric preview is one rendering of the finished heights — so the row collapses to the
             rotate and the toggle back out. *@
          <CanvasLayerBar>
            @if (!threeD)
            {
              <LayerChip Icon="spline" Active="overlayInterfaces"
                         Title="Where pieces touch: shared edges in green (thinner where narrow), corners in red"
                         OnClick='() => ToggleOverlay("interfaces")'>Interfaces</LayerChip>
              <LayerChip Icon="shield" Active="overlayFrontline" Title="Piece edges facing a build area"
                         OnClick='() => ToggleOverlay("frontline")'>Front line</LayerChip>
              <LayerChip Icon="type" Active="overlayLabels"
                         Title="Names of pieces and build areas, and the distances between build areas"
                         OnClick='() => ToggleOverlay("labels")'>Labels</LayerChip>
              <LayerChip Icon="mountain" Active="heightMap" Title="Colour pieces by height"
                         OnClick="ToggleHeightMap">Heights</LayerChip>
              <CanvasRoundButton Icon="scan" Title="Zoom to fit (F)" OnClick="Fit" />
            }
            else
            {
              <CanvasRoundButton Icon="rotate-cw" Title="Rotate the preview 90°" OnClick="RotateIso" />
            }
            @if (isoUnavailable)
            {
              <span class="canvas-note" title="@IsoNoteTitle">@IsoNote</span>
            }
            <ViewModeToggle ThreeD="threeD" Disabled="@isoUnavailable"
                            Title="@(isoUnavailable ? IsoNoteTitle : "3-D preview (read-only)")"
                            OnClick="Toggle3D" />
          </CanvasLayerBar>

          @if (!threeD)
          {
          @* Four families, four slots. Every drawing tool the plan editor has is one of four questions —
             which piece role · which technical annotation · which marker · which box kind — and within a
             family only one is ever armed, so each shows the option in hand and keeps the rest a chevron
             away. Nineteen buttons become six, and the six that remain say what was last drawn with.

             They share one box: with each family down to an option and a chevron, a rule between them would
             separate less than the pairs already do. *@
          <CanvasDock FlyoutOpen="@(openFlyout is not null)" OnDismissFlyout="CloseFlyouts">
            <DockGroup Viewing>
              <DockButton Icon="mouse-pointer-2" Title="Select" Active="@(tool == "select")"
                          OnClick='() => PickTool("select")' />
              <DockButton Icon="hand" Title="Move" Active="@(tool == "pan")"
                          OnClick='() => PickTool("pan")' />
            </DockGroup>
            <DockGroup>
              @* The land — the roles that produce terrain. *@
              <DockFlyoutGroup Items="TerrainItems" ActiveKey="@terrainActive" Label="Pieces"
                               Armed="@(tool == "piece" && role == terrainActive)"
                               Open="@(openFlyout == "terrain")" OnToggleOpen='() => ToggleFlyout("terrain")'
                               OnPick="PickTerrain" />
              @* The build area and the annotations that reserve or connect — none of them generate terrain. *@
              <DockFlyoutGroup Items="TechnicalItems" ActiveKey="@technicalActive" Label="Zones"
                               Armed="@TechnicalArmed"
                               Open="@(openFlyout == "technical")" OnToggleOpen='() => ToggleFlyout("technical")'
                               OnPick="PickTechnical" />
              @* What is put on the land. *@
              <DockFlyoutGroup Items="MarkerItems" ActiveKey="@markerActive" Label="Markers"
                               Armed="@(tool == markerActive)"
                               Open="@(openFlyout == "markers")" OnToggleOpen='() => ToggleFlyout("markers")'
                               OnPick="PickMarker" />
              @* Box envelopes: drawing one states what the pieces inside it realize. Annotation only — a box
                 never compiles, and dragging it carries its members. *@
              <DockFlyoutGroup Items="BoxItems" ActiveKey="@boxActive" Label="Boxes"
                               Armed="@(tool == "box" && boxKind == boxActive)"
                               Open="@(openFlyout == "boxes")" OnToggleOpen='() => ToggleFlyout("boxes")'
                               OnPick="PickBox" />
            </DockGroup>
          </CanvasDock>
          }
        </div>
        <div class="sidebar-handle"></div>
        <Inspector>
            <Section>
              @if (sel is null)
              {
                <p class="section-desc">Select something to edit it. Draw a piece first, then place spawns and wools on it.</p>
              }
              else if (sel.Kind == "piece")
              {
                <DetailHeader Icon="box" Label="Piece">
                  <span class="detail-header-badges"><Badge Kind="neutral">@sel.Role</Badge></span>
                </DetailHeader>
                <Field Label="Id">
                  <input class="field-input" value="@sel.Id" @onchange="OnPieceId" />
                </Field>
                <Field Label="Role">
                  <select class="field-input" value="@sel.Role" @onchange="OnPieceRole">
                    @foreach (var r in Roles) { <option value="@r.Id">@r.Label</option> }
                  </select>
                </Field>
                <Field Label="Surface (y)">
                  <div class="ctrl-row">
                    <Button Variant="icon" Title='@($"Lower surface by {(int)surfaceStep}")' OnClick="() => StepSurface(-(int)surfaceStep)">−</Button>
                    <span class="plan-stepper-value">@sel.Surface@(sel.SurfaceSet ? "" : " (base)")</span>
                    <Button Variant="icon" Title='@($"Raise surface by {(int)surfaceStep}")' OnClick="() => StepSurface((int)surfaceStep)">+</Button>
                  </div>
                </Field>
                <Field Label="Step">
                  <div class="ctrl-row">
                    @foreach (var s in StepPresets)
                    {
                      <Chip Active="(int)surfaceStep == s" Title='@($"Step surface by {s}")' OnClick="() => SetSurfaceStep(s)">@s</Chip>
                    }
                  </div>
                </Field>
                <Button Full OnClick="ToggleMirrors">
                  @(sel.Mirrors ? "Exclude from mirror" : "Include in mirror")
                </Button>
                <Button Full Variant="danger" OnClick="DeleteSelected">
                  <i data-lucide="trash-2"></i> Delete piece
                </Button>
              }
              else if (sel.Kind == "footprint")
              {
                <DetailHeader Icon="home" Label="Building">
                  <span class="detail-header-badges"><Badge Kind="neutral">@sel.MarkerKind</Badge></span>
                </DetailHeader>
                <Field Label="On piece">
                  <div class="plan-readout">@sel.Piece</div>
                </Field>
                <Field Label="Size">
                  <div class="plan-readout">
                    @(sel.Footprint is { Length: >= 4 } f ? $"{(int)f[2]} × {(int)f[3]}" : "—")
                  </div>
                </Field>
                <Field Label="Offset from piece corner">
                  <div class="plan-readout">
                    @(sel.Footprint is { Length: >= 4 } o ? $"x {(int)o[0]}, z {(int)o[1]}" : "—")
                  </div>
                </Field>
                <p class="section-desc">
                  The piece around the building is its protected area. Drag the dashed rectangle to move
                  the building, or its handles to resize it.
                </p>
                <Button Full Variant="danger" OnClick="DeleteSelected">
                  <i data-lucide="trash-2"></i> Clear building
                </Button>
                <p class="section-desc">Clearing it restores the default building.</p>
              }
              else if (sel.Kind == "zone")
              {
                var lane = sel.ZoneKind == "water-lane";
                <DetailHeader Icon="@(lane ? "waves" : "square-dashed")" Label="@(lane ? "Water lane" : "Build area")" />
                <Field Label="Id">
                  <input class="field-input" value="@sel.Id" @onchange="OnZoneId" />
                </Field>
                <Field Label="Opens">
                  <div class="plan-readout">
                    @(lane ? "During the match, when the lane floods" : "At the start of the match")
                  </div>
                </Field>
                <Button Full Variant="danger" OnClick="DeleteSelected">
                  <i data-lucide="trash-2"></i> @(lane ? "Delete water lane" : "Delete build area")
                </Button>
              }
              else if (sel.Kind == "box")
              {
                <DetailHeader Icon="group" Label="Box">
                  <span class="detail-header-badges"><Badge Kind="neutral">@sel.BoxKind</Badge></span>
                </DetailHeader>
                <Field Label="Id">
                  <input class="field-input" value="@sel.Id" @onchange="OnBoxId" />
                </Field>
                <Field Label="Kind">
                  <select class="field-input" value="@sel.BoxKind" @onchange="OnBoxKind">
                    @foreach (var k in BoxKinds) { <option value="@k.Id">@k.Label</option> }
                  </select>
                </Field>
                <Field Label="@($"Members ({sel.Members?.Count ?? 0})")">
                  <div class="plan-readout">
                    @(sel.Members is { Count: > 0 } ? string.Join(", ", sel.Members) : "None")
                  </div>
                </Field>
                <p class="section-desc">
                  @(sel.MembersNamed
                    ? "Members are fixed. Resizing the box doesn't change them."
                    : "Members are the pieces fully inside the box. Dragging the box moves them too.")
                </p>
                <Button Full OnClick="ToggleBoxMembers">
                  @(sel.MembersNamed ? "Use pieces inside" : "Fix members")
                </Button>
                <Button Full Variant="danger" OnClick="DeleteSelected">
                  <i data-lucide="trash-2"></i> Delete box
                </Button>
              }
              else
              {
                <DetailHeader Icon="@MarkerIcon(sel.MarkerKind)" Label="@sel.MarkerKind" />
                <Field Label="On piece">
                  <div class="plan-readout">@sel.Piece &nbsp; <span class="list-tag">at @OffsetLabel</span></div>
                </Field>
                @if (sel.MarkerKind == "spawn")
                {
                  <Field Label="Facing">
                    <div class="ctrl-row">
                      <span class="plan-stepper-value">@sel.Facing</span>
                      <Button Variant="icon" OnClick="CycleFacing" Title="Turn"><i data-lucide="rotate-cw"></i></Button>
                    </div>
                  </Field>
                }
                @* An objective marker states the structure it builds. Only what differs from the generator's
                   default is stored, so a marker left alone stays the bare { piece, at } it was placed as. *@
                @if (sel.MarkerKind is "destroyable" or "core")
                {
                  <Field Label="Name">
                    <LabelHint>@(sel.MarkerKind == "core" ? "(optional)" : "(optional, defaults to the team's)")</LabelHint>
                    <ChildContent>
                      <input class="field-input" value="@sel.Name" placeholder="@(sel.MarkerKind == "core" ? "Core" : "Red Monument")"
                             @onchange="@(e => SetMarkerText("name", e.Value?.ToString(), string.Empty))" />
                    </ChildContent>
                  </Field>
                }
                @if (sel.MarkerKind == "wool")
                {
                  @* A wool states a dye or states nothing. Nothing is not a default the inspector can show a
                     value for: the compiler resolves it against the owning team and the wools placed before
                     this one, so the option reads as what it is rather than naming a colour. *@
                  <Field Label="Colour">
                    <div class="field-pick-row">
                      <span class="field-swatch" style="background:@WoolSwatch"></span>
                      <select class="field-input" value="@WoolColor"
                              @onchange="@(e => SetMarkerText("color", e.Value?.ToString(), string.Empty))">
                        <option value="">Auto</option>
                        @foreach (var dye in vocabulary.Wool.Colors)
                        {
                          <option value="@dye.Name" selected="@(dye.Name == WoolColor)">@dye.Label</option>
                        }
                      </select>
                    </div>
                  </Field>
                }
                @if (sel.MarkerKind == "destroyable")
                {
                  <Field Label="Design">
                    <select class="field-input" value="@DestroyableStyle"
                            @onchange="@(e => SetMarkerText("style", e.Value?.ToString(), vocabulary.Destroyable.Style))">
                      @foreach (var design in vocabulary.Destroyable.Styles)
                      {
                        <option value="@design" selected="@(design == DestroyableStyle)">@design</option>
                      }
                    </select>
                  </Field>
                  <Field Label="Material">
                    <select class="field-input" value="@DestroyableMaterials"
                            @onchange="@(e => SetMarkerText("materials", e.Value?.ToString(), vocabulary.Destroyable.Materials))">
                      @foreach (var material in vocabulary.Destroyable.MaterialChoices)
                      {
                        <option value="@material" selected="@(material == DestroyableMaterials)">@material</option>
                      }
                    </select>
                  </Field>
                  <Field Label="Float">
                    <LabelHint>(air under it)</LabelHint>
                    <ChildContent>
                      <input class="field-input" type="number" min="0" max="64" value="@DestroyableFloat"
                             @onchange="@(e => SetMarkerNumber("float", Num(e.Value, DestroyableFloat), vocabulary.Destroyable.Float))" />
                    </ChildContent>
                  </Field>
                }
                else if (sel.MarkerKind == "core")
                {
                  @* A core is chosen, not designed: the author states the lava and the casing follows, so a
                     casing with nothing in it cannot be typed. The readout is the obsidian those two imply. *@
                  <Field Label="Lava footprint">
                    <LabelHint>(width and depth)</LabelHint>
                    <ChildContent>
                      <select class="field-input" value="@CoreLava"
                              @onchange="@(e => SetMarkerNumber("lava", Num(e.Value, CoreLava), vocabulary.Core.Lava))">
                        @foreach (var n in vocabulary.Core.LavaRange) { <option value="@n">@n × @n</option> }
                      </select>
                    </ChildContent>
                  </Field>
                  <Field Label="Lava height">
                    <LabelHint>(layers)</LabelHint>
                    <ChildContent>
                      <select class="field-input" value="@CoreLavaHeight"
                              @onchange="@(e => SetMarkerNumber("lavaHeight", Num(e.Value, CoreLavaHeight), vocabulary.Core.LavaHeight))">
                        @foreach (var n in vocabulary.Core.LavaHeightRange) { <option value="@n">@n</option> }
                      </select>
                    </ChildContent>
                  </Field>
                  <Field Label="Casing">
                    <div class="filter-group-options">
                      <Chip Active="@(!CoreOpenTop)" OnClick="@(() => SetMarkerField("openTop", null))"
                            Title="A lid over the lava">capped</Chip>
                      <Chip Active="@CoreOpenTop" OnClick="@(() => SetMarkerField("openTop", true))"
                            Title="Lava flush with the rim">open</Chip>
                    </div>
                  </Field>
                  <p class="section-desc">@CoreCasingReadout</p>
                  <Field Label="Float">
                    <LabelHint>(air under the casing)</LabelHint>
                    <ChildContent>
                      <input class="field-input" type="number" min="0" max="64" value="@CoreFloat"
                             @onchange="@(e => SetMarkerNumber("float", Num(e.Value, CoreFloat), vocabulary.Core.Float))" />
                    </ChildContent>
                  </Field>
                  <Field Label="Leak">
                    <LabelHint>(fall before it counts)</LabelHint>
                    <ChildContent>
                      <input class="field-input" type="number" min="0" max="64" value="@CoreLeak"
                             @onchange="@(e => SetMarkerNumber("leak", Num(e.Value, CoreLeak), vocabulary.Core.Leak))" />
                    </ChildContent>
                  </Field>
                  <p class="section-desc">
                    @if (CoreDigDepth > 0)
                    {
                      <text>Capturing it means breaking the casing and digging @CoreDigDepth block@(CoreDigDepth == 1 ? "" : "s") below it.</text>
                    }
                    else
                    {
                      <text>The lava leaks as soon as the casing is broken, with no digging.</text>
                    }
                  </p>
                }
                <Button Full Variant="danger" OnClick="DeleteSelected">
                  <i data-lucide="trash-2"></i> Delete marker
                </Button>
              }
            </Section>
      </Inspector>
      </Workspace>
      </div>

  <SideDrawer Open="showCompile" Title="Compile" Icon="play" OnClose="CloseCompile">
    <Body>
      @if (compiling)
      {
        <p class="section-desc">Compiling…</p>
      }
      else
      {
        @if (compileErrors.Count > 0)
        {
          <div class="plan-compile-errors">
            <p class="section-desc">Fix these problems to compile:</p>
            @foreach (var f in compileErrors)
            {
              var finding = f;
              @* A finding with subjects is clickable — it can point at what it is about; one without has
                 nothing to show, so it stays a static row rather than offering a click that does nothing. *@
              <button class="plan-lint-row @(HasSubjects(finding) ? null : "plan-lint-row--static")"
                      disabled="@(!HasSubjects(finding))" title="@ShowFindingTitle(finding)"
                      @onclick="() => ShowFinding(finding)">
                <span class="plan-lint-dot plan-lint-dot--error"></span>
                @if (!string.IsNullOrEmpty(finding.Rule)) { <span class="plan-lint-chip">@finding.Rule</span> }
                <span class="plan-lint-msg">@finding.Message</span>
              </button>
            }
          </div>
        }
        else if (compileError is not null)
        {
          <div class="plan-compile-errors"><p class="section-desc">@compileError</p></div>
        }
        else if (compileWarnings.Count > 0)
        {
          <div class="plan-compile-warnings">
            <p class="section-desc">Compiled with warnings:</p>
            @foreach (var f in compileWarnings)
            {
              var finding = f;
              <button class="plan-lint-row @(HasSubjects(finding) ? null : "plan-lint-row--static")"
                      disabled="@(!HasSubjects(finding))" title="@ShowFindingTitle(finding)"
                      @onclick="() => ShowFinding(finding)">
                <span class="plan-lint-dot plan-lint-dot--lint"></span>
                @if (!string.IsNullOrEmpty(finding.Rule)) { <span class="plan-lint-chip">@finding.Rule</span> }
                <span class="plan-lint-msg">@finding.Message</span>
              </button>
            }
          </div>
        }

        @* Every file this plan can be read out of, in one place: the plan document itself, and — once the
           compile lands — the pair it compiled into. The plan tab stands whether or not the compile
           succeeded, because a plan that will not compile is exactly the one worth having a copy of. *@
        @if (compiledPlan is not null)
        {
          <div class="plan-compile-tabs">
            @foreach (var (id, label) in CompileTabs)
            {
              <button class="draw-tool-btn @(compileTab == id ? "draw-tool-btn--active" : null)"
                      @key="id" @onclick="() => compileTab = id">@label</button>
            }
            <div class="plan-compile-tab-actions">
              <Button Title="Copy to clipboard" OnClick="CopyTab"><i data-lucide="clipboard"></i> @(copied ? "Copied" : "Copy")</Button>
              <Button Title="Download this file" OnClick="DownloadTab"><i data-lucide="download"></i> Download</Button>
            </div>
          </div>
          <pre class="plan-compile-json">@TabText</pre>
        }
      }
    </Body>
    <Footer>
      <div class="plan-compile-draft">
        @* A map-backed plan builds onto the map already open — it advances that row rather than
           originating a second one, so the label and the result name what actually happened. *@
        @if (draftSlug is null)
        {
          @* Rebuilding a map someone has since worked on is a different act from originating one, and the
             difference is invisible in the button. So the map says what it is about to trade before it
             does it — replaced, kept, and nothing else. *@
          @if (orphanedRelief is { } orphaned)
          {
            @* The layout write refused (409): relief drawn on islands the rebuilt board no longer has. The
               way through is the author's to choose, so it is offered here rather than left as a failure. *@
            <div class="plan-rebuild-warn">
              <p class="section-desc"><strong>The new layout has no island for the relief on
                @string.Join(", ", orphaned).</strong> Rebuilding deletes that relief. Relief on the other
                islands is kept.</p>
              <div class="ctrl-row">
                <Button Fill OnClick="KeepRelief">Cancel</Button>
                <Button Variant="danger" Fill Disabled="@draftBusy" OnClick="DiscardReliefAndRebuild">
                  <i data-lucide="hammer"></i> Delete and rebuild
                </Button>
              </div>
            </div>
          }
          else if (confirmingRebuild)
          {
            <div class="plan-rebuild-warn">
              <p class="section-desc"><strong>This map is already built.</strong> Rebuilding it from the plan:</p>
              <ul class="plan-rebuild-list">
                <li><span class="plan-rebuild-mark plan-rebuild-mark--drop"><i data-lucide="refresh-cw"></i></span>
                  <span><strong>Replaces</strong> the terrain and islands, removes sketch shapes the plan doesn't have, and rewrites the teams, spawns, wools, and build areas.</span></li>
                <li><span class="plan-rebuild-mark plan-rebuild-mark--keep"><i data-lucide="check"></i></span>
                  <span><strong>Keeps</strong> relief on islands that remain, room heights you changed, terrain themes, room shells, dressing, and authors.</span></li>
              </ul>
              <p class="section-desc">Changes made in Configure to teams, spawns, or wools are overwritten.</p>
              @* Fill, not Full: two full-width buttons wrap onto two rows, which pushed the one that
                 actually rebuilds furthest from where the eye lands. *@
              <div class="ctrl-row">
                <Button Fill OnClick="CancelRebuild">Cancel</Button>
                <Button Variant="danger" Fill Disabled="@draftBusy" OnClick="BuildRequested">
                  <i data-lucide="hammer"></i> Rebuild
                </Button>
              </div>
            </div>
          }
          else
          {
            @* The label names the state the drawer is in, not the map's: a compile that was refused leaves
               nothing to build, and a button still offering the build is a dead control that says why only by
               being grey. The hammer goes with it — an icon for the act is wrong on a label that refuses it. *@
            <Button Variant="primary" Full Disabled="@(compiledLayout is null)" Busy="@draftBusy"
                    BusyLabel="@($"{draftStep}…")" OnClick="BuildRequested">
              @if (compiledLayout is not null) { <i data-lucide="hammer"></i> }
              @DraftLabel
            </Button>
          }
        }
        else
        {
          <div class="plan-lint-ok">
            <i data-lucide="check-circle-2"></i>
            @if (MapBacked) { <text>Built <strong>@draftSlug</strong></text> }
            else { <text>Draft <strong>@draftSlug</strong> created</text> }
          </div>
          @if (droppedShapes.Count > 0)
          {
            <p class="section-desc">Removed @droppedShapes.Count sketch shape@(droppedShapes.Count == 1 ? "" : "s")
              the plan doesn't have: @string.Join(", ", droppedShapes).</p>
          }
          <Button Full Href="@($"/maps/{draftSlug}/sketch")" target="_blank" rel="noopener">
            <i data-lucide="external-link"></i> Open in sketch editor
          </Button>
          <Button Variant="primary" Full OnClick="DownloadWorld">
            <i data-lucide="download"></i> Download world ZIP
          </Button>
        }
        @if (draftError is not null) { <p class="section-desc plan-compile-draft-error">@draftError</p> }
      </div>
    </Footer>
  </SideDrawer>

  <SideDrawer Open="showOpenDb" Title="Open plan" Icon="folder-open" OnClose="CloseDbBrowser">
    <Body>
      @if (dbBusy)
      {
        <p class="section-desc">Loading…</p>
      }
      else if (dbError is not null)
      {
        <div class="plan-compile-errors"><p class="section-desc">@dbError</p></div>
      }
      else if (dbPlans.Count == 0)
      {
        <p class="section-desc">No saved plans yet. Save a plan to see it here.</p>
      }
      else
      {
        <div class="plan-lint-list">
          @foreach (var p in dbPlans)
          {
            <button class="plan-lint-row" @onclick="() => LoadFromDb(p.Id)" title="Open this plan">
              <span class="plan-lint-chip">@p.Origin</span>
              <span class="plan-lint-msg plan-db-name">@(string.IsNullOrWhiteSpace(p.Name) ? "Untitled plan" : p.Name)</span>
              @if (p.StaleComposer)
              {
                <span class="plan-db-stale" title="@StaleTitle(p)">@(p.ComposerVersion ?? "No version")</span>
              }
              <span class="plan-db-date">@p.UpdatedAt.ToLocalTime().ToString("MMM d")</span>
            </button>
          }
        </div>
      }
    </Body>
  </SideDrawer>
  </ChildContent>
</StudioShell>
