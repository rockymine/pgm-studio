@namespace PgmStudio.Client.Features.Plan

@* Apply-step rail (TP10, G157): the plan canvas beside this is the selector — click a box/piece, Ctrl-click
   several — and this rail picks the theme, previews it, and applies/removes it on the selection. Map default
   under everything, then boxes, then per-piece overrides. Themes are created in the previous step. *@

<Sidebar>
  <Section Title="Map default">
    <p class="section-desc">The lowest layer — paints every cell no box or piece claims.</p>
    <Field>
      <select class="field-input" value="@MapTheme" @onchange="OnMapDefault">
        <option value="">(built-in default)</option>
        @foreach (var id in Themes) { <option value="@id">@id</option> }
      </select>
    </Field>
  </Section>

  <Section Title="Theme to apply">
    @if (Themes.Count == 0)
    {
      <p class="section-desc">No themes yet — create one in the previous step, then apply it here.</p>
    }
    else
    {
      @foreach (var id in Themes)
      {
        <ListRow Compact Selected="@(id == Picked)" @key="id" OnClick="() => Pick(id)">
          <span class="list-label list-label--mono">@id</span>
          @if (MapTheme == id) { <Badge Kind="neutral">map default</Badge> }
        </ListRow>
      }
      @if (Picked is not null)
      {
        <div class="theme-apply-swatches">
          @foreach (var bucket in new[] { "surface", "wall", "rim", "fill" })
          {
            <figure class="theme-apply-swatch">
              <div class="theme-swatch-img">@((MarkupString)(Swatches.GetValueOrDefault(bucket) ?? ""))</div>
              <figcaption>@bucket</figcaption>
            </figure>
          }
        </div>
      }
    }
  </Section>

  <Section Title="Selection">
    @if (Shapes.Count == 0)
    {
      <p class="section-desc">Click a shape on the canvas to theme it. Ctrl-click to select several; double-click
        a box to drill into one of its pieces.</p>
    }
    else
    {
      <p class="section-desc">@Shapes.Count shape@(Shapes.Count == 1 ? "" : "s") selected.</p>
      @foreach (var shape in Shapes)
      {
        var theme = ThemeOf(shape);
        <div class="theme-apply-sel-row" @key="@($"{shape.Kind}:{shape.Id}")">
          <span class="list-label list-label--mono">@shape.Id</span>
          <Badge Kind="dim">@shape.Kind</Badge>
          @if (!string.IsNullOrEmpty(theme)) { <Badge Kind="neutral">@theme</Badge> }
          else { <span class="section-desc">— unthemed —</span> }
        </div>
      }
      <div class="panel-actions">
        <Button Variant="primary" Icon="paintbrush" OnClick="Apply" Disabled="@(Picked is null)">
          Apply @Picked
        </Button>
        <Button Icon="eraser" OnClick="Remove">Remove</Button>
      </div>
    }
  </Section>
</Sidebar>
