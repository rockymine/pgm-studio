@page "/catalog"
@layout StudioLayout

@* Shape catalog (G144): the generation vocabulary as browsable cards — every approach family and body form
   the pipeline can build, rendered server-side, each badged with how far it actually gets. *@

<StudioShell Bare="true">
  <Bar>
    <Topbar HomeHref="/" HomeLabel="Studio" HomeTitle="Studio home">
      <Crumbs><Crumb Dim>Shape catalog</Crumb></Crumbs>
      <Right>
        <Button Href="/generator" Icon="sparkles" Title="Browse generated layouts">Generator</Button>
      </Right>
    </Topbar>
  </Bar>
  <ChildContent>
  <div class="lib-body">
    <aside class="lib-filters">
      <Section Title="Filters">

        <Field Label="Box kind">
          <div class="filter-group-options">
            @foreach (var k in Kinds)
            {
              <Chip Active="kindFilter.Contains(k.Token)" Title="@k.Hint"
                    OnClick="() => Toggle(kindFilter, k.Token)">@k.Label<span class="filter-chip-n">@Count(byKind, k.Token)</span></Chip>
            }
          </div>
        </Field>

        <Field Label="Reach">
          <LabelEnd><span class="text-xs text-muted">how far it gets</span></LabelEnd>
          <ChildContent>
            <div class="filter-group-options">
              @foreach (var t in Tiers)
              {
                <Chip Active="tierFilter.Contains(t.Token)" Title="@t.Hint"
                      OnClick="() => Toggle(tierFilter, t.Token)">@t.Label<span class="filter-chip-n">@Count(byTier, t.Token)</span></Chip>
              }
            </div>
          </ChildContent>
        </Field>

        <Field Label="Family / form">
          <div class="filter-group-options">
            @foreach (var family in byFamily.Keys.OrderBy(FamilyOrder))
            {
              <Chip Active="familyFilter.Contains(family)"
                    OnClick="() => Toggle(familyFilter, family)">@family<span class="filter-chip-n">@Count(byFamily, family)</span></Chip>
            }
          </div>
        </Field>

        @if (AnyFilter)
        {
          <Button Full OnClick="ClearFilters">Clear filters</Button>
        }

        <p class="section-desc">
          The counts are the whole catalog, not the filtered slice — a chip says what it would show
          before it is picked.
        </p>
      </Section>
    </aside>

    <main class="lib-main">
      <p class="lib-intro">
        Every shape the pipeline can put in a box, emitted once and drawn mouth-up. The composer docks all
        four box edges; the other three orientations are the same shape turned, so only one is shown. Both
        handednesses are kept — a flip is an authored variant, not a viewing angle.
      </p>

      @if (error is not null) { <p class="lib-status">@error</p> }
      else if (loading) { <p class="lib-status">Emitting the catalog…</p> }
      else
      {
        <p class="lib-count">@Shown.Count of @total shape@(total == 1 ? string.Empty : "s")</p>
        <div class="lib-grid">
          @foreach (var shape in Shown)
          {
            <div class="lib-card cat-card--@shape.Tier">
              <div class="lib-card-badges">
                <span class="lib-badge cat-badge--family">@shape.Family</span>
                <span class="lib-badge cat-badge--@shape.Tier" title="@TierHint(shape.Tier)">@TierLabel(shape.Tier)</span>
              </div>
              <button class="lib-card-fig" @onclick="() => OpenProbe(shape)"
                      title="Open in the knob panel">@((MarkupString)shape.Svg)</button>
              <div class="lib-card-foot">
                <span class="lib-card-meta">@shape.BoxW×@shape.BoxH · w@(shape.CorridorCells)</span>
                @foreach (var knob in shape.Knobs)
                {
                  <span class="cat-knob">@knob</span>
                }
              </div>
              @if (shape.Note is not null)
              {
                <p class="lib-card-note">@shape.Note</p>
              }
            </div>
          }
        </div>
        @if (Shown.Count == 0) { <p class="lib-status">No shape matches these filters.</p> }
      }
    </main>

    @if (probeOpen)
    {
      <aside class="lib-rail">
        <div class="lib-rail-head">
          <span class="lib-rail-title">Knob panel</span>
          <button class="lib-rail-x" @onclick="CloseProbe" title="Close"><i data-lucide="x" @key="@("probe-x")"></i></button>
        </div>

        <div class="lib-fig @(probe?.Rejection is null ? null : "cat-probe-fig--refused")">
          @if (probe?.Svg is { } svg) { @((MarkupString)svg) }
          else { <span class="cat-probe-none">no shape</span> }
        </div>

        @if (probe?.Rejection is { } rejection)
        {
          <div class="cat-probe-reject">
            <span class="cat-probe-code">@rejection.Code</span>
            <p class="cat-probe-why">@rejection.Detail</p>
            @if (rejection.MinW is { } minW && rejection.MinH is { } minH)
            {
              <Button OnClick="() => ResizeTo(minW, minH)">Resize to @minW×@minH</Button>
            }
          </div>
        }
        else if (probe is not null)
        {
          <p class="cat-probe-ok">
            @probe.LandCells cells of land · @string.Join(" · ", probe.Slots)
          </p>
        }

        <Field Label="Family">
          <div class="filter-group-options">
            @foreach (var f in schemaFamilies)
            {
              <Chip Active="probeFamily == f.Token"
                    Title="@(f.OnProductionMenu ? $"min {f.MinW}×{f.MinH}" : "off the production fill menu")"
                    OnClick="() => PickFamily(f.Token)">@f.Token</Chip>
            }
          </div>
        </Field>

        <Field Label="Box width">
          <LabelEnd><strong>@probeW</strong></LabelEnd>
          <ChildContent>
            <input type="range" class="field-range" min="2" max="32" step="1" value="@probeW" @oninput="OnWidth" />
          </ChildContent>
        </Field>

        <Field Label="Box height">
          <LabelEnd><strong>@probeH</strong></LabelEnd>
          <ChildContent>
            <input type="range" class="field-range" min="2" max="32" step="1" value="@probeH" @oninput="OnHeight" />
          </ChildContent>
        </Field>

        <Field Label="Corridor width">
          <LabelEnd><strong>w@(probeCw)</strong></LabelEnd>
          <ChildContent>
            <input type="range" class="field-range" min="2" max="5" step="1" value="@probeCw" @oninput="OnCorridor" />
          </ChildContent>
        </Field>

        <Field Label="Mouth">
          <div class="filter-group-options">
            @foreach (var edge in Edges)
            {
              <Chip Active="probeMouth == edge" OnClick="() => PickMouth(edge)">@edge</Chip>
            }
          </div>
        </Field>

        <Field Label="Knobs">
          <div class="filter-group-options">
            <Chip Active="probeFlip" OnClick="ToggleFlip">flip</Chip>
            <Chip Active="probeSideTuck" Disabled="@(!SideTuckAllowed)"
                  Title="@SideTuckTitle" OnClick="ToggleSideTuck">side-tuck</Chip>
            <Chip Active="probeWoolAtEnd" Disabled="@(!WoolAtEndAllowed)"
                  Title="@WoolAtEndTitle" OnClick="ToggleWoolAtEnd">wool at end</Chip>
          </div>
        </Field>

        @if (AttachWAllowed)
        {
          <Field Label="Attachment width">
            <LabelEnd><strong>@(probeAttachW == 0 ? "default" : probeAttachW.ToString())</strong></LabelEnd>
            <ChildContent>
              <input type="range" class="field-range" min="0" max="6" step="1" value="@probeAttachW" @oninput="OnAttachW" />
            </ChildContent>
          </Field>
        }

        <p class="section-desc">
          Emitted through <code>BoxFiller</code>, so the profile check and the docking gate run exactly as they
          do in composition. A refusal is an answer, not an error — it is the emitter's own words.
        </p>
      </aside>
    }
  </div>
  </ChildContent>
</StudioShell>
