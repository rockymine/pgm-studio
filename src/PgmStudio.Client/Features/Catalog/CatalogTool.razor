@page "/catalog"
@layout StudioLayout

@* Shape catalog: the generation vocabulary as browsable cards — every approach family and body form
   the pipeline can build, rendered server-side, each badged with how far it actually gets. *@

<PageTitle>Shape catalog · PGM Studio</PageTitle>

<StudioShell Bare="true">
  <Bar>
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>Shape catalog</Crumb></Crumbs>
    </Topbar>
  </Bar>
  <ChildContent>
  <div class="lib-body">
    <FilterSidebar>
      <FilterPanel Title="Shape filters" Active="AnyFilter" OnClear="ClearFilters">
          <FilterGroup Label="Kind" Multi>
            @foreach (var k in Kinds)
            {
              <Chip Active="kindFilter.Contains(k.Token)" Title="@k.Hint" Count="Count(byKind, k.Token)"
                    OnClick="() => Toggle(kindFilter, k.Token)">@k.Label</Chip>
            }
          </FilterGroup>

          <FilterGroup Label="Usage" Multi>
            @foreach (var t in Tiers)
            {
              <Chip Active="tierFilter.Contains(t.Token)" Title="@t.Hint" Count="Count(byTier, t.Token)"
                    OnClick="() => Toggle(tierFilter, t.Token)">@t.Label</Chip>
            }
          </FilterGroup>

          <FilterGroup Label="Shape family" Multi>
            @foreach (var family in byFamily.Keys.OrderBy(FamilyOrder))
            {
              <Chip Active="familyFilter.Contains(family)" Count="Count(byFamily, family)"
                    OnClick="() => Toggle(familyFilter, family)">@FamilyLabel(family)</Chip>
            }
          </FilterGroup>

          <p class="filter-panel-note">The number on each option counts the whole catalog, whatever else is ticked.</p>
      </FilterPanel>
    </FilterSidebar>

    <main class="lib-main">
      <PageHeading Title="Shape catalog">
        <Lead>Every shape the generator can place, drawn with its opening at the top. Rotations are not shown, but
          mirrored versions are.</Lead>
      </PageHeading>

      @if (error is not null) { <StatusLine>@error</StatusLine> }
      else if (loading) { <StatusLine /> }
      else
      {
        <div class="gen-toolbar">
          <p class="gen-scanned"><strong>@Shown.Count</strong> of @total shape@(total == 1 ? string.Empty : "s") match</p>
          <BoardKey Entries="key" />
        </div>
        <div class="lib-grid">
          @foreach (var shape in Shown)
          {
            <PictureCard @key="shape.Id" Class="@($"cat-card--{shape.Tier}")" FigClass="lib-card-fig--board" Svg="@shape.Svg"
                         Name="@FamilyLabel(shape.Family)" Meta="@($"{shape.BoxW} by {shape.BoxH} cells")"
                         OnClick="() => OpenProbe(shape)">
              <div class="lib-card-badges">
                <span class="lib-badge cat-badge--@shape.Tier">@TierLabel(shape.Tier)</span>
                <span class="lib-badge">@KindLabel(shape.Kind)</span>
                <span class="lib-badge">Lane @shape.LaneWidth</span>
                @foreach (var knob in shape.Knobs)
                {
                  <span class="lib-badge cat-knob">@knob</span>
                }
              </div>
              @if (shape.Note is not null)
              {
                <p class="lib-card-note">@shape.Note</p>
              }
            </PictureCard>
          }
        </div>
        @if (Shown.Count == 0) { <EmptyState>No shapes match these filters. Clear one to see more.</EmptyState> }
      }
    </main>

    @if (probeOpen)
    {
      <aside class="lib-rail">
        @* The emitted shape stays pinned: every knob below it is judged by what it does to that shape, so
           scrolling to one must not take the shape off screen. *@
        <div class="lib-rail-pin">
          <div class="lib-rail-head">
            <span class="lib-rail-title">Shape settings</span>
            <Button Variant="icon" Icon="x" Class="lib-rail-x" Title="Close" OnClick="CloseProbe" />
          </div>
          <div class="lib-fig @(probe?.Rejection is null ? null : "cat-probe-fig--refused")">
            @if (probe?.Svg is { } svg) { @((MarkupString)svg) }
            else { <span class="cat-probe-none">No shape</span> }
          </div>
        </div>

        <div class="lib-rail-body">
        <p class="lib-rail-lead">Built with the generator's own checks. A shape that can't be built says why here.</p>
        @if (probe?.Rejection is { } rejection)
        {
          <div class="cat-probe-reject">
            <span class="cat-probe-code">@rejection.Code</span>
            <p class="cat-probe-why">@rejection.Detail</p>
            @if (rejection.MinW is { } minW && rejection.MinH is { } minH)
            {
              <Button OnClick="() => ResizeTo(minW, minH)">Resize to @minW by @minH</Button>
            }
          </div>
        }
        else if (probe is not null)
        {
          <p class="cat-probe-ok">
            @probe.LandCells cells of ground · @string.Join(" · ", probe.Parts)
          </p>
        }

        <Field Label="Shape family">
          <div class="filter-group-options">
            @foreach (var f in schemaFamilies)
            {
              <Chip Active="probeFamily == f.Token"
                    Title="@(f.OnProductionMenu ? $"At least {f.MinW} by {f.MinH} cells" : "Not used by the generator")"
                    OnClick="() => PickFamily(f.Token)">@FamilyLabel(f.Token)</Chip>
            }
          </div>
        </Field>

        <Field Label="Box width" Unit="cells">
          <LabelEnd><strong>@probeW</strong></LabelEnd>
          <ChildContent>
            <RangeField Min="2" Max="32" Value="probeW" ValueChanged="OnWidth" />
          </ChildContent>
        </Field>

        <Field Label="Box depth" Unit="cells">
          <LabelEnd><strong>@probeH</strong></LabelEnd>
          <ChildContent>
            <RangeField Min="2" Max="32" Value="probeH" ValueChanged="OnHeight" />
          </ChildContent>
        </Field>

        <Field Label="Lane width" Unit="cells">
          <LabelEnd><strong>@probeLaneWidth</strong></LabelEnd>
          <ChildContent>
            <RangeField Min="2" Max="5" Value="probeLaneWidth" ValueChanged="OnLaneWidth" />
          </ChildContent>
        </Field>

        <Field Label="Opening">
          <div class="filter-group-options">
            @foreach (var edge in Edges)
            {
              <Chip Active="probeMouth == edge" OnClick="() => PickMouth(edge)">@edge</Chip>
            }
          </div>
        </Field>

        <Field Label="Options">
          <div class="filter-group-options">
            <Chip Active="probeFlip" OnClick="ToggleFlip">Flip</Chip>
            <Chip Active="probeSideTuck" Disabled="@(!SideTuckAllowed)"
                  Title="@SideTuckTitle" OnClick="ToggleSideTuck">Side tuck</Chip>
            <Chip Active="probeWoolAtEnd" Disabled="@(!WoolAtEndAllowed)"
                  Title="@WoolAtEndTitle" OnClick="ToggleWoolAtEnd">Wool at end</Chip>
          </div>
        </Field>

        @if (AttachWAllowed)
        {
          <Field Label="Attachment width" Unit="cells" Note="At 0 the shape takes its own width.">
            <LabelEnd><strong>@(probeAttachW == 0 ? "Auto" : probeAttachW.ToString())</strong></LabelEnd>
            <ChildContent>
              <RangeField Min="0" Max="6" Value="probeAttachW" ValueChanged="OnAttachW" />
            </ChildContent>
          </Field>
        }

        </div>
      </aside>
    }
  </div>
  </ChildContent>
</StudioShell>
