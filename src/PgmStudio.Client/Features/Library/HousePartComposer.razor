@namespace PgmStudio.Client.Features.Library

@* The library's parts half (B71): a roof, a storey and a porch are each authored once here and bound by the
   houses that want them — the level `style` → `theme` already has, applied to buildings. One component for
   all three because they are the same act: pick a kind, bind styles to that kind's parts, turn that kind's
   knobs. What differs is which parts and which knobs, and that is data (PartKindInfo), not a third editor. *@

<div class="lib-body">
  <aside class="lib-filters">
    <Section Title="Which part">
      <p class="section-desc">A house is composed from these. Each is reusable on its own, so a roof authored
        once tops every building that wants it.</p>
      @foreach (var candidate in PartKindInfo.All)
      {
        <Button Full Icon="@candidate.Icon" @key="candidate.Id"
                Variant="@(candidate.Id == kind.Id ? "primary" : null)"
                OnClick="() => Switch(candidate)">@candidate.Plural</Button>
      }
    </Section>

    <Button Full Variant="primary" Icon="plus" OnClick="StartNew">New @kind.Singular</Button>

    <Section Title="Styles">
      <p class="section-desc">A course can only bind a style the library already holds — @styles.Count saved.
        Parts, rooms and themes draw from the same shelf.</p>
      <Button Full Href="/library/styles" Icon="paintbrush">Author a style</Button>
    </Section>
  </aside>

  <main class="lib-main">
    <p class="lib-intro">@kind.Intro</p>

    @if (loading) { <p class="lib-status">Reading the library…</p> }
    else
    {
      <p class="lib-count">@entries.Count @(entries.Count == 1 ? kind.Singular : kind.Plural.ToLowerInvariant())</p>
      <div class="lib-grid lib-grid--wide">
        @foreach (var entry in entries)
        {
          <div class="lib-card @(entry.Id == editingId ? "lib-card--picked" : null)" @key="entry.Id">
            <button class="lib-card-fig" @onclick="() => Edit(entry.Id)" title="Open in the editor">
              @((MarkupString)entry.Preview)
            </button>
            <div class="lib-card-foot">
              <span class="lib-card-meta">@entry.Name</span>
            </div>
          </div>
        }
      </div>
      @if (entries.Count == 0)
      {
        <p class="lib-status">No @kind.Plural.ToLowerInvariant() yet — start one with
          <strong>New @kind.Singular</strong>.</p>
      }
    }
  </main>

  @if (Editing)
  {
    <aside class="lib-rail">
      @* The sample building stays pinned: a part is judged by what it does to a building, so scrolling to a
         course must not take the building off screen. *@
      <div class="lib-rail-pin">
        <div class="lib-rail-head">
          <div class="section-heading">
            <span class="lib-rail-title">@(editingId is null ? $"New {kind.Singular}" : $"Edit {kind.Singular}")</span>
            <HelpMark Open="figureHelp" Title="What the views show"
                      OnClick="() => figureHelp = !figureHelp" />
          </div>
          <button class="lib-rail-x" @onclick="Close" title="Close"><i data-lucide="x" @key="@("part-x")"></i></button>
        </div>
        @if (figureHelp)
        {
          <div class="help-note-body">The part on a plain sample building, so what differs between two cards is
            the part and never the house around it. @kind.FigureNote</div>
        }
        <HouseViews Preview="preview" />
      </div>

      <div class="lib-rail-body">
        <Field Label="Name">
          <input class="field-input" @bind="draftName" @bind:event="oninput" />
        </Field>

        @foreach (var part in kind.Stacked)
        {
          <Section Title="@part.Title" Variant="list" @key="part.Id"
                   HelpTitle="@($"What the {part.Title.ToLowerInvariant()} is")">
            <Help>@part.Blurb</Help>
            <Actions>
              <Badge Kind="dim">@Courses(part.Id).Count course@(Courses(part.Id).Count == 1 ? string.Empty : "s")</Badge>
            </Actions>
            <ChildContent>
              @foreach (var course in Courses(part.Id))
              {
                <div class="lib-bind" @key="@($"{part.Id}-{course.Ordinal}")">
                  <select class="field-input field-input--slim" value="@course.StyleId"
                          @onchange="e => BindCourse(part.Id, course.Ordinal, e)">
                    @foreach (var group in StylesByKind)
                    {
                      <optgroup label="@MaterialKind.NameOf(group.Key)" @key="group.Key">
                        @foreach (var style in group) { <option value="@style.Id">@style.Name</option> }
                      </optgroup>
                    }
                  </select>
                  <input class="field-input field-input--slim" type="number" min="1" step="1"
                         title="How many courses this one runs"
                         value="@course.Height" @onchange="e => SetCourseHeight(part.Id, course.Ordinal, e)" />
                  @if (StyleOf(course.StyleId) is { } bound)
                  {
                    <span class="lib-bind-swatch">@((MarkupString)bound.Preview)</span>
                  }
                  <Button Variant="icon" Icon="trash-2" Title="Remove this course"
                          OnClick="() => RemoveCourse(part.Id, course.Ordinal)" />
                </div>
              }
              @if (Courses(part.Id).Count == 0)
              {
                <p class="section-desc">Unbound — keeps the built-in finish.</p>
              }
              <div class="panel-actions">
                <Button Icon="plus" Disabled="@(styles.Count == 0)" OnClick="() => AddCourse(part.Id)">Add a course</Button>
              </div>
            </ChildContent>
          </Section>
        }

        @if (kind.Single.Count > 0)
        {
          <Section Title="Trim" Variant="list" HelpTitle="Why these are not stacks">
            <Help>Each of these is one material read straight through — a post is a post all the way up — so
              binding one is a single choice rather than a stack.</Help>
            <ChildContent>
              @foreach (var part in kind.Single)
              {
                <Field Label="@part.Title" @key="part.Id">
                  <select class="field-input field-input--slim" title="@part.Blurb"
                          value="@Single(part.Id)" @onchange="e => BindSingle(part.Id, e)">
                    <option value="0">Unbound</option>
                    @foreach (var group in StylesByKind)
                    {
                      <optgroup label="@MaterialKind.NameOf(group.Key)" @key="group.Key">
                        @foreach (var style in group) { <option value="@style.Id">@style.Name</option> }
                      </optgroup>
                    }
                  </select>
                </Field>
              }
            </ChildContent>
          </Section>
        }

        @* ── the knobs, one section per kind ────────────────────────────────────────────────────── *@
        @if (roof is not null)
        {
          <Section Title="Shape" Variant="list" HelpTitle="One field, six forms">
            <Help>Every form is a height field over the same plan, which is why one stamper builds all six. The
              pitch and the ridge cap only mean anything on a sloped roof and the hole only on a flat lid, so
              each is offered under the form rather than as a knob of its own.</Help>
            <ChildContent>
              <Field Label="Form">
                <select class="field-input field-input--slim" value="@roof.Form" @onchange="SetForm">
                  @foreach (var form in RoofForms.All)
                  {
                    <option value="@form" @key="form">@RoofForms.Describe(form)</option>
                  }
                </select>
              </Field>
              @if (Sloped)
              {
                <Field Label="Pitch">
                  <input class="field-input field-input--slim" type="number" min="1" max="4" step="1"
                         title="Courses of rise per block travelled inward. 1 is 45°."
                         value="@roof.Pitch" @onchange="SetPitch" />
                </Field>
              }
              <Field Label="Overhang">
                <input class="field-input field-input--slim" type="number" min="0" max="4" step="1"
                       title="How far the roof reaches past the walls, in blocks. 0 ends it flush."
                       value="@roof.Overhang" @onchange="SetOverhang" />
              </Field>
              @if (Sloped)
              {
                <Field Label="Ridge">
                  <Chip Active="roof.RidgeCap" OnClick="ToggleRidgeCap">
                    @(roof.RidgeCap ? "Capped in the verge" : "The roof's own material")
                  </Chip>
                </Field>
              }
              else
              {
                <Field Label="Hole">
                  <Chip Active="roof.RoofHole" OnClick="ToggleHole">
                    @(roof.RoofHole ? "Open in the middle" : "Sealed — an unlit room")
                  </Chip>
                </Field>
              }
            </ChildContent>
          </Section>
        }

        @if (storey is not null)
        {
          <Section Title="The room" Variant="list" HelpTitle="Why clear and not courses">
            <Help>A storey is measured by the air a player stands in, not by the masonry around it: that is the
              number being decided and the only one with a floor under it. The courses follow — one more than
              the clear where another storey stands over this one, for the slab between them.</Help>
            <ChildContent>
              <Field Label="Clear height">
                <input class="field-input field-input--slim" type="number" min="3" max="16" step="1"
                       title="Blocks of air between this floor and the next thing over it. Never below three — a room has to be stood up in."
                       value="@storey.Clear" @onchange="SetClear" />
              </Field>
              <Field Label="@(Bound(RoomParts.Border) ? "Border width" : "Border width — no border bound")">
                <input class="field-input field-input--slim" type="number" min="1" max="4" step="1"
                       disabled="@(!Bound(RoomParts.Border))"
                       title="@(Bound(RoomParts.Border)
                                ? "How many blocks in from the walls the border ring runs."
                                : "Bind a style to Border above and this decides how wide that ring runs.")"
                       value="@storey.BorderWidth" @onchange="SetBorderWidth" />
              </Field>
              <Field Label="@(Bound(RoomParts.Inlay) ? "Inlay inset" : "Inlay inset — no inlay bound")">
                <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                       disabled="@(!Bound(RoomParts.Inlay))"
                       title="@(Bound(RoomParts.Inlay)
                                ? "How far in from the walls the centred plate starts."
                                : "Bind a style to Inlay above and this decides where that plate starts.")"
                       value="@storey.InlayInset" @onchange="SetInlayInset" />
              </Field>
            </ChildContent>
          </Section>

          <Section Title="Windows" Variant="list" HelpTitle="Why a block and not a style">
            <Help>A stair's metadata is which way it climbs and a slab's is which half it fills. The four stairs
              of a lattice differ from each other by geometry alone, and a material resolving its data from
              where the cell sits would turn all four the same way — a solid patch of wall rather than a
              window.</Help>
            <ChildContent>
              <Field Label="Form">
                <select class="field-input field-input--slim" value="@storey.Windows.Form" @onchange="SetWindowForm">
                  @foreach (var form in WindowForms.All)
                  {
                    <option value="@form" @key="form">@WindowForms.Describe(form)</option>
                  }
                </select>
              </Field>
              @if (Glazing)
              {
                <Field Label="Made of">
                  <BlockPicker Blocks="blocks" Id="storey.Windows.Block" Data="storey.Windows.Data"
                               OnPick="PickWindowBlock" />
                </Field>
                <Field Label="Sill">
                  <input class="field-input field-input--slim" type="number" min="1" max="16" step="1"
                         title="The course above this storey's own floor the opening starts at."
                         value="@storey.Windows.Sill" @onchange="SetWindowSill" />
                </Field>
                @if (WindowForms.Canonical(storey.Windows.Form) != WindowForms.StairLattice)
                {
                  <Field Label="Blocks wide">
                    <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                           value="@storey.Windows.Width" @onchange="SetWindowWidth" />
                  </Field>
                }
                @if (WindowForms.Canonical(storey.Windows.Form) == WindowForms.Pane)
                {
                  <Field Label="Blocks tall">
                    <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                           value="@storey.Windows.Height" @onchange="SetWindowHeight" />
                  </Field>
                }
                <Field Label="Spacing">
                  <input class="field-input field-input--slim" type="number" min="0" max="16" step="1"
                         title="Clear blocks of wall between one window and the next."
                         value="@storey.Windows.Spacing" @onchange="SetWindowSpacing" />
                </Field>
              }
            </ChildContent>
          </Section>
        }

        @if (porch is not null)
        {
          <Section Title="The deck" Variant="list" HelpTitle="Where a porch comes from">
            <Help>A porch is taken <strong>out of</strong> the footprint, never added to it — the footprint
              comes from the piece and a style may not change it. The walls stand back from one side, and the
              strip they gave up is a deck with posts, a rail and its own roof over it.</Help>
            <ChildContent>
              <Field Label="Blocks deep">
                <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                       title="How deep a strip the walls give up. The room keeps at least three blocks."
                       value="@porch.Depth" @onchange="SetPorchDepth" />
              </Field>
              <Field Label="Pulled in by">
                <input class="field-input field-input--slim" type="number" min="0" max="8" step="1"
                       title="How far the deck stops short of each end of that wall. 0 runs it the full width."
                       value="@porch.Inset" @onchange="SetPorchInset" />
              </Field>
              <Field Label="Off which wall">
                <select class="field-input field-input--slim" value="@porch.Edge" @onchange="SetPorchEdge">
                  @foreach (var edge in PorchEdges.All)
                  {
                    <option value="@edge" @key="edge">@PorchEdges.Describe(edge)</option>
                  }
                </select>
              </Field>
              <Field Label="Canopy">
                <select class="field-input field-input--slim" value="@porch.Roof" @onchange="SetPorchRoof">
                  @foreach (var form in RoofForms.All)
                  {
                    <option value="@form" @key="form">@RoofForms.Describe(form)</option>
                  }
                </select>
              </Field>
              <Field Label="Rail">
                <Chip Active="@(porch.RailBlock > 0)" OnClick="ToggleRail">
                  @(porch.RailBlock > 0 ? "Along the open edges" : "None — step off anywhere")
                </Chip>
              </Field>
              @if (porch.RailBlock > 0)
              {
                <Field Label="Rail made of">
                  <BlockPicker Blocks="blocks" Id="porch.RailBlock" Data="0" ShowColors="false"
                               OnPick="PickRailBlock" />
                </Field>
              }
            </ChildContent>
          </Section>
        }

        @if (note is not null) { <p class="section-desc">@note</p> }

        <div class="panel-actions">
          <Button Variant="primary" Icon="save" Disabled="@(string.IsNullOrWhiteSpace(draftName))" OnClick="Save">
            @(editingId is null ? "Add to library" : "Save changes")
          </Button>
          @if (editingId is not null)
          {
            <Button Variant="danger" Icon="trash-2" OnClick="Delete">Delete</Button>
          }
        </div>
      </div>
    </aside>
  }
</div>
