@namespace PgmStudio.Client.Features.Library

@* The browse page every library opens on: a strip carrying the name search, whatever the kind filters by,
   and the New button, over a grid of cards. Picking a card opens the editor at its own route. *@

<div class="lib-page">
  <div class="lib-strip">
    <label class="lib-search">
      <i data-lucide="search" @key="@("lib-search")"></i>
      <input class="lib-search-input" type="search" placeholder="@($"Search {Kind.Title.ToLowerInvariant()} by name…")"
             value="@search" @oninput="OnSearch" />
    </label>
    @Filters
    <span class="lib-strip-gap"></span>
    <span class="lib-count">@Shown.Count of @Rows.Count</span>
    <Button Variant="primary" Icon="plus" Href="@($"/library/{Kind.Slug}/new")" Writes>New @Kind.One</Button>
  </div>

  <div class="lib-scroll">
    <PageHeading Title="@Kind.Title"><Lead>@Kind.Blurb</Lead></PageHeading>
    @if (Loading) { <p class="lib-status">Loading…</p> }
    else
    {
      <div class="lib-grid @(Wide ? "lib-grid--wide" : null)">
        @foreach (var row in Shown)
        {
          <PictureCard @key="row.Id" Svg="@row.Preview" Name="@row.Name" Href="@($"/library/{Kind.Slug}/{row.Id}")"
                       Title="@($"Open {row.Name}")">
            @if (Badge is not null)
            {
              <div class="lib-card-badges"><span class="lib-badge">@Badge(row)</span></div>
            }
          </PictureCard>
        }
      </div>

      @if (Shown.Count == 0)
      {
        <p class="lib-status">
          @if (Rows.Count == 0)
          {
            @($"No {Kind.Title.ToLowerInvariant()} yet. Create one with New {Kind.One}.")
          }
          else
          {
            @($"No matches.")
          }
        </p>
      }
    }
  </div>
</div>
