@namespace PgmStudio.Client.Features.Library
@using PgmStudio.Client.Components
@using PgmStudio.Contracts
@using PgmStudio.Vocabulary

@* One editor for the two clicked kinds. A tree and a boulder are placed by a click, so what is placed is a
   position and what stands there is a recipe — and a recipe is browsed and authored here rather than carried
   on every placement. The two share a frame and differ only in their fields, the way the three house parts do. *@

<LibraryEditor Kind="Kind" Name="@draftName" NameChanged="SetName" Nests="false"
               Outline="Outline" Selected="@selected" OnSelect="Choose" Note="@note">
  <Preview>
    @if (card is not null)
    {
      <figure class="theme-section-figure">@((MarkupString)card)</figure>
    }
  </Preview>
  <Fields>
    @if (tree is not null)
    {
      <Field Label="Kind">
        <Select Options="@Select.Words(TreeForms.All, TreeForms.Name, TreeForms.Describe)" Value="@tree.Form"
                ValueChanged="SetTreeForm" />
      </Field>

      @if (TreeForms.Canonical(tree.Form) == TreeForms.Template)
      {
        <Field Label="Species">
          <Select Options="@(Select.Words(TreeSpeciesNames.All, name => char.ToUpperInvariant(name[0]) + name[1..]))" Value="@tree.Species"
                  ValueChanged="v => Tree(t => t with { Species = v })" />
        </Field>
      }

      @if (TreeForms.Canonical(tree.Form) == TreeForms.Copied)
      {
        @if (tree.Body is { Length: > 0 })
        {
          <Readout>Holds @tree.Body.Length blocks and stands @tree.Height.ToString("0") blocks tall. Copy it from the world again to change it.</Readout>
        }
        else
        {
          <EmptyState>No blocks yet. A copied tree is cut from a world by the library's seed tool.</EmptyState>
        }
        <Field Label="Source" Note="@(tree.Cut is null ? "None is recorded, so it can't be saved as a copied tree." : null)">
          @if (tree.Cut is { } cut)
          {
            <Readout>Copied from @cut.World at @cut.X, @cut.Y, @cut.Z on @cut.At.ToString("yyyy-MM-dd").</Readout>
            @if (cut.Builder is { Length: > 0 } builder)
            {
              <Readout>Built by @builder, credited as a contributor on maps that use it.</Readout>
            }
          }
        </Field>
      }
      else
      {
        <Field Label="Height"><LabelEnd><strong>@($"{tree.Height:0} blocks")</strong></LabelEnd>
          <ChildContent><RangeField Min="5" Max="40" Value="@((int)tree.Height)"
                 ValueChanged="value => Tree(t => t with { Height = value })" /></ChildContent></Field>
      }
    }
    else if (boulder is not null)
    {
      <Field Label="Shape">
        <Select Options="@Select.Words(BoulderForms.All, BoulderForms.Name, BoulderForms.Describe)" Value="@boulder.Form"
                ValueChanged="v => Boulder(b => b with { Form = v })" />
      </Field>
      <Field Label="Size"><LabelEnd><strong>@($"{boulder.Size:0.0} blocks")</strong></LabelEnd>
        <ChildContent><RangeField Min="20" Max="100" Value="@((int)(boulder.Size * 10))"
               ValueChanged="value => Boulder(b => b with { Size = value / 10 })" /></ChildContent></Field>
      <Field Label="Moss" Note="@(boulder.Mossy ? "Moss grows on the faces open to the sky." : null)">
        <div class="chip-row">
          <Chip Active="@(!boulder.Mossy)" OnClick="() => Boulder(b => b with { Mossy = false })">Bare</Chip>
          <Chip Active="boulder.Mossy" OnClick="() => Boulder(b => b with { Mossy = true })">Mossy</Chip>
        </div>
      </Field>
      <Section Title="Material" Term="material">
        <MaterialEditor Blocks="blocks" Styles="styles" Node="rock" OnChanged="RockChanged" />
      </Section>
    }
  </Fields>
  <Actions>
    @if (!seeded)
    {
      <Button Variant="primary" Icon="save" Disabled="@(string.IsNullOrWhiteSpace(draftName))" Writes OnClick="Save">
        @(editingId is null ? "Add to library" : "Save changes")
      </Button>
    }
    @if (editingId is not null)
    {
      <Button Icon="copy" Writes OnClick="SaveAsCopy">Save as copy</Button>
      @if (!seeded) { <Button Variant="danger" Icon="trash-2" Deletes OnClick="Delete">Delete</Button> }
    }
  </Actions>
</LibraryEditor>
