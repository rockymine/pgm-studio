@namespace PgmStudio.Client.Features.Library
@inject TerrainLibraryClient Library
@inject NavigationManager Nav

@* One house part — a roof, a storey or a porch — on a page of its own. One editor for the three because they
   are the same act: pick a form, bind styles to that kind's pieces, turn that kind's knobs. What differs is
   PartKindInfo, which is data. The picture stands the part on a plain sample building, so what changes
   between two of them is the part and never the house around it. *@

<LibraryEditor Kind="Part.Kind" Name="@draftName" NameChanged="SetName"
               Outline="Outline" Selected="@selected" OnSelect="Pick"
               Footnote="@Part.FigureNote" Note="@note">
  <Views>
    @foreach (var (id, label, icon, note) in HouseViews.Offered)
    {
      <LayerChip Icon="@icon" Active="@(id == view)" @key="id" Title="@note"
                 OnClick="() => SetView(id)">@label</LayerChip>
    }
  </Views>
  <Dock>
    @* A style states nothing about the rectangle it is stamped over, and a ridge follows that rectangle, so
       the proportion the sample is judged at is asked here rather than set on the style. *@
    @foreach (var (id, width, depth) in HouseFootprints.All)
    {
      <DockChoice Active="@(id == footprint)" @key="id"
                  Title="@($"Preview on a {width} × {depth} building")"
                  OnClick="() => SetFootprint(id)">@width × @depth</DockChoice>
    }
  </Dock>
  <Preview>
    <HouseViews Preview="preview" View="@view" />
  </Preview>
  <Fields>
    @if (selected == KnobsPart)
    {
      @if (roof is not null)
      {
          <Field Label="Form">
            <Select Options="@Select.Words(RoofForms.Offered, RoofForms.Describe)"
                    Value="@roof.Form" ValueChanged="SetForm" />
          </Field>
          @if (Sloped)
          {
            <Field Label="Pitch">
              <NumberField Slim Min="1" Max="4" Value="roof.Pitch" ValueChanged="SetPitch"
                           title="Blocks of rise per block inward. 1 is 45°." />
            </Field>
          }
          <Field Label="Overhang">
            <NumberField Slim Min="0" Max="4" Value="roof.Overhang" ValueChanged="SetOverhang"
                         title="How far the roof reaches past the walls, in blocks. 0 ends it flush." />
          </Field>
          @if (Sloped)
          {
            <Field Label="Ridge">
              <Chip Active="roof.RidgeCap" OnClick="ToggleRidgeCap">
                @(roof.RidgeCap ? "Verge material" : "Roof material")
              </Chip>
            </Field>
            @* A slab halves the rise per block travelled inward, so a roof laid in slabs stands half as tall
               at the same pitch and the body fills the cubes between. *@
            <Field Label="Steps in">
              <div class="chip-row">
                <Chip Active="@(!Slabbed && !Staired)" OnClick="StepInBlocks">Whole blocks</Chip>
                <Chip Active="@Staired" OnClick="StepInStairs">Stairs</Chip>
                <Chip Active="@Slabbed" OnClick="StepInSlabs">Slabs</Chip>
              </div>
            </Field>
            @if (Slabbed)
            {
              <Field Label="Slab">
                <BlockPicker Blocks="blocks" Id="roof.RoofSlab" Data="roof.RoofSlabData"
                             OnPick="PickRoofSlab" />
              </Field>
              <p class="section-desc">Use a slab of the same material as the roof body. A slab that does
                not match can't be saved.</p>
            }
            @if (Staired)
            {
              <Field Label="Stair">
                <BlockPicker Blocks="blocks" Id="roof.RoofStair" Data="0" OnPick="PickRoofStair" />
              </Field>
              <p class="section-desc">Use a stair of the same material as the roof body. Along the sloped
                edges it is placed upside down, so the edge has some depth.</p>
            }
            <Field Label="Wear"><LabelEnd><strong>@($"{roof.RoofWear * 100:0}%")</strong></LabelEnd>
              <ChildContent><RangeField Min="0" Max="100" Value="@((int)(roof.RoofWear * 100))"
                     OnCommit="SetRoofWear" /></ChildContent></Field>
          }
          else
          {
            <Field Label="Hole">
              <Chip Active="roof.RoofHole" OnClick="ToggleHole">
                @(roof.RoofHole ? "Open in the middle" : "Closed (the room is unlit)")
              </Chip>
            </Field>
          }
      }
      @if (storey is not null)
      {
      <p class="section-desc">Clear height is the open space a player stands in, not counting walls or
          floors.</p>
          <Field Label="Clear height">
            <NumberField Slim Min="3" Max="16" Value="storey.Clear" ValueChanged="SetClear"
                         title="Blocks of air between this floor and whatever is above it. At least 3." />
          </Field>
          <Field Label="@(Bound(RoomParts.Border) ? "Border width" : "Border width (no border set)")">
            <NumberField Slim Min="1" Max="4" Value="storey.BorderWidth" ValueChanged="SetBorderWidth"
                         disabled="@(!Bound(RoomParts.Border))"
                         title="@(Bound(RoomParts.Border)
                                  ? "How many blocks the border ring reaches in from the walls."
                                  : "Set a pattern for Border to use this.")" />
          </Field>
          <Field Label="@(Bound(RoomParts.Inlay) ? "Inlay inset" : "Inlay inset (no inlay set)")">
            <NumberField Slim Min="1" Max="8" Value="storey.InlayInset" ValueChanged="SetInlayInset"
                         disabled="@(!Bound(RoomParts.Inlay))"
                         title="@(Bound(RoomParts.Inlay)
                                  ? "How far from the walls the inlay starts."
                                  : "Set a pattern for Inlay to use this.")" />
          </Field>
      }
      @if (porch is not null)
      {
      <p class="section-desc">A porch takes space from the footprint rather than adding to it. The walls
          step back from one side, leaving a deck with posts, a rail, and a roof.</p>
          <Field Label="Blocks deep">
            <NumberField Slim Min="1" Max="8" Value="porch.Depth" ValueChanged="SetPorchDepth"
                         title="How far the walls step back. The room keeps at least 3 blocks." />
          </Field>
          <Field Label="Inset">
            <NumberField Slim Min="0" Max="8" Value="porch.Inset" ValueChanged="SetPorchInset"
                         title="How far the deck stops short of each end of that wall. 0 runs it the full width." />
          </Field>
          <Field Label="Wall">
            <Select Options="@Select.Words(PorchEdges.All, PorchEdges.Describe)"
                    Value="@porch.Edge" ValueChanged="SetPorchEdge" />
          </Field>
          <Field Label="Canopy">
            <Select Options="@Select.Words(RoofForms.Offered, RoofForms.Describe)"
                    Value="@porch.Roof" ValueChanged="SetPorchRoof" />
          </Field>
          <Field Label="Rail">
            <Chip Active="@(porch.RailBlock > 0)" OnClick="ToggleRail">
              @(porch.RailBlock > 0 ? "Along the open edges" : "None")
            </Chip>
          </Field>
          @if (porch.RailBlock > 0)
          {
            <Field Label="Rail material">
              <BlockPicker Blocks="blocks" Id="porch.RailBlock" Data="0" ShowColors="false"
                           OnPick="PickRailBlock" />
            </Field>
          }
      }
    }
    else if (selected == WindowsPart && storey is not null)
    {
      <WindowFields Window="storey.Windows" WindowChanged="SetWindows" Blocks="blocks"
                    SillTitle="How many courses above this storey's floor the window starts." />
    }
    else if (Stacked is { } stacked)
    {
      <p class="section-desc">@stacked.Blurb</p>
      @foreach (var course in Courses(stacked.Id))
      {
        <div @key="@($"{stacked.Id}-{course.Ordinal}")">
          <StyleSelect Styles="styles" Value="@course.StyleId" Unbound="None"
                       ValueChanged="id => BindCourse(stacked.Id, course.Ordinal, id)">
            <Trailing>
              <NumberField Slim Min="1" Value="course.Height" ValueChanged="value => SetCourseHeight(stacked.Id, course.Ordinal, value)"
                           title="Height in courses" />
              <Button Variant="icon" Icon="trash-2" Title="Remove this course"
                      OnClick="() => RemoveCourse(stacked.Id, course.Ordinal)" />
            </Trailing>
          </StyleSelect>
        </div>
      }
      @if (Courses(stacked.Id).Count == 0)
      {
        <p class="section-desc">No pattern set. The default finish is used.</p>
      }
      <div class="panel-actions">
        <Button Icon="plus" Disabled="@(styles.Count == 0)" OnClick="() => AddCourse(stacked.Id)">Add a course</Button>
      </div>
    }
    else if (SingleBound is { } single)
    {
      @* One material read straight through, so binding it is a single choice rather than a stack: a post is a
         post all the way up, and a ceiling is one slab. *@
      <p class="section-desc">@single.Blurb</p>
      <Field Label="Made of">
        <StyleSelect Styles="styles" Value="@Single(single.Id)" Title="@single.Blurb"
                     ValueChanged="id => BindSingle(single.Id, id)" />
      </Field>
    }
  </Fields>
  <Actions>
    <Button Variant="primary" Icon="save" Disabled="@(string.IsNullOrWhiteSpace(draftName))" Writes OnClick="Save">
      @(editingId is null ? "Add to library" : "Save changes")
    </Button>
    @if (editingId is not null)
    {
      <Button Variant="danger" Icon="trash-2" Deletes OnClick="Delete">Delete</Button>
    }
  </Actions>
</LibraryEditor>
