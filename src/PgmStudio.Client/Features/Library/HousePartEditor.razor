@namespace PgmStudio.Client.Features.Library
@inject TerrainLibraryClient Library
@inject NavigationManager Nav

@* One house part — a roof, a storey or a porch — on a page of its own. One editor for the three because they
   are the same act: pick a form, bind styles to that kind's pieces, turn that kind's knobs. What differs is
   PartKindInfo, which is data. The picture stands the part on a plain sample building, so what changes
   between two of them is the part and never the house around it. *@

<LibraryEditor Kind="Part.Kind" Name="@draftName" NameChanged="SetName"
               Outline="Outline" Selected="@selected" OnSelect="Pick"
               Footnote="@Part.FigureNote" Note="@note">
  <Views>
    @foreach (var (id, label, icon, note) in HouseViews.Offered)
    {
      <LayerChip Icon="@icon" Active="@(id == view)" @key="id" Title="@note"
                 OnClick="() => SetView(id)">@label</LayerChip>
    }
  </Views>
  <Dock>
    @* A style states nothing about the rectangle it is stamped over, and a ridge follows that rectangle, so
       the proportion the sample is judged at is asked here rather than set on the style. *@
    @foreach (var (id, width, depth) in HouseFootprints.All)
    {
      <DockChoice Active="@(id == footprint)" @key="id"
                  Title="@($"Draw the sample on a {width} × {depth} shell")"
                  OnClick="() => SetFootprint(id)">@width × @depth</DockChoice>
    }
  </Dock>
  <Preview>
    <HouseViews Preview="preview" View="@view" />
  </Preview>
  <Fields>
    @if (selected == KnobsPart)
    {
      @if (roof is not null)
      {
      <p class="section-desc">Every form is a height field over the same plan, which is why one stamper builds all six. The
          pitch and the ridge cap only mean anything on a sloped roof and the hole only on a flat lid, so
          each is offered under the form rather than as a knob of its own.</p>
          <Field Label="Form">
            <Select Options="@Select.Words(RoofForms.All, RoofForms.Describe)"
                    Value="@roof.Form" ValueChanged="SetForm" />
          </Field>
          @if (Sloped)
          {
            <Field Label="Pitch">
              <input class="field-input field-input--slim" type="number" min="1" max="4" step="1"
                     title="Courses of rise per block travelled inward. 1 is 45°."
                     value="@roof.Pitch" @onchange="SetPitch" />
            </Field>
          }
          <Field Label="Overhang">
            <input class="field-input field-input--slim" type="number" min="0" max="4" step="1"
                   title="How far the roof reaches past the walls, in blocks. 0 ends it flush."
                   value="@roof.Overhang" @onchange="SetOverhang" />
          </Field>
          @if (Sloped)
          {
            <Field Label="Ridge">
              <Chip Active="roof.RidgeCap" OnClick="ToggleRidgeCap">
                @(roof.RidgeCap ? "Capped in the verge" : "The roof's own material")
              </Chip>
            </Field>
            @* A slab halves the rise per block travelled inward, so a roof laid in slabs stands half as tall
               at the same pitch and the body fills the cubes between. *@
            <Field Label="Steps in">
              <Chip Active="@Slabbed" OnClick="ToggleRoofSlab">
                @(Slabbed ? "Half courses — slabs" : "Whole blocks")
              </Chip>
            </Field>
            @if (Slabbed)
            {
              <Field Label="The slab">
                <BlockPicker Blocks="blocks" Id="roof.RoofSlab" Data="roof.RoofSlabData"
                             OnPick="PickRoofSlab" />
              </Field>
              <p class="section-desc">A single slab, in the material the roof body is laid in —
                <code>HS3</code> refuses a pair that do not continue each other.</p>
            }
          }
          else
          {
            <Field Label="Hole">
              <Chip Active="roof.RoofHole" OnClick="ToggleHole">
                @(roof.RoofHole ? "Open in the middle" : "Sealed — an unlit room")
              </Chip>
            </Field>
          }
      }
      @if (storey is not null)
      {
      <p class="section-desc">A storey is measured by the air a player stands in, not by the masonry around it: that is the
          number being decided and the only one with a floor under it. The courses follow — one more than
          the clear where another storey stands over this one, for the slab between them.</p>
          <Field Label="Clear height">
            <input class="field-input field-input--slim" type="number" min="3" max="16" step="1"
                   title="Blocks of air between this floor and the next thing over it. Never below three — a room has to be stood up in."
                   value="@storey.Clear" @onchange="SetClear" />
          </Field>
          <Field Label="@(Bound(RoomParts.Border) ? "Border width" : "Border width — no border bound")">
            <input class="field-input field-input--slim" type="number" min="1" max="4" step="1"
                   disabled="@(!Bound(RoomParts.Border))"
                   title="@(Bound(RoomParts.Border)
                            ? "How many blocks in from the walls the border ring runs."
                            : "Bind a style to Border above and this decides how wide that ring runs.")"
                   value="@storey.BorderWidth" @onchange="SetBorderWidth" />
          </Field>
          <Field Label="@(Bound(RoomParts.Inlay) ? "Inlay inset" : "Inlay inset — no inlay bound")">
            <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                   disabled="@(!Bound(RoomParts.Inlay))"
                   title="@(Bound(RoomParts.Inlay)
                            ? "How far in from the walls the centred plate starts."
                            : "Bind a style to Inlay above and this decides where that plate starts.")"
                   value="@storey.InlayInset" @onchange="SetInlayInset" />
          </Field>
      }
      @if (porch is not null)
      {
      <p class="section-desc">A porch is taken <strong>out of</strong> the footprint, never added to it — the footprint
          comes from the piece and a style may not change it. The walls stand back from one side, and the
          strip they gave up is a deck with posts, a rail and its own roof over it.</p>
          <Field Label="Blocks deep">
            <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                   title="How deep a strip the walls give up. The room keeps at least three blocks."
                   value="@porch.Depth" @onchange="SetPorchDepth" />
          </Field>
          <Field Label="Pulled in by">
            <input class="field-input field-input--slim" type="number" min="0" max="8" step="1"
                   title="How far the deck stops short of each end of that wall. 0 runs it the full width."
                   value="@porch.Inset" @onchange="SetPorchInset" />
          </Field>
          <Field Label="Off which wall">
            <Select Options="@Select.Words(PorchEdges.All, PorchEdges.Describe)"
                    Value="@porch.Edge" ValueChanged="SetPorchEdge" />
          </Field>
          <Field Label="Canopy">
            <Select Options="@Select.Words(RoofForms.All, RoofForms.Describe)"
                    Value="@porch.Roof" ValueChanged="SetPorchRoof" />
          </Field>
          <Field Label="Rail">
            <Chip Active="@(porch.RailBlock > 0)" OnClick="ToggleRail">
              @(porch.RailBlock > 0 ? "Along the open edges" : "None — step off anywhere")
            </Chip>
          </Field>
          @if (porch.RailBlock > 0)
          {
            <Field Label="Rail made of">
              <BlockPicker Blocks="blocks" Id="porch.RailBlock" Data="0" ShowColors="false"
                           OnPick="PickRailBlock" />
            </Field>
          }
      }
    }
    else if (selected == WindowsPart && storey is not null)
    {
      <WindowFields Window="storey.Windows" WindowChanged="SetWindows" Blocks="blocks"
                    SillTitle="The course above this storey's own floor the opening starts at." />
    }
    else if (Stacked is { } stacked)
    {
      <p class="section-desc">@stacked.Blurb</p>
      @foreach (var course in Courses(stacked.Id))
      {
        <div @key="@($"{stacked.Id}-{course.Ordinal}")">
          <StyleSelect Styles="styles" Value="@course.StyleId" Unbound="Unbound"
                       ValueChanged="id => BindCourse(stacked.Id, course.Ordinal, id)">
            <Trailing>
              <input class="field-input field-input--slim" type="number" min="1" step="1"
                     title="How many courses this one runs"
                     value="@course.Height" @onchange="e => SetCourseHeight(stacked.Id, course.Ordinal, e)" />
              <Button Variant="icon" Icon="trash-2" Title="Remove this course"
                      OnClick="() => RemoveCourse(stacked.Id, course.Ordinal)" />
            </Trailing>
          </StyleSelect>
        </div>
      }
      @if (Courses(stacked.Id).Count == 0)
      {
        <p class="section-desc">Unbound — keeps the built-in finish.</p>
      }
      <div class="panel-actions">
        <Button Icon="plus" Disabled="@(styles.Count == 0)" OnClick="() => AddCourse(stacked.Id)">Add a course</Button>
      </div>
    }
    else if (SingleBound is { } single)
    {
      @* One material read straight through, so binding it is a single choice rather than a stack: a post is a
         post all the way up, and a ceiling is one slab. *@
      <p class="section-desc">@single.Blurb</p>
      <Field Label="Made of">
        <StyleSelect Styles="styles" Value="@Single(single.Id)" Title="@single.Blurb"
                     ValueChanged="id => BindSingle(single.Id, id)" />
      </Field>
    }
  </Fields>
  <Actions>
    <Button Variant="primary" Icon="save" Disabled="@(string.IsNullOrWhiteSpace(draftName))" OnClick="Save">
      @(editingId is null ? "Add to library" : "Save changes")
    </Button>
    @if (editingId is not null)
    {
      <Button Variant="danger" Icon="trash-2" OnClick="Delete">Delete</Button>
    }
  </Actions>
</LibraryEditor>
