@namespace PgmStudio.Client.Features.Library
@inject TerrainLibraryClient Library
@inject IJSRuntime JS

@* What /library opens on: every library as a card, grouped by what it dresses, each showing what it holds. *@

<ContentColumn MaxWidth="1200">
  <header class="lib-hero">
    <h1 class="lib-hero-title">Libraries</h1>
    <p class="lib-hero-lead">Make materials, terrain finishes, buildings, and props once, and use them on
      every map.</p>
  </header>

  @foreach (var (group, slugs) in Groups)
  {
    <section class="lib-group" @key="group">
      <h2 class="lib-group-title">@group</h2>
      <div class="lib-choices">
        @foreach (var kind in LibraryKinds.All.Where(k => slugs.Contains(k.Slug)))
        {
          <a class="lib-choice" href="@($"/library/{kind.Slug}")" @key="kind.Slug">
            <div class="lib-choice-fig">
              @if (Samples(kind) is { Count: > 0 } pictures)
              {
                @foreach (var picture in pictures)
                {
                  <span class="lib-choice-pic">@((MarkupString)picture)</span>
                }
              }
              else
              {
                <span class="lib-choice-empty">@(loading ? "Loading…" : $"No {kind.Title.ToLowerInvariant()} yet")</span>
              }
            </div>
            <div class="lib-choice-body">
              <div class="lib-choice-head">
                <span class="lib-choice-icon"><i data-lucide="@kind.Icon" @key="kind.Icon"></i></span>
                <span class="lib-choice-title">@kind.Title</span>
                <span class="lib-choice-count">@CountLabel(kind)</span>
              </div>
              <p class="lib-choice-desc">@kind.Blurb</p>
            </div>
          </a>
        }
      </div>
    </section>
  }
</ContentColumn>
