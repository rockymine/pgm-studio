@namespace PgmStudio.Client.Features.Library
@inject TerrainLibraryClient Library
@inject NavigationManager Nav

@* One material, on a page of its own. A material nests — a band, a layer and a stop are each themselves a
   material — so the nest is the outline and the inspector edits whichever node it has picked. *@

<LibraryEditor Kind="LibraryKinds.Styles" Name="@draftName" NameChanged="SetName"
               Outline="Outline" Selected="@selected" OnSelect="Pick"
               Footnote="@Footnote" Note="@note">
  <Preview>
    @if (preview is null) { <p class="lib-status">Nothing to draw yet.</p> }
    else
    {
      <figure class="lib-fig">@((MarkupString)preview.Plan)</figure>
      <figure class="lib-fig lib-fig--section">@((MarkupString)preview.Section)</figure>
    }
  </Preview>
  <Fields>
    @if (Picked is { } node)
    {
      <MaterialEditor Flat Node="node" Blocks="blocks" Styles="Fillable" OnChanged="DraftEdited" @key="selected" />
    }
    else
    {
      <p class="section-desc">This part no longer exists. Pick another row.</p>
    }
  </Fields>
  <Actions>
    @if (!seeded)
    {
      <Button Variant="primary" Icon="save" Disabled="@(!CanSave)" Writes OnClick="Save">
        @(editingId is null ? "Add to library" : "Save changes")
      </Button>
    }
    @if (editingId is not null)
    {
      <Button Icon="copy" Writes OnClick="SaveAsCopy">Save as copy</Button>
      @if (!seeded) { <Button Variant="danger" Icon="trash-2" Deletes OnClick="Delete">Delete</Button> }
    }
  </Actions>
</LibraryEditor>
