@namespace PgmStudio.Client.Features.Library
@using PgmStudio.Client.Components
@using PgmStudio.Contracts
@using PgmStudio.Vocabulary

@* One named biome field. It places no block — it is the byte a client reads to tint grass, leaves and water —
   so there is no geometry to draw and the whole of it is its numbers plus a patch of ground showing what they
   do. A map takes a copy of the row it picks, the way it does with a palette. *@

<LibraryEditor Kind="Kind" Name="@draftName" NameChanged="SetName" Nests="false"
               Outline="Outline" Selected="@FieldPart" OnSelect="_ => Task.CompletedTask"
               Note="@note">
  <Preview>
    @if (card is not null)
    {
      <figure class="theme-section-figure">@((MarkupString)card)</figure>
    }
  </Preview>
  <Fields>
    <Field Label="Kind">
      <Select Options="@Select.Words(BiomeKinds.All, BiomeKinds.Name, BiomeKinds.Describe)" Value="@Kinds"
              ValueChanged="SetKind" />
    </Field>

    @if (Kinds == BiomeKinds.Solid)
    {
      <Field Label="Biome" Term="biome">
        <div class="filter-group-options">
          @foreach (var offered in biomes)
          {
            <Chip Active="@(SolidId == offered.Id)" @key="offered.Id" OnClick="() => SetSolid(offered.Id)">
              <span class="biome-swatch" style="--swatch: @offered.Hex"></span> @offered.Name
            </Chip>
          }
        </div>
      </Field>
    }
    else
    {
      <SeedField Value="@((int)Number(SeedField))" ValueChanged="seed => SetNumber(SeedField, seed)" />

      @if (Kinds == BiomeKinds.Cell)
      {
        <Field Label="Patch size" Unit="blocks">
          <NumberField Value="Number(CellSizeField)" ValueChanged="v => SetNumber(CellSizeField, (int)v)" Min="1" />
        </Field>
        <Field Label="Jitter" Unit="%" Note="At 0 the patches lie on a grid, and at 100 they are fully irregular.">
          <NumberField Value="Number(JitterField)" ValueChanged="v => SetNumber(JitterField, (int)v)" Min="0" Max="100" />
        </Field>
      }
      else
      {
        <Field Label="Scale" Unit="blocks">
          <NumberField Value="Number(ScaleField)" ValueChanged="v => SetNumber(ScaleField, (int)v)" Min="1" />
        </Field>
        <Field Label="Octaves" Help="Each octave lays a finer layer of detail over the last.">
          <NumberField Value="Number(OctavesField)" ValueChanged="v => SetNumber(OctavesField, (int)v)" Min="1" Max="6" />
        </Field>
      }

      <Section Title="Biomes" Term="biome">
      @for (var at = 0; at < Picked.Count; at++)
      {
        var slot = at;
        <Field Label="@($"Biome {slot + 1}")">
          <div class="panel-actions">
            <Select Options="BiomeOptions" Value="@Picked[slot].ToString()"
                    ValueChanged="value => SetAt(slot, int.TryParse(value, out var id) ? id : First)" />
            <span class="biome-swatch" style="--swatch: @Hex(Picked[slot])"></span>
            <Button Variant="icon" Icon="trash-2" Title="Delete this biome" Disabled="@(Picked.Count <= 1)"
                    OnClick="() => DropAt(slot)" />
          </div>
        </Field>
      }
      <Button Icon="plus" OnClick="() => SetAt(-1, First)">Add a biome</Button>
      </Section>
    }
  </Fields>
  <Actions>
    @if (!seeded)
    {
      <Button Variant="primary" Icon="save" Writes OnClick="Save" Disabled="@string.IsNullOrWhiteSpace(draftName)">
        @(editingId is null ? "Add to library" : "Save changes")
      </Button>
    }
    @if (editingId is not null)
    {
      <Button Icon="copy" Writes OnClick="SaveAsCopy">Save as copy</Button>
      @if (!seeded) { <Button Variant="danger" Icon="trash-2" Deletes OnClick="Delete">Delete</Button> }
    }
  </Actions>
</LibraryEditor>
