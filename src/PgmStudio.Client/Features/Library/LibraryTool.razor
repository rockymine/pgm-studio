@page "/library"
@page "/library/{Kind}"
@page "/library/{Kind}/{Entry}"
@layout StudioLayout

@* The library: where a material is authored once and reused. Six kinds on the rail, in the order they
   compose; /library chooses between them, /library/{kind} browses one, and /library/{kind}/{id} — or
   /new — edits an entry on a page of its own. The host owns only the shell and which route is showing. *@

<PageTitle>@PageName — PGM Studio</PageTitle>

<StudioShell>
  <Bar>
    <Topbar HomeHref="/" HomeLabel="Studio" HomeTitle="Studio home">
      <Crumbs>
        @if (Open is null)
        {
          <Crumb Dim>Library</Crumb>
        }
        else
        {
          <Crumb Href="/library" Dim>Library</Crumb>
          @if (Entry is null)
          {
            <Crumb>@Open.Title</Crumb>
          }
          else
          {
            <Crumb Href="@($"/library/{Open.Slug}")" Dim>@Open.Title</Crumb>
            <Crumb>@EntryName</Crumb>
          }
        }
      </Crumbs>
      <Right>
        @if (saveState is not null) { <span class="topbar-save-status">@saveState</span> }
      </Right>
    </Topbar>
  </Bar>
  <Rail>
    <NavRail LogoHref="/" LogoTitle="Studio home">
      <NavButton Icon="library" Title="Every library" Href="/library" Active="@(Open is null)" />
      <div class="nav-rail-div"></div>
      @foreach (var kind in LibraryKinds.All)
      {
        <NavButton Icon="@kind.Icon" Title="@kind.Title" Href="@($"/library/{kind.Slug}")"
                   Active="@(Open?.Slug == kind.Slug)" @key="kind.Slug" />
      }
    </NavRail>
  </Rail>
  <ChildContent>
    @if (Open is null)
    {
      <LibraryChooser />
    }
    else if (Entry is null)
    {
      <LibraryBrowseHost Kind="Open" />
    }
    else if (Open.Slug == LibraryKinds.StylesSlug)
    {
      <StyleEditor Entry="@Entry" OnSaved="OnSaved" OnName="OnEntryName" />
    }
    else if (Open.Slug == LibraryKinds.ThemesSlug)
    {
      <ThemeEditor Entry="@Entry" OnSaved="OnSaved" OnName="OnEntryName" />
    }
    else if (Open.Slug == LibraryKinds.HousesSlug)
    {
      <HouseEditor Entry="@Entry" OnSaved="OnSaved" OnName="OnEntryName" />
    }
    else if (Open.Slug is LibraryKinds.TreesSlug or LibraryKinds.BouldersSlug)
    {
      <PropRecipeEditor Kind="Open" Entry="@Entry" OnSaved="OnSaved" OnName="OnEntryName" />
    }
    else
    {
      <HousePartEditor Part="PartKindInfo.Of(Open.Slug)" Entry="@Entry" OnSaved="OnSaved" OnName="OnEntryName" />
    }
  </ChildContent>
</StudioShell>
