@page "/library"
@page "/library/{Tab}"
@layout StudioLayout

@* The style & theme library (B44): where terrain paint is authored once and reused. Two halves, because the
   two things a theme decomposes into are browsed differently — styles by what they look like and what kind
   they are, themes by the finish they compose to. The host owns only the shell and which half is showing. *@

<PageTitle>Style library — PGM Studio</PageTitle>

<StudioShell Bare="true">
  <Bar>
    <Topbar HomeHref="/" HomeLabel="Studio" HomeTitle="Studio home">
      <Crumbs>
        <Crumb Dim>Style library</Crumb>
        <Crumb>@(OnThemes ? "Themes" : "Styles")</Crumb>
      </Crumbs>
      <Right>
        <Button Href="@($"/library/{StylesTab}")" Variant="@(OnThemes ? null : "primary")"
                Icon="paintbrush" Title="Every reusable material recipe">Styles</Button>
        <Button Href="@($"/library/{ThemesTab}")" Variant="@(OnThemes ? "primary" : null)"
                Icon="layers" Title="Styles composed into whole finishes">Themes</Button>
      </Right>
    </Topbar>
  </Bar>
  <ChildContent>
    @if (OnThemes) { <ThemeComposer /> }
    else { <StyleBrowser /> }
  </ChildContent>
</StudioShell>
