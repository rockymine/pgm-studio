@page "/library"
@page "/library/{Tab}"
@layout StudioLayout

@* The style library (B44, G34b, B71): where materials are authored once and reused. Four halves, in the order
   they compose — a style is one material, a theme is a terrain finish made of styles, a house part is a roof, a
   storey or a porch made of styles, and a room is a building made of parts. A style is browsed by what it looks
   like; everything above it by what it composes to. The host owns only the shell and which one is showing. *@

<PageTitle>Style library — PGM Studio</PageTitle>

<StudioShell Bare="true">
  <Bar>
    <Topbar HomeHref="/" HomeLabel="Studio" HomeTitle="Studio home">
      <Crumbs>
        <Crumb Dim>Style library</Crumb>
        <Crumb>@TabName</Crumb>
      </Crumbs>
      <Right>
        <Button Href="@($"/library/{StylesTab}")" Variant="@(On(StylesTab) ? "primary" : null)"
                Icon="paintbrush" Title="Every reusable material recipe">Styles</Button>
        <Button Href="@($"/library/{ThemesTab}")" Variant="@(On(ThemesTab) ? "primary" : null)"
                Icon="layers" Title="Styles composed into whole terrain finishes">Themes</Button>
        <Button Href="@($"/library/{PartsTab}")" Variant="@(On(PartsTab) ? "primary" : null)"
                Icon="blocks" Title="Roofs, storeys and porches a house is composed from">Parts</Button>
        <Button Href="@($"/library/{RoomsTab}")" Variant="@(On(RoomsTab) ? "primary" : null)"
                Icon="box" Title="Parts and styles composed into whole buildings">Rooms</Button>
      </Right>
    </Topbar>
  </Bar>
  <ChildContent>
    @if (On(ThemesTab)) { <ThemeComposer /> }
    else if (On(PartsTab)) { <HousePartComposer /> }
    else if (On(RoomsTab)) { <RoomStyleComposer /> }
    else { <StyleBrowser /> }
  </ChildContent>
</StudioShell>
