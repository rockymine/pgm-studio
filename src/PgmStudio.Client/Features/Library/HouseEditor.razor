@namespace PgmStudio.Client.Features.Library
@inject TerrainLibraryClient Library
@inject NavigationManager Nav

@* One whole building, on a page of its own. A house is a stack of storeys under a roof, with a porch, a
   doorway and the foundation it stands on; the outline is those pieces and the inspector holds the one the
   outline has picked. The picture is the sample shell four ways, so a porch and a window read where a section
   alone would draw them as a patch of the wall they are cut into. *@

<LibraryEditor Kind="LibraryKinds.Houses" Name="@draftName" NameChanged="SetName"
               Outline="Outline" Selected="@selected" OnSelect="Pick"
               Footnote="@Footnote" Note="@note">
  <Views>
    @foreach (var (id, label, icon, note) in HouseViews.Offered)
    {
      <OverlayChip Icon="@icon" Active="@(id == view)" @key="id" Title="@note"
                 OnClick="() => SetView(id)">@label</OverlayChip>
    }
  </Views>
  <Dock>
    @* A style states nothing about the rectangle it is stamped over, and a ridge follows that rectangle, so
       the proportion the sample is judged at is asked here rather than set on the style. *@
    @foreach (var (id, width, depth) in HouseFootprints.All)
    {
      <DockChoice Active="@(id == footprint)" @key="id"
                  OnClick="() => SetFootprint(id)">@width × @depth</DockChoice>
    }
  </Dock>
  <Preview>
    <HouseViews Preview="preview" View="@view" />
  </Preview>
  <Fields>
    @* No draft, no fields — a refused read nulls the draft and words the refusal into `note`, which the
       header carries, so there is nothing for this space to draw. Branching on the draft alone is also what
       lets every branch below dereference it.

       Inside that, the one thing the header cannot say: that there is nothing here YET. A failure worded into
       the space a load has not filled is the failure wearing the loading state's clothes, and a cold client
       wears them for seconds on the way to a house that reads perfectly well. *@
    @if (draft is null) { @if (note is null) { <StatusLine /> } }
    else if (selected == ComposedPart)
    {
      <Section Description="Picking a saved roof, porch or storey replaces this house's own settings for that part. A clear height of 0 keeps the storey's own.">
        <Field Label="Roof">
          <Select Options="@Parts(roofs.Select(part => (part.Id, part.Name)))" Value="@((draft.RoofStyleId ?? 0).ToString())"
                  Placeholder="Own roof" PlaceholderValue="0" ValueChanged="BindRoofStyle" />
        </Field>
        <Field Label="Porch" Term="porch">
          <Select Options="@Parts(porches.Select(part => (part.Id, part.Name)))" Value="@((draft.PorchStyleId ?? 0).ToString())"
                  Placeholder="Own porch" PlaceholderValue="0" ValueChanged="BindPorchStyle" />
        </Field>

        @* The stack is an order, so it is a list with the ground at the top and no ordinal to type: moving a
           row is moving a storey. *@
        <Field Label="Storeys" Term="storey">
          <Badge Kind="dim">@(draft.StoreyStack.Count == 0
            ? "Own walls" : $"{draft.StoreyStack.Count} set")</Badge>
        </Field>
        @for (var at = 0; at < draft.StoreyStack.Count; at++)
        {
          var index = at;
          var storey = draft.StoreyStack[index];
          <div class="lib-bind" @key="@($"storey-{index}")">
            <Select Options="@Parts(storeys.Select(part => (part.Id, part.Name)))"
                    Value="@storey.StoreyStyleId.ToString()" ValueChanged="id => BindStorey(index, id)" />
            <NumberField Slim Min="0" Max="16" Value="storey.Clear" ValueChanged="value => SetStoreyStackClear(index, value)"
                         aria-label="Clear height in blocks" />
            <Button Variant="icon" Icon="chevron-up" Title="Move up"
                    Disabled="@(index == 0)" OnClick="() => MoveStorey(index, -1)" />
            <Button Variant="icon" Icon="chevron-down" Title="Move down"
                    Disabled="@(index == draft.StoreyStack.Count - 1)" OnClick="() => MoveStorey(index, 1)" />
            <Button Variant="icon" Icon="trash-2" Title="Delete this storey"
                    OnClick="() => RemoveStorey(index)" />
          </div>
        }
        @if (draft.StoreyStack.Count > 0)
        {
          <Readout>Ground floor first. @StackCourses blocks of wall, with a ladder on the door wall between floors.</Readout>
        }
        <div class="panel-actions">
          <Button Icon="plus" Disabled="@(storeys.Count == 0)" OnClick="AddStorey">Add a storey</Button>
          @if (storeys.Count == 0)
          {
            <Button Href="/library/storeys/new" Icon="blocks" Writes>Add a storey</Button>
          }
        </div>
      </Section>
    }
    else if (Piece is { } part)
    {
      @* A part that takes one material takes one picker. Offering a stack for the roof offered an author
         courses the stamper reads the first of and drops the rest — a knob whose preview never moved. *@
      @if (!part.Stacked)
      {
        <Field Label="@part.Title" Term="@part.Term" Help="@part.Help" Note="@part.Note">
          <SlotSelect Styles="styles" Blocks="blocks" Value="@Single(part.Id).StyleId" Block="Single(part.Id).Block"
                      ValueChanged="fill => BindSingle(part.Id, fill)" />
        </Field>
      }

      @if (part.Stacked)
      {
      <Field Label="@part.ExtentLabel" Unit="blocks" Help="@part.Help">
        <NumberField Slim Min="1" Value="Extent(part.Id)" ValueChanged="value => SetExtent(part.Id, value)" />
      </Field>

      @foreach (var course in Courses(part.Id))
      {
        <div @key="@($"{part.Id}-{course.Ordinal}")">
          <SlotSelect Styles="styles" Blocks="blocks" Value="@course.StyleId" Block="course.Block"
                      ValueChanged="fill => BindCourse(part.Id, course.Ordinal, fill)">
            <Trailing>
              <NumberField Slim Min="1" Value="course.Height" ValueChanged="value => SetCourseHeight(part.Id, course.Ordinal, value)"
                           aria-label="Course height in blocks" />
              @* Icon variant: the button carries a glyph and no label, which is what that variant is —
                 as a plain action-btn it kept the text padding and drew a wide box in a row of square ones. *@
              <Button Variant="icon" Icon="trash-2" Title="Delete this course"
                      OnClick="() => RemoveCourse(part.Id, course.Ordinal)" />
            </Trailing>
          </SlotSelect>
        </div>
      }

      @if (Courses(part.Id).Count == 0)
      {
        <EmptyState>No courses yet. Add one to replace the default look.</EmptyState>
      }

      <div class="panel-actions">
        <Button Icon="plus" Disabled="@(styles.Count == 0)" OnClick="() => AddCourse(part.Id)">Add a course</Button>
      </div>
      }

      @* A part's non-material knobs belong to that part, so they sit in its own section rather than in
         a second one competing for the same heading. *@
      @if (part.Id == RoomParts.Floor)
      {
        @* The floor's top course, divided across the room. A zone is a plan division and its stack is a
           depth one, which is why these are parts beside the floor rather than courses inside it. *@
        @foreach (var zone in RoomPartInfo.FloorZones)
        {
          <Field Label="@zone.Title" Help="@zone.Help" @key="zone.Id">
            <SlotSelect Styles="styles" Blocks="blocks" Value="@Single(zone.Id).StyleId" Block="Single(zone.Id).Block"
                        Unbound="Bare floor" ValueChanged="fill => BindSingle(zone.Id, fill)" />
          </Field>
        }
        <Field Label="Edge width" Unit="blocks" Help="How far the edge ring reaches in from the walls.">
          <NumberField Slim Min="1" Max="4" Value="draft.BorderWidth" ValueChanged="SetBorderWidth" />
        </Field>
        <Field Label="Inlay inset" Unit="blocks" Help="How far in from the walls the inlay starts.">
          <NumberField Slim Min="1" Max="8" Value="draft.InlayInset" ValueChanged="SetInlayInset" />
        </Field>
      }

      @if (part.Id == RoomParts.Wall)
      {
        @* Windows are cut out of the wall the courses above just built, so they are the wall's knob. *@
        <WindowFields Window="Windows" WindowChanged="SetWindows" Blocks="blocks" />

        @* Beams are the wall's timber frame: posts and a plate the courses are laid between, so they belong
           to the wall rather than to the trim the corners are finished in. *@
        <Field Label="Timber frame" Term="timber frame">
          <div class="chip-row">
            <Chip Active="@(!Beamed)" OnClick="() => SetBeams(false)">None</Chip>
            <Chip Active="@Beamed" OnClick="() => SetBeams(true)">Framed</Chip>
          </div>
        </Field>
        @if (draft.Beams is { } beams)
        {
          <Field Label="Beam material" Note="Logs only, or the house can't be saved.">
            <BlockPicker Blocks="blocks" Id="beams.Block" Data="beams.Data" OnPick="PickBeamBlock" />
          </Field>
          <Field Label="Beam length" Unit="blocks" Help="How far a beam runs along the wall from each corner." Note="At 0 only the corner posts stand.">
            <NumberField Slim Min="0" Max="16" Value="beams.Reach" ValueChanged="SetBeamReach" />
          </Field>
        }
      }

      @if (part.Id == RoomParts.Wall)
      {
        @* Storeys belong to the wall: they are how the wall is divided up, and the courses each one
           spends come out of the same height. *@
        <Field Label="Storey count" Help="How many floors stand inside the walls. Every floor but the top has a ceiling and a ladder.">
          <NumberField Slim Min="1" Max="8" Value="draft.Storeys" ValueChanged="SetStoreys" />
        </Field>
        @if (draft.Storeys > 1)
        {
          <Field Label="Clear height" Unit="blocks" Help="The open space a player stands in, between this floor and whatever is above it, not counting walls or floors."
                 Note="At 0 each storey takes the wall height, and never less than 3.">
            <NumberField Slim Min="0" Max="16" Value="draft.StoreyClear" ValueChanged="SetStoreyClear" />
          </Field>
          <Readout>The walls stand @StoreyCourses blocks tall and hold @draft.Storeys storeys of @EffectiveClear blocks clear.</Readout>
        }
      }

      @if (part.Id == RoomParts.Roof)
      {
        <Field Label="Roof form" Term="roof form">
          <Select Options="@Select.Words(RoofForms.Offered, RoofForms.Name, RoofForms.Describe)"
                  Value="@draft.RoofForm" ValueChanged="SetForm" />
        </Field>
        @if (Sloped)
        {
          <Field Label="Pitch" Term="pitch" Note="At 1 the roof climbs at 45 degrees.">
            <NumberField Slim Min="1" Max="4" Value="draft.Pitch" ValueChanged="SetPitch" />
          </Field>
        }
        <Field Label="Overhang" Unit="blocks" Note="At 0 the roof ends flush with the walls.">
          <NumberField Slim Min="0" Max="4" Value="draft.Overhang" ValueChanged="SetOverhang" />
        </Field>
        @if (Sloped)
        {
          <Field Label="Roof ridge" Term="roof ridge">
            <div class="chip-row">
              <Chip Active="@(!draft.RidgeCap)" OnClick="() => SetRidgeCap(false)">Roof material</Chip>
              <Chip Active="draft.RidgeCap" OnClick="() => SetRidgeCap(true)">Verge material</Chip>
            </div>
          </Field>
          @* A slab halves the rise per block travelled inward, so a roof laid in slabs stands half as tall at
             the same pitch and the body fills the cubes between. *@
          <Field Label="Steps in">
            <div class="chip-row">
              <Chip Active="@(!Slabbed && !Staired)" OnClick="StepInBlocks">Whole blocks</Chip>
              <Chip Active="@Staired" OnClick="StepInStairs">Stairs</Chip>
              <Chip Active="@Slabbed" OnClick="StepInSlabs">Slabs</Chip>
            </div>
          </Field>
          @if (Slabbed)
          {
            <Field Label="Slab" Note="The roof body's own material, or the house can't be saved.">
              <BlockPicker Blocks="blocks" Id="draft.RoofSlab" Data="draft.RoofSlabData"
                           OnPick="PickRoofSlab" />
            </Field>
          }
          @if (Staired)
          {
            <Field Label="Stair" Note="The roof body's own material. Along the sloped edges it lies upside down.">
              <BlockPicker Blocks="blocks" Id="draft.RoofStair" Data="0" OnPick="PickRoofStair" />
            </Field>
          }
          <Field Label="Wear" Help="How weathered the roof is, as the share of its stairs laid as whole blocks and of its edge laid as slabs."><LabelEnd><strong>@($"{draft.RoofWear * 100:0}%")</strong></LabelEnd>
            <ChildContent><RangeField Min="0" Max="100" Value="@((int)(draft.RoofWear * 100))"
                   OnCommit="SetRoofWear" /></ChildContent></Field>
          @* The gable is the triangle above the wall's own top, so what is cut into it is its own opening. *@
          <Field Label="Gable windows">
            <div class="chip-row">
              <Chip Active="@(!Gabled)" OnClick="() => SetGableWindowsOn(false)">None</Chip>
              <Chip Active="@Gabled" OnClick="() => SetGableWindowsOn(true)">Cut in</Chip>
            </div>
          </Field>
          @if (draft.GableWindows is { } gable)
          {
            <WindowFields Window="gable" WindowChanged="SetGableWindows" Blocks="blocks"
                          SillHelp="Measured up from the top of the wall to where the window starts." />
          }
        }
        else
        {
          <Field Label="Roof hole" Note="@(draft.RoofHole ? null : "A closed roof leaves the room unlit.")">
            <div class="chip-row">
              <Chip Active="@(!draft.RoofHole)" OnClick="() => SetHole(false)">Closed</Chip>
              <Chip Active="draft.RoofHole" OnClick="() => SetHole(true)">Open centre</Chip>
            </div>
          </Field>
        }
      }
    }
    else if (selected == TrimPart)
    {
      @foreach (var trim in RoomPartInfo.Trim.Where(part => part.Id != RoomParts.Sill || Single(part.Id).Bound))
      {
        <Field Label="@trim.Title" Term="@trim.Term" Help="@trim.Help" Note="@trim.Note" @key="trim.Id">
          <SlotSelect Styles="styles" Blocks="blocks" Value="@Single(trim.Id).StyleId" Block="Single(trim.Id).Block"
                      ValueChanged="fill => BindSingle(trim.Id, fill)" />
        </Field>
      }
    }
    else if (selected == PorchPart)
    {
      <Field Label="Porch" Term="porch">
        <div class="chip-row">
          <Chip Active="@(Porch is null)" OnClick="() => SetPorchOn(false)">None</Chip>
          <Chip Active="@(Porch is not null)" OnClick="() => SetPorchOn(true)">Deck</Chip>
        </div>
      </Field>
      @if (Porch is { } deck)
      {
        <Field Label="Porch depth" Unit="blocks" Help="How far the walls step back from the porch side. The room keeps at least 3 blocks.">
          <NumberField Slim Min="1" Max="8" Value="deck.Depth" ValueChanged="SetPorchDepth" />
        </Field>
        <Field Label="Porch inset" Unit="blocks" Help="How far the deck stops short of each end of its wall." Note="At 0 the deck runs the wall's full width.">
          <NumberField Slim Min="0" Max="8" Value="deck.Inset" ValueChanged="SetPorchInset" />
        </Field>
        <Field Label="Porch wall">
          <Select Options="@Select.Words(PorchEdges.All, PorchEdges.Name, PorchEdges.Describe)"
                  Value="@deck.Edge" ValueChanged="SetPorchEdge" />
        </Field>
        <Field Label="Canopy form">
          <Select Options="@Select.Words(RoofForms.Offered, RoofForms.Name, RoofForms.Describe)"
                  Value="@deck.Roof" ValueChanged="SetPorchRoof" />
        </Field>
        <Field Label="@RoomPartInfo.Canopy.Title" Help="@RoomPartInfo.Canopy.Help">
          <SlotSelect Styles="styles" Blocks="blocks" Value="@Single(RoomParts.Canopy).StyleId"
                      Block="Single(RoomParts.Canopy).Block"
                      Unbound="House roof" ValueChanged="fill => BindSingle(RoomParts.Canopy, fill)" />
        </Field>
        <Field Label="Rail">
          <div class="chip-row">
            <Chip Active="@(deck.RailBlock <= 0)" OnClick="() => SetRail(false)">None</Chip>
            <Chip Active="@(deck.RailBlock > 0)" OnClick="() => SetRail(true)">Open edges</Chip>
          </div>
        </Field>
        @if (deck.RailBlock > 0)
        {
          <Field Label="Rail material">
            <BlockPicker Blocks="blocks" Id="deck.RailBlock" Data="0" ShowColors="false"
                         OnPick="PickRailBlock" />
          </Field>
        }
      }
    }
    else if (selected == DoorPart)
    {
      <Section Description="Attackers break glass and cobweb, and open a wooden door by hand, to enter a wool room. A spawn's door is always open.">
        <Field Label="Door">
          <Select Options="@Doors" Value="@draft.Door" ValueChanged="SetDoor" />
        </Field>
        <Field Label="Door height" Unit="blocks">
          <NumberField Slim Min="1" Value="draft.DoorHeight" ValueChanged="SetDoorHeight" />
        </Field>
        <Field Label="Door width" Unit="blocks" Note="At least 2.">
          <NumberField Slim Min="2" Max="8" Value="draft.DoorWidth" ValueChanged="SetDoorWidth" />
        </Field>
      </Section>

      <Section Title="Door head" Term="door head">
        <Field Label="Over the door">
          <div class="chip-row">
            <Chip Active="@(!Headed)" OnClick="() => SetDoorHeadOn(false)">None</Chip>
            <Chip Active="@Headed" OnClick="() => SetDoorHeadOn(true)">Door head</Chip>
          </div>
        </Field>
        @if (draft.DoorHead is { } head)
        {
          <Field Label="Head form">
            <Select Options="@DoorHeadFormOptions" Value="@head.Form" ValueChanged="SetDoorHeadForm" />
          </Field>
          <Field Label="Head stairs" Note="The centre's own material, or the house can't be saved.">
            <BlockPicker Blocks="blocks" Id="head.Block" Data="0" OnPick="PickDoorHeadBlock" />
          </Field>
          <Field Label="Head centre">
            <Select Options="@DoorHeadFillOptions" Value="@head.Fill" ValueChanged="SetDoorHeadFill" />
          </Field>
          @if (DoorHeadFilled)
          {
            <Field Label="Centre material">
              <BlockPicker Blocks="blocks" Id="head.FillBlock" Data="head.FillData" OnPick="PickDoorHeadFill" />
            </Field>
          }
        }
      </Section>
    }
  </Fields>
  <Actions>
    @if (!seeded)
    {
      <Button Variant="primary" Icon="save" Disabled="@(string.IsNullOrWhiteSpace(draftName))" Writes OnClick="Save">
        @(editingId is null ? "Add to library" : "Save changes")
      </Button>
    }
    @if (editingId is not null)
    {
      <Button Icon="copy" Writes OnClick="SaveAsCopy">Save as copy</Button>
      @if (!seeded) { <Button Variant="danger" Icon="trash-2" Deletes OnClick="Delete">Delete</Button> }
    }
  </Actions>
</LibraryEditor>
