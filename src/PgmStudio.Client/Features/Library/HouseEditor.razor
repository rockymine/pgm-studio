@namespace PgmStudio.Client.Features.Library
@inject TerrainLibraryClient Library
@inject NavigationManager Nav

@* One whole building, on a page of its own. A house is a stack of storeys under a roof, with a porch, a
   doorway and the foundation it stands on; the outline is those pieces and the inspector holds the one the
   outline has picked. The picture is the sample shell four ways, so a porch and a window read where a section
   alone would draw them as a patch of the wall they are cut into. *@

<LibraryEditor Kind="LibraryKinds.Houses" Name="@draftName" NameChanged="SetName"
               Outline="Outline" Selected="@selected" OnSelect="Pick"
               Footnote="@Footnote" Note="@note">
  <Preview>
    <HouseViews Preview="preview" />
  </Preview>
  <Fields>
    @if (draft is null) { <p class="section-desc">That house could not be read.</p> }
    else if (selected == ComposedPart)
    {
      <p class="section-desc">A roof, a porch and a stack of storeys are each authored once in their own
      library and bound here — the level a theme already has over a style. A bound part <em>replaces</em> the outline rows
      that describe the same thing; unbound, this house keeps describing it itself.</p>
      <Field Label="Roof">
        <select class="field-input field-input--slim" value="@(draft.RoofStyleId ?? 0)"
                @onchange="BindRoofStyle">
          <option value="0">Unbound — the Roof row below</option>
          @foreach (var part in roofs) { <option value="@part.Id" @key="part.Id">@part.Name</option> }
        </select>
      </Field>
      <Field Label="Porch">
        <select class="field-input field-input--slim" value="@(draft.PorchStyleId ?? 0)"
                @onchange="BindPorchStyle">
          <option value="0">Unbound — the Porch row below</option>
          @foreach (var part in porches) { <option value="@part.Id" @key="part.Id">@part.Name</option> }
        </select>
      </Field>

      @* The stack is an order, so it is a list with the ground at the top and no ordinal to type: moving a
         row is moving a storey. *@
      <Field Label="Storeys">
        <Badge Kind="dim">@(draft.StoreyStack.Count == 0
          ? "Unbound — the Wall row below" : $"{draft.StoreyStack.Count} bound")</Badge>
      </Field>
      @for (var at = 0; at < draft.StoreyStack.Count; at++)
      {
        var index = at;
        var storey = draft.StoreyStack[index];
        <div class="lib-bind" @key="@($"storey-{index}")">
          <select class="field-input field-input--slim" value="@storey.StoreyStyleId"
                  @onchange="e => BindStorey(index, e)">
            @foreach (var part in storeys) { <option value="@part.Id" @key="part.Id">@part.Name</option> }
          </select>
          <input class="field-input field-input--slim" type="number" min="0" max="16" step="1"
                 title="The clear this storey takes here. 0 keeps the storey style's own."
                 value="@storey.Clear" @onchange="e => SetStoreyStackClear(index, e)" />
          <Button Variant="icon" Icon="chevron-up" Title="Move down the building"
                  Disabled="@(index == 0)" OnClick="() => MoveStorey(index, -1)" />
          <Button Variant="icon" Icon="chevron-down" Title="Move up the building"
                  Disabled="@(index == draft.StoreyStack.Count - 1)" OnClick="() => MoveStorey(index, 1)" />
          <Button Variant="icon" Icon="trash-2" Title="Remove this storey"
                  OnClick="() => RemoveStorey(index)" />
        </div>
      }
      @if (draft.StoreyStack.Count > 0)
      {
        <p class="section-desc">Ground floor first. @StackCourses courses of wall, with a ladder up the door
          wall between each pair.</p>
      }
      <div class="panel-actions">
        <Button Icon="plus" Disabled="@(storeys.Count == 0)" OnClick="AddStorey">Add a storey</Button>
        @if (storeys.Count == 0)
        {
          <Button Href="/library/parts" Icon="blocks">Author a storey</Button>
        }
      </div>
    }
    else if (Piece is { } part)
    {
      <p class="section-desc">@part.Blurb</p>
      @* A part that takes one material takes one picker. Offering a stack for the roof offered an author
         courses the stamper reads the first of and drops the rest — a knob whose preview never moved. *@
      @if (!part.Stacked)
      {
        <Field Label="Material">
          <select class="field-input field-input--slim" title="@part.Blurb"
                  value="@Single(part.Id)" @onchange="e => BindSingle(part.Id, e)">
            <option value="0">Unbound — keeps the built-in finish</option>
            @foreach (var group in StylesByKind)
            {
              <optgroup label="@MaterialKind.NameOf(group.Key)" @key="group.Key">
                @foreach (var style in group) { <option value="@style.Id">@style.Name</option> }
              </optgroup>
            }
          </select>
        </Field>
      }

      @if (part.Stacked)
      {
      <Field Label="@part.ExtentLabel">
        <input class="field-input field-input--slim" type="number" min="1" step="1"
               value="@Extent(part.Id)" @onchange="e => SetExtent(part.Id, e)" />
      </Field>

      @foreach (var course in Courses(part.Id))
      {
        <div class="lib-bind" @key="@($"{part.Id}-{course.Ordinal}")">
          <select class="field-input field-input--slim" value="@course.StyleId"
                  @onchange="e => BindCourse(part.Id, course.Ordinal, e)">
            @foreach (var group in StylesByKind)
            {
              <optgroup label="@MaterialKind.NameOf(group.Key)" @key="group.Key">
                @foreach (var style in group) { <option value="@style.Id">@style.Name</option> }
              </optgroup>
            }
          </select>
          <input class="field-input field-input--slim" type="number" min="1" step="1"
                 title="How many courses this one runs"
                 value="@course.Height" @onchange="e => SetCourseHeight(part.Id, course.Ordinal, e)" />
          @if (StyleOf(course.StyleId) is { } bound)
          {
            <span class="lib-bind-swatch">@((MarkupString)bound.Preview)</span>
          }
          @* Icon variant: the button carries a glyph and no label, which is what that variant is —
             as a plain action-btn it kept the text padding and drew a wide box in a row of square ones. *@
          <Button Variant="icon" Icon="trash-2" Title="Remove this course"
                  OnClick="() => RemoveCourse(part.Id, course.Ordinal)" />
        </div>
      }

      @if (Courses(part.Id).Count == 0)
      {
        <p class="section-desc">Unbound — keeps the built-in finish.</p>
      }

      <div class="panel-actions">
        <Button Icon="plus" Disabled="@(styles.Count == 0)" OnClick="() => AddCourse(part.Id)">Add a course</Button>
      </div>
      }

      @* A part's non-material knobs belong to that part, so they sit in its own section rather than in
         a second one competing for the same heading. *@
      @if (part.Id == RoomParts.Floor)
      {
        @* The floor's top course, divided across the room. A zone is a plan division and its stack is a
           depth one, which is why these are parts beside the floor rather than courses inside it. *@
        @foreach (var zone in RoomPartInfo.FloorZones)
        {
          <Field Label="@zone.Title" @key="zone.Id">
            <select class="field-input field-input--slim" title="@zone.Blurb"
                    value="@Single(zone.Id)" @onchange="e => BindSingle(zone.Id, e)">
              <option value="0">Unbound — the floor shows through</option>
              @foreach (var group in StylesByKind)
              {
                <optgroup label="@MaterialKind.NameOf(group.Key)" @key="group.Key">
                  @foreach (var style in group) { <option value="@style.Id">@style.Name</option> }
                </optgroup>
              }
            </select>
          </Field>
        }
        <Field Label="Border width">
          <input class="field-input field-input--slim" type="number" min="1" max="4" step="1"
                 title="How many blocks in from the walls the border ring runs."
                 value="@draft.BorderWidth" @onchange="SetBorderWidth" />
        </Field>
        <Field Label="Inlay inset">
          <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                 title="How far in from the walls the centred plate starts."
                 value="@draft.InlayInset" @onchange="SetInlayInset" />
        </Field>
      }

      @if (part.Id == RoomParts.Wall)
      {
        @* Windows are cut out of the wall the courses above just built, so they are the wall's knob. *@
        <Field Label="Windows">
          <select class="field-input field-input--slim" value="@Windows.Form" @onchange="SetWindowForm">
            @foreach (var form in WindowForms.All)
            {
              <option value="@form" @key="form">@WindowForms.Describe(form)</option>
            }
          </select>
        </Field>
        @if (Glazing)
        {
          <Field Label="Made of">
            <BlockPicker Blocks="blocks" Id="Windows.Block" Data="Windows.Data" OnPick="PickWindowBlock" />
          </Field>
          <Field Label="Sill">
            <input class="field-input field-input--slim" type="number" min="1" max="16" step="1"
                   title="The course above the floor the opening starts at."
                   value="@Windows.Sill" @onchange="SetWindowSill" />
          </Field>
          @if (Windows.Form != WindowForms.StairLattice)
          {
            <Field Label="Blocks wide">
              <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                     value="@Windows.Width" @onchange="SetWindowWidth" />
            </Field>
          }
          @if (Windows.Form == WindowForms.Pane)
          {
            <Field Label="Blocks tall">
              <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                     value="@Windows.Height" @onchange="SetWindowHeight" />
            </Field>
          }
          <Field Label="Spacing">
            <input class="field-input field-input--slim" type="number" min="0" max="16" step="1"
                   title="Clear blocks of wall between one window and the next."
                   value="@Windows.Spacing" @onchange="SetWindowSpacing" />
          </Field>
        }
      }

      @if (part.Id == RoomParts.Wall)
      {
        @* Storeys belong to the wall: they are how the wall is divided up, and the courses each one
           spends come out of the same height. *@
        <Field Label="Storeys">
          <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                 title="How many floors are stacked inside. Each but the top carries a slab and a ladder."
                 value="@draft.Storeys" @onchange="SetStoreys" />
        </Field>
        @if (draft.Storeys > 1)
        {
          <Field Label="Clear per storey">
            <input class="field-input field-input--slim" type="number" min="0" max="16" step="1"
                   title="Blocks of air in each storey. 0 uses the wall height above. Never below 3 — a room has to be stood up in."
                   value="@draft.StoreyClear" @onchange="SetStoreyClear" />
          </Field>
          <p class="section-desc">@draft.Storeys storeys of @EffectiveClear clear
            — @(draft.Storeys * EffectiveClear + draft.Storeys - 1) courses of wall, with a ladder up the
            door wall.</p>
        }
      }

      @if (part.Id == RoomParts.Roof)
      {
        <Field Label="Shape">
          <select class="field-input field-input--slim" value="@draft.RoofForm" @onchange="SetForm">
            @foreach (var form in RoofForms.All)
            {
              <option value="@form" @key="form">@RoofForms.Describe(form)</option>
            }
          </select>
        </Field>
        @if (Sloped)
        {
          <Field Label="Pitch">
            <input class="field-input field-input--slim" type="number" min="1" max="4" step="1"
                   title="Courses of rise per block travelled inward. 1 is 45°."
                   value="@draft.Pitch" @onchange="SetPitch" />
          </Field>
        }
        <Field Label="Overhang">
          <input class="field-input field-input--slim" type="number" min="0" max="4" step="1"
                 title="How far the roof reaches past the walls, in blocks. 0 ends it flush."
                 value="@draft.Overhang" @onchange="SetOverhang" />
        </Field>
        @if (Sloped)
        {
          <Field Label="Ridge">
            <Chip Active="draft.RidgeCap" OnClick="ToggleRidgeCap">
              @(draft.RidgeCap ? "Capped in the verge" : "The roof's own material")
            </Chip>
          </Field>
        }
        else
        {
          <Field Label="Hole">
            <Chip Active="draft.RoofHole" OnClick="ToggleHole">
              @(draft.RoofHole ? "Open in the middle" : "Sealed — an unlit room")
            </Chip>
          </Field>
        }
      }
    }
    else if (selected == TrimPart)
    {
      <p class="section-desc">A corner post, a footing and a roof edge are each one material read straight through, so binding
      one is a single choice. Leaving them unbound is what a plain shell is: corners that are wall like the
      rest of it, no footing, and a roof edge in the roof's own material.</p>
      @foreach (var trim in RoomPartInfo.Trim)
      {
        <Field Label="@trim.Title" @key="trim.Id">
          <select class="field-input field-input--slim" title="@trim.Blurb"
                  value="@Single(trim.Id)" @onchange="e => BindSingle(trim.Id, e)">
            <option value="0">Unbound</option>
            @foreach (var group in StylesByKind)
            {
              <optgroup label="@MaterialKind.NameOf(group.Key)" @key="group.Key">
                @foreach (var style in group) { <option value="@style.Id">@style.Name</option> }
              </optgroup>
            }
          </select>
        </Field>
      }
    }
    else if (selected == PorchPart)
    {
      <p class="section-desc">A porch is taken <strong>out of</strong> the footprint, never added to it — the footprint comes
      from the piece and a style may not change it. The walls stand back from one side, and the strip they
      gave up is a deck with posts, a rail and its own roof over it.</p>
      <Field Label="Porch">
        <Chip Active="@(Porch is not null)" OnClick="TogglePorch">
          @(Porch is null ? "None — walls on the whole footprint" : "A strip given up to a deck")
        </Chip>
      </Field>
      @if (Porch is { } deck)
      {
        <Field Label="Blocks deep">
          <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                 title="How deep a strip the walls give up. The room keeps at least three blocks."
                 value="@deck.Depth" @onchange="SetPorchDepth" />
        </Field>
        <Field Label="Pulled in by">
          <input class="field-input field-input--slim" type="number" min="0" max="8" step="1"
                 title="How far the deck stops short of each end of that wall. 0 runs it the full width."
                 value="@deck.Inset" @onchange="SetPorchInset" />
        </Field>
        <Field Label="Off which wall">
          <select class="field-input field-input--slim" value="@deck.Edge" @onchange="SetPorchEdge">
            @foreach (var edge in PorchEdges.All)
            {
              <option value="@edge" @key="edge">@PorchEdges.Describe(edge)</option>
            }
          </select>
        </Field>
        <Field Label="Canopy">
          <select class="field-input field-input--slim" value="@deck.Roof" @onchange="SetPorchRoof">
            @foreach (var form in RoofForms.All)
            {
              <option value="@form" @key="form">@RoofForms.Describe(form)</option>
            }
          </select>
        </Field>
        <Field Label="Rail">
          <Chip Active="@(deck.RailBlock > 0)" OnClick="ToggleRail">
            @(deck.RailBlock > 0 ? "Along the open edges" : "None — step off anywhere")
          </Chip>
        </Field>
        @if (deck.RailBlock > 0)
        {
          <Field Label="Rail made of">
            <BlockPicker Blocks="blocks" Id="deck.RailBlock" Data="0" ShowColors="false"
                         OnPick="PickRailBlock" />
          </Field>
        }
      }
    }
    else if (selected == DoorPart)
    {
      <p class="section-desc">A closed set: only these can be broken by an attacker, so only these open a cage. A spawn's door
        is always open, whatever is chosen here.</p>
      <Field Label="Made of">
        <select class="field-input field-input--slim" value="@draft.Door" @onchange="SetDoor">
          @foreach (var door in doors) { <option value="@door.Slug" @key="door.Slug">@door.Label</option> }
        </select>
      </Field>
      <Field Label="Courses tall">
        <input class="field-input field-input--slim" type="number" min="1" step="1"
               value="@draft.DoorHeight" @onchange="SetDoorHeight" />
      </Field>
    }
  </Fields>
  <Actions>
    <Button Variant="primary" Icon="save" Disabled="@(string.IsNullOrWhiteSpace(draftName))" OnClick="Save">
      @(editingId is null ? "Add to library" : "Save changes")
    </Button>
    @if (editingId is not null)
    {
      <Button Icon="copy" OnClick="SaveAsCopy">Save as copy</Button>
      <Button Variant="danger" Icon="trash-2" OnClick="Delete">Delete</Button>
    }
  </Actions>
</LibraryEditor>
