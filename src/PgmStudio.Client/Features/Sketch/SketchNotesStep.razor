@namespace PgmStudio.Client.Features.Sketch

@* Review's Notes step — the board as a player sees it, drawn with the game's own block textures. One picture
   enlarged with its camera over it, the gallery of views under it, and beside it the notes column: an admin's
   notes on the picture in view and on the whole map. A note is pinned by arming a tool in the dock on the
   picture — a point, a box or a lasso, which the studio projects onto the ground — or to the picture or the map
   as a whole. The cameras themselves are placed, kept and removed in the Cameras step, on the canvas. *@

<div class="phase-body">
  <Workspace>
    @if (Views.Error is not null)
    {
      <div class="ingame"><p class="ingame__note ingame__note--warn">@Views.Error</p></div>
    }
    else if (Gallery is null)
    {
      <div class="ingame"><p class="ingame__note">Loading views…</p></div>
    }
    else if (Gallery.Undrawable is { } why)
    {
      <div class="ingame">
        <div class="callout ingame__note">
          <span class="callout-icon"><i data-lucide="info"></i></span>
          <p><strong>In-game pictures aren't available on this server.</strong> They need Minecraft 1.8.9's block
            textures, which it doesn't have. @why</p>
        </div>
      </div>
    }
    else if (Gallery.Views.Count == 0 || Shown is not { } shown)
    {
      <div class="ingame">
        <p class="ingame__note">Nothing to show yet. Draw some ground first.</p>
      </div>
    }
    else
    {
      <div class="ingame ingame--stage">
        <div class="ingame__main" tabindex="0" @ref="main" @onkeydown="OnKey">
          <div class="ingame__head">
            <span class="ingame__name">@shown.Name</span>
            <Button Icon="external-link" Href="@FullSize(shown)" target="_blank" rel="noopener"
                    Title="Open at 1920 × 1080 in a new tab">Full size</Button>
          </div>

          @if (Views.Refusal is not null) { <p class="ingame__note ingame__note--warn" role="alert">@Views.Refusal</p> }
          @if (Landed is { } landed)
          {
            <div class="ingame__moved" role="status">
              <span>The board has changed since these pictures were drawn: they show change @DrawnAt, and change @landed has landed.</span>
              <Button Icon="refresh-cw" OnClick="RedrawAsync">Draw the pictures again</Button>
            </div>
          }
          <div class="ingame__frame">
            @if (Compared is { } compared)
            {
              <SketchNoteCompare Before="@compared.Before" BeforeChange="compared.BeforeChange" After="@compared.After"
                                 AfterChange="compared.AfterChange" Now="@compared.Now" NowChange="compared.NowChange"
                                 Width="compared.Width" Height="compared.Height" Mode="@CompareMode(compared)"
                                 OnMode="mode => (comparing, compareMode) = (compared.Key, mode)" />
            }
            else
            {
              <SketchEyePicture Slug="@Slug" Query="@shown.Query" Width="PictureWidth" Height="PictureHeight"
                                Round="Round" Alt="@shown.Name" Class="ingame__picture"
                                Standin="@SketchEyePicture.SourceOf(Slug, shown.Query, SketchEyePicture.ThumbWidth, SketchEyePicture.ThumbHeight, Round)" />
            }
            @if (CameraInView is { } camera)
            {
              <div class="ingame__camera" aria-label="The camera this picture is drawn with">
                <span>@Position(camera)</span>
                <span>@Facing(camera)</span>
              </div>
            }
            @if (Notes.Allowed)
            {
              @if (showMarks)
              {
                <svg class="ingame__marks" viewBox="0 0 @PictureWidth @PictureHeight" preserveAspectRatio="none" aria-hidden="true">
                  @if ((Compared is not null ? Current : OpenHere) is { } open && open.Anchor.Marks is { Count: > 0 } openMarks)
                  {
                    @Shape(open.Anchor.Kind, openMarks, "ingame__mark ingame__mark--open")
                  }
                  @foreach (var pinned in RepliesHere)
                  {
                    @Shape(pinned.Kind, pinned.Marks!, "ingame__mark ingame__mark--reply")
                  }
                  @if (step is NotesStep.New or NotesStep.Thread && mark is { } drawn)
                  {
                    @Shape(drawn.Kind, drawn.Pixels, "ingame__mark ingame__mark--draft")
                  }
                  @if (drawing is { } live)
                  {
                    @Shape(live.Kind, live.Pixels, "ingame__mark ingame__mark--draft")
                  }
                </svg>
                @foreach (var note in Compared is null ? PinnedHere : [])
                {
                  var (x, y) = PinAt(note);
                  <button type="button" class="@(SketchNotesColumn.PinClass(note) + " ingame__pin")" @key="note.Id"
                          style="@PinStyle(x, y)" aria-label="@($"Open note {note.Id}")" @onclick="() => OpenNote(note)">@note.Id</button>
                }
              }
              @if (tool is not null)
              {
                <div class="ingame__trap" @ref="trap"
                     @onpointerdown="PointerDown" @onpointermove="PointerMove" @onpointerup="PointerUp"
                     @onpointerleave="PointerUp"></div>
                <div class="ingame__hint">@ToolHint</div>
              }
              <CanvasDock>
                <DockGroup Viewing="true">
                  <DockButton Icon="crosshair" Title="@($"Point: pin {Pins} to a block")" Active="@(tool == NoteAnchors.Point)"
                              OnClick="() => Arm(NoteAnchors.Point)" />
                  <DockButton Icon="square" Title="@($"Box: pin {Pins} to an area")" Active="@(tool == NoteAnchors.Box)"
                              OnClick="() => Arm(NoteAnchors.Box)" />
                  <DockButton Icon="lasso" Title="@($"Lasso: pin {Pins} to an outlined area")" Active="@(tool == NoteAnchors.Lasso)"
                              OnClick="() => Arm(NoteAnchors.Lasso)" />
                  <span class="ingame__divider"></span>
                  <DockButton Icon="eye" Title="@(showMarks ? "Hide note pins" : "Show note pins")"
                              Active="showMarks" OnClick="() => showMarks = !showMarks" />
                </DockGroup>
              </CanvasDock>
            }
          </div>

          <div class="ingame__strip">
            @foreach (var view in Gallery.Views)
            {
              var count = Waiting(view.Id);
              <button type="button" class="@(view.Id == shown.Id ? "ingame__card ingame__card--on" : "ingame__card")"
                      @key="view.Id" title="@view.Name" @onclick="() => Show(view)">
                <span class="ingame__thumb">
                  <SketchEyePicture Slug="@Slug" Query="@view.Query" Round="Round" Alt="@view.Name" />
                  @if (Notes.Allowed && count > 0) { <span class="ingame__count">@count</span> }
                  @if (view.Picture) { <Badge Kind="neutral" Class="ingame__flag">map picture</Badge> }
                  else if (view.Kept) { <Badge Kind="neutral" Class="ingame__flag">kept</Badge> }
                </span>
                <span class="ingame__cardname">@view.Name</span>
              </button>
            }
          </div>
        </div>

        @if (Notes.Allowed)
        {
          <SketchNotesColumn Step="step" Notes="Notes.All" ViewIds="ViewIds" ViewId="@shown.Id" ViewName="@shown.Name"
                             Current="Current" Filter="@filter" AnchorTitle="@AnchorTitle" AnchorBody="@AnchorBody"
                             HasMark="@(mark is not null)" ReplyMark="@ReplyMark" WholeMap="wholeMap" Ready="Ready" Busy="busy" Error="@notesError"
                             OnFilter="f => filter = f" OnOpen="OpenNote" OnBack="BackToOverview" OnNew="StartNote"
                             OnClearMark="ClearMark" OnWholeMap="PinToMap" OnResolve="() => ChangeAsync(NoteStatuses.Resolved)"
                             OnReopen="() => ChangeAsync(NoteStatuses.Open)"
                             OnWontDo="() => ChangeAsync(NoteStatuses.WontDo)" OnSend="SendNoteAsync" OnReply="ReplyAsync"
                             Changes="Changes" OnChangesSince="OnChangesSince" Stale="stale" OnRedraw="RedrawAsync"
                             MeUuid="@Notes.MeUuid" Handoff="Notes.Handoff" Handing="handing" OnHandOff="HandOffAsync" />
        }
      </div>
    }
  </Workspace>
</div>

@code {
    /// <summary>A mark drawn on the picture, in its pixels — one for a point, two corners for a box, an outline
    /// for a lasso.</summary>
    private RenderFragment Shape(string kind, IReadOnlyList<PixelDto> pixels, string css) => kind switch
    {
        NoteAnchors.Point when pixels.Count > 0 =>
            @<circle class="@css" cx="@pixels[0].X" cy="@pixels[0].Y" r="12" />,
        NoteAnchors.Box when pixels.Count > 1 =>
            @<rect class="@css" x="@Math.Min(pixels[0].X, pixels[1].X)" y="@Math.Min(pixels[0].Y, pixels[1].Y)"
                   width="@Math.Abs(pixels[1].X - pixels[0].X)" height="@Math.Abs(pixels[1].Y - pixels[0].Y)" />,
        NoteAnchors.Lasso when pixels.Count > 1 =>
            @<polygon class="@css" points="@string.Join(' ', pixels.Select(pixel => $"{pixel.X},{pixel.Y}"))" />,
        _ => @<g></g>,
    };
}
