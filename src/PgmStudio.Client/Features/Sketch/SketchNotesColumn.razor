@namespace PgmStudio.Client.Features.Sketch

@* The notes column beside Review's picture, in two steps. The overview lists the notes on the picture in
   view, under four filters, and then the notes on the whole map; choosing one opens its thread, and a new note
   shows what it is pinned to over its text. ‹ All notes goes back from either. The phase owns what is shown
   and what is drawn on the picture; this column only renders it and says what was asked. *@

<aside class="notes-column" aria-label="Notes">
  @switch (Step)
  {
    case NotesStep.Overview:
      <div class="notes-column__head">
        <div class="notes-column__title">
          <span class="notes-column__kicker">NOTES</span>
          <span class="notes-column__name">@(ViewName ?? "This view")</span>
        </div>
        <Button Variant="primary" Icon="plus" OnClick="OnNew">New note</Button>
      </div>
      <div class="notes-column__filters">
        @foreach (var (id, label) in Filters)
        {
          <Chip Active="@(Filter == id)" OnClick="() => OnFilter.InvokeAsync(id)">@label&nbsp;<b>@Count(id)</b></Chip>
        }
      </div>
      @if (Handoff is { Ready: true } handoff)
      {
        <div class="notes-column__handoff">
          <span class="notes-column__hint">
            @Handed(handoff)
            @if (handoff.Session is { } session) { <a href="@session" target="_blank" rel="noopener">Watch the session ›</a> }
          </span>
          @if (handoff.Fresh > 0)
          {
            <Button Variant="primary" Icon="sparkles" Busy="Handing" BusyLabel="Handing over…" OnClick="() => OnHandOff.InvokeAsync(false)"
                    Title="Start one agent session that answers every open note">Hand to the agent</Button>
          }
          else if (handoff.Waiting > 0)
          {
            <Button Icon="repeat" Busy="Handing" BusyLabel="Handing over…" OnClick="() => OnHandOff.InvokeAsync(true)"
                    Title="Start another session with the same notes, for one that stopped short">Again</Button>
          }
        </div>
      }
      <div class="notes-column__list">
        @if (Error is not null) { <p class="notes-column__error">@Error</p> }
        @{ var here = OnThisPicture.Where(Passes).ToList(); }
        @foreach (var note in here) { @Row(note) }
        @if (here.Count == 0) { <p class="notes-column__empty">No matching notes on this view.</p> }
        @{ var whole = OnTheMap.Where(Passes).ToList(); }
        @if (whole.Count > 0)
        {
          <div class="notes-column__group">WHOLE MAP</div>
          @foreach (var note in whole) { @Row(note) }
        }
        @{ var elsewhere = Elsewhere.Where(Passes).ToList(); }
        @if (elsewhere.Count > 0)
        {
          <div class="notes-column__group">OTHER VIEWS</div>
          @foreach (var note in elsewhere) { @Row(note) }
        }
      </div>
      break;

    case NotesStep.Thread when Current is { } note:
      <div class="notes-column__head notes-column__head--step">
        <button type="button" class="notes-column__back" @onclick="OnBack">‹ All notes</button>
        <div class="notes-column__threadhead">
          <span class="@PinClass(note)">@Glyph(note)</span>
          <b class="notes-column__threadtitle">@Title(note)</b>
          <span class="@StatusClass(note.Status)">@NoteStatuses.Label(note.Status)</span>
        </div>
      </div>
      <div class="notes-column__thread" @ref="thread">
        @for (var i = 0; i < note.Messages.Count; i++)
        {
          var message = note.Messages[i];
          var first = i == 0;
          @if (!first && Landed(note.Messages[i - 1].Change, message.Change) is > 0 and var between)
          {
            @Marker(between, note.Messages[i - 1].Change)
          }
          var who = Writers.Describe(message.Author, message.Token);
          <div class="@MessageClass(message)" @key="message.Id">
            <span class="note-message__avatar">
              @if (message.Token is not null)
              {
                <span class="agent-mark" title="@who" aria-hidden="true">AI</span>
              }
              else
              {
                <PlayerHead Uuid="@message.AuthorUuid" Name="@message.Author" Title="@who" Size="28" />
              }
            </span>
            <div class="note-message__bubble">
              <div class="note-message__who" title="@who">
                <b>@Writers.Name(message.Author, message.Token)</b>
                @if (message.Token is not null) { <span class="note-message__badge">agent</span> }
                <span>@Ago(message.At) · change @message.Change</span>
              </div>
              <div class="note-message__body">@message.Body</div>
              @if (message.Mark is { } pinned)
              {
                <div class="note-message__mark"><i data-lucide="pin"></i>@MarkLine(pinned)</div>
              }
              @if (message.Picture is { } picture)
              {
                <a class="note-message__picture" href="@($"api/notes/pictures/{picture}")" target="_blank" rel="noopener">
                  <img src="@($"api/notes/pictures/{picture}")" alt="@(first ? "The picture the note was written on" : "The same camera after the change")" loading="lazy" />
                  <span>@(first ? "before" : "after") · change @message.Change</span>
                </a>
              }
            </div>
          </div>
        }
        @if (note.Messages.Count > 0 && Landed(note.Messages[^1].Change, null) is > 0 and var since)
        {
          @Marker(since, note.Messages[^1].Change)
        }
        <div class="notes-column__actions">
          @if (note.Status == NoteStatuses.Resolved || note.Status == NoteStatuses.WontDo)
          {
            <Button OnClick="OnReopen" Busy="Busy" BusyLabel="Reopening…">Reopen</Button>
          }
          @if (note.Status != NoteStatuses.Resolved)
          {
            <Button Icon="check" OnClick="OnResolve" Busy="Busy" BusyLabel="Resolving…">Resolve</Button>
          }
          @if (note.Status != NoteStatuses.Resolved && note.Status != NoteStatuses.WontDo)
          {
            <Button Icon="x" OnClick="OnWontDo" Busy="Busy" BusyLabel="Declining…"
                    Title="Close it as not to be done; it stays listed, and Reopen hands it back">Won't do</Button>
          }
        </div>
      </div>
      <div class="notes-column__compose">
        @if (ReplyMark is { } replyMark)
        {
          <div class="notes-column__replymark">
            <span>@replyMark</span>
            <Button OnClick="OnClearMark">Clear mark</Button>
          </div>
        }
        <div class="notes-column__reply">
          <textarea id="note-reply" class="field-input" rows="3" placeholder="Reply…" aria-label="Reply" value="@reply" readonly="@sending"
                    @oninput="e => reply = e.Value?.ToString() ?? string.Empty"
                    @onkeydown="key => SendOnKey(key, SendReplyAsync)"></textarea>
          <Button Variant="primary" Disabled="@(string.IsNullOrWhiteSpace(reply) || !Ready)" Busy="sending" BusyLabel="Sending…"
                  OnClick="SendReplyAsync">Send</Button>
        </div>
        @if (Error is not null) { <p class="notes-column__error">@Error</p> }
        @if (sent is not null) { <span class="notes-column__sent" role="status">✓ @sent</span> }
      </div>
      break;

    case NotesStep.New:
      <div class="notes-column__head notes-column__head--step">
        <button type="button" class="notes-column__back" @onclick="OnBack">‹ All notes</button>
        <b class="notes-column__threadtitle">New note</b>
      </div>
      <div class="notes-column__thread">
        <div class="notes-column__group">PINNED TO</div>
        <div class="notes-column__anchor">
          <b>@AnchorTitle</b>
          <p>@AnchorBody</p>
          @if (Stale) { <Button Variant="primary" Icon="refresh-cw" OnClick="OnRedraw">Draw the pictures again</Button> }
          else if (HasMark) { <Button OnClick="OnClearMark">Clear mark</Button> }
        </div>
        @if (!WholeMap)
        {
          <Chip OnClick="OnWholeMap">Pin to the whole map instead</Chip>
        }
      </div>
      <div class="notes-column__compose">
        <textarea id="note-body" class="field-input" rows="4" placeholder="Write a note." aria-label="Note" value="@draft"
                  readonly="@sending" @oninput="e => draft = e.Value?.ToString() ?? string.Empty"
                  @onkeydown="key => SendOnKey(key, SendNoteAsync)"></textarea>
        @if (Error is not null) { <p class="notes-column__error">@Error</p> }
        <div class="notes-column__send">
          @if (sent is not null) { <span class="notes-column__sent" role="status">✓ @sent</span> }
          else { <span class="notes-column__hint"></span> }
          <Button Variant="primary" Disabled="@(string.IsNullOrWhiteSpace(draft) || !Ready)" Busy="sending" BusyLabel="Sending…"
                  OnClick="SendNoteAsync">Send</Button>
        </div>
      </div>
      break;
  }
</aside>

@code {
    /// <summary>Where the board changed between two messages, or since the last: how many changes landed, which
    /// opens History on them.</summary>
    private RenderFragment Marker(int count, long after) => @<button type="button" class="notes-column__landed"
        @onclick="() => OnChangesSince.InvokeAsync(after)">@Changed(count) · History ›</button>;

    private RenderFragment Row(MapNoteDto note) => @<button type="button" class="notes-row" @key="note.Id" @onclick="() => OnOpen.InvokeAsync(note)">
        <span class="@PinClass(note)">@Glyph(note)</span>
        <span class="notes-row__text">
          <span class="notes-row__top"><b>@Title(note)</b><span class="@StatusClass(note.Status)">@NoteStatuses.Label(note.Status)</span></span>
          <span class="notes-row__last">@Last(note)</span>
        </span>
      </button>;
}
