@namespace PgmStudio.Client.Features.Sketch

@* The notes column beside the In game picture, in two steps. The overview lists the notes on the picture in
   view, under four filters, and then the notes on the whole map; choosing one opens its thread, and a new note
   shows what it is pinned to over its text. ‹ All notes goes back from either. The phase owns what is shown
   and what is drawn on the picture; this column only renders it and says what was asked. *@

<aside class="notes-column" aria-label="Notes">
  @switch (Step)
  {
    case NotesStep.Overview:
      <div class="notes-column__head">
        <div class="notes-column__title">
          <span class="notes-column__kicker">NOTES</span>
          <span class="notes-column__name">@(ViewName ?? "This picture")</span>
        </div>
        <Button Variant="primary" Icon="plus" OnClick="OnNew">New note</Button>
      </div>
      <div class="notes-column__filters">
        @foreach (var (id, label) in Filters)
        {
          <Chip Active="@(Filter == id)" OnClick="() => OnFilter.InvokeAsync(id)">@label&nbsp;<b>@Count(id)</b></Chip>
        }
      </div>
      <div class="notes-column__list">
        @if (Error is not null) { <p class="notes-column__error">@Error</p> }
        @{ var here = OnThisPicture.Where(Passes).ToList(); }
        @foreach (var note in here) { @Row(note) }
        @if (here.Count == 0) { <p class="notes-column__empty">No notes on this picture with this filter.</p> }
        @{ var whole = OnTheMap.Where(Passes).ToList(); }
        @if (whole.Count > 0)
        {
          <div class="notes-column__group">ON THE WHOLE MAP</div>
          @foreach (var note in whole) { @Row(note) }
        }
        @{ var elsewhere = Elsewhere.Where(Passes).ToList(); }
        @if (elsewhere.Count > 0)
        {
          <div class="notes-column__group">ON OTHER PICTURES</div>
          @foreach (var note in elsewhere) { @Row(note) }
        }
      </div>
      break;

    case NotesStep.Thread when Current is { } note:
      <div class="notes-column__head notes-column__head--step">
        <button type="button" class="notes-column__back" @onclick="OnBack">‹ All notes</button>
        <div class="notes-column__threadhead">
          <span class="@PinClass(note)">@Glyph(note)</span>
          <b class="notes-column__threadtitle">@Title(note)</b>
          <span class="@StatusClass(note.Status)">@NoteStatuses.Label(note.Status)</span>
        </div>
        @if (note.Tag is { } noteTag) { <span class="notes-column__tag">@noteTag</span> }
        @if (ChangesSince(note) is > 0 and var since)
        {
          <button type="button" class="notes-column__since" @onclick="() => OnChangesSince.InvokeAsync(LastChange(note))">
            @since @(since == 1 ? "change" : "changes") since the last message ›
          </button>
        }
      </div>
      <div class="notes-column__thread">
        @for (var i = 0; i < note.Messages.Count; i++)
        {
          var message = note.Messages[i];
          var first = i == 0;
          <div class="@(message.Token is null ? "note-message" : "note-message note-message--agent")" @key="message.Id">
            <div class="note-message__who">
              <b>@message.Author</b>
              <span>· @Ago(message.At)@(message.Token is { } token ? $" · token “{token}”" : "") · change @message.Change</span>
            </div>
            <div class="note-message__body">@message.Body</div>
            @if (message.Picture is { } picture)
            {
              <a class="note-message__picture" href="@($"api/notes/pictures/{picture}")" target="_blank" rel="noopener">
                <img src="@($"api/notes/pictures/{picture}")" alt="@(first ? "The picture the note was written on" : "The same camera after the change")" loading="lazy" />
                <span>@(first ? "before" : "after") · change @message.Change</span>
              </a>
            }
          </div>
        }
        <div class="notes-column__actions">
          @if (note.Status == NoteStatuses.Resolved || note.Status == NoteStatuses.WontDo)
          {
            <Button OnClick="OnReopen" Busy="Busy" BusyLabel="Reopening…">Reopen</Button>
          }
          @if (note.Status != NoteStatuses.Resolved)
          {
            <Button Icon="check" OnClick="OnResolve" Busy="Busy" BusyLabel="Resolving…">Resolve</Button>
          }
        </div>
      </div>
      <div class="notes-column__compose">
        <label class="notes-column__label" for="note-reply">Reply</label>
        <textarea id="note-reply" class="field-input" rows="3" placeholder="Reply…" value="@reply"
                  @oninput="e => reply = e.Value?.ToString() ?? string.Empty"></textarea>
        @if (Error is not null) { <p class="notes-column__error">@Error</p> }
        <div class="notes-column__send">
          <span class="notes-column__hint">A reply hands the thread back to the agent.</span>
          <Button Variant="primary" Disabled="@string.IsNullOrWhiteSpace(reply)" Busy="Busy" BusyLabel="Sending…"
                  OnClick="SendReplyAsync">Send</Button>
        </div>
      </div>
      break;

    case NotesStep.New:
      <div class="notes-column__head notes-column__head--step">
        <button type="button" class="notes-column__back" @onclick="OnBack">‹ All notes</button>
        <b class="notes-column__threadtitle">New note</b>
      </div>
      <div class="notes-column__thread">
        <div class="notes-column__group">PINNED TO</div>
        <div class="notes-column__anchor">
          <b>@AnchorTitle</b>
          <p>@AnchorBody</p>
          @if (HasMark) { <Button OnClick="OnClearMark">Clear the mark</Button> }
        </div>
        @if (!WholeMap)
        {
          <Chip OnClick="OnWholeMap">Pin to the whole map instead</Chip>
        }
      </div>
      <div class="notes-column__compose">
        <label class="notes-column__label" for="note-body">Note</label>
        <textarea id="note-body" class="field-input" rows="4" placeholder="Write a note. A tag is optional." value="@draft"
                  @oninput="e => draft = e.Value?.ToString() ?? string.Empty"></textarea>
        @if (Error is not null) { <p class="notes-column__error">@Error</p> }
        <div class="notes-column__send">
          <label class="notes-column__label" for="note-tag">Tag</label>
          <select id="note-tag" class="field-input notes-column__tagpick" value="@(tag ?? "")"
                  @onchange="e => tag = e.Value?.ToString() is { Length: > 0 } picked ? picked : null">
            <option value="">none</option>
            @foreach (var word in NoteTags.All) { <option value="@word">@word</option> }
          </select>
          <span class="notes-column__hint"></span>
          <Button Variant="primary" Disabled="@(string.IsNullOrWhiteSpace(draft) || !Ready)" Busy="Busy" BusyLabel="Sending…"
                  OnClick="SendNoteAsync">Send</Button>
        </div>
      </div>
      break;
  }
</aside>

@code {
    private RenderFragment Row(MapNoteDto note) => @<button type="button" class="notes-row" @key="note.Id" @onclick="() => OnOpen.InvokeAsync(note)">
        <span class="@PinClass(note)">@Glyph(note)</span>
        <span class="notes-row__text">
          <span class="notes-row__top"><b>@Title(note)</b><span class="@StatusClass(note.Status)">@NoteStatuses.Label(note.Status)</span></span>
          <span class="notes-row__last">@Last(note)</span>
        </span>
      </button>;
}
