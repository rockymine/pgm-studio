@namespace PgmStudio.Client.Features.Sketch

@* Sketch Layout inspector — actions for the selected shape (operation / override / delete) or group
   (rename / mirror participation + its shape list). Edits round-trip to the JS bridge via the host. *@

<Inspector>
    <Section>
      @if (Shape is not null)
      {
        <DetailHeader Icon="@TypeIcon(Shape.Type)" Label="@Shape.Type">
          <span class="detail-header-badges">
            <Badge Class="@(Shape.Operation == "subtract" ? "badge--error" : "badge--success")">@Shape.Operation</Badge>
            @if (Shape.Override) { <Badge Kind="warning">override</Badge> }
            <Badge Kind="neutral">@Shape.Dim</Badge>
          </span>
        </DetailHeader>

        <div class="section-header section-header--ruled"><h2 class="section-title">Actions</h2></div>
        <Button Full OnClick="() => OnToggleOp.InvokeAsync(Shape.Id)">
          @(Shape.Operation == "subtract" ? "Make add" : "Make subtract")
        </Button>
        <Button Full OnClick="() => OnToggleOverride.InvokeAsync(Shape.Id)">
          @(Shape.Override ? "Remove override" : "Set override")
        </Button>
        @if (Shape.Type == "rectangle")
        {
          <Button Full OnClick="() => OnPromoteShape.InvokeAsync(Shape.Id)"
                  Title="Turn this rectangle into a polygon — then drag corners, insert vertices, or curve edges (P)">
            <i data-lucide="pentagon"></i> Convert to polygon
          </Button>
        }
        <Field Label="Height (thickness)">
          <NumberField Value="Shape.BaseHeight" ValueChanged="HeightChanged" Min="1" />
        </Field>
        <Field Label="Floor (elevation)">
          <NumberField Value="Shape.Floor" ValueChanged="FloorChanged" Min="0" />
        </Field>
        @if (string.IsNullOrEmpty(Shape.HeightMode))
        {
          <p class="plan-readout">Top at @(Shape.Floor + Shape.BaseHeight).</p>
        }

        @* How the top is decided once the group carries a relief. Ordinary ground is the default and stays
           it: a shape drawn to make a landmass IS the landmass, and the relief inside it is what the ground
           does. The other three are for a shape meant to stand in the terrain rather than be it. *@
        <Field Label="Stands as">
          <Select Options="HeightModes" Value="@Shape.HeightMode" ValueChanged="HeightModeChanged" />
        </Field>
        @if (HeightModeReadout.Length > 0)
        {
          <p class="plan-readout">@HeightModeReadout</p>
        }
        @if (!string.IsNullOrEmpty(Shape.HeightMode))
        {
          <Field Label="Skirt">
            <LabelHint>(how far in it eases into the ground)</LabelHint>
            <ChildContent>
              <NumberField Value="Shape.Skirt" ValueChanged="SkirtChanged" Min="0" />
            </ChildContent>
          </Field>
          <p class="plan-readout">@SkirtReadout</p>
        }
        else
        {
          @* Whether the shape's ground joins its group's relief. Only asked of a shape that IS ground: one
             standing out of the field already answers it, and a raise reads the ground under its own
             footprint to know where to stand. *@
          <Field Label="Takes part in relief">
            <Select Options="ReliefScopes" Value="@Shape.ReliefScope" ValueChanged="ReliefScopeChanged" />
          </Field>
          @if (ReliefScopeReadout.Length > 0)
          {
            <p class="plan-readout">@ReliefScopeReadout</p>
          }
        }
        <Field Label="Rotate (°)">
          <input @key="rotateNonce" class="field-input" type="number" step="15" placeholder="0" value="@rotateInput" @onchange="RotateChanged" />
        </Field>
        @if (Shape.Type == "polyline")
        {
          <div class="section-header section-header--ruled"><h2 class="section-title">Band</h2></div>
          <Field Label="Width (blocks)">
            <NumberField Value="Shape.Radius * 2" ValueChanged="WidthChanged" Min="2" Step="2" />
          </Field>
          <Field Label="Edge">
            <Select Options="StrokeEdges" Value="@Shape.StrokeEdge" ValueChanged="EdgeChanged" />
          </Field>
          @if (Shape.StrokeEdge == "rough")
          {
            <Field Label="Wander seed">
              <LabelHint>(the same seed wanders the same way on every export)</LabelHint>
              <ChildContent>
                <NumberField Value="Shape.StrokeSeed" ValueChanged="SeedChanged" Min="0" />
              </ChildContent>
            </Field>
          }
        }
        @if (Shape.Type == "polygon" || Shape.Type == "lasso")
        {
          @if (SlopeControls.Count >= 2)
          {
            <div class="section-header section-header--ruled"><h2 class="section-title">Surface slope</h2></div>
            @foreach (var control in SlopeControls)
            {
              <Field Label='@($"Vertex {control.Idx + 1} height")'>
                <NumberField Value="control.Height" ValueChanged="(v) => OnSlopeHeightChanged.InvokeAsync((control.Idx, v))" Min="1" />
              </Field>
            }
            <Button Full OnClick="() => OnApplySlope.InvokeAsync()">
              <i data-lucide="move-3d"></i> Apply slope
            </Button>
            <p class="plan-readout">
              Fits a @(SlopeControls.Count == 2 ? "ramp" : "plane") through @SlopeControls.Count points · shift-click
              a marked one to unmark it
            </p>
          }
          else if (SelectedVertexIdx >= 0)
          {
            <Field Label='@($"Vertex {SelectedVertexIdx + 1} height")'>
              <NumberField Value="SelectedVertexHeight" ValueChanged="VertexHeightChanged" Min="1" />
            </Field>
            <p class="section-desc">Shift-click 2–3 vertices to tilt the whole surface as a slope.</p>
          }
          else
          {
            <p class="section-desc">Click a vertex to set its height, or shift-click 2–3 vertices to tilt the surface as a slope.</p>
          }
        }
        <Button Full Variant="danger" OnClick="() => OnDeleteShape.InvokeAsync(Shape.Id)">
          <i data-lucide="trash-2"></i> Delete
        </Button>
        <p class="section-desc">Move: arrow keys · Shift+arrow = 16 blocks@(Shape.Type == "rectangle" ? " · P = to polygon" : "")@(Shape.Type == "polyline" ? " · drag the points to move the route" : "")</p>
      }
      else if (Group is not null)
      {
        <DetailHeader Icon="layers" Label="@Group.Name">
          <span class="detail-header-badges">
            <Badge Kind="neutral">@Group.ShapeIds.Count shape@(Group.ShapeIds.Count == 1 ? "" : "s")</Badge>
          </span>
        </DetailHeader>

        <Field Label="Name">
          <input class="field-input" value="@Group.Name" @onchange="RenameChanged" />
        </Field>
        <Button Full OnClick="() => OnToggleMirrors.InvokeAsync(Group.Id)">
          @(Group.Mirrors ? "Exclude from mirror" : "Include in mirror")
        </Button>
        <Field Label="Rotate (°)">
          <input @key="rotateNonce" class="field-input" type="number" step="15" placeholder="0" value="@rotateInput" @onchange="RotateChanged" />
        </Field>

        <div class="section-header section-header--ruled"><h2 class="section-title">Shapes</h2></div>
        @foreach (var s in GroupShapes())
        {
          <ListRow Compact>
            <span class="geo-type-icon" style="@(s.Operation == "subtract" ? "color:var(--canvas-sub-fill)" : null)"><i data-lucide="@TypeIcon(s.Type)"></i></span>
            <span class="list-label">@s.Type</span>
            <span class="list-tag">@s.Dim</span>
          </ListRow>
        }
        <p class="section-desc">Move: arrow keys · Shift+arrow = 16 blocks</p>
      }
      else
      {
        <p class="section-desc">Select a shape or group to inspect.</p>
      }
    </Section>
</Inspector>
