@namespace PgmStudio.Client.Features.Sketch

@* Sketch Layout inspector — actions for the selected shape (operation / override / delete) or group
   (rename / mirror participation + its shape list). Edits round-trip to the JS bridge via the host. *@

<Inspector>
  @if (Shape is not null)
  {
    <DetailHeader Icon="@Shape.Icon" Label="@Shape.Name">
      <span class="detail-header-badges">
        <Badge Class="@(Shape.Operation == "subtract" ? "badge--error" : "badge--success")">@(Shape.Operation == "subtract" ? "Carve" : "Build")</Badge>
        @if (Shape.Override) { <Badge Kind="warning">Override</Badge> }
        <Badge Kind="neutral">@Shape.Dim</Badge>
      </span>
    </DetailHeader>

    <Section Title="Actions">
      <Button Full Writes OnClick="() => OnToggleOp.InvokeAsync(Shape.Id)">
        @(Shape.Operation == "subtract" ? "Switch to build" : "Switch to carve")
      </Button>
      <Button Full Writes OnClick="() => OnToggleOverride.InvokeAsync(Shape.Id)">
        @(Shape.Override ? "Clear override" : "Set override")
      </Button>
      @if (Shape.Type == "rectangle")
      {
        <Button Full Writes OnClick="() => OnPromoteShape.InvokeAsync(Shape.Id)">
          <i data-lucide="pentagon"></i> Convert to polygon
        </Button>
      }
    </Section>

    <Section>
      @if (Forms.Length > 1)
      {
        <Field Label="Form">
          <Select Options="Forms" Value="@(Shape.IsSolid ? Shape.Type : "")" ValueChanged="FormChanged" />
        </Field>
      }
      @* A sphere, a torus and an arch are as tall as a radius, a tube and a deck make them. *@
      @if (HasHeight)
      {
        @if (IsLevel)
        {
          <Field Label="Top" Unit="world y">
            <NumberField Value="Shape.Floor + Shape.BaseHeight" ValueChanged="TopChanged" Min="Shape.Floor + 1" aria-label="Top" />
          </Field>
        }
        else
        {
          <Field Label="@HeightLabel" Unit="blocks" Note="@HeightNote">
            <NumberField Value="Shape.BaseHeight" ValueChanged="HeightChanged" Min="1" />
          </Field>
        }
      }
      @if (Shape.Type != "arch")
      {
        <Field Label="Floor" Unit="world y">
          <NumberField Value="Shape.Floor" ValueChanged="FloorChanged" Min="0" aria-label="Floor" />
        </Field>
      }
      @if (TopReadout.Length > 0)
      {
        <Readout>@TopReadout</Readout>
      }
      @if (Shape.IsSolid)
      {
        @if (Shape.Type != "arch")
        {
          <Field Label="Turn" Unit="°" Note="Measured clockwise.">
            <NumberField Value="Shape.Turn" ValueChanged='(v) => SolidChanged("turn", v)' Step="15" />
          </Field>
          <Field Label="Tilt" Unit="°" Note="A positive tilt raises the far end.">
            <NumberField Value="Shape.Tilt" ValueChanged='(v) => SolidChanged("tilt", v)' Min="-90" Max="90" Step="15" />
          </Field>
          <Field Label="Sunk" Unit="blocks" Help="How deep the solid is bedded under its floor.">
            <NumberField Value="Shape.Sunk" ValueChanged='(v) => SolidChanged("sunk", v)' Min="0" />
          </Field>
        }
        @if (Shape.Type == "torus")
        {
          <Field Label="Tube radius" Unit="blocks">
            <NumberField Value="Shape.Tube" ValueChanged='(v) => SolidChanged("tube", v)' Min="1" />
          </Field>
        }
        @if (Shape.Type == "arch")
        {
          <Field Label="Deck at crown" Unit="world y">
            <NumberField Value="Shape.DeckCrown" ValueChanged="CrownChanged" Min="0" aria-label="Deck at crown" />
          </Field>
          <Field Label="Deck at feet" Unit="world y">
            <NumberField Value="Shape.DeckEnd" ValueChanged="FeetChanged" Min="0" aria-label="Deck at feet" />
          </Field>
        }
      }

      @* How the top is decided. Ordinary ground is the default: a shape drawn to make an island is that island's
         ground. The other four are for a shape meant to stand in the ground rather than be it. *@
      @if (!Shape.IsSolid)
      {
        <Field Label="Height mode">
          <Select Options="HeightModes" Value="@Shape.HeightMode" ValueChanged="HeightModeChanged" />
        </Field>
      }
      @if (!string.IsNullOrEmpty(Shape.HeightMode) && !Shape.IsSolid)
      {
        <Field Label="Skirt" Unit="blocks" Term="skirt">
          <NumberField Value="Shape.Skirt" ValueChanged="SkirtChanged" Min="0" />
        </Field>
      }
      else
      {
        @* Whether the modifiers reshape the shape's ground. Only asked of a shape that is ground: one with a
           height mode already stands at its own statement and holds. *@
        <Field Label="Terraform">
          <Select Options="@(Shape.IsSolid ? SketchReliefScopes.Solid : SketchReliefScopes.Ground)" Value="@Shape.ReliefScope" ValueChanged="ReliefScopeChanged" />
        </Field>
      }
      <Field Label="Rotate by" Unit="°">
        <NumberField Value="null" ValueChanged="RotateChanged" Step="15" />
      </Field>
    </Section>

    @if (Shape.Footprint == "polyline")
    {
      <Section Title="Line">
        <Field Label="Width" Unit="blocks">
          <NumberField Value="Shape.Radius * 2" ValueChanged="WidthChanged" Min="2" Step="2" />
        </Field>
        @if (Shape.Type == "polyline")
        {
          <Field Label="Edges">
            <Select Options="StrokeEdges" Value="@Shape.StrokeEdge" ValueChanged="EdgeChanged" />
          </Field>
          @if (Shape.StrokeEdge == "rough")
          {
            <SeedField Label="Edge seed" Value="Shape.StrokeSeed" ValueChanged="seed => SeedChanged(seed)" />
          }
        }
      </Section>
    }
    @if (Shape.Type == "polygon" || Shape.Type == "lasso")
    {
      <Section Title="Surface slope" Description="@SlopeDescription">
        @if (SlopeControls.Count >= 2)
        {
          @foreach (var control in SlopeControls)
          {
            <Field Label='@($"Point {control.Idx + 1} height")' Unit="blocks">
              <NumberField Value="control.Height" ValueChanged="(v) => OnSlopeHeightChanged.InvokeAsync((control.Idx, v))" Min="1" />
            </Field>
          }
          <Button Full Writes OnClick="() => OnApplySlope.InvokeAsync()">
            <i data-lucide="move-3d"></i> Apply slope
          </Button>
          <Readout>Fits a @(SlopeControls.Count == 2 ? "ramp" : "plane") through @SlopeControls.Count points.</Readout>
        }
        else if (SelectedVertexIdx >= 0)
        {
          <Field Label='@($"Point {SelectedVertexIdx + 1} height")' Unit="blocks">
            <NumberField Value="SelectedVertexHeight" ValueChanged="VertexHeightChanged" Min="1" />
          </Field>
        }
      </Section>
    }
    <InspectorDelete Title="Delete this shape" OnClick="() => OnDeleteShape.InvokeAsync(Shape.Id)" />
  }
  else if (Group is not null)
  {
    <DetailHeader Icon="layers" Label="@Group.Name">
      <span class="detail-header-badges">
        <Badge Kind="neutral">@Group.ShapeIds.Count shape@(Group.ShapeIds.Count == 1 ? "" : "s")</Badge>
      </span>
    </DetailHeader>

    <Section>
      <Field Label="Name">
        <input class="field-input" value="@Group.Name" @onchange="RenameChanged" />
      </Field>
      <Button Full Writes OnClick="() => OnToggleMirrors.InvokeAsync(Group.Id)">
        @(Group.Mirrors ? "Stop copying" : "Copy for other teams")
      </Button>
      <Field Label="Rotate by" Unit="°">
        <NumberField Value="null" ValueChanged="RotateChanged" Step="15" />
      </Field>
    </Section>

    <Section Title="Shapes">
      @foreach (var s in GroupShapes())
      {
        <ListRow Compact>
          <span class="@(s.Operation == "subtract" ? "geo-type-icon geo-type-icon--subtract" : "geo-type-icon")"><i data-lucide="@s.Icon"></i></span>
          <span class="list-label">@s.Name</span>
          <span class="list-tag">@s.Dim</span>
        </ListRow>
      }
    </Section>
  }
  else
  {
    <Section>
      <EmptyState>No shape selected. Click a shape or a group to edit it.</EmptyState>
    </Section>
  }
</Inspector>
