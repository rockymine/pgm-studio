@namespace PgmStudio.Client.Features.Sketch

@* Which storey is being drawn on, as canvas chrome, and where one is added and removed. A layer is a
   property of the board rather than of any one phase — the same as the mirror axis and the chunk grid,
   which is why it hangs off the canvas and is therefore present wherever the canvas is. Whatever is placed
   lands on the active layer; the others ghost.

   The storeys are switched, added and deleted here and nowhere else, because a list offering the same three
   verbs in two places is two places to keep in step. What stays in the Draw sidebar is the active storey's
   settings — its name and its base Y — which are settings rather than a mode. *@

@if (Layers.Count > 1 || AllowEdit)
{
  <div class="canvas-layer-strip" role="group" aria-label="Storey">
    <span class="canvas-layer-strip-label">Storey</span>
    @foreach (var layer in Layers)
    {
      <span class="canvas-layer-tab-wrap @(layer.Id == ActiveId ? "canvas-layer-tab-wrap--on" : null)" @key="layer.Id">
        <button type="button" class="canvas-layer-tab" title="@($"Draw on '{layer.Name}', based at y {layer.BaseY}")"
                aria-pressed="@(layer.Id == ActiveId)" @onclick="() => OnSelect.InvokeAsync(layer.Id)">
          <span class="canvas-layer-tab-name">@layer.Name</span>
          <span class="canvas-layer-tab-y">y @layer.BaseY</span>
        </button>
        @* The last storey has no delete: a board always stands on one, and a strip with nothing on it is
           not a board with no storeys but a board whose storey cannot be reached. *@
        @if (AllowEdit && Layers.Count > 1)
        {
          <button type="button" class="canvas-layer-del" title="@($"Delete '{layer.Name}'")"
                  @onclick="() => OnDelete.InvokeAsync(layer.Id)">
            <i data-lucide="x" @key="@($"del-{layer.Id}")"></i>
          </button>
        }
      </span>
    }
    @if (AllowEdit)
    {
      <button type="button" class="canvas-layer-add" title="Add a storey above" @onclick="OnAdd">
        <i data-lucide="plus" @key="@("plus")"></i>
      </button>
    }
  </div>
}

@code {
    [Parameter] public IReadOnlyList<SketchLayerRow> Layers { get; set; } = [];
    [Parameter] public string? ActiveId { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<string> OnDelete { get; set; }

    /// <summary>Whether the set of storeys can be changed from here. Adding and removing one is drawing
    /// work, so only Draw offers it; every other phase switches between the storeys that exist.</summary>
    [Parameter] public bool AllowEdit { get; set; }
}
