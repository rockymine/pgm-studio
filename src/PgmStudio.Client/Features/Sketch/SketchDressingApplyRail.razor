@namespace PgmStudio.Client.Features.Sketch

@* Apply-step controls for the Dressing phase, shown beneath the island tree: pick a dressing and place it on
   the island or shape selected in the tree. The map default sits under everything. Dressings are defined in
   the previous step; here they are only chosen and placed — the twin of the Theme phase's apply rail. *@

<Section Title="Map default">
  <p class="section-desc">The lowest layer — grows on every cell no shape claims.</p>
  <Field>
    <select class="field-input" value="@MapDressing" @onchange="OnMapDefault">
      <option value="">(nothing grows)</option>
      @foreach (var id in Dressings) { <option value="@id">@id</option> }
    </select>
  </Field>
</Section>

<Section Title="Dressing to place">
  @if (Dressings.Count == 0)
  {
    <p class="section-desc">No dressings yet — define one in the previous step, then place it here.</p>
  }
  else
  {
    @foreach (var id in Dressings)
    {
      <ListRow Compact Selected="@(id == Picked)" @key="id" OnClick="() => Pick(id)">
        <span class="list-label list-label--mono">@id</span>
        @if (MapDressing == id) { <Badge Kind="neutral">map default</Badge> }
      </ListRow>
    }
    @if (Picked is not null)
    {
      <figure class="theme-section-figure">@((MarkupString)(Preview?.Section ?? ""))</figure>
    }
  }
</Section>

<Section Title="Selection">
  @if (!HasSelection)
  {
    <p class="section-desc">Select an island or a shape in the tree above, then place a dressing. An island
      dresses all its shapes; a shape dresses just itself.</p>
  }
  else
  {
    var current = SelectionDressing();
    <div class="theme-apply-sel-row">
      <span class="list-label list-label--mono">@(SelectedIslandId ?? SelectedShapeId)</span>
      <Badge Kind="dim">@(SelectedIslandId is not null ? "island" : "shape")</Badge>
      @if (current == MixedMarker) { <Badge Kind="neutral">mixed</Badge> }
      else if (!string.IsNullOrEmpty(current)) { <Badge Kind="neutral">@current</Badge> }
      else { <span class="section-desc">— bare —</span> }
    </div>
    <div class="panel-actions">
      <Button Variant="primary" Icon="trees" OnClick="Apply" Disabled="@(Picked is null)">
        Grow @Picked
      </Button>
      <Button Icon="eraser" OnClick="Remove">Clear</Button>
    </div>
  }
</Section>
