@namespace PgmStudio.Client.Features.Sketch

@* Where a note's thread stands, as a badge: open in the accent, answered done, waiting on the author a warning,
   and closed either way neutral. *@

<Badge Kind="@Kind" data-status="@Status">@NoteStatuses.Label(Status)</Badge>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = default!;

    private string Kind => Status switch
    {
        NoteStatuses.Open => "accent",
        NoteStatuses.Answered => "success",
        NoteStatuses.NeedsInfo => "warning",
        _ => "neutral",
    };
}
