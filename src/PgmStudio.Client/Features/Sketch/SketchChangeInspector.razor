@namespace PgmStudio.Client.Features.Sketch

@* One change, or the changes since one: who wrote it and why, where its documents came from, every edit it made
   to the three documents, and the columns the build moved with them — the same colours the canvas draws them in.
   Putting the map back writes the documents as they stood at the start of what is shown, as a new change. *@

<Inspector>
  <DetailHeader Icon="history" Label="@Title" />
  <Section>
    @if (Change is null)
    {
      <EmptyState>No change selected. Pick one in the list to see what it did.</EmptyState>
    }
    else
    {
      <Readout>@SketchHistoryList.Who(Change) · @Moments.Ago(Change.At) · changed the @SketchHistoryList.Documents(Change.Documents)</Readout>
      @if (Change.Note is { Length: > 0 } note) { <p class="change-note">"@note"</p> }
      @if (Change.Discarded is { Count: > 0 } dropped)
      {
        <Readout>Discarded @string.Join(", ", dropped.Select(number => $"#{number}")), which its writer hadn't seen.</Readout>
      }
      @if (OriginLink is { } link)
      {
        <Readout><a href="@link" target="_blank" rel="noopener">@OriginText</a></Readout>
      }
    }
  </Section>
  @if (Change is not null)
  {
    <Section Title="Edits">
      <div class="change-legend" aria-label="Colours on the map">
        <span><span class="change-legend__swatch change-legend__swatch--added"></span>Added</span>
        <span><span class="change-legend__swatch change-legend__swatch--removed"></span>Removed</span>
        <span><span class="change-legend__swatch change-legend__swatch--reshaped"></span>Reshaped</span>
        <span><span class="change-legend__swatch change-legend__swatch--changed"></span>Changed</span>
      </div>
      @if (Diff is null)
      {
        <StatusLine>Comparing…</StatusLine>
      }
      else if (Diff.Edits.Count == 0)
      {
        <EmptyState>No edits in this change.</EmptyState>
      }
      else
      {
        <div class="change-edits">
          @foreach (var edit in Diff.Edits.Take(Shown))
          {
            <div class="change-edit">
              <span class="change-edit__subject">@Subject(edit)</span>
              <span class="change-edit__says">@edit.Says</span>
            </div>
          }
        </div>
        @if (Diff.Edits.Count > Shown)
        {
          <Readout>And @(Diff.Edits.Count - Shown) more.</Readout>
        }
      }
    </Section>
    @if (SpanNotes.Count > 0)
    {
      <Section Title="Notes written">
        @foreach (var (note, message) in SpanNotes)
        {
          <button type="button" class="notes-row" @key="note.Id" @onclick="() => OnOpenNote.InvokeAsync(note.Id)">
            <b title="@SketchNotesColumn.Title(note)">@SketchNotesColumn.Title(note)</b>
            <span class="notes-row__meta">
              <NoteStatus Status="@note.Status" />
              <span class="notes-row__last">@Writers.Name(message.Author, message.Token): @message.Body</span>
            </span>
            <span class="notes-row__thread">
              <span class="@SketchNotesColumn.PinClass(note)"></span>@SketchNotesColumn.MessageCount(note)
            </span>
          </button>
        }
      </Section>
    }
    <Section Title="World" Description="@(World is not null ? "The changed columns are boxed on the canvas." : null)">
      @if (World is { } world)
      {
        <div class="change-world">
          <span><span class="change-world__swatch change-world__swatch--ground"></span>Ground @world.Ground.Columns</span>
          <span><span class="change-world__swatch change-world__swatch--surface"></span>Surface @world.Surface.Columns</span>
          <span><span class="change-world__swatch change-world__swatch--structure"></span>Structure @world.Structure.Columns</span>
        </div>
      }
      else if (WorldError is not null)
      {
        <StatusLine>@WorldError</StatusLine>
      }
      else
      {
        <StatusLine>Building both versions…</StatusLine>
      }
    </Section>
    <Section>
      <Button Variant="primary" Icon="undo-2" Disabled="@(From == 0 || From == Latest)" Busy="Restoring"
              BusyLabel="Restoring…" Writes Title="@RestoreClosed" OnClick="() => History.RestoreAsync(From)">
        Restore to #@From
      </Button>
      @if (RestoreReadout is { } restoreReadout) { <Readout>@restoreReadout</Readout> }
      @if (RestoreError is not null) { <p class="field-error">@RestoreError</p> }
    </Section>
  }
</Inspector>
