@namespace PgmStudio.Client.Features.Sketch

@* Every change to the map's documents, newest first: its number, what its writer said it is or which documents
   it wrote, who wrote it and when. Picking one draws what it did on the canvas and opens it in the inspector. *@

<Section Title="Change history" Variant="list">
  <div class="panel-list">
    @if (History.ChangesError is not null)
    {
      <StatusLine>@History.ChangesError</StatusLine>
    }
    else if (Changes is null)
    {
      <StatusLine>Loading changes…</StatusLine>
    }
    else if (Changes.Count == 0)
    {
      <EmptyState>No changes yet. Every save to this map adds one.</EmptyState>
    }
    else
    {
      @foreach (var change in Changes.Reverse())
      {
        <ListRow Compact Class="list-row--two-line" Selected="@(History.SpanTo == change.Number)" @key="change.Number"
                 OnClick="() => History.PickChange(change.Number)">
          <span class="list-tag">#@change.Number</span>
          <span class="list-row__text">
            <span class="list-label">@Said(change)</span>
            <span class="list-row__meta">@Who(change) · @Moments.Ago(change.At)</span>
          </span>
        </ListRow>
      }
    }
  </div>
</Section>
