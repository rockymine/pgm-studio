@namespace PgmStudio.Client.Features.Sketch
@using PgmStudio.Vocabulary

@* The picked modifier: what it does, its numbers, and the areas of its mask. Every field writes through the
   bridge, so each change is one undo step and the board's contours, paint and 3-D answer it. *@

<Inspector>
  <DetailHeader Icon="@SketchModifierState.Icon(Op)" Label="@ModifierOps.Label(Op)">
    <span class="detail-header-badges">
      <Button Variant="icon" Icon="x" Title="Done: show the terraform marks" OnClick="Close" />
      <Button Variant="icon" Icon="trash-2" Writes Title="Delete this modifier" OnClick="Delete" />
    </span>
  </DetailHeader>
  <p class="section-desc">@SketchModifierState.Blurb(Op)</p>
  @if (Changed is { } columns && !ModifierOps.Carves(Op))
  {
    <p class="inspector-readout">@ChangedLine(columns)</p>
  }

  <Field Label="Name">
    <input class="field-input" value="@(Modifier["name"]?.GetValue<string>() ?? "")" placeholder="@Id"
           @onchange="e => SetText(Name, e.Value?.ToString())" />
  </Field>
  <label class="check-row">
    <input type="checkbox" checked="@(!SketchModifierState.Off(Modifier))" @onchange="e => SetBool(Off, e.Value is not true)" />
    On — switched off, it keeps its numbers and changes nothing
  </label>

  @switch (Op)
  {
    case ModifierOps.Mound:
      @NumberRow("Rise", Rise, 8, "blocks at its deepest point; negative with Cut sinks a dish")
      @NumberRow("Shoulder", Power, 1.6, "above 1 it holds full height further out", min: 0.1)
      @NumberRow("Join", Join, 0, "0 keeps the higher of two areas; above, they melt into a ridge", min: 0)
      break;
    case ModifierOps.Crater:
      @NumberRow("Floor", Floor, 0, "the world y of its floor")
      @NumberRow("Flat floor", Flat, 0, "blocks out from its middle", min: 0)
      @NumberRow("Wall slope", Slope, 1, "blocks up per block out", min: 0)
      @NumberRow("Melt", Melt, 0, "blocks over which its rim rounds into the ground", min: 0)
      @NumberRow("Join", Join, 0, "how overlapping areas add up", min: 0)
      break;
    case ModifierOps.Level:
      @NumberRow("Height", Top, null, "the world y it holds; empty takes the median of the ground")
      @NumberRow("Flat out to", Inner, 1, "1 is the mask's rim", min: 0)
      @NumberRow("Skirt out to", Outer, 1.5, "where it has eased back to the ground", min: 0)
      break;
    case ModifierOps.Ridge:
      @NumberRow("Rise", Rise, 8, "blocks at the crest", step: "0.5")
      @NumberRow("Wander", Wander, 2, "how far noise pushes the foot off the line", min: 0, step: "0.5")
      break;
    case ModifierOps.Butte:
      @NumberRow("Top", Top, null, "the world y of its flat top; empty is the median ground plus 12")
      @NumberRow("Cliff", Cliff, 1.5, "blocks over which its face drops", min: 0, step: "0.5")
      @NumberRow("Talus", Talus, 6, "blocks of loose slope at its foot", min: 0)
      @NumberRow("Apron", Apron, 0.3, "how much of the face's height the talus keeps", min: 0, max: 1, step: "0.05")
      @NumberRow("Jag", Jag, 0.12, "how ragged the edge is", min: 0, step: "0.01")
      break;
    case ModifierOps.Spire:
      @NumberRow("Top", Top, null, "the world y of its tip; empty is the median ground plus 20")
      @NumberRow("Taper", Taper, 1.6, "above 1 it narrows faster toward the tip", min: 0.1, step: "0.1")
      @NumberRow("Jag", Jag, 0.15, "how ragged the flanks are", min: 0, step: "0.01")
      break;
    case ModifierOps.Scarp:
      @NumberRow("Height", Height, 6, "blocks the raised side stands above the other")
      <Field Label="Raised side">
        <LabelHint>(walking along the line as it was traced)</LabelHint>
        <ChildContent>
          <Select Slim="false" Options="Sides" Value="@(Number(Modifier, Side) == -1 ? "-1" : "1")"
                  ValueChanged="SetSide" />
        </ChildContent>
      </Field>
      @NumberRow("Cliff", Cliff, 2, "blocks over which the face rises", min: 0, step: "0.5")
      @NumberRow("Talus", Talus, 5, "blocks of loose slope below the face", min: 0)
      break;
    case ModifierOps.Canyon:
      @NumberRow("Depth", Depth, 12, "blocks below the ground it cuts", min: 0)
      @NumberRow("Floor share", Bed, 0.35, "the share of the width that is flat floor", min: 0, max: 1, step: "0.05")
      @NumberRow("Wall", Wall, 2.5, "how steep the walls are", min: 0.1, step: "0.1")
      @NumberRow("Ledges", Ledges, 0, "steps cut into the walls", min: 0, max: 6)
      break;
    case ModifierOps.River:
      @NumberRow("Bed depth", Depth, 2, "blocks the bed is cut below the ground", min: 0, step: "0.5")
      @NumberRow("Water depth", Water, 1, "blocks of water standing in the bed", min: 0, step: "0.5")
      @NumberRow("Bank", Bank, 4, "blocks over which the banks ease back into the ground", min: 0)
      @BedRow
      break;
    case ModifierOps.Lake:
      @NumberRow("Level", Level, null, "the world y of the water surface; empty is one below the ground most of the rim stands above")
      @NumberRow("Depth", Depth, 3, "blocks the basin is cut below the surface", min: 0, step: "0.5")
      @NumberRow("Shore", Shore, 3, "blocks over which the shore eases into the ground", min: 0)
      @BedRow
      break;
    case ModifierOps.Road:
      @NumberRow("Grade", Grade, 0.25, "the most it may climb per block along its run", min: 0, step: "0.05")
      @NumberRow("Shoulder", Shoulder, 4, "blocks over which its edges ease into the slope", min: 0)
      break;
    case ModifierOps.Gullies:
      @NumberRow("Count", Count, 8, "how many channels", min: 1, max: 64)
      @NumberRow("Depth", Depth, 3, "blocks each is cut", min: 0, step: "0.5")
      @NumberRow("Wander", Wander, 0.9, "how much each meanders as it falls", min: 0, step: "0.1")
      @NumberRow("Sharpness", Sharpness, 3, "how narrow and steep their sides are", min: 0.1, step: "0.1")
      break;
    case ModifierOps.Warp:
      @NumberRow("Amount", Amount, 6, "blocks the ground is shifted by", min: 0, step: "0.5")
      @NumberRow("Cell", Cell, 24, "the size of the noise that shifts it", min: 1)
      break;
    case ModifierOps.Profile:
      @NumberRow("Floor", Floor, null, "the world y of a flat floor; empty follows the ground")
      <Field Label="Shaped side">
        <LabelHint>(walking along the line as it was traced)</LabelHint>
        <ChildContent>
          <Select Slim="false" Options="ProfileSides" Value="@(Number(Modifier, Side) is { } hand ? (hand < 0 ? "-1" : "1") : "")"
                  ValueChanged="SetProfileSide" />
        </ChildContent>
      </Field>
      @NumberRow("Jag", Jag, 1.5, "blocks each step's edge wanders in and out", min: 0, step: "0.5")
      @NumberRow("Talus", Talus, 0, "blocks of slope banked against the first cliff", min: 0)
      @NumberRow("Apron", Apron, 0.3, "how much of the first step the talus climbs", min: 0, max: 1, step: "0.05")
      <div class="section-header section-header--ruled"><h2 class="section-title">Steps</h2></div>
      <p class="section-desc">Out from the line: where each cliff starts and ends, in blocks, and how far over the floor it climbs.</p>
      @for (var index = 0; index < Steps.Count; index++)
      {
        var at = index;
        var step = Steps[at];
        <div class="modifier-size">
          <Field Label="Start"><NumberField Value="Number(step, Start)" ValueChanged="v => SetStep(at, Start, v)" Min="0" /></Field>
          <Field Label="End"><NumberField Value="Number(step, End)" ValueChanged="v => SetStep(at, End, v)" Min="0" /></Field>
          <Field Label="Rise"><NumberField Value="Number(step, Rise)" ValueChanged="v => SetStep(at, Rise, v)" /></Field>
          <Button Variant="icon" Icon="trash-2" Writes Title="Remove this step" Disabled="@(Steps.Count == 1)" OnClick="() => RemoveStep(at)" />
        </div>
      }
      <Button Icon="plus" Writes OnClick="AddStep">Add a step</Button>
      break;
    case ModifierOps.Coast:
      @NumberRow("Sea level", Level, null, "the world y of the sea; empty is one below the ground most of the rim stands above")
      @NumberRow("Shelf", Shelf, 10, "blocks inland over which the land eases down to the beach", min: 1)
      @NumberRow("Depth", Depth, 6, "the deepest the sea floor lies under the surface", min: 0, step: "0.5")
      @NumberRow("Floor slope", Slope, 0.35, "blocks the floor falls per block out from the shore", min: 0, step: "0.05")
      @BedRow
      break;
    case ModifierOps.Lumps:
      @NumberRow("Count", Count, 12, "how many are strewn; one whose middle misses the mask is not placed", min: 1, max: 200)
      @RangeRow("Length", Across, 6, 16, "blocks along the long axis, least to most", min: 1)
      @RangeRow("Height", Heights, 2, 5, "blocks high, least to most", min: 0)
      @RangeRow("Width share", Stretch, 0.5, 1, "the short axis as a share of the long", min: 0.05, max: 1, step: "0.05")
      @NumberRow("Heading", Angle, null, "degrees they line up along; empty turns each at random")
      @NumberRow("Jag", Jag, 0.25, "how ragged each foot is", min: 0, step: "0.05")
      @NumberRow("Shoulder", Power, 1.8, "above 1 each holds its height further out", min: 0.1, step: "0.1")
      break;
    case ModifierOps.Shatter:
      @NumberRow("Piece size", Cell, 10, "blocks across one piece", min: 2)
      @NumberRow("Lift", Amount, 3, "the most a piece rises or drops, in blocks", min: 0, step: "0.5")
      @NumberRow("Tilt", Tilt, 0.25, "the steepest a piece leans, blocks per block", min: 0, step: "0.05")
      @NumberRow("Cleft", Gap, 1, "blocks either side of a seam cut into a cleft; 0 for none", min: 0, step: "0.5")
      @NumberRow("Cleft depth", Depth, 4, "how deep the clefts are cut", min: 0, step: "0.5")
      @NumberRow("Wander", Wander, 3, "how far the seams bend", min: 0, step: "0.5")
      break;
    case ModifierOps.Tunnel:
      @NumberRow("Cover", Cover, 3, "the fewest blocks of ground kept over it, away from its mouths", min: 0)
      @NumberRow("Mouth", Mouth, 4, "blocks in from each end it opens through its cover", min: 0)
      @NumberRow("Sag", Sag, 0, "blocks its floor dips under the straight run between its ends at the middle")
      @NumberRow("Wander", Wander, 0.2, "how much its width breathes along the run", min: 0, max: 1, step: "0.05")
      <p class="section-desc">Each end's floor is the ground there; a point may state its own floor as a third number.</p>
      @DressRow
      break;
    case ModifierOps.Chamber:
      @NumberRow("Floor", Floor, null, "the world y of its floor; empty is its cover and height under the lowest ground")
      @NumberRow("Height", Height, 6, "blocks its dome stands over the floor at the middle", min: 1)
      @NumberRow("Cover", Cover, 3, "the fewest blocks of ground kept over it", min: 0)
      @NumberRow("Jag", Jag, 0.15, "how ragged its wall is", min: 0, step: "0.05")
      @DressRow
      break;
    case ModifierOps.Shaft:
      @NumberRow("Floor", Floor, null, "the world y of its floor; empty is sixteen under the lowest ground")
      <label class="check-row">
        <input type="checkbox" checked="@(Modifier[LadderField]?.GetValue<bool>() != false)"
               @onchange="e => SetBool(LadderField, e.Value is true)" />
        A ladder up its south wall
      </label>
      @DressRow
      break;
    case ModifierOps.Noise:
      <div class="section-header section-header--ruled"><h2 class="section-title">Sizes</h2></div>
      @for (var index = 0; index < Sizes.Count; index++)
      {
        var at = index;
        var size = Sizes[at];
        <div class="modifier-size">
          <Field Label="Cell"><NumberField Value="Number(size, Cell)" ValueChanged="v => SetSize(at, Cell, v)" Min="1" /></Field>
          <Field Label="Octaves"><NumberField Value="Number(size, Octaves)" ValueChanged="v => SetSize(at, Octaves, v)" Min="1" Max="6" /></Field>
          <Field Label="Rise"><NumberField Value="Number(size, Rise)" ValueChanged="v => SetSize(at, Rise, v)" Step="0.5" /></Field>
          <Button Variant="icon" Icon="trash-2" Writes Title="Remove this size" Disabled="@(Sizes.Count == 1)" OnClick="() => RemoveSize(at)" />
        </div>
      }
      <Button Icon="plus" Writes OnClick="AddSize">Add a size</Button>
      break;
  }

  @NumberRow("Seed", Seed, 1, "which noise it reads", min: 1)
  @NumberRow("Soft rim", Soft, null, "share of the mask over which the change fades in; empty is none", min: 0, max: 1, step: "0.05")
  @if (Op != ModifierOps.Level)
  {
    <Field Label="Mode">
      <Select Slim="false" Options="Modes" Value="@(Modifier[Mode]?.GetValue<string>() ?? "")" ValueChanged="v => SetText(Mode, v)" />
    </Field>
  }

  <div class="section-header section-header--ruled"><h2 class="section-title">Mask</h2></div>
  <label class="check-row">
    <input type="checkbox" checked="@Mirrored" @onchange="e => SetMirror(e.Value is true)" />
    Mirrored by the map's symmetry
  </label>
  <p class="inspector-readout">@AreaLine</p>
  @for (var index = 0; index < Areas.Count; index++)
  {
    @if (SketchModifierState.IsLine(Areas[index]))
    {
      var at = index;
      <Field Label="@LineWidthLabel(at)">
        <LabelHint>(blocks, the band either side of the line is half)</LabelHint>
        <ChildContent>
          <NumberField Value="Number(Areas[at], Width) ?? DefaultLineWidth" ValueChanged="v => SetLineWidth(at, v)" Min="1" />
        </ChildContent>
      </Field>
    }
  }
  <Button Icon="plus" Writes OnClick="AddOutline"
          Title="@(HasLine ? "Trace another line on the board; it joins this mask" : "Trace another outline on the board; it joins this mask")">@(HasLine ? "Add a line" : "Add an outline")</Button>

  @if (Leavable.Count > 0)
  {
    <div class="section-header section-header--ruled"><h2 class="section-title">Leaves out</h2></div>
    <p class="section-desc">Shapes ticked here keep their ground: this modifier does not touch their columns.</p>
    @foreach (var shape in Leavable)
    {
      <label class="check-row" @key="shape.Id">
        <input type="checkbox" checked="@Leaves.Contains(shape.Id)" @onchange="e => SetLeaves(shape.Id, e.Value is true)" />
        @ShapeLabel(shape)
      </label>
    }
  }
  @if (!string.IsNullOrEmpty(error))
  {
    <p class="field-error">@error</p>
  }
</Inspector>

@code {
    private RenderFragment DressRow => __builder =>
    {
        <label class="check-row">
          <input type="checkbox" checked="@(Modifier[DressField]?.GetValue<bool>() != false)"
                 @onchange="e => SetBool(DressField, e.Value is true)" />
          Dressed — gravel and clay floors, stalactites, ore in the faces
        </label>
    };

    private RenderFragment BedRow => __builder =>
    {
        <Field Label="Bed">
          <LabelHint>(under its water and along its beach; empty is the default bank)</LabelHint>
          <ChildContent>
            <SlotSelect Styles="styles" Blocks="blocks" Value="@BedSlot.StyleId" Block="@BedSlot.Block"
                        Unbound="@BedUnbound" ValueChanged="FillBed" />
          </ChildContent>
        </Field>
    };

    private RenderFragment RangeRow(string label, string field, double least, double most, string hint,
                                    double? min = null, double? max = null, string step = "1") => __builder =>
    {
        var (low, high) = RangeOf(field, least, most);
        <Field Label="@label">
          <LabelHint>(@hint)</LabelHint>
          <ChildContent>
            <div class="modifier-size">
              <NumberField Value="@low" ValueChanged="v => SetRange(field, v, high)" Min="min" Max="max" Step="@step" />
              <NumberField Value="@high" ValueChanged="v => SetRange(field, low, v)" Min="min" Max="max" Step="@step" />
            </div>
          </ChildContent>
        </Field>
    };

    private RenderFragment NumberRow(string label, string field, double? fallback, string hint,
                                     double? min = null, double? max = null, string step = "1") => __builder =>
    {
        <Field Label="@label">
          <LabelHint>(@hint)</LabelHint>
          <ChildContent>
            <NumberField Value="@(Number(Modifier, field) ?? fallback)" ValueChanged="v => SetNumber(field, v)"
                         OnCleared="() => Clear(field)" Min="min" Max="max" Step="@step" />
          </ChildContent>
        </Field>
    };
}
