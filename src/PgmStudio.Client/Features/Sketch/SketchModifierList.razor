@namespace PgmStudio.Client.Features.Sketch
@using PgmStudio.Vocabulary

@* The modifier stack, in the order it runs: each row picks its modifier, switches it off and on, and moves it up
   or down the order. A modifier is added by tracing its outline with its tool in the dock. *@

<Section Title="Modifiers">
  @if (State.Modifiers.Count == 0)
  {
    <p class="section-desc">No modifier yet. Pick one in the dock and drag its outline on the board; each changes the ground inside it, in this list's order.</p>
  }
  else
  {
    <div class="region-tree" role="listbox" aria-label="Modifiers, in the order they run">
      @for (var index = 0; index < State.Modifiers.Count; index++)
      {
        var modifier = State.Modifiers[index];
        var id = SketchModifierState.Id(modifier);
        var off = SketchModifierState.Off(modifier);
        var at = index;
        <div class="geo-row modifier-row @(id == State.SelectedId ? "geo-row--selected" : null) @(off ? "modifier-row--off" : null)"
             @key="id" role="option" aria-selected="@(id == State.SelectedId)" @onclick="() => Pick(id)">
          <span class="geo-type-icon"><i data-lucide="@SketchModifierState.Icon(SketchModifierState.Op(modifier))"></i></span>
          <span class="geo-label">@SketchModifierState.Name(modifier)</span>
          <span class="list-tag">@ModifierOps.Label(SketchModifierState.Op(modifier))</span>
          <span class="modifier-row-tools" @onclick:stopPropagation>
            <Button Variant="icon" Icon="chevron-up" Writes Title="Run earlier" Disabled="@(at == 0)" OnClick="() => Move(id, -1)" />
            <Button Variant="icon" Icon="chevron-down" Writes Title="Run later" Disabled="@(at == State.Modifiers.Count - 1)" OnClick="() => Move(id, 1)" />
            <Button Variant="icon" Icon="eye" Writes Class="@(off ? "modifier-eye--off" : null)"
                    Title="@(off ? "Switched off: switch on" : "Switch off, keeping its numbers")" OnClick="() => Toggle(id, !off)" />
          </span>
        </div>
      }
    </div>
  }
</Section>
