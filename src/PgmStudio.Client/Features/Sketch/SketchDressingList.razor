@namespace PgmStudio.Client.Features.Sketch

@* What is placed on the map, as a list. The canvas is the primary way to reach a prop, but a small marker in a
   dense corner is hard to hit, and a list is the one view that says how much has been placed at all. *@

<Section Title="Placed">
  <Actions>
    @if (total > 0) { <span class="list-tag" title="Props placed on the map">@total</span> }
  </Actions>
  <ChildContent>
    @if (total == 0)
    {
      <p class="section-desc">Nothing placed yet. Pick a tool and place something.</p>
    }
    else
    {
      <div class="region-tree">
        @foreach (var group in groups)
        {
          var open = !collapsed.Contains(group.Kind);
          var fold = $"{(open ? "Collapse" : "Expand")} {group.Title.ToLowerInvariant()}";
          <div class="geo-row geo-row--group" @key="group.Kind" @onclick="() => Toggle(group.Kind)" title="@fold">
            <span class="geo-indent">
              <button type="button" class="collapse-btn" @key="open" aria-expanded="@(open ? "true" : "false")"
                      aria-label="@fold" @onclick="() => Toggle(group.Kind)" @onclick:stopPropagation="true">
                <i data-lucide="@(open ? "chevron-down" : "chevron-right")"></i>
              </button>
            </span>
            <span class="geo-type-icon"><i data-lucide="@group.Icon"></i></span>
            <span class="geo-label">@group.Title</span>
            <span class="list-tag">@group.Rows.Count</span>
          </div>
          @if (open)
          {
            @foreach (var row in group.Rows)
            {
              <div id="@RowElementId(row.Id)" class="geo-row @(row.Id == selectedId ? "geo-row--selected" : null)" @key="row.Id"
                   data-kind="@group.Kind" tabindex="0" role="button" aria-pressed="@(row.Id == selectedId ? "true" : "false")"
                   @onclick="() => Select(row.Id)" @onkeydown="key => OnRowKey(key, row.Id)"
                   @onmouseenter="() => Hover(row.Id)" @onmouseleave="() => Hover(null)"
                   @onfocus="() => Hover(row.Id)" @onblur="() => Hover(null)">
                <span class="geo-indent"><span class="indent-pipe"></span></span>
                <span class="geo-label" title="@row.Label">@row.Label</span>
                <span class="list-tag" title="@row.WhereTitle">@row.Where</span>
              </div>
            }
          }
        }
      </div>
    }
  </ChildContent>
</Section>
