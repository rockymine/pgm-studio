@namespace PgmStudio.Client.Features.Sketch

@* What the terrain CHARGES, per group. Deliberately not a score: a relief that is walkable everywhere is a
   field rather than a map, so one number would rank every barrier an author placed on purpose as a defect.
   Every reading here is per passability tier, and the two that decide whether a relief added pressure or broke
   the map — places and ledges — sit next to each other for exactly that comparison. *@

<Section Title="What it charges">
  @if (groups.Count == 0)
  {
    <p class="section-desc">Nothing measured yet. Press <strong>Measure</strong>.</p>
  }
  else
  {
    @* What the read complains about, above the numbers it complained from. A measurement that names a fault
       and leaves the author to find it in the table is half a reading. *@
    @if (complaints.Count > 0)
    {
      <div class="plan-lint-list">
        @foreach (var complaint in complaints)
        {
          <div class="plan-lint-row plan-lint-row--static" @key="complaint">
            <span class="plan-lint-dot plan-lint-dot--lint"></span>
            @if (complaint.Rule.Length > 0) { <span class="plan-lint-chip">@complaint.Rule</span> }
            <span class="plan-lint-msg">@complaint.Message</span>
          </div>
        }
      </div>
    }

    @foreach (var group in groups)
    {
      <div class="readback" @key="group.Id">
        <div class="readback-head">
          <span class="geo-label">@group.Id</span>
          <span class="list-tag">y @group.Low–@group.High · @group.Relief blocks of relief</span>
        </div>

        @* How much of it a player can stand still on. Every other reading here is a step, and a step cannot
           tell a field from a ramp: ground graded end to end crosses perfectly and has nowhere to stop. *@
        <div class="readback-head">
          <span class="list-tag">@Pct(group.Level) level · largest field @Pct(group.LargestField)</span>
        </div>

        @* The three thresholds the game actually has. None is a fault and a good map is a mix, so these are
           reported side by side rather than scored against the flattest. *@
        <table class="readback-table">
          <thead>
            <tr><th>Crossing</th><th>Open</th><th>Places</th><th>Largest</th><th>Ledges</th></tr>
          </thead>
          <tbody>
            @foreach (var tier in group.Tiers)
            {
              <tr @key="tier.Name">
                <td>@TierWord(tier.Name)</td>
                <td>@Pct(tier.Share)</td>
                <td>@tier.Places</td>
                <td>@Pct(tier.LargestPlace)</td>
                <td>@tier.Ledges</td>
              </tr>
            }
          </tbody>
        </table>

        @* A count says the board is broken and nothing else. What an author needs before they can fix it is
           where the piece is, so every piece but the one they are standing on is listed with its middle. *@
        @{ var stranded = group.Tiers.FirstOrDefault(t => t.Name == "walk")?.Parts.Skip(1).ToList() ?? []; }
        @if (stranded.Count > 0)
        {
          <p class="section-desc">Cut off on foot, largest first:</p>
          <ul class="list-plain">
            @foreach (var part in stranded)
            {
              <li @key="part">
                <span class="list-tag">@(part.Place ? "place" : "ledge")</span>
                @part.Cells cells (@Pct(part.Share)) around @part.CentroidX, @part.CentroidZ
              </li>
            }
          </ul>
        }

        @* A barrier is usually not a wall but a detour, and a drop is free the way it falls — so a crossing is
           counted in both directions or it cannot tell the two apart. *@
        <table class="readback-table">
          <thead>
            <tr><th>Rows</th><th>On foot</th><th>With a block</th><th>Descended</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>west–east</td>
              <td>@group.AcrossX.OnFoot / @group.AcrossX.Rows</td>
              <td>@group.AcrossX.WithBlock</td>
              <td>@group.AcrossX.Descended</td>
            </tr>
            <tr>
              <td>north–south</td>
              <td>@group.AcrossZ.OnFoot / @group.AcrossZ.Rows</td>
              <td>@group.AcrossZ.WithBlock</td>
              <td>@group.AcrossZ.Descended</td>
            </tr>
          </tbody>
        </table>

        <div class="readback-head">
          <span class="list-tag">@group.FaceCount faces · @group.Cliffs @(group.Cliffs == 1 ? "cliff" : "cliffs")</span>
          @if (group.SymmetryError > 0)
          {
            <Badge Kind="warning">@group.SymmetryError off its mirror</Badge>
          }
          else if (group.Symmetric)
          {
            <Badge Kind="ok">mirrors exactly</Badge>
          }
        </div>

        @if (group.Faces.Count > 0)
        {
          <p class="section-desc">
            Widest face @group.Faces[0].Width wide, dropping @group.Faces[0].Drop.
            @if (group.Cliffs == 0)
            {
              <text>Nothing wide enough to read as a cliff — these are banks.</text>
            }
          </p>
        }

        @* The one reading that names statements rather than ground. A wall between two marks reads through
           every row above as terrain, so this is where an author learns which two to go and change. *@
        @if (group.Seams.Count > 0)
        {
          <table class="readback-table">
            <thead>
              <tr><th>Marks that meet on a step</th><th>Step</th><th>At</th><th>Cells</th></tr>
            </thead>
            <tbody>
              @foreach (var seam in group.Seams)
              {
                <tr @key="seam">
                  <td>@seam.A | @seam.B</td>
                  <td>@seam.Step</td>
                  <td>@seam.X, @seam.Z</td>
                  <td>@seam.Cells</td>
                </tr>
              }
            </tbody>
          </table>
        }

        @if (group.SilentMarks.Count > 0)
        {
          <p class="section-desc">
            Pinned nothing: <strong>@string.Join(", ", group.SilentMarks)</strong>.
          </p>
        }
      </div>
    }
  }

  <Button Full Variant="ghost" Busy="@busy" BusyLabel="Measuring…" OnClick="Measure">
    <i data-lucide="ruler"></i> Measure
  </Button>
</Section>
