@page "/maps/{Slug}/sketch"
@layout StudioLayout
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable

@* Sketch tool — Layout step. Blazor renders the topbar + toolbar + svg shell; the reused SketchCanvas
   JS (via bridge/sketch-bridge.js) owns drawing, the live group computation, and the mirror preview.
   Persistence (load/save) is wired in S2d; this step is the draw + live-groups experience. *@

<StudioShell>
  <Bar>
    <Topbar HomeHref="maps?stage=sketch" HomeLabel="Sketches" HomeTitle="Back to sketches">
      <Crumbs>
        <Crumb>@Slug.Replace('_', ' ')</Crumb>
        <Crumb Dim>Sketch</Crumb>
      </Crumbs>
      <Right>
        @if (saveError is not null) { <span class="topbar-crumb topbar-crumb--warn" title="@saveError">@saveError</span> }
        @if (downloadError is not null) { <span class="topbar-crumb topbar-crumb--warn" title="@downloadError">@downloadError</span> }
        @if (exportRefused) { <Button Href="@($"maps/{Slug}/configure")" Icon="settings-2">Open Configure</Button> }
        <span class="topbar-crumb topbar-crumb--dim">@groupLabel</span>
        <Button Variant="icon" Icon="undo-2" Title="Undo" Disabled="@(!canUndo)" Writes OnClick="Undo" />
        <Button Variant="icon" Icon="redo-2" Title="Redo" Disabled="@(!canRedo)" Writes OnClick="Redo" />
        <Button Variant="primary" Icon="download" Busy="downloading" BusyLabel="Building…" Builds OnClick="DownloadMap"
                Title="Download the map: its world and map.xml, ready for a server">Download map</Button>
      </Right>
    </Topbar>
  </Bar>
  <Rail>
    <NavRail>
      <NavButton Icon="book-open-text" Title="Info" Active="@InfoActive" OnClick="GoInfo" />
      <NavButton Icon="pencil-ruler" Title="Draw" Active="@DrawActive" OnClick="GoDraw" />
      <NavButton Icon="mountain" Title="Terraform" Active="@ReliefActive" OnClick="GoRelief" />
      <NavButton Icon="palette" Title="Palette" Active="@ThemeActive" OnClick="GoTheme" />
      <NavButton Icon="trees" Title="Decoration" Active="@DressingActive" OnClick="GoDressing" />
      <NavButton Icon="eye" Title="In game" Active="@InGameActive" OnClick="GoInGame" />
      <NavButton Icon="history" Title="History" Active="@HistoryActive" OnClick="GoHistory" />
      <NavButton Icon="clipboard" Title="Report" Active="@ReportActive" OnClick="GoReport" />
    </NavRail>
  </Rail>
  <ChildContent>
      <WriteGate OnChanged="OnWriteReason" />
      @if (InfoActive)
      {
        <SketchInfoPhase Slug="@Slug" OnNext="GoDraw"
                         Mode="@mode" CenterX="@centerX" CenterZ="@centerZ"
                         OnModeChange="OnModeChange" OnCenterX="OnCenterX" OnCenterZ="OnCenterZ" />
      }
      @* The gallery is a page of pictures rather than a canvas; placing a view of one's own is the canvas's, so
         the shared body below comes back for it. *@
      @if (InGameActive && !placingView)
      {
        <SketchInGamePhase Slug="@Slug" Views="views" Error="@viewsError" Refusal="@viewsRefusal" Round="viewRound" Tick="followTick"
                           LinkedNote="linkedNote" OnLinkOpened="LinkOpened"
                           OnBack="GoDressing" OnPlace="PlaceView" OnLetGo="LetGoView" OnPicture="PictureView"
                           Changes="ChangeNumbers" OnChangesSince="ShowChangesSince" OnRedraw="RedrawInGame" />
      }
      @if (ReportActive)
      {
        <SketchReportPhase Slug="@Slug" Report="report" Error="@reportError" OnBack="GoHistory" OnRead="LoadReportAsync" />
      }
      @* Every phase that draws shares the one mounted canvas, so this body stays present (hidden while Info is
         up) — [hidden] is display:none, and the canvas re-measures on unhide. A phase swaps what the columns
         hold and which overlays the bar offers; the canvas is reused as it stands. *@
      <div class="phase-body" hidden="@(!(DrawActive || ThemeActive || DressingActive || ReliefActive || PlacingViewActive || HistoryActive))">
      @if (ThemeActive)
      {
        <FlowBar Class="flow-bar--flush" PhaseIcon="palette" PhaseTitle="Palette"
                 BackEnabled="true" NextLabel="Done" NextEnabled="true" OnBack="GoRelief" OnNext="GoDressing" />
      }
      else if (DressingActive)
      {
        <FlowBar Class="flow-bar--flush" PhaseIcon="trees" PhaseTitle="Decoration"
                 BackEnabled="true" NextLabel="Done" NextEnabled="true" OnBack="GoTheme" OnNext="GoInGame" />
      }
      else if (ReliefActive)
      {
        <FlowBar Class="flow-bar--flush" PhaseIcon="mountain" PhaseTitle="Terraform"
                 BackEnabled="true" NextLabel="Done" NextEnabled="true" OnBack="GoDraw" OnNext="GoTheme" />
      }
      else if (HistoryActive)
      {
        <FlowBar Class="flow-bar--flush" PhaseIcon="history" PhaseTitle="History"
                 BackEnabled="true" NextLabel="Draw" NextEnabled="true" OnBack="GoInGame" OnNext="GoDraw" />
      }
      else if (PlacingViewActive)
      {
        <FlowBar Class="flow-bar--flush" PhaseIcon="eye" PhaseTitle="Place a view"
                 BackEnabled="true" NextLabel="Gallery" NextEnabled="true" OnBack="ShowGallery" OnNext="ShowGallery" />
      }
      else
      {
        <FlowBar Class="flow-bar--flush" PhaseIcon="pencil-ruler" PhaseTitle="Draw"
                 BackEnabled="true" NextLabel="Done" NextEnabled="true"
                 OnBack="GoInfo" OnNext="GoRelief" />
      }
      <Workspace>
        <Sidebar>
          @if (ThemeActive)
          {
            @* What exists, and nothing more: the theme in hand is on the strip and what it lands on is in the
               inspector, so the column stays the one list a phase can always show. *@
            <SketchPanel Groups="groups" Shapes="shapes" SelectedShapeId="@selectedShapeId" SelectedGroupId="@selectedGroupId"
                         OnSelectShape="SelectShape" OnSelectGroup="SelectGroup" />
          }
          else if (HistoryActive)
          {
            <SketchHistoryList Changes="changes?.Changes" Picked="spanTo" Error="@changesError" OnPick="PickChange" />
          }
          else if (DressingActive)
          {
            @* Dressing places things on the map rather than assigning recipes to shapes, so its sidebar is the
               list of what is placed — the group tree would only offer a selection nothing here acts on. *@
            <SketchDressingList StateJson="@dressingJson" Handle="handle" />
          }
          else if (PlacingViewActive)
          {
            @* Every camera the gallery has, as the canvas draws it: the views kept, then the studio's
               suggestions. Choosing one here picks it up as a press on its camera would. *@
            <Section Title="Kept views">
              <div class="panel-list">
                @foreach (var kept in KeptViews)
                {
                  <ListRow Compact Selected="@(viewDraft?.Source?.Id == kept.Id)" @key="kept.Id" OnClick="() => SelectView(kept)">
                    <span class="geo-type-icon"><i data-lucide="camera"></i></span>
                    <span class="list-label">@kept.Name</span>
                    <span class="list-tag">@kept.LookX, @kept.LookZ</span>
                  </ListRow>
                }
              </div>
            </Section>
            @if (SuggestedViews.Count > 0)
            {
              <Section Title="Suggested">
                <div class="panel-list">
                  @foreach (var suggested in SuggestedViews)
                  {
                    <ListRow Compact Selected="@(viewDraft?.Source?.Id == suggested.Id)" @key="suggested.Id" OnClick="() => SelectView(suggested)">
                      <span class="geo-type-icon"><i data-lucide="camera"></i></span>
                      <span class="list-label">@suggested.Name</span>
                      <span class="list-tag">@suggested.LookX, @suggested.LookZ</span>
                    </ListRow>
                  }
                </div>
              </Section>
            }
          }
          else if (ReliefActive)
          {
            @* Relief needs BOTH: the group tree, because the group is the unit a relief is solved over and
               picking one is how its base and grain are reached; and the list of what is stated, because a
               spot height under a broad bench is a small target on the canvas. *@
            <SketchPanel Groups="groups" Shapes="shapes" SelectedShapeId="@selectedShapeId" SelectedGroupId="@selectedGroupId"
                         OnSelectShape="SelectShape" OnSelectGroup="SelectGroup" />
            <SketchReliefList StateJson="@reliefJson" Handle="handle" />
          }
          else
          {
            <SketchLayers Layers="layerRows" ActiveId="@activeLayerId"
                          OnRename="RenameLayer" OnSetBaseY="SetLayerBaseY" />
            <SketchPanel Groups="groups" Shapes="shapes" SelectedShapeId="@selectedShapeId" SelectedGroupId="@selectedGroupId"
                         OnSelectShape="SelectShape" OnSelectGroup="SelectGroup" />
          }
        </Sidebar>
        <div class="sidebar-handle"></div>
        <div class="workspace-canvas">
          <div @ref="wrapRef" class="svg-area">
            <svg @ref="svgRef" class="map-canvas-svg" xmlns="http://www.w3.org/2000/svg"></svg>
          </div>

          <CanvasReadout @ref="readout" ShowSize />

          @* The chips mean different things either side of the toggle. In 2-D they are overlays over the
             drawing; in 3-D they are the board's own layers, one chip each, because the thing
             an author wants in a preview of a stack is to take the deck off and look under it. A board of
             one layer shows none — there is nothing to take off — and the rotate replaces fit either way. *@
          <CanvasLayerBar>
            @if (!threeD)
            {
              @if (ChipOffered(ChipShapes))
              {
                <LayerChip Icon="shapes" Active="shapesOn" Title="Show the drawn shapes"
                           OnClick="ToggleShapes">Shapes</LayerChip>
              }
              @if (ChipOffered(ChipMirror))
              {
                <LayerChip Icon="flip-horizontal-2" Active="mirrorOn" Title="Show the mirrored copies"
                           OnClick="ToggleMirror">Mirror</LayerChip>
              }
              @if (ChipOffered(ChipChunks))
              {
                <LayerChip Icon="grid" Active="chunksOn" Title="Show the 16-block chunk grid"
                           OnClick="ToggleChunks">Chunks</LayerChip>
              }
              @if (ChipOffered(ChipBlocks))
              {
                <LayerChip Icon="box" Active="blocksOn" Title="@BlocksChipTitle"
                           OnClick="ToggleBlocks">Blocks</LayerChip>
              }
              @if (ChipOffered(ChipRelief))
              {
                <LayerChip Icon="mountain" Active="reliefOn" Title="Show height contours"
                           OnClick="ToggleRelief">Contours</LayerChip>
              }
              <CanvasRoundButton Icon="scan" Title="Zoom to fit (F)" OnClick="OnFit" />
            }
            else
            {
              @foreach (var id in isoLayers)
              {
                <LayerChip Icon="layers" Active="@(!isoHidden.Contains(id))"
                           Title="@($"Show layer '{id}'")"
                           OnClick="@(() => ToggleIsoLayer(id))">@id</LayerChip>
              }
              <CanvasRoundButton Icon="rotate-cw" Title="Rotate the preview 90°" OnClick="RotateIso" />
            }
            @if (isoUnavailable)
            {
              <span class="canvas-note" title="@IsoNoteTitle">@IsoNote</span>
            }
            @* The picture is the world the export builds, so where the drawing and the build disagree the
               screen shows the build and says nothing about the difference. Name the shapes; the finding's
               own sentence, on hover, says what happened to which. *@
            @if (threeD && IsoContested.Count > 0)
            {
              <span class="canvas-note canvas-note--warn" title="@IsoContestedWhy">
                Built differently from the drawing: @string.Join(", ", IsoContested)
              </span>
            }
            @* Placing a view is 2-D only: the eye is stood on a map of the board. *@
            @if (!PlacingViewActive)
            {
              <ViewModeToggle ThreeD="threeD" Disabled="@isoUnavailable"
                              Title="@(isoUnavailable ? IsoNoteTitle : "3-D preview (read-only)")"
                              OnClick="Toggle3D" />
            }
          </CanvasLayerBar>

          @* A layer is the board's rather than a phase's, so the switch is chrome and every phase that
             draws the canvas has it. Adding and removing one is drawing work, so only Draw offers those. *@
          @if (!threeD)
          {
            <SketchLayerStrip Layers="layerRows" ActiveId="@activeLayerId" OnSelect="SelectLayer"
                              OnAdd="AddLayer" OnDelete="DeleteLayer" AllowEdit="@DrawActive" />
          }

          @* What is in hand, where a thing in hand belongs. The Theme phase's every click is addressed to it. *@
          @if (ThemeActive && !threeD)
          {
            <SketchThemeStrip Themes="themeIds" Brush="@themeBrush" MapTheme="@mapThemeId" AddOpen="themeAddOpen"
                              OnTake="TakeTheme" OnAdd="() => themeAddOpen = !themeAddOpen" />
          }

          @* Nothing is drawn in the isometric preview, so the dock goes with the tools it holds. *@
          @if (!threeD)
          {
          <CanvasDock>
            @* Getting around the canvas and picking what is already on it — the whole dock in a select-only
               phase (Theme). Every group after this one authors something, which is Draw's and Dressing's. *@
            <DockGroup Viewing>
              <DockButton Icon="mouse-pointer-2" Title="Select" Active="@(tool == "select")"
                          OnClick='() => SetTool("select")' />
              <DockButton Icon="hand" Title="Move" Active="@(tool == "move")"
                          OnClick='() => SetTool("move")' />
            </DockGroup>
            @if (DressingActive)
            {
              <DockGroup>
                @foreach (var placer in DressingTools.All)
                {
                  <DockButton Icon="@placer.Icon" Title="@placer.Name" @key="placer.Tool"
                              Active="@(tool == placer.Tool)" OnClick="() => SetTool(placer.Tool)" />
                }
              </DockGroup>
            }
            else if (PlacingViewActive)
            {
              <DockGroup>
                <DockButton Icon="camera" Title="Place a view: press where to stand, then drag toward the target"
                            Active="@(tool == "eye")" OnClick='() => SetTool("eye")' />
              </DockGroup>
            }
            else if (ReliefActive)
            {
              <DockGroup>
                @foreach (var stater in ReliefTools.All)
                {
                  <DockButton Icon="@stater.Icon" Title="@stater.Name" @key="stater.Tool"
                              Active="@(tool == stater.Tool)" OnClick="() => SetTool(stater.Tool)" />
                }
              </DockGroup>
            }
            else if (!ScopeApplyActive && !HistoryActive)
            {
              @* The three tools that make a shape, and the operation the shape will perform, in one box wearing
                 one colour — so an armed carve cannot be read as an armed build. What a drawn shape does to
                 the land is not a sibling of the tool that draws it, so the word leads the group rather than
                 being a fourth glyph in it. *@
              <DockGroup Accent="@OpAccent" Idle="@(!DrawToolActive)">
                <DockModeButton Pressed="@Carving" Title="@OpTitle" OnClick="ToggleOperation">@(Carving ? "Carve" : "Build")</DockModeButton>
                <DockButton Icon="rectangle-horizontal" Title="Rectangle" Active="@(tool == "rectangle")"
                            OnClick='() => SetTool("rectangle")' />
                <DockButton Icon="pentagon" Title="Polygon" Active="@(tool == "polygon")"
                            OnClick='() => SetTool("polygon")' />
                <DockButton Icon="lasso" Title="Lasso" Active="@(tool == "lasso")"
                            OnClick='() => SetTool("lasso")' />
              </DockGroup>
              @* Reads and cuts what is already drawn — neither makes land, so neither takes the operation
                 colour and both sit in their own box. *@
              <DockGroup>
                <DockButton Icon="ruler" Title="Measure" Active="@(tool == "measure")" OnClick='() => SetTool("measure")' />
                <DockButton Icon="scissors" Title="Split" Active="@(tool == "split")" OnClick='() => SetTool("split")' />
                @* Not an overlay: it changes what a drag does rather than what is drawn, so it sits with the
                   tools that drag rather than in the bar that says what is shown. *@
                <DockButton Icon="magnet" Title="Snap to shape edges (hold Alt to skip)"
                            Active="@snapOn" OnClick="ToggleSnap" />
              </DockGroup>
            }
          </CanvasDock>
          }
        </div>
        @if (HistoryActive)
        {
          <div class="sidebar-handle"></div>
          <SketchChangeInspector Change="SpanChange" From="spanFrom" To="@(spanTo ?? 0)" Latest="LatestChange"
                                 Diff="spanDiff" World="spanWorld" WorldError="@spanWorldError"
                                 Restoring="restoring" RestoreError="@restoreError" OnRestore="RestoreAsync"
                                 Notes="SpanNotes" OnOpenNote="OpenNoteFromHistory" />
        }
        else if (DressingActive)
        {
          <div class="sidebar-handle"></div>
          <SketchDressingInspector Handle="handle" ActiveTool="@tool" StateJson="@dressingJson" Layers="layerRows" />
        }
        else if (PlacingViewActive)
        {
          <div class="sidebar-handle"></div>
          <SketchViewDraft Slug="@Slug" Draft="viewDraft" Round="viewRound" Note="@viewNote" OnAimed="OnViewAimed"
                           OnKeep="KeepView" OnDiscard="DiscardView" />
        }
        else if (ReliefActive)
        {
          <div class="sidebar-handle"></div>
          <SketchReliefInspector Handle="handle" ActiveTool="@tool" StateJson="@reliefJson" />
        }
        else if (ThemeActive)
        {
          <div class="sidebar-handle"></div>
          <SketchThemeInspector Handle="handle" Themes="themeIds" Brush="@themeBrush" MapTheme="@mapThemeId"
                                ThemeSources="themeSources"
                                BiomeSource="biomeSource" BiomeJson="@biomeJson" BiomeChanged="ReadBiome"
                                ShapeThemes="shapeThemes" ShapeCount="themedShapeTotal" Revision="themeRevision"
                                SelectedGroupId="@selectedGroupId" SelectedShapeId="@selectedShapeId"
                                TargetShapeIds="ScopeTargetShapeIds"
                                AddOpen="themeAddOpen" AddOpenChanged="v => themeAddOpen = v"
                                OnHold="SetThemeBrush" OnChanged="ReadThemes" />
        }
        else if (selectedStructural is not null)
        {
          @* A picked plan piece answers a rail of its own: its geometry is the plan's, and the one thing
             here is the height a region was compiled at. *@
          <div class="sidebar-handle"></div>
          <SketchStructuralInspector Piece="selectedStructural" Note="@structuralNote"
                                     OnSetHeight="SetStructuralHeight" OnClose="ClearStructural" />
        }
        else
        {
          <div class="sidebar-handle"></div>
          <SketchInspector Handle="handle" Shape="SelectedShape" Group="SelectedGroup" Shapes="shapes"
                           OnToggleOp="ToggleOp" OnToggleOverride="ToggleOverride" OnDeleteShape="DeleteShape"
                           OnPromoteShape="PromoteShape" OnSetHeight="SetHeight" OnToggleMirrors="ToggleMirrors" OnRenameGroup="RenameGroup"
                           OnRotate="Rotate" OnSetStrokeBand="SetStrokeBand"
                           SelectedVertexIdx="selectedVertexIdx" SelectedVertexHeight="selectedVertexHeight" OnSetVertexHeight="SetVertexHeight"
                           SlopeControls="slopeControls" OnSlopeHeightChanged="SetSlopeHeight" OnApplySlope="ApplySlope" />
        }
      </Workspace>
      </div>
  </ChildContent>
</StudioShell>
