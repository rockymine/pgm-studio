@page "/maps/{Slug}/sketch"
@layout StudioLayout
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable

@* Sketch tool. Blazor renders the editor bar, the dock and the svg shell; the SketchCanvas JS (via
   bridge/sketch-bridge.js) owns drawing, the live group computation and the symmetry preview. *@

@{ var move = BarMove; }
<StudioShell Focused="true">
  <Bar>
    <EditorBar MapName="@(string.IsNullOrWhiteSpace(mapName) ? Slug.Replace('_', ' ') : mapName)" Slug="@Slug" Stage="@MapStage.Sketch"
               PhaseTitle="@move.Title" Steps="@move.Steps" CurrentStep="@move.Step" NoMove="@(!move.Moves)"
               BackEnabled="true" NextLabel="@move.NextLabel" NextEnabled="@move.NextOpen"
               OnBack="move.OnBack" OnNext="move.OnNext">
      <State>
        @if (SaveState is { } saveState) { <span role="status">@saveState</span> }
        @if (ProblemsShown)
        {
          <span class="problems-pop-host">
            @* Keyed on its state: the glyph changes with it, and lucide has already swapped the old one for an svg. *@
            <button type="button" @key="Stopped" class="problems-btn@(Stopped ? null : " problems-btn--warn")" aria-expanded="@(popOpen ? "true" : "false")"
                    @onclick="() => TogglePop(null)">
              <Icon Name="@(Stopped ? "circle-x" : "triangle-alert")" />@ProblemsLabel<span class="problems-btn-n">@ProblemRules</span>
            </button>
            @if (popOpen)
            {
              <div class="problems-pop" role="dialog" aria-label="This map's problems">
                <ProblemList Problems="problems" Only="popOnly" OpenFirst Actions="ConfigureActions">
                  <Head>
                    <div class="section-header section-header--ruled">
                      <h3 class="section-title">This map</h3>
                      <Button Variant="icon" Icon="x" Title="Close" OnClick="ClosePop" />
                    </div>
                    @if (UnlistedRefusal is { } refusalSentence) { <p class="problems-verdict">@refusalSentence</p> }
                    @if (exportRefused && downloadRefusal is { Findings.Count: 0 })
                    {
                      <Button Href="@($"maps/{Slug}/configure")" Icon="settings-2">Open Configure</Button>
                    }
                  </Head>
                </ProblemList>
              </div>
            }
          </span>
        }
      </State>
      <History>
        <Button Variant="icon" Icon="undo-2" Title="Undo" Disabled="@(!canUndo)" Writes OnClick="Undo" />
        <Button Variant="icon" Icon="redo-2" Title="Redo" Disabled="@(!canRedo)" Writes OnClick="Redo" />
      </History>
      <Commands>
        <Button Variant="icon" Icon="download" Busy="downloading" Builds OmitClosed OnClick="DownloadMap"
                Title="@(downloading ? "Building the map…" : DownloadTitle)" aria-label="@DownloadTitle" aria-busy="@(downloading ? "true" : null)" />
      </Commands>
    </EditorBar>
  </Bar>
  <Rail>
    @* Only the active phase lists its steps, so every phase is handed the open one's. History is not a phase of the
       work, so it stands at the rail's foot, outside Back and Next. *@
    <NavRail FoldKey="sketch" Label="Sketch chapters">
      <ChildContent>
        <NavButton Icon="book-open-text" Title="Identity" Active="@InfoActive" OnClick="GoInfo"
                   Steps="@move.Steps" CurrentStep="@move.Step" OnStep="move.OnStep" />
        <NavButton Icon="pencil-ruler" Title="Draw" Active="@DrawActive" OnClick="GoDraw"
                   Steps="@move.Steps" CurrentStep="@move.Step" OnStep="move.OnStep" />
        <NavButton Icon="mountain" Title="Terraform" Active="@ReliefActive" OnClick="GoRelief" />
        <NavButton Icon="palette" Title="Palette" Active="@ThemeActive" OnClick="GoTheme" />
        <NavButton Icon="trees" Title="Decoration" Active="@DressingActive" OnClick="GoDressing" />
        <NavButton Icon="eye" Title="Review" Active="@ReviewActive" OnClick="GoReview"
                   Steps="@move.Steps" CurrentStep="@move.Step" OnStep="move.OnStep" />
      </ChildContent>
      <Foot>
        <NavButton Icon="history" Title="History" Active="@HistoryActive" OnClick="GoHistory" />
      </Foot>
    </NavRail>
  </Rail>
  <ChildContent>
      <WriteGate OnChanged="OnWriteReason" />
      @if (InfoActive)
      {
        <SketchInfoPhase Slug="@Slug" Step="infoStep" OnRenamed="renamed => mapName = renamed" OnSaveStatus="status => infoSave = status"
                         Mode="@mode" CenterX="@centerX" CenterZ="@centerZ"
                         OnModeChange="OnModeChange" OnCenterX="OnCenterX" OnCenterZ="OnCenterZ" />
      }
      @* Review's Notes step is a page of pictures rather than a canvas; its Cameras step is the canvas's, so the
         shared body below comes back for it. *@
      @if (NotesActive)
      {
        <SketchNotesStep Slug="@Slug" Views="views" Notes="notes" LinkedNote="linkedNote" OnLinkOpened="LinkOpened"
                         Changes="history.ChangeNumbers" OnChangesSince="ShowChangesSince" OnRedraw="RedrawReview" />
      }
      @* Every phase that draws shares the one mounted canvas, so this body stays present (hidden while Info is
         up) — [hidden] is display:none, and the canvas re-measures on unhide. A phase swaps what the columns
         hold and which overlays the bar offers; the canvas is reused as it stands. *@
      <div class="phase-body" hidden="@(!(DrawActive || ThemeActive || DressingActive || ReliefActive || CamerasActive || HistoryActive))">
      <Workspace>
        <Sidebar>
          @* A layer is the board's rather than a phase's, so its list heads every sidebar the canvas has. *@
          <SketchLayerList Layers="layerRows" ActiveId="@activeLayerId" PickedId="@PickedLayer?.Id" Hidden="hiddenLayers"
                           ActiveEyeClosed="@(iso.ThreeD ? null : "The layer being drawn on is always shown")"
                           AllowAdd="@DrawActive" OnPick="PickLayer" OnAdd="AddLayer" OnShow="ShowLayer" />
          @if (ThemeActive)
          {
            @* What exists, and nothing more: the theme in hand is on the strip and what it lands on is in the
               inspector, so the column stays the one list a phase can always show. *@
            <SketchPanel Groups="groups" Shapes="shapes" SelectedShapeId="@selectedShapeId" SelectedGroupId="@selectedGroupId"
                         OnSelectShape="SelectShape" OnSelectGroup="SelectGroup" />
            <SketchPaintRuleList Handle="handle" PaintJson="@themes.PaintJson" SelectedId="@paintRuleId"
                                 OnSelect="SelectPaintRule" />
          }
          else if (HistoryActive)
          {
            <SketchHistoryList History="history" />
          }
          else if (DressingActive)
          {
            @* Dressing places things on the map rather than assigning recipes to shapes, so its sidebar is the
               list of what is placed — the group tree would only offer a selection nothing here acts on. *@
            <SketchDressingList StateJson="@dressingJson" Handle="handle" />
          }
          else if (CamerasActive)
          {
            <SketchViewList Views="views" />
          }
          else if (PlacesActive)
          {
            <SketchPlacesList Places="PlaceList" SelectedId="@selectedPlaceId" OnSelect="SelectPlace" Notes="notes.All"
                              Verdict="@placesDocument.Verdict" OnVerdict="SetVerdict" />
          }
          else if (ReliefActive)
          {
            <SketchModifierList Handle="handle" State="modifiers" Shapes="shapes" />
          }
          else if (LayoutActive)
          {
            @* Layout is about the pieces, so its list is of them; the shapes are Ground's. *@
            <SketchPiecesList Pieces="pieceRows" SelectedId="@selectedStructural?.Id" OnSelect="PickPiece" />
          }
          else
          {
            <SketchPanel Groups="groups" Shapes="shapes" SelectedShapeId="@selectedShapeId" SelectedGroupId="@selectedGroupId"
                         OnSelectShape="SelectShape" OnSelectGroup="SelectGroup" />
          }
        </Sidebar>
        <div class="sidebar-handle"></div>
        <div class="workspace-canvas">
          <div @ref="wrapRef" class="svg-area">
            <svg @ref="svgRef" class="map-canvas-svg" xmlns="http://www.w3.org/2000/svg"></svg>
          </div>

          <CanvasReadout @ref="readout" ShowSize OnZoomClick="OnFit" />

          @* The chips are overlays over the drawing, and 2-D's alone: in 3-D a layer is taken off by its eye in the
             sidebar's list, and the rotate replaces fit. *@
          <CanvasOverlayBar>
            @if (!iso.ThreeD)
            {
              @if (ChipOffered(ChipShapes))
              {
                <OverlayChip Icon="shapes" Active="shapesOn" Title="@ChipShapesTitle"
                           OnClick="ToggleShapes">Shapes</OverlayChip>
              }
              @if (ChipOffered(ChipMirror))
              {
                <OverlayChip Icon="flip-horizontal-2" Active="mirrorOn" Title="@ChipMirrorTitle"
                           OnClick="ToggleMirror">Mirror</OverlayChip>
              }
              @if (ChipOffered(ChipChunks))
              {
                <OverlayChip Icon="grid" Active="chunksOn" Title="@ChipChunksTitle"
                           OnClick="ToggleChunks">Chunks</OverlayChip>
              }
              @if (ChipOffered(ChipBlocks))
              {
                <OverlayChip Icon="box" Active="blocksOn" Title="@ChipBlocksTitle"
                           OnClick="ToggleBlocks">Blocks</OverlayChip>
              }
              @if (ChipOffered(ChipRelief))
              {
                <OverlayChip Icon="mountain" Active="reliefOn" Title="@ChipContoursTitle"
                           OnClick="ToggleRelief">Contours</OverlayChip>
              }
              <CanvasRoundButton Icon="scan" Title="Zoom to fit (F)" OnClick="OnFit" />
            }
            else
            {
              <CanvasRoundButton Icon="rotate-cw" Title="Turn clockwise" OnClick="iso.RotateAsync" />
            }
            @* The picture is the world the export builds, so where the drawing and the build disagree the
               screen shows the build and says nothing about the difference. Name the shapes; the finding's
               own sentence, on hover, says what happened to which. *@
            @if (iso.ThreeD && isoNotBuilt.Count > 0)
            {
              <button type="button" class="problems-btn problems-btn--warn canvas-problems"
                      @onclick="() => TogglePop(ProblemKind.LeftOut)">
                <i data-lucide="triangle-alert"></i>@isoNotBuilt.Count left out
              </button>
            }
            @if (editNote is not null)
            {
              <span class="canvas-note canvas-note--warn" role="status">@editNote</span>
            }
            @* Placing a view is 2-D only: the eye is stood on a map of the canvas. *@
            <IsoToggle View="iso" OfferToggle="@(!CamerasActive)" />
          </CanvasOverlayBar>

          @* What is in hand, where a thing in hand belongs. The Theme phase's every click is addressed to it. *@
          @if (ThemeActive && !iso.ThreeD)
          {
            <SketchThemeStrip Themes="themes" Brush="@themeBrush" AddOpen="themeAddOpen"
                              OnTake="TakeTheme" OnAdd="() => themeAddOpen = !themeAddOpen" />
          }

          @* The ground read after the first few modifiers, in the picture and in 2-D alike. *@
          @if (ReliefActive)
          {
            <SketchStepStrip State="modifiers" OnStep="SetStep" />
          }

          @* Nothing is drawn in the isometric preview, so the dock goes with the tools it holds. *@
          @if (!iso.ThreeD)
          {
          <CanvasDock FlyoutOpen="@(openFlyout is not null)" OnDismissFlyout="CloseFlyouts">
            @* Getting around the canvas and picking what is already on it — the whole dock in a select-only
               phase (Theme). Every group after this one authors something, which is Draw's and Dressing's. *@
            <DockGroup Viewing>
              <DockButton Icon="mouse-pointer-2" Title="Select" Active="@(tool == "select")"
                          OnClick='() => SetTool("select")' />
              <DockButton Icon="hand" Title="Pan" Active="@(tool == "move")"
                          OnClick='() => SetTool("move")' />
            </DockGroup>
            @if (DressingActive)
            {
              <DockGroup>
                @foreach (var placer in DressingTools.All)
                {
                  var named = PropKindNames.Of(placer.Kind);
                  <DockButton Icon="@named.Icon" Title="@named.One" @key="placer.Tool"
                              Active="@(tool == placer.Tool)" OnClick="() => SetTool(placer.Tool)" />
                }
              </DockGroup>
            }
            else if (CamerasActive)
            {
              <DockGroup>
                <DockButton Icon="camera" Title="Place a view"
                            Active="@(tool == "eye")" OnClick='() => SetTool("eye")' />
              </DockGroup>
            }
            else if (ReliefActive)
            {
              @* Five families of operation, each down to its last-picked one: the ground a mask raises or sinks,
                 the lines a run is traced for, the water, the texture laid over the ground, and the space carved
                 under it. *@
              <DockGroup>
                <DockFlyoutGroup Items="GroundItems" ActiveKey="@groundActive" Label="Ground"
                                 Armed="@ModifierArmed(groundActive)"
                                 Open="@(openFlyout == GroundFamily)" OnToggleOpen="() => ToggleFlyout(GroundFamily)"
                                 OnPick="ArmModifier" />
                <DockFlyoutGroup Items="LineItems" ActiveKey="@linesActive" Label="Lines"
                                 Armed="@ModifierArmed(linesActive)"
                                 Open="@(openFlyout == LinesFamily)" OnToggleOpen="() => ToggleFlyout(LinesFamily)"
                                 OnPick="ArmModifier" />
                <DockFlyoutGroup Items="WaterItems" ActiveKey="@waterActive" Label="Water"
                                 Armed="@ModifierArmed(waterActive)"
                                 Open="@(openFlyout == WaterFamily)" OnToggleOpen="() => ToggleFlyout(WaterFamily)"
                                 OnPick="ArmModifier" />
                <DockFlyoutGroup Items="TextureItems" ActiveKey="@textureActive" Label="Texture"
                                 Armed="@ModifierArmed(textureActive)"
                                 Open="@(openFlyout == TextureFamily)" OnToggleOpen="() => ToggleFlyout(TextureFamily)"
                                 OnPick="ArmModifier" />
              </DockGroup>
              <DockGroup>
                <DockFlyoutGroup Items="CarveItems" ActiveKey="@carveActive" Label="Carve"
                                 Armed="@ModifierArmed(carveActive)"
                                 Open="@(openFlyout == CarveFamily)" OnToggleOpen="() => ToggleFlyout(CarveFamily)"
                                 OnPick="ArmModifier" />
              </DockGroup>
            }
            else if (PlacesActive)
            {
              @* A place is drawn with the notes step's marks — a point, a box, a lasso — and a polygon and a line
                 beside them. Each draws a place rather than ground. *@
              <DockGroup>
                <DockButton Icon="pin" Title="Point" Active="@(tool == PlaceTool(PlaceShapes.Point))"
                            OnClick="() => ArmPlace(PlaceShapes.Point)" />
                <DockButton Icon="rectangle-horizontal" Title="Box" Active="@(tool == PlaceTool(PlaceShapes.Box))"
                            OnClick="() => ArmPlace(PlaceShapes.Box)" />
                <DockButton Icon="pentagon" Title="Polygon" Active="@(tool == PlaceTool(PlaceShapes.Ring))"
                            OnClick="() => ArmPlace(PlaceShapes.Ring)" />
                <DockButton Icon="lasso" Title="Lasso" Active="@(tool == PlaceTool("lasso"))"
                            OnClick='() => ArmPlace("lasso")' />
                <DockButton Icon="spline" Title="Polyline" Active="@(tool == PlaceTool(PlaceShapes.Line))"
                            OnClick="() => ArmPlace(PlaceShapes.Line)" />
              </DockGroup>
            }
            else if (LayoutActive)
            {
              @* The Layout step's three families, each down to its last-picked option and a chevron. Arming one
                 places that piece: a room or a zone is dragged out, a marker is put down with a click. *@
              <DockGroup>
                <DockFlyoutGroup Items="PieceItems" ActiveKey="@pieceActive" Label="Pieces"
                                 Armed="@(tool == PieceTool(pieceActive))"
                                 Open="@(openFlyout == "pieces")" OnToggleOpen='() => ToggleFlyout("pieces")'
                                 OnPick="ArmPiece" />
                <DockFlyoutGroup Items="ZoneItems" ActiveKey="@zoneActive" Label="Zones"
                                 Armed="@(tool == PieceTool(zoneActive))"
                                 Open="@(openFlyout == "zones")" OnToggleOpen='() => ToggleFlyout("zones")'
                                 OnPick="ArmPiece" />
                <DockFlyoutGroup Items="MarkerItems" ActiveKey="@markerActive" Label="Markers"
                                 Armed="@(tool == PieceTool(markerActive))"
                                 Open="@(openFlyout == "markers")" OnToggleOpen='() => ToggleFlyout("markers")'
                                 OnPick="ArmPiece" />
              </DockGroup>
            }
            else if (!ScopeApplyActive && !HistoryActive)
            {
              @* The four tools that make a shape, and the operation the shape will perform, in one box wearing
                 one colour — so an armed carve cannot be read as an armed build. What a drawn shape does to
                 the land is not a sibling of the tool that draws it, so the word leads the group rather than
                 being a fourth glyph in it. *@
              <DockGroup Accent="@OpAccent" Idle="@(!DrawToolActive)">
                <DockModeButton Pressed="@Carving" Title="@OpTitle" OnClick="ToggleOperation">@(Carving ? "Carve" : "Build")</DockModeButton>
                <DockButton Icon="rectangle-horizontal" Title="Rectangle" Active="@(tool == "rectangle")"
                            OnClick='() => SetTool("rectangle")' />
                <DockButton Icon="pentagon" Title="Polygon" Active="@(tool == "polygon")"
                            OnClick='() => SetTool("polygon")' />
                <DockButton Icon="spline" Title="Polyline" Active="@(tool == "polyline")"
                            OnClick='() => SetTool("polyline")' />
                <DockButton Icon="lasso" Title="Lasso" Active="@(tool == "lasso")"
                            OnClick='() => SetTool("lasso")' />
              </DockGroup>
              @* Reads and cuts what is already drawn — neither makes land, so neither takes the operation
                 colour and both sit in their own box. *@
              <DockGroup>
                <DockButton Icon="ruler" Title="Measure" Active="@(tool == "measure")" OnClick='() => SetTool("measure")' />
                <DockButton Icon="scissors" Title="Split" Active="@(tool == "split")" OnClick='() => SetTool("split")' />
                @* Not an overlay: it changes what a drag does rather than what is drawn, so it sits with the
                   tools that drag rather than in the bar that says what is shown. *@
                <DockButton Icon="magnet" Title="@($"{SnapTitle} (hold Alt to skip)")"
                            Active="@snapOn" OnClick="ToggleSnap" />
              </DockGroup>
            }
          </CanvasDock>
          }
        </div>
        @if (HistoryActive)
        {
          <div class="sidebar-handle"></div>
          <SketchChangeInspector History="history" Notes="notes" OnOpenNote="OpenNoteFromHistory" />
        }
        else if (DressingActive)
        {
          <div class="sidebar-handle"></div>
          <SketchDressingInspector Handle="handle" ActiveTool="@tool" StateJson="@dressingJson" Layers="layerRows" />
        }
        else if (CamerasActive)
        {
          <div class="sidebar-handle"></div>
          <SketchViewDraft Slug="@Slug" Views="views" OnKeep="KeepView" />
        }
        else if (ReliefActive)
        {
          <div class="sidebar-handle"></div>
          @if (modifiers.Selected is { } pickedModifier)
          {
            <SketchModifierInspector @key="SketchModifierState.Id(pickedModifier)" Handle="handle" Modifier="pickedModifier"
                                     Shapes="shapes" Groups="groups" Changed="@modifiers.ChangedBy(SketchModifierState.Id(pickedModifier))" />
          }
          else
          {
            <Inspector>
              <Section>
                <EmptyState>No modifier selected. Pick one in the dock to trace it, or in the list to edit it.</EmptyState>
              </Section>
            </Inspector>
          }
        }
        else if (ThemeActive && PaintRuleOpen)
        {
          <div class="sidebar-handle"></div>
          <SketchPaintRuleInspector Handle="handle" PaintJson="@themes.PaintJson" RuleId="@(paintRuleId ?? "")"
                                    ModifierIds="@(themes.ModifierIds ?? [])" OnClose="() => paintRuleId = null" />
        }
        else if (ThemeActive)
        {
          <div class="sidebar-handle"></div>
          <SketchThemeInspector Handle="handle" Themes="themes" Brush="@themeBrush"
                                SelectedGroupId="@selectedGroupId" SelectedShapeId="@selectedShapeId"
                                TargetShapeIds="ScopeTargetShapeIds"
                                AddOpen="themeAddOpen" AddOpenChanged="v => themeAddOpen = v"
                                OnHold="SetThemeBrush" />
        }
        else if (PlacesActive)
        {
          <div class="sidebar-handle"></div>
          @if (SelectedPlace is { } place)
          {
            <SketchPlaceInspector Place="place" Pieces="placePieces" Note="@placeNote"
                                  OnChange="ChangePlace" OnDelete="DeletePlace">
              <SketchPlaceNotes Slug="@Slug" Place="place" Notes="notes" />
            </SketchPlaceInspector>
          }
          else
          {
            <Inspector>
              @if (!string.IsNullOrEmpty(placeNote)) { <p class="field-error">@placeNote</p> }
            </Inspector>
          }
        }
        else if (PickedLayer is { } pickedLayer)
        {
          <div class="sidebar-handle"></div>
          <SketchLayerInspector Layer="pickedLayer" ShapeCount="shapes.Count" GroupCount="groups.Count"
                                Deletable="@(layerRows.Count > 1)" OnRename="RenameLayer" OnSetBaseY="SetLayerBaseY"
                                OnSetUnderside="SetLayerUnderside" OnDelete="DeleteLayer" />
        }
        else if (selectedStructural is not null)
        {
          @* A picked plan piece answers a rail of its own: its geometry is the plan's, and the one thing
             here is the height a region was compiled at. *@
          <div class="sidebar-handle"></div>
          <SketchStructuralInspector Piece="selectedStructural" Note="@structuralNote"
                                     OnSetHeight="SetStructuralHeight" OnTurn="TurnStructural"
                                     OnDelete="@(LayoutActive ? DeleteStructural : null)"
                                     Settings="pieceSettings" Vocabulary="objectiveWords" Yaw="spawnYaw"
                                     OnSetting="SetObjectiveField" OnFace="FaceSpawn"
                                     StampsOff="stampsOff" OnSwitchStamp="@(change => SwitchStamp(change.Word, change.On))"
                                   House="@RoomHouseBody" Reshapes="LayoutActive" />
        }
        else
        {
          <div class="sidebar-handle"></div>
          <SketchInspector Handle="handle" Shape="SelectedShape" Group="SelectedGroup" Shapes="shapes"
                           OnToggleOp="ToggleOp" OnToggleOverride="ToggleOverride" OnDeleteShape="DeleteShape"
                           OnPromoteShape="PromoteShape" OnSetHeight="SetHeight" OnToggleMirrors="ToggleMirrors" OnRenameGroup="RenameGroup"
                           OnRotate="Rotate" OnSetStrokeBand="SetStrokeBand"
                           SelectedVertexIdx="selectedVertexIdx" SelectedVertexHeight="selectedVertexHeight" OnSetVertexHeight="SetVertexHeight"
                           SlopeControls="slopeControls" OnSlopeHeightChanged="SetSlopeHeight" OnApplySlope="ApplySlope" />
        }
      </Workspace>
      </div>
  </ChildContent>
</StudioShell>

@code {
    /// <summary>The picked room's house, for the structural inspector; null where no room's wing is picked in Layout.</summary>
    private RenderFragment? RoomHouseBody => roomHouse is not { } house ? null : @<SketchRoomHouse House="house" Shells="houseShells" Picked="houseWing" OnStyle="SetRoomHouseStyle" OnPick="PickRoomWing" OnDelete="DeleteRoomWing" OnSpec="SetRoomWingSpec" />;
}
