@namespace PgmStudio.Client.Features.Sketch
@using PgmStudio.Geom.Relief

@* The active layer's settings — its name and the y it is based at. Which layer is active, and which
   layers there are, is the canvas strip's: a layer is switched where it is drawn on, so the sidebar
   states what the layer IS rather than offering a second list of the same rows. *@

<Section Title="Layer" Writes>
  @if (ActiveLayer is not null)
  {
    <Field Label="Name">
      <input class="field-input" value="@ActiveLayer.Name" @onchange="RenameActive" />
    </Field>
    <Field Label="Base" Unit="world y">
      <NumberField Value="ActiveLayer.BaseY" ValueChanged="BaseYActive" />
    </Field>
    <Field Note="Stone hangs under the ground, narrowing inward from its edge.">
      <label class="check-row">
        <input type="checkbox" checked="@(ActiveLayer.Underside is not null)" @onchange="e => ToggleUnderside(e.Value is true)" />
        Underside
      </label>
    </Field>
    @if (ActiveLayer.Underside is { } underside)
    {
      <Field Label="Edge depth" Unit="blocks">
        <NumberField Value="underside.Edge" Min="0" Max="64" ValueChanged="v => SetUnderside(underside with { Edge = v })" />
      </Field>
      <Field Label="Inward deepening" Help="How much deeper it hangs for each block in from the edge.">
        <NumberField Value="underside.Taper" Min="0" Max="8" Step="0.1" ValueChanged="v => SetUnderside(underside with { Taper = v })" />
      </Field>
      <Field Label="Unevenness" Unit="blocks">
        <NumberField Value="underside.Rough" Min="0" Max="16" Step="0.5" ValueChanged="v => SetUnderside(underside with { Rough = v })" />
      </Field>
      <SeedField Value="underside.Seed" ValueChanged="seed => SetUnderside(underside with { Seed = seed })" />
    }
  }
</Section>
