@namespace PgmStudio.Client.Features.Sketch

@* The active layer's settings — its name and the y it is based at. Which layer is active, and which
   layers there are, is the canvas strip's: a layer is switched where it is drawn on, so the sidebar
   states what the layer IS rather than offering a second list of the same rows. *@

<Section Title="Layer">
  @if (ActiveLayer is not null)
  {
    <Field Label="Name">
      <input class="field-input" value="@ActiveLayer.Name" @onchange="RenameActive" />
    </Field>
    <Field Label="Base Y (blocks)">
      <NumberField Value="ActiveLayer.BaseY" ValueChanged="BaseYActive" />
    </Field>
  }
</Section>
