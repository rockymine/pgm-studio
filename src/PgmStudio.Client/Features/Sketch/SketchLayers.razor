@namespace PgmStudio.Client.Features.Sketch

@* The active storey's settings — its name and the y it is based at. Which storey is active, and which
   storeys there are, is the canvas strip's: a storey is switched where it is drawn on, so the sidebar
   states what the storey IS rather than offering a second list of the same rows. *@

<Section Title="Storey">
  @if (ActiveLayer is not null)
  {
    <Field Label="Name">
      <input class="field-input" value="@ActiveLayer.Name" @onchange="RenameActive" />
    </Field>
    <Field Label="Base Y (blocks)">
      <NumberField Value="ActiveLayer.BaseY" ValueChanged="BaseYActive" />
    </Field>
  }
</Section>
