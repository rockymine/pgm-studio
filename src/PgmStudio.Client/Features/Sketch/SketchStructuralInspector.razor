@namespace PgmStudio.Client.Features.Sketch

@* The plan's own piece, picked on the canvas. Its geometry belongs to the plan and is not editable here;
   what a region carries and an author may correct is the height it was compiled at. *@

<Inspector>
  <Section>
    <DetailHeader Icon="@Icon" Label="@Label">
      <span class="detail-header-badges">
        @if (Piece.Who.Length > 0) { <Badge Kind="neutral">@Piece.Who</Badge> }
        @if (!Piece.IsPoint) { <Badge Kind="neutral">@Piece.Dim</Badge> }
        @if (Piece.HeightAuthored) { <Badge Kind="warning">corrected</Badge> }
      </span>
    </DetailHeader>

    @if (Piece.IsRegion)
    {
      <div class="section-header section-header--ruled"><h2 class="section-title">Height</h2></div>
      <Field Label="Surface (blocks)">
        <NumberField Value="@(Piece.BaseHeight ?? 0)" ValueChanged="HeightChanged" Min="1" />
      </Field>
      <p class="section-desc">
        @if (Piece.HeightAuthored)
        {
          <text>Set by you. Rebuilding from the plan keeps it.</text>
        }
        else
        {
          <text>Set by the plan. Rebuilding from the plan resets it unless you change it here.</text>
        }
      </p>
    }
    else if (!Piece.Piece)
    {
      <p class="section-desc">
        The building has no height of its own. Change the height on the region around it.
      </p>
    }

    <div class="section-header section-header--ruled"><h2 class="section-title">Position</h2></div>
    @if (Piece.IsPoint)
    {
      <Field Label="X"><span class="plan-stepper-value">@($"{Piece.Middle.X:0.#}")</span></Field>
      <Field Label="Z"><span class="plan-stepper-value">@($"{Piece.Middle.Z:0.#}")</span></Field>
    }
    <p class="section-desc">
      Drag to move it.
      @if (!Piece.Piece)
      {
        @(Piece.IsRegion
          ? "The marker, building, and iron on it move with it."
          : "The region under it stays where it is.")
      }
      @if (House is not null) { <text>Drag a corner to resize a wing, or click the + on a free wall to add one.</text> }
      else if (EndsDrag && Piece.Role == PlayPieceKinds.Wall) { <text>Drag an end to move it alone. It snaps to the edge of a shape.</text> }
      else if (!Piece.IsPoint) { <text>It can't be resized.</text> }
      @if (!Piece.Piece) { <text>Rebuilding from the plan puts it back.</text> }
    </p>
    @House
    @if (Yaw is { } yaw)
    {
      <Field Label="Facing">
        <div class="ctrl-row">
          <span class="plan-stepper-value">@($"{yaw:0}°")</span>
          <Button Variant="icon" Writes OnClick="() => OnFace.InvokeAsync()" Title="Turn"><i data-lucide="rotate-cw"></i></Button>
        </div>
      </Field>
    }
    @if (Settings is { } settings && Vocabulary is { } words)
    {
      <ObjectiveFields Kind="@ObjectiveKind" Values="settings" Vocabulary="words" OnSet="OnSetting" />
    }
    @if (Piece.Turns)
    {
      <div class="panel-actions">
        <Button Variant="icon" Icon="rotate-ccw" Title="Turn counterclockwise" Writes OnClick="() => OnTurn.InvokeAsync(-1)" />
        <Button Variant="icon" Icon="rotate-cw" Title="Turn clockwise" Writes OnClick="() => OnTurn.InvokeAsync(1)" />
      </div>
    }
    @if (!string.IsNullOrEmpty(Note))
    {
      <p class="field-error">@Note</p>
    }
    @if (OnDelete is not null && Piece.Role != StructuralRoles.Building && !Piece.IsPoint)
    {
      <Button Full Variant="danger" Writes OnClick="OnDelete">
        <i data-lucide="trash-2"></i> Delete
      </Button>
    }
    <Button Full OnClick="() => OnClose.InvokeAsync()">
      <i data-lucide="x"></i> Deselect
    </Button>
  </Section>
</Inspector>
