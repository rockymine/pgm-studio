@namespace PgmStudio.Client.Features.Sketch

@* A play piece picked on the canvas: where it stands and how big it is are the intent's, moved, turned and
   resized on the canvas; what a region carries and an author may correct here is the height it is held at. *@

<Inspector>
  <Section>
    <DetailHeader Icon="@Piece.Icon" Label="@Piece.Label">
      <span class="detail-header-badges">
        @if (Piece.Who.Length > 0) { <Badge Kind="neutral">@Piece.Who</Badge> }
        @if (!Piece.IsPoint) { <Badge Kind="neutral">@Piece.Dim</Badge> }
        @if (Piece.HeightAuthored) { <Badge Kind="warning">corrected</Badge> }
      </span>
    </DetailHeader>

    @if (Piece.IsRegion)
    {
      <div class="section-header section-header--ruled"><h2 class="section-title">Height</h2></div>
      <Field Label="Surface (blocks)">
        <NumberField Value="@Piece.BaseHeight" ValueChanged="HeightChanged" Min="1" />
      </Field>
      <p class="section-desc">
        @if (Piece.HeightAuthored)
        {
          <text>Held at this height. The ground around it meets it.</text>
        }
        else if (Piece.BaseHeight is null)
        {
          <text>Stands on the ground under it. State a height to hold it there.</text>
        }
        else
        {
          <text>Settles on the ground under it, from the height the layout was written with. Change it to hold it there.</text>
        }
      </p>
    }
    else if (!Piece.Piece)
    {
      <p class="section-desc">
        The building has no height of its own. Change the height on the region around it.
      </p>
    }

    <div class="section-header section-header--ruled"><h2 class="section-title">Position</h2></div>
    @if (Piece.IsPoint)
    {
      <Field Label="X"><span class="stepper-value">@($"{Piece.Middle.X:0.#}")</span></Field>
      <Field Label="Z"><span class="stepper-value">@($"{Piece.Middle.Z:0.#}")</span></Field>
    }
    <p class="section-desc">
      Drag to move it.
      @if (!Piece.Piece)
      {
        @(Piece.IsRegion
          ? "The marker, building, and iron on it move with it."
          : "The region under it stays where it is.")
      }
      @if (House is not null) { <text> Drag a corner or an edge to resize a wing, or click the + on a free wall to add one.</text> }
      else if (Reshapes && Piece.Role == PlayPieceKinds.Wall) { <text> Drag an end to move it alone. It snaps to the edge of a shape.</text> }
      else if (Reshapes && (Piece.IsRegion || Piece.Role is PlayPieceKinds.BuildArea or PlayPieceKinds.WaterLane))
      {
        <text> Drag a corner or an edge to resize it@(Piece.IsRegion ? "; what stands on it keeps its place across it" : "").</text>
      }
      else if (!Piece.IsPoint) { <text> It can't be resized.</text> }
    </p>
    @House
    @if (Yaw is { } yaw)
    {
      <Field Label="Facing">
        <div class="ctrl-row">
          <span class="stepper-value">@($"{yaw:0}°")</span>
          <Button Variant="icon" Writes OnClick="() => OnFace.InvokeAsync()" Title="Turn"><i data-lucide="rotate-cw"></i></Button>
        </div>
      </Field>
    }
    @if (Settings is { } settings && Vocabulary is { } words)
    {
      <ObjectiveFields Kind="@ObjectiveKind" Values="settings" Vocabulary="words" OnSet="OnSetting" />
    }
    @if (Piece.Turns)
    {
      <div class="panel-actions">
        <Button Variant="icon" Icon="rotate-ccw" Title="Turn counterclockwise" Writes OnClick="() => OnTurn.InvokeAsync(-1)" />
        <Button Variant="icon" Icon="rotate-cw" Title="Turn clockwise" Writes OnClick="() => OnTurn.InvokeAsync(1)" />
      </div>
    }
    @if (!string.IsNullOrEmpty(Note))
    {
      <p class="field-error">@Note</p>
    }
    @if (OnDelete is not null && Piece.Role != StructuralRoles.Building && !Piece.IsPoint)
    {
      <Button Full Variant="danger" Writes OnClick="OnDelete">
        <i data-lucide="trash-2"></i> Delete
      </Button>
    }
  </Section>
</Inspector>
