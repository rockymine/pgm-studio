@namespace PgmStudio.Client.Features.Sketch

@* A play piece picked on the canvas: where it stands and how big it is are the intent's, moved, turned and
   resized on the canvas; what a region carries and an author may correct here is the height it is held at. *@

<Inspector>
  <DetailHeader Icon="@Piece.Icon" Label="@Piece.Label">
    <span class="detail-header-badges">
      @if (Piece.Who.Length > 0) { <Badge Kind="neutral">@Piece.Who</Badge> }
      @if (!Piece.IsPoint) { <Badge Kind="neutral">@Piece.Dim</Badge> }
      @if (Piece.HeightAuthored) { <Badge Kind="warning">Corrected</Badge> }
    </span>
  </DetailHeader>

  @if (Piece.IsRegion)
  {
    <Section Title="Height">
      <Field Label="Surface" Unit="blocks" Term="surface" Note="@HeightNote">
        <NumberField Value="@Piece.BaseHeight" ValueChanged="HeightChanged" Min="1" placeholder="Auto" />
      </Field>
    </Section>
  }
  else if (!Piece.Piece)
  {
    <Section Description="The building has no height of its own. Change the height of the room around it." />
  }

  <Section Title="Position" Description="@PositionDescription">
    @if (Piece.IsPoint)
    {
      <Field Label="X"><span class="stepper-value">@($"{Piece.Middle.X:0.#}")</span></Field>
      <Field Label="Z"><span class="stepper-value">@($"{Piece.Middle.Z:0.#}")</span></Field>
    }
    @House
    @if (Yaw is { } yaw)
    {
      <Field Label="Facing">
        <div class="ctrl-row">
          <span class="stepper-value">@($"{yaw:0}°")</span>
          <Button Variant="icon" Icon="rotate-cw" Title="Turn clockwise" Writes OnClick="() => OnFace.InvokeAsync()" />
        </div>
      </Field>
    }
    @if (Settings is { } settings && Vocabulary is { } words)
    {
      <ObjectiveFields Kind="@ObjectiveKind" Values="settings" Vocabulary="words" OnSet="OnSetting" />
    }
  </Section>
  @if (StampsOff is { } off && StampSwitches.Of(Piece.Role) is { Length: > 0 } stamps)
  {
    <Section Title="Stamps" Description="Switch one off where the world already carries its own.">
      @foreach (var word in stamps)
      {
        var on = !off.Contains(word);
        <label class="check-row"><input type="checkbox" checked="@on" disabled="@(!Reshapes)"
               @onchange="@(e => OnSwitchStamp.InvokeAsync((word, e.Value is true)))" />@StampLabel(word)</label>
      }
    </Section>
  }
  @if (Piece.Turns || !string.IsNullOrEmpty(Note))
  {
    <Section>
      @if (Piece.Turns)
      {
        <div class="panel-actions">
          <Button Variant="icon" Icon="rotate-ccw" Title="Turn counterclockwise" Writes OnClick="() => OnTurn.InvokeAsync(-1)" />
          <Button Variant="icon" Icon="rotate-cw" Title="Turn clockwise" Writes OnClick="() => OnTurn.InvokeAsync(1)" />
        </div>
      }
      @if (!string.IsNullOrEmpty(Note))
      {
        <p class="field-error">@Note</p>
      }
    </Section>
  }
  @if (OnDelete is not null && Piece.Role != StructuralRoles.Building && !Piece.IsPoint)
  {
    <InspectorDelete Title="Delete this piece" OnClick="OnDelete" />
  }
</Inspector>
