@namespace PgmStudio.Client.Features.Sketch
@using System.Net.Http.Json
@inject HttpClient Http

@* One place's notes as one conversation under its fields: every thread pinned to it, oldest first, and a text box
   that answers the newest thread or starts the first. Opening the place reads what was new in it. *@

@if (Notes.Allowed)
{
  <SketchNotesColumn Embedded Step="NotesStep.Conversation" Notes="Notes.All" PlaceId="@Place.Id" ViewName="@Place.Name"
                     Error="@error" MeUuid="@Notes.MeUuid" OnReply="SendAsync" />
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public Place Place { get; set; } = default!;
    [Parameter, EditorRequired] public SketchNotes Notes { get; set; } = default!;

    private string? error;
    private string? shownPlace;
    private readonly HashSet<string> marked = [];

    private IEnumerable<MapNoteDto> Threads => Notes.All.Where(note => note.Anchor.Place == Place.Id);

    protected override void OnParametersSet()
    {
        if (shownPlace == Place.Id) return;
        shownPlace = Place.Id;
        error = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Each thread is read once at the length it was shown, so a read that does not land is not asked again.
        var unread = Threads.Where(note => note.Unread > 0 && marked.Add($"{note.Id}:{note.Messages.Count}")).ToList();
        if (unread.Count == 0) return;
        foreach (var note in unread) await Http.PostAsync($"api/map/{Slug}/notes/{note.Id}/read", null);
        await Notes.LoadAsync();
    }

    /// <summary>Answer the place's newest thread, or start its first.</summary>
    private async Task<bool> SendAsync(string body)
    {
        error = null;
        var newest = Threads.MaxBy(note => note.CreatedAt);
        var answer = newest is null
            ? await Http.PostAsJsonAsync($"api/map/{Slug}/notes",
                new MapNoteRequest(body, new NoteAnchorDto(NoteAnchors.Place, Place: Place.Id)))
            : await Http.PostAsJsonAsync($"api/map/{Slug}/notes/{newest.Id}/replies", new NoteReplyRequest(body));
        if (!answer.IsSuccessStatusCode)
        {
            error = await ServerRefusal.SentenceAsync(answer);
            StateHasChanged();
            return false;
        }
        await Notes.LoadAsync();
        // The column calls back through a delegate rather than an event, so this host draws itself again.
        StateHasChanged();
        return true;
    }
}
