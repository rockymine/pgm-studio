@namespace PgmStudio.Client.Features.Sketch

@* Apply-step controls (finishing-model.md §4), shown beneath the island tree: pick a theme and apply/remove it
   on the island or shape selected in the tree. Map default sits under everything. Themes are created in the
   previous step. *@

<Section Title="Map default">
  <p class="section-desc">The lowest layer — paints every cell no shape claims.</p>
  <Field>
    <select class="field-input" value="@MapTheme" @onchange="OnMapDefault">
      <option value="">(built-in default)</option>
      @foreach (var id in Themes) { <option value="@id">@id</option> }
    </select>
  </Field>
</Section>

<Section Title="Theme to apply">
  @if (Themes.Count == 0)
  {
    <p class="section-desc">No themes yet — create one in the previous step, then apply it here.</p>
  }
  else
  {
    @foreach (var id in Themes)
    {
      <ListRow Compact Selected="@(id == Picked)" @key="id" OnClick="() => Pick(id)">
        <span class="list-label list-label--mono">@id</span>
        @if (MapTheme == id) { <Badge Kind="neutral">map default</Badge> }
      </ListRow>
    }
    @if (Picked is not null)
    {
      <div class="theme-apply-swatches">
        @foreach (var bucket in new[] { "surface", "wall", "rim", "fill" })
        {
          <figure class="theme-apply-swatch">
            <div class="theme-swatch-img">@((MarkupString)(Swatches.GetValueOrDefault(bucket) ?? ""))</div>
            <figcaption>@bucket</figcaption>
          </figure>
        }
      </div>
    }
  }
</Section>

<Section Title="Selection">
  @if (!HasSelection)
  {
    <p class="section-desc">Select an island or a shape in the tree above, then apply a theme. An island themes
      all its shapes; a shape themes just itself.</p>
  }
  else
  {
    var current = SelectionTheme();
    <div class="theme-apply-sel-row">
      <span class="list-label list-label--mono">@(SelectedIslandId ?? SelectedShapeId)</span>
      <Badge Kind="dim">@(SelectedIslandId is not null ? "island" : "shape")</Badge>
      @if (current == "~mixed~") { <Badge Kind="neutral">mixed</Badge> }
      else if (!string.IsNullOrEmpty(current)) { <Badge Kind="neutral">@current</Badge> }
      else { <span class="section-desc">— unthemed —</span> }
    </div>
    <div class="panel-actions">
      <Button Variant="primary" Icon="paintbrush" OnClick="Apply" Disabled="@(Picked is null)">
        Apply @Picked
      </Button>
      <Button Icon="eraser" OnClick="Remove">Remove</Button>
    </div>
  }
</Section>
