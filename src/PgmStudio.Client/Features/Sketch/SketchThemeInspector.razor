@namespace PgmStudio.Client.Features.Sketch

@* The Theme phase's inspector. It shows what is in hand and what the selection is painted with; with nothing
   selected it shows what the board falls back to instead, so the column describes the phase when it has no one
   thing to describe.

   Themes are authored in the library, not here — the strip's + copies one onto the board, and a board theme
   edited elsewhere is saved out and copied back. One editor for a theme means one shape for a theme. *@

<Inspector>
  @* Adding is a short detour that ends by taking what it copied in hand, so it has the column to itself
     rather than pushing what the phase is showing down a scroll. *@
  @if (AddOpen)
  {
    <Section Title="Add from the library">
      <Actions>
        <Button Variant="icon" Icon="x" Title="Close" OnClick="() => AddOpenChanged.InvokeAsync(false)" />
      </Actions>
      <ChildContent>
        <p class="section-desc">Copying one in takes a snapshot; the same name again replaces it.</p>
        @if (libraryThemes.Count == 0)
        {
          <p class="section-desc">The library has no themes yet.</p>
        }
        else
        {
          <div class="lib-picklist">
            @foreach (var theme in libraryThemes)
            {
              <ListRow Compact @key="theme.Id" OnClick="() => CopyIn(theme)">
                <span class="list-label">@theme.Name</span>
                @if (Themes.Contains(theme.Name)) { <Badge Kind="dim">on the board</Badge> }
                <span class="list-tag">copy in</span>
              </ListRow>
            }
          </div>
        }
        <div class="panel-actions">
          <Button Href="/library/themes" Icon="external-link">Author one in the library</Button>
        </div>
      </ChildContent>
    </Section>
  }
  else
  {
  @if (InHand is { } held)
  {
    <Section Title="In hand">
      <Actions><Badge Kind="neutral">@held</Badge></Actions>
      <ChildContent>
        <p class="section-desc">Click to paint · Shift-click the group · Alt-click to lift · Esc to put down</p>
        @if (preview is not null)
        {
          <div class="theme-section-figure">@((MarkupString)preview.Section)</div>
          <div class="theme-apply-swatches">
            @foreach (var bucket in ThemeBuckets.All)
            {
              <figure class="theme-apply-swatch" @key="bucket">
                <div class="theme-swatch-img">@((MarkupString)(preview.Buckets.GetValueOrDefault(bucket) ?? ""))</div>
                <figcaption>@bucket</figcaption>
              </figure>
            }
          </div>
        }
        <div class="panel-actions">
          <Button Icon="upload" OnClick="SaveToLibrary" Title="Save this board theme to the library, one style per bucket">Save to library</Button>
          <Button Variant="danger" Icon="trash-2" OnClick="RemoveFromBoard"
                  Title="Take it off the board — every shape painted with it goes back to the map default">Remove</Button>
        </div>
        @if (note is not null) { <p class="section-desc">@note</p> }
      </ChildContent>
    </Section>
  }

  @if (HasSelection)
  {
    <Section Title="Selection">
      <Actions>
        <Badge Kind="dim">@(SelectedGroupId is not null ? "group" : "shape")</Badge>
      </Actions>
      <ChildContent>
        <div class="theme-apply-sel-row">
          <span class="list-label list-label--mono">@(SelectedGroupId ?? SelectedShapeId)</span>
          @if (SelectionTheme() == Mixed) { <Badge Kind="neutral">mixed</Badge> }
          else if (SelectionTheme() is { Length: > 0 } current) { <Badge Kind="neutral">@current</Badge> }
          else { <span class="section-desc">— unpainted, so the map default reaches it —</span> }
        </div>
        <div class="panel-actions">
          <Button Icon="eraser" OnClick="ClearSelection" Disabled="@(SelectionTheme().Length == 0)">Unpaint</Button>
        </div>
      </ChildContent>
    </Section>
  }
  else
  {
    @* Nothing is selected, so the column describes the board: what paints where nothing else reaches, and how
       much of the board is still falling through to it. *@
    <Section Title="Board defaults">
      <Field Label="Map default">
        <LabelHint>(the lowest layer — what paints a cell no shape claims)</LabelHint>
        <ChildContent>
          <Select Options="MapThemes" Value="@MapTheme" ValueChanged="SetMapDefault"
                  Placeholder="(unthemed — stone)" />
        </ChildContent>
      </Field>
      <p class="section-desc">@Coverage</p>
    </Section>

    <Section Title="Room shells">
      <Actions>
        <Button Variant="icon" Icon="library" Href="/library/houses" Title="Open the house library" />
      </Actions>
      <ChildContent>
        <p class="section-desc">The finish each is stamped with — never its size. One shell each, since both
          are mirrored.</p>
        @foreach (var kind in RoomKindInfo.All)
        {
          <Field Label="@kind.Title" @key="kind.Id">
            <div class="lib-bind">
              <Select Options="RoomShells(kind.Id)" Value="@RoomChoice(kind.Id)"
                      ValueChanged="choice => BindRoom(kind.Id, choice)" />
              @if (BoundRoom(kind.Id) is not null || IsOpenRoom(kind.Id))
              {
                <Button Variant="icon" Icon="x" Title="Go back to the built-in shell"
                        OnClick="() => ClearRoom(kind.Id)" />
              }
            </div>
          </Field>
          @if (RoomPreview(kind.Id) is { } views)
          {
            <div class="dressing-views">
              <figure class="theme-section-figure">@((MarkupString)views.Plan)</figure>
              <figure class="theme-section-figure">@((MarkupString)views.Section)</figure>
            </div>
          }
        }
        @if (rooms.Count == 0)
        {
          <p class="section-desc">The library has no room styles yet.</p>
        }
      </ChildContent>
    </Section>
  }
  }
</Inspector>
