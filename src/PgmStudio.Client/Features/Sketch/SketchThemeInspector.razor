@namespace PgmStudio.Client.Features.Sketch

@* The Theme phase's inspector. It shows what is in hand and what the selection is painted with; with nothing
   selected it shows what the board falls back to instead, so the column describes the phase when it has no one
   thing to describe.

   Themes are authored in the library, not here — the strip's + copies one onto the board, and a board theme
   edited elsewhere is saved out and copied back. One editor for a theme means one shape for a theme. *@

<Inspector>
  @* Adding is a short detour that ends by taking what it copied in hand, so it has the column to itself
     rather than pushing what the phase is showing down a scroll. *@
  @if (AddOpen)
  {
    <Section Title="Add from library">
      <Actions>
        <Button Variant="icon" Icon="x" Title="Close" OnClick="() => AddOpenChanged.InvokeAsync(false)" />
      </Actions>
      <ChildContent>
        <p class="section-desc">Adds a copy to this map. Adding the same palette again updates that copy.</p>
        @if (libraryThemes.Count == 0)
        {
          <p class="section-desc">No palettes in the library yet.</p>
        }
        else
        {
          <div class="lib-picklist">
            @foreach (var theme in libraryThemes)
            {
              <ListRow Compact @key="theme.Id" OnClick="() => CopyIn(theme)">
                <span class="list-label">@theme.Name</span>
                @if (CopiedAs(theme.Id) is { } copy) { <Badge Kind="dim">on this map as @copy</Badge> }
                <span class="list-tag">@(CopiedAs(theme.Id) is null ? "Add" : "Update")</span>
              </ListRow>
            }
          </div>
        }
        <div class="panel-actions">
          <Button Href="/library/themes" Icon="external-link" Writes>Create one in the library</Button>
        </div>
      </ChildContent>
    </Section>
  }
  else
  {
  @if (InHand is { } held)
  {
    <Section Title="Painting with">
      <Actions><Badge Kind="neutral">@held</Badge></Actions>
      <ChildContent>
        <p class="section-desc">Click: paint · Shift-click: paint the group · Alt-click: pick up a shape's palette · Esc: stop</p>
        @if (HeldSource is { } source)
        {
          <p class="section-desc">
            Copied from “@source.Name” in the library.
            @if (heldMatchesSource == true) { <text>It matches the library version.</text> }
            else if (heldMatchesSource == false) { <text>It differs from the library version. One of them has been edited.</text> }
          </p>
        }
        @if (preview is not null)
        {
          <div class="theme-section-figure">@((MarkupString)preview.Section)</div>
          <div class="theme-apply-swatches">
            @foreach (var bucket in ThemeBuckets.All)
            {
              <figure class="theme-apply-swatch" @key="bucket">
                <div class="theme-swatch-img">@((MarkupString)(preview.Buckets.GetValueOrDefault(bucket) ?? ""))</div>
                <figcaption>@bucket</figcaption>
              </figure>
            }
          </div>
        }
        <div class="panel-actions">
          <Button Icon="upload" Writes OnClick="SaveToLibrary" Title="Save this palette to the library as one pattern per part">Save to library</Button>
          <Button Variant="danger" Icon="trash-2" Writes OnClick="RemoveFromBoard"
                  Title="Remove from this map. Shapes painted with it go back to the default palette.">Remove</Button>
        </div>
        @if (note is not null) { <p class="section-desc">@note</p> }
      </ChildContent>
    </Section>
  }

  @if (HasSelection)
  {
    <Section Title="Selection">
      <Actions>
        <Badge Kind="dim">@(SelectedGroupId is not null ? "group" : "shape")</Badge>
      </Actions>
      <ChildContent>
        <div class="theme-apply-sel-row">
          <span class="list-label list-label--mono">@(SelectedGroupId ?? SelectedShapeId)</span>
          @if (SelectionTheme() == Mixed) { <Badge Kind="neutral">mixed</Badge> }
          else if (SelectionTheme() is { Length: > 0 } current) { <Badge Kind="neutral">@current</Badge> }
          else { <span class="section-desc">Unpainted (uses the default palette)</span> }
        </div>
        <div class="panel-actions">
          <Button Icon="eraser" Writes OnClick="ClearSelection" Disabled="@(SelectionTheme().Length == 0)">Unpaint</Button>
        </div>
      </ChildContent>
    </Section>
  }
  else
  {
    @* Nothing is selected, so the column describes the board: what paints where nothing else reaches, and how
       much of the board is still falling through to it. *@
    <Section Title="Map defaults">
      @* Every row is one library row bound to the whole board, and each carries the button through to the
         library that holds it. What a row is bound to is said by name; the pictures are the library's own.
         The order is the order a column is built: the paint under everything, the tint over it, then the
         finish stamped where a room stands. *@
      <Field Label="Default palette">
        <LabelHint>(paints ground no shape covers)</LabelHint>
        <ChildContent>
          <div class="lib-bind">
            <Select Options="MapThemes" Value="@Themes.MapTheme" ValueChanged="SetMapDefault"
                    Placeholder="None (stone)" />
            <Button Variant="icon" Icon="library" Href="/library/themes" Title="Open the palette library" />
          </div>
        </ChildContent>
      </Field>
      <p class="section-desc">@Coverage</p>

      @* A biome places no block — it is the byte a client reads to tint grass, leaves and water — so it is
         bound here rather than placed. Picked, never authored: the row's own editor holds its palette and
         its scale. *@
      <Field Label="Map biome">
        <LabelHint>(tints grass, leaves, and water)</LabelHint>
        <ChildContent>
          <div class="lib-bind">
            <Select Options="BiomePatterns" Value="@BiomeChoice" ValueChanged="SetMapBiome"
                    Placeholder="@(BiomeOffLibrary ? "(not in the library)" : "None (plains everywhere)")"
                    PlaceholderValue="0" />
            <Button Variant="icon" Icon="library" Href="/library/biomes" Title="Open the biome library" />
          </div>
        </ChildContent>
      </Field>

      <p class="section-desc">Room shells set how rooms look, not their size. Each room kind has one shell,
        used on both sides.</p>
      @foreach (var kind in RoomKindInfo.All)
      {
        <Field Label="@kind.Title" @key="kind.Id">
          <div class="lib-bind">
            <Select Options="RoomOptions" Value="@RoomChoice(kind.Id)"
                    ValueChanged="choice => BindRoom(kind.Id, choice)"
                    Placeholder="@RoomPlaceholder(kind.Id)" PlaceholderValue="0" />
            @if (BoundRoom(kind.Id) is not null || IsOpenRoom(kind.Id))
            {
              <Button Variant="icon" Icon="x" Title="Use the built-in shell" Writes
                      OnClick="() => ClearRoom(kind.Id)" />
            }
            <Button Variant="icon" Icon="library" Href="/library/houses" Title="Open the house library" />
          </div>
        </Field>
      }
      @if (rooms.Count == 0)
      {
        <p class="section-desc">No room styles in the library yet.</p>
      }
    </Section>
  }
  }
</Inspector>
