@namespace PgmStudio.Client.Features.Sketch

@* Terrain-paint theming (docs/world-export/terrain-painting.md TP10), two steps: Create defines this sketch's
   named themes — a paintbrush per bucket, each switchable between a solid, a stack, a team tint and the
   patterns, previewed as it is edited; Apply picks the map default, assigns themes to shapes and islands, and
   shows the themed map top-down. Edits funnel through the sketch-bridge onto the sketch document, which the
   export resolves paint from. A theme can also be copied in from the style/theme library, or saved out to it —
   both as the painter's theme JSON, so neither side learns how the other stores one. Previews are server-
   rendered SVG through the real materials + palette. *@

<div class="phase-body">
  <FlowBar Class="flow-bar--flush" PhaseIcon="palette" PhaseTitle="Theme"
           Steps="@Steps" CurrentStep="0" BackEnabled="true" NextLabel="Apply →"
           OnStep="OnStep" OnBack="OnBack" OnNext="OnApply" />
  <Workspace>
    <ContentColumn MaxWidth="720">
      @if (State is null)
      {
        <Section><p class="section-desc">Loading themes…</p></Section>
      }
      else
      {
        @* ── Create: the theme registry, then a paintbrush per bucket. Apply is the next step (canvas mode). ── *@
        <Section Title="Themes">
          <p class="section-desc">A theme is a full terrain-paint recipe — one material per bucket, plus how
            deep each reaches. Define one here, then apply it to the map on the canvas in the next step.</p>

          @foreach (var id in State.Themes.Keys)
          {
            <ListRow Compact Selected="@(id == Selected)" @key="id" OnClick="() => Select(id)">
              <span class="list-label list-label--mono">@id</span>
              @if (State.MapTheme == id) { <Badge Kind="neutral">map default</Badge> }
            </ListRow>
          }
          @if (State.Themes.Count == 0)
          {
            <p class="section-desc">No themes yet — the whole map paints the built-in default.</p>
          }

          <Field Label="New theme">
            <div class="panel-actions">
              <input class="field-input" placeholder="name" @bind="NewName" @bind:event="oninput" />
              <Button Icon="plus" OnClick="AddTheme">Add</Button>
            </div>
          </Field>
        </Section>

        @* ── the library bridge: start from a saved theme, or save this one for the next map ── *@
        <Section Title="From the library">
          <Actions>
            <Button Href="/library/themes" Icon="library" Title="Open the style &amp; theme library">Library</Button>
          </Actions>
          <ChildContent>
            <p class="section-desc">Themes built in the library are reusable across maps. Copying one in takes a
              snapshot — editing it here leaves the library's copy alone, and the other way round.</p>
            @if (LibraryThemes.Count == 0)
            {
              <p class="section-desc">The library has no themes yet. Build one there, or save this map's below.</p>
            }
            else
            {
              <Field Label="Copy one in">
                <div class="panel-actions">
                  <select class="field-input" value="@LibraryPick" @onchange="PickLibraryTheme">
                    <option value="0">(pick a library theme)</option>
                    @foreach (var theme in LibraryThemes) { <option value="@theme.Id">@theme.Name</option> }
                  </select>
                  <Button Icon="download" Disabled="@(LibraryPick == 0)" OnClick="PullFromLibrary">Copy in</Button>
                </div>
              </Field>
              @if (PickedLibraryTheme is { } picked)
              {
                <div class="theme-section-figure">@((MarkupString)picked.Preview)</div>
              }
            }
            @if (Selected is not null)
            {
              <Field Label="Save this one">
                <div class="panel-actions">
                  <Button Icon="upload" OnClick="PushToLibrary">Save @Selected to the library</Button>
                </div>
              </Field>
            }
            @if (LibraryNote is not null) { <p class="section-desc">@LibraryNote</p> }
          </ChildContent>
        </Section>

        @if (Selected is not null && Theme is not null)
        {
          @* what the whole theme finishes terrain into, before the four brushes that make it up *@
          <Section Title="What it paints">
            <p class="section-desc">A sample plateau painted with this theme and cut open — the rim capping each
              edge, the wall under it, the surface band, the fill body and the bedrock floor. The right half of
              the ground belongs to a team, so a team tint shows beside its neutral fallback.</p>
            <div class="theme-section-figure">@((MarkupString)(Preview?.Section ?? ""))</div>
          </Section>

          @* the four paintbrushes: a toggle, a depth, a material, and what that material paints like *@
          @foreach (var bucket in Buckets)
          {
            <Section Title="@bucket.Info.Title" @key="bucket.Id">
              <Actions>
                @if (bucket.Info.CanDisable)
                {
                  <Chip Active="@bucket.Enabled" OnClick="@bucket.Toggle">@(bucket.Enabled ? "Painting" : "Off")</Chip>
                }
                else
                {
                  <Badge Kind="dim">always paints</Badge>
                }
              </Actions>
              <ChildContent>
                <p class="section-desc">@bucket.Info.Blurb</p>
                @if (bucket.Enabled)
                {
                  <div class="bucket-editor">
                    <div class="bucket-editor-form">
                      @if (bucket.Info.HasDepth)
                      {
                        <Field Label="Courses deep">
                          <input class="field-input field-input--slim" type="number" min="1" step="1"
                                 value="@bucket.Depth" @onchange="@bucket.SetDepth" />
                        </Field>
                      }
                      <MaterialEditor Node="@bucket.Material" Blocks="Blocks" OnChanged="ThemeEdited" />
                    </div>
                    <figure class="bucket-editor-swatch">
                      <div class="theme-swatch-img">@((MarkupString)Swatch(bucket.Id))</div>
                      <figcaption>neutral · team</figcaption>
                    </figure>
                  </div>
                }
                else
                {
                  <p class="section-desc">Off — its blocks fall through to @bucket.Info.FallsTo.</p>
                }
              </ChildContent>
            </Section>
          }

          <Section Title="Ground and edges">
            <p class="section-desc">How far down the paint reaches, and which faces count as an edge worth capping.</p>
            <Field Label="Bedrock floor">
              <div class="panel-actions">
                <select class="field-input field-input--slim" value="@BedrockMode" @onchange="SetBedrockMode">
                  <option value="@AbsoluteBedrock">blocks up from the bottom</option>
                  <option value="@RelativeBedrock">everything under the painted depth</option>
                </select>
                <input class="field-input field-input--slim" type="number" min="0" step="1"
                       value="@BedrockValue" @onchange="SetBedrockValue" />
              </div>
            </Field>
            <Field Label="Where the rim runs">
              <select class="field-input field-input--slim" value="@RimEdges" @onchange="SetRimEdges">
                @foreach (var mode in RimEdgeModes.All)
                {
                  <option value="@mode" @key="mode">@RimEdgeModes.LabelOf(mode)</option>
                }
              </select>
            </Field>
            <Field Label="Where the wall runs">
              <Chip Active="@Flag(ThemeFields.WallOnTerrainFaces, true)" OnClick="ToggleWallFaces">
                @(Flag(ThemeFields.WallOnTerrainFaces, true) ? "Terrain and void risers" : "Only risers facing the void")
              </Chip>
            </Field>
          </Section>

          <Section Title="This theme">
            <Field Label="Rename">
              <div class="panel-actions">
                <input class="field-input" placeholder="@Selected" @bind="RenameTo" />
                <Button OnClick="RenameTheme">Rename</Button>
                <Button Variant="danger" Icon="trash-2" OnClick="DeleteSelected">Delete</Button>
              </div>
            </Field>
            <details class="theme-json-details">
              <summary>Theme JSON</summary>
              <Field Error="@JsonError">
                <textarea class="field-input theme-json" spellcheck="false" @bind="ThemeJsonText"></textarea>
              </Field>
              <div class="panel-actions">
                <Button Variant="primary" OnClick="ApplyThemeJson">Apply JSON</Button>
              </div>
            </details>
          </Section>
        }
      }
    </ContentColumn>
  </Workspace>
</div>
