@namespace PgmStudio.Client.Features.Sketch
@using System.Text.Json.Nodes

@* The Relief phase's inspector: the numbers of the mark under the cursor, and — always, below them — the
   group's own settings, because those are what every mark in it is stated against. With nothing selected the
   same form edits the active tool's starting numbers, so the next mark placed is already aimed. *@

<Inspector>
  <Section>
    @if (mark is null)
    {
      <p class="section-desc">Pick a tool and state something.</p>
      <p class="plan-readout">@markCount stated on this map.</p>
    }
    else
    {
      <DetailHeader Icon="@Info.Icon" Label="@Info.Title">
        <span class="detail-header-badges">
          @if (editingSelection) { <Badge Kind="neutral">selected</Badge> }
          else { <Badge Kind="dim">next one</Badge> }
          @if (kind == MarkKinds.Scarp) { <Badge Kind="warning">blocks movement</Badge> }
        </span>
      </DetailHeader>
      <p class="section-desc">@Info.Blurb</p>

      @* The handle a finding names. A seam is reported as a pair of marks and RL4 names one that pinned
         nothing, so the name in the readback and the name in this panel have to be the same word. *@
      @if (editingSelection)
      {
        <Field Label="Name" Error="@nameError">
          <input class="field-input" value="@MarkId" @onchange="Rename" />
        </Field>
      }

      @if (kind == MarkKinds.Point)
      {
        <Field Label="Height">
          <NumberField Value="Height(0)" ValueChanged="v => SetHeight(0, v)" />
        </Field>
        <Field Label="Radius">
          <LabelHint>(blocks held at that height)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(MarkFields.Radius, 4)" ValueChanged="SetRadius" Min="0" />
          </ChildContent>
        </Field>
        <p class="plan-readout">@PointReadout</p>
      }
      else if (kind == MarkKinds.Line)
      {
        <Field Label="Radius">
          <LabelHint>(blocks held either side of the line)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(MarkFields.Radius, 2)" ValueChanged="SetRadius" Min="0" />
          </ChildContent>
        </Field>
        <p class="plan-readout">@LineReadout</p>
        <div class="section-header section-header--ruled"><h2 class="section-title">Heights along it</h2></div>
        @for (var i = 0; i < HeightCount; i++)
        {
          var at = i;
          <Field Label="@StationLabel(at, HeightCount)">
            <NumberField Value="Height(at)" ValueChanged="v => SetHeight(at, v)" />
          </Field>
        }
        <div class="detail-header-badges">
          <Button Variant="ghost" OnClick="AddHeight">Add a height</Button>
          @if (HeightCount > 1)
          {
            <Button Variant="ghost" OnClick="LevelHeights">Make it level</Button>
          }
        </div>

        @* How much of the band is flat, and how the rest of it falls. Off, the whole band is held — which
           is what a ridge wants. On, a line that comes back past itself grades between its own passes
           instead of stepping between them. *@
        <div class="section-header section-header--ruled"><h2 class="section-title">Across the band</h2></div>
        <Field Label="Flat">
          <label class="ctrl-row" style="cursor:pointer">
            <input type="checkbox" class="control-input control-input--hidden" checked="@HasTread"
                   @onchange="ToggleTread" />
            <span class="plan-readout">
              @(HasTread ? "flat to a tread, then graded" : "the whole band is flat")
            </span>
          </label>
        </Field>
        @if (HasTread)
        {
          <Field Label="Tread">
            <LabelHint>(blocks flat either side)</LabelHint>
            <ChildContent>
              <NumberField Value="Tread" ValueChanged="SetTread" Min="0" Max="@Radius" Step="0.5" />
            </ChildContent>
          </Field>
          <Field Label="Batter">
            <LabelHint>(degrees; 0 lets the drawing decide)</LabelHint>
            <ChildContent>
              <NumberField Value="Batter" ValueChanged="SetBatter" Min="0" Max="89" />
            </ChildContent>
          </Field>
          <p class="plan-readout">@TreadReadout</p>
        }
      }
      else if (kind == MarkKinds.Area)
      {
        @* A ring states one height or one per corner. One is a floor; one per corner is a shelf that can
           be cut into a slope, which is the only way a pad follows ground it was drawn across. *@
        @if (Tilted)
        {
          @for (var i = 0; i < HeightCount; i++)
          {
            var at = i;
            <Field Label="@($"Corner {at + 1}")">
              <NumberField Value="Height(at)" ValueChanged="v => SetHeight(at, v)" />
            </Field>
          }
          <Button Variant="ghost" OnClick="LevelHeights">Make it level</Button>
        }
        else
        {
          <Field Label="Height">
            <NumberField Value="Height(0)" ValueChanged="v => SetHeight(0, v)" />
          </Field>
          @if (RingCount >= 3)
          {
            <Button Variant="ghost" OnClick="TiltArea">A height per corner</Button>
          }
        }
        <Field Label="Bevel">
          <LabelHint>(blocks in from the rim; 0 meets its neighbour on a step)</LabelHint>
          <ChildContent>
            <NumberField Value="Bevel" ValueChanged="SetBevel" Min="0" />
          </ChildContent>
        </Field>
        <p class="plan-readout">@AreaReadout</p>
      }
      else if (kind == MarkKinds.Scarp)
      {
        <Field Label="Shelf">
          <LabelHint>(the +z hand of the line)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(MarkFields.High, 11)" ValueChanged="SetHigh" />
          </ChildContent>
        </Field>
        <Field Label="Ground below">
          <LabelHint>(the other side)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(MarkFields.Low, 5)" ValueChanged="SetLow" />
          </ChildContent>
        </Field>
        <Field Label="Face">
          <LabelHint>(how wide the drop is)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(MarkFields.Face, 2)" ValueChanged="SetFace" Min="1" />
          </ChildContent>
        </Field>
        <Field Label="Band">
          <LabelHint>(how far the two levels are held)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(MarkFields.Band, 5)" ValueChanged="SetBand" Min="1" />
          </ChildContent>
        </Field>
        <p class="plan-readout">@ScarpReadout</p>
      }
      else if (kind == MarkKinds.Push)
      {
        <Field Label="Lift">
          <LabelHint>(negative digs)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(PushFields.Amount, 5)" ValueChanged="SetAmount" />
          </ChildContent>
        </Field>
        <Field Label="Skirt">
          <LabelHint>(how far the lift falls away outside the ring)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(PushFields.Falloff, 10)" ValueChanged="SetFalloff" Min="0" />
          </ChildContent>
        </Field>
        <Field Label="Crown">
          <LabelHint>(how much higher the middle stands)</LabelHint>
          <ChildContent>
            <NumberField Value="Num(PushFields.Crown, 2)" ValueChanged="SetCrown" />
          </ChildContent>
        </Field>
        <Field Label="Roughness">
          <NumberField Value="Num(PushFields.Roughness, 0.3)" ValueChanged="SetRoughness" Min="0" Step="0.05" />
        </Field>
        <p class="plan-readout">@PushReadout</p>

        @* Per-vertex lift. Only for a placed push: the numbers are one per corner of the ring that was drawn,
           so there is nothing to list until there is a ring. This is what makes a drawn ridge fall along its
           length instead of holding level. *@
        @if (editingSelection && amounts.Count > 0)
        {
          @if (PushCornerReadout.Length > 0)
          {
            <p class="plan-readout">@PushCornerReadout</p>
          }
          @for (var i = 0; i < amounts.Count; i++)
          {
            var at = i;
            <Field Label="@($"Corner {at + 1}")">
              <NumberField Value="amounts[at]" ValueChanged="v => SetPushAmount(at, v)" />
            </Field>
          }
          @if (VariesAlongRing)
          {
            <Button Variant="ghost" OnClick="LevelAmounts">Make it level</Button>
          }
        }
      }

      @if (editingSelection)
      {
        <Button Full Variant="danger" OnClick="Delete"><i data-lucide="trash-2"></i> Delete</Button>
      }
    }
  </Section>

  @* The group's own settings. Always shown, never behind a selection: they are what the marks are stated
     against, so a base an author cannot see is a set of heights they cannot read. *@
  @if (groupId is not null)
  {
    <Section Title="@GroupTitle">
      <Field Label="Base" Error="@groupError">
        <LabelHint>(where the ground falls back to)</LabelHint>
        <ChildContent>
          <NumberField Value="Base" ValueChanged="SetBase" />
        </ChildContent>
      </Field>
      @* The level the group is already drawn at, against which every height in this panel is read. A relief
         replaces the top of every column of its group, so a base that differs from it moves the landmass. *@
      @if (groupTop is { } top)
      {
        <p class="plan-readout">
          Group top @top —
          @if (Math.Abs(Base - top) < 0.5) { <span>the ground stays where it is</span> }
          else if (Base > top) { <b>the group rises @Blocks(Base - top)</b> }
          else { <b>the group drops @Blocks(top - Base)</b> }
        </p>
      }
      <Field Label="Reach">
        <LabelHint>(0 = the marks decide everything)</LabelHint>
        <ChildContent>
          <NumberField Value="ReliefNum(ReliefFields.Reach, 0)" ValueChanged="SetReach" Min="0" />
        </ChildContent>
      </Field>
      <Field Label="Block step">
        <NumberField Value="ReliefNum(ReliefFields.Step, 1)" ValueChanged="SetStep" Min="1" Max="4" />
      </Field>
      @if (StepReadout.Length > 0)
      {
        <p class="plan-readout">@StepReadout</p>
      }
      <Field Label="Meant to be">
        <LabelHint>(checked against the solve; shapes nothing)</LabelHint>
        <ChildContent>
          <Select Options="Landforms" Value="@Landform" ValueChanged="SetLandform" Placeholder="not stated" />
        </ChildContent>
      </Field>

      <div class="section-header section-header--ruled"><h2 class="section-title">Grain</h2></div>
      <p class="plan-readout">@GrainReadout</p>
      <Field Label="Amount">
        <LabelHint>(blocks)</LabelHint>
        <ChildContent>
          <NumberField Value="GrainNum(GrainFields.Amplitude, 1.2)" ValueChanged="SetGrainAmount" Min="0" Step="0.5" />
        </ChildContent>
      </Field>
      <Field Label="Feature size">
        <LabelHint>(blocks)</LabelHint>
        <ChildContent>
          <NumberField Value="GrainNum(GrainFields.Scale, 12)" ValueChanged="SetGrainScale" Min="1" />
        </ChildContent>
      </Field>
      <Field Label="Seed">
        <NumberField Value="GrainNum(GrainFields.Seed, 1)" ValueChanged="SetGrainSeed" Min="0" />
      </Field>

      <div class="section-header section-header--ruled"><h2 class="section-title">Rim</h2></div>
      <Field Label="Hold the outline">
        <label class="ctrl-row" style="cursor:pointer">
          <input type="checkbox" class="control-input control-input--hidden" checked="@HasRim"
                 @onchange="ToggleRim" />
          <span class="plan-readout">@(HasRim ? "the outline is held" : "the land runs to the edge")</span>
        </label>
      </Field>
      @if (HasRim)
      {
        <Field Label="Rim height">
          <NumberField Value="RimHeight" ValueChanged="SetRimHeight" />
        </Field>
        <Field Label="Rim depth">
          <LabelHint>(rings in from the outline)</LabelHint>
          <ChildContent>
            <NumberField Value="RimDepth" ValueChanged="SetRimDepth" Min="1" />
          </ChildContent>
        </Field>
        <p class="plan-readout">@RimReadout</p>
      }
    </Section>
  }
</Inspector>
