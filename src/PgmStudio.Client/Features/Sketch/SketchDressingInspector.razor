@namespace PgmStudio.Client.Features.Sketch
@using System.Text.Json.Nodes

@* The Dressing phase's inspector: the knobs of the prop under the cursor, and a picture of what they make.
   With nothing selected the same form edits the active tool's starting values, so the next prop placed is
   already aimed. Every picker is drawn by the pass itself, never by an icon. *@

@* Wide: the tree and boulder pickers are grids of rendered cards, which read at three to a row only at this
   width. *@
<Inspector Class="workspace-inspector--wide">
  <Section>
    @if (prop is null)
    {
      <p class="section-desc">Pick a tool and place something. Click a placed prop to change it.</p>
      <p class="inspector-readout">@propCount item@(propCount == 1 ? "" : "s") placed on this map.</p>
    }
    else
    {
      @* Pinned while the form scrolls: which of the two the form is editing decides what a change does. *@
      <div class="dressing-head">
        <DetailHeader Icon="@Info.Icon" Label="@Info.One">
          <span class="detail-header-badges">
            @if (editingSelection) { <Badge Kind="neutral">selected</Badge> }
            else { <Badge Kind="accent">in hand</Badge> }
          </span>
        </DetailHeader>
        <p class="section-desc dressing-head-says" role="status">
          @if (editingSelection)
          {
            <text>Changes apply to this @Info.One.ToLowerInvariant() and carry to the next one placed.</text>
          }
          else
          {
            <text>@Info.Gesture Hold <kbd>Shift</kbd> to place several.</text>
          }
        </p>
      </div>

      @* ── what the last canvas operation did, or would not do ─────────────────────────────────── *@
      @if (note is not null)
      {
        <p class="section-desc dressing-note">@note</p>
      }

      @* ── why this prop is not one the pass would take ─────────────────────────────────────────── *@
      @if (refusal is { Findings.Count: > 0 })
      {
        <ProblemList Problems="refused" Bare OpenFirst />
      }
      else if (refusal is not null)
      {
        <p class="section-desc dressing-refusal">@refusal.Message</p>
      }

      @* No picture of the prop: every kind is picked from cards that are pictures of the thing itself, and the
         card in use is what the inspector shows. *@

      @* ── the knobs, by kind ──────────────────────────────────────────────────────────────────── *@
      @if (kind == PropKinds.Stroke)
      {
        <Field Label="Type">
          <div class="filter-group-options">
            <Chip Active="@(!Flag(PropFields.ClaimsGround))"
                  OnClick="() => Set(PropFields.ClaimsGround, JsonValue.Create(false))"
                  Title="Anything can stand on it">Paint</Chip>
            <Chip Active="@Flag(PropFields.ClaimsGround)"
                  OnClick="() => Set(PropFields.ClaimsGround, JsonValue.Create(true))"
                  Title="Trees and boulders keep clear of it">Path</Chip>
          </div>
        </Field>
        <Field Label="Width (blocks)"><LabelEnd><strong>@($"{Num(PropFields.Radius, 3) * 2:0}")</strong></LabelEnd>
          <ChildContent><RangeField Min="2" Max="16" Step="2" Value="@(Num(PropFields.Radius, 3) * 2)"
                 ValueChanged="value => Draft(PropFields.Radius, JsonValue.Create(Math.Max(1, value / 2)))" OnCommit="Commit" /></ChildContent></Field>
        <Field Label="Wander (blocks)" Hint="how far it strays from your line; its ends stay fixed">
          <LabelEnd><strong>@($"{Num(PropFields.Wander, 0):0}")</strong></LabelEnd>
          <ChildContent><RangeField Min="0" Max="8" Value="@((int)Num(PropFields.Wander, 0))"
                 ValueChanged="value => Draft(PropFields.Wander, JsonValue.Create(value))" OnCommit="Commit" /></ChildContent></Field>
        @if (Num(PropFields.Wander, 0) > 0)
        {
          <Field Label="Bend length (blocks)" Hint="short is twisty, long is gentle">
            <LabelEnd><strong>@($"{Num(PropFields.WanderLength, 16):0}")</strong></LabelEnd>
            <ChildContent><RangeField Min="4" Max="64" Step="2" Value="@((int)Num(PropFields.WanderLength, 16))"
                   ValueChanged="value => Draft(PropFields.WanderLength, JsonValue.Create(value))" OnCommit="Commit" /></ChildContent></Field>
        }
        <div class="section-header section-header--ruled"><h2 class="section-title">Style</h2></div>
        <div class="prop-cards">
          @foreach (var option in strokeStyles)
          {
            <button class="prop-card @(Text(PropFields.Style, PropFields.SolidStyle) == option.Key ? "prop-card--active" : null)"
                    title="@option.Label" @onclick="() => Pick(PropFields.Style, option)">
              <span class="prop-card-art">@((MarkupString)option.Svg)</span>
              <span class="prop-card-label">@option.Label</span>
            </button>
          }
        </div>
        @if (Text(PropFields.Style, PropFields.SolidStyle) == "worn")
        {
          <Field Label="Paved share"><LabelEnd><strong>@($"{Num(PropFields.Coverage, 0.7) * 100:0}%")</strong></LabelEnd>
            <ChildContent><RangeField Min="10" Max="100" Value="@((int)(Num(PropFields.Coverage, 0.7) * 100))"
                   ValueChanged="value => Draft(PropFields.Coverage, JsonValue.Create(Share(value)))" OnCommit="Commit" /></ChildContent></Field>
        }
        <Field Label="Paving">
          <SlotSelect Styles="styles" Blocks="blocks" Value="@SlotOf(PropFields.Pave).StyleId" Block="@SlotOf(PropFields.Pave).Block"
                      Unbound="@UnboundLabel(PropFields.Pave)" ValueChanged="fill => Fill(PropFields.Pave, fill)" />
        </Field>
      }
      else if (kind == PropKinds.Fluid)
      {
        <div class="section-header"><h2 class="section-title">Form</h2></div>
        <div class="prop-cards">
          @foreach (var option in fluidForms)
          {
            <button class="prop-card @(Text(PropFields.Form, PropFields.CanalForm) == option.Key ? "prop-card--active" : null)"
                    title="@option.Label" @onclick="() => Pick(PropFields.Form, option)">
              <span class="prop-card-art">@((MarkupString)option.Svg)</span>
              <span class="prop-card-label">@option.Label</span>
            </button>
          }
        </div>
        <Field Label="Fluid">
          <ChildContent><div class="chip-row">
            <Chip Active="Text(PropFields.Fluid, PropFields.WaterFluid) == PropFields.WaterFluid"
                  OnClick="() => Set(PropFields.Fluid, JsonValue.Create(PropFields.WaterFluid))">Water</Chip>
            <Chip Active="Text(PropFields.Fluid, PropFields.WaterFluid) == PropFields.LavaFluid"
                  OnClick="() => Set(PropFields.Fluid, JsonValue.Create(PropFields.LavaFluid))">Lava</Chip>
          </div></ChildContent>
        </Field>
        <Field Label="Width (blocks)"><LabelEnd><strong>@($"{Num(PropFields.Radius, 3) * 2:0}")</strong></LabelEnd>
          <ChildContent><RangeField Min="2" Max="24" Step="2" Value="@(Num(PropFields.Radius, 3) * 2)"
                 ValueChanged="value => Draft(PropFields.Radius, JsonValue.Create(Math.Max(1, value / 2)))" OnCommit="Commit" /></ChildContent></Field>
        <Field Label="Depth (blocks)">
          <LabelEnd><strong>@($"{Num(PropFields.Depth, 2):0}")</strong></LabelEnd>
          <ChildContent><RangeField Min="1" Max="8" Value="@((int)Num(PropFields.Depth, 2))"
                 ValueChanged="value => Draft(PropFields.Depth, JsonValue.Create(value))" OnCommit="Commit" /></ChildContent></Field>
        <Field Label="Beach (blocks)" Hint="width of the bank between fluid and land">
          <LabelEnd><strong>@($"{Num(PropFields.Shore, 2):0}")</strong></LabelEnd>
          <ChildContent><RangeField Min="0" Max="8" Value="@((int)Num(PropFields.Shore, 2))"
                 ValueChanged="value => Draft(PropFields.Shore, JsonValue.Create(value))" OnCommit="Commit" /></ChildContent></Field>
        <Field Label="Beach edge">
          <div class="chip-row">
            <Chip Active="Flag(PropFields.ShoreWander, true)" OnClick="() => Set(PropFields.ShoreWander, JsonValue.Create(true))">Varied</Chip>
            <Chip Active="!Flag(PropFields.ShoreWander, true)" OnClick="() => Set(PropFields.ShoreWander, JsonValue.Create(false))">Even</Chip>
          </div>
        </Field>
        <Field Label="Bank roughness" Hint="how uneven natural and stream edges are; a canal ignores it">
          <LabelEnd><strong>@($"{Num(PropFields.Edge, 0.8):0.0}")</strong></LabelEnd>
          <ChildContent><RangeField Min="0" Max="25" Value="@((int)(Num(PropFields.Edge, 0.8) * 10))"
                 ValueChanged="value => Draft(PropFields.Edge, JsonValue.Create(value / 10.0))" OnCommit="Commit" /></ChildContent></Field>
        <Field Label="Shore" Hint="the bed and the beach">
          <ChildContent><SlotSelect Styles="styles" Blocks="blocks" Value="@SlotOf(PropFields.Bank).StyleId" Block="@SlotOf(PropFields.Bank).Block"
                      Unbound="@UnboundLabel(PropFields.Bank)" ValueChanged="fill => Fill(PropFields.Bank, fill)" /></ChildContent>
        </Field>
      }
      else if (kind == PropKinds.Flora)
      {
        @* How much grows, then what: each plant a share of what grows, two to a row. *@
        <div class="field-grid">
          @ShareRow("Coverage", SpecFields.Coverage, 0.45)
          <Field Label="Patch size" Hint="how big the thicker and thinner patches are" Half>
            <LabelEnd><strong>@($"{Spec(SpecFields.Scale, 12):0}")</strong></LabelEnd>
            <ChildContent><RangeField Min="4" Max="30" Value="@((int)Spec(SpecFields.Scale, 12))"
                   ValueChanged="value => DraftSpec(SpecFields.Scale, JsonValue.Create(value))" OnCommit="Commit" /></ChildContent>
          </Field>
        </div>
        <div class="section-header section-header--ruled"><h2 class="section-title">What grows</h2></div>
        <div class="field-grid">
          @ShareRow("Ferns", SpecFields.FernShare, 0.25)
          @ShareRow("Flowers", SpecFields.FlowerShare, 0.18)
          @ShareRow("Tall grass", SpecFields.TallShare, 0)
          @ShareRow("Dead bushes", SpecFields.DeadBushShare, 0, "on sand and clay, and some on dirt")
          @ShareRow("Cacti", SpecFields.CactusShare, 0, "on sand only, one to four blocks tall")
          @ShareRow("Mushrooms", SpecFields.MushroomShare, 0, "on podzol and mycelium only")
          @ShareRow("Lily pads", SpecFields.LilyShare, 0, "on still water, in clusters where coverage is high")
          @ShareRow("Crops", SpecFields.CropShare, 0, "on farmland only, one crop per plot")
        </div>
        @if (Spec(SpecFields.CropShare, 0) > 0)
        {
          <Field Label="Sown"><ChildContent><div class="chip-row">
            @foreach (var crop in CropKinds.All)
            {
              <Chip Active="Crops().Contains(crop)" @key="crop" OnClick="() => ToggleCrop(crop)">@crop</Chip>
            }
          </div></ChildContent></Field>
          @ShareRow("Ripeness", SpecFields.Ripeness, 1, "from just sown to ready, varying a little per plot", half: false)
        }
      }
      else if (kind == PropKinds.Chest)
      {
        <Field Label="Front" Hint="the side the latch faces; mirrored copies turn to match">
          <ChildContent><div class="chip-row">
            @foreach (var side in Sides)
            {
              <Chip Active="Text(PropFields.Facing, Sides[0].Key) == side.Key" @key="side.Key"
                    OnClick="() => Set(PropFields.Facing, JsonValue.Create(side.Key))">@side.Label</Chip>
            }
          </div></ChildContent>
        </Field>
        <Field Label="Stands" Hint="on the ground, or at a set height such as a deck or floor">
          <ChildContent><div class="chip-row">
            <Chip Active="prop?[PropFields.Y] is null" OnClick="() => Set(PropFields.Y, null)">On the ground</Chip>
            <Chip Active="prop?[PropFields.Y] is not null" OnClick="() => Set(PropFields.Y, JsonValue.Create((int)Num(PropFields.Y, 64)))">At a height</Chip>
          </div>
            @if (prop?[PropFields.Y] is not null)
            {
              <NumberField Value="Num(PropFields.Y, 64)" ValueChanged="v => Set(PropFields.Y, JsonValue.Create((int)v))" Min="1" Step="1" />
            }
          </ChildContent>
        </Field>
        <div class="section-header section-header--ruled"><h2 class="section-title">Items</h2></div>
        <p class="section-desc">Up to 27 stacks, in the order they fill the chest. Write enchantments as name and level, for example <code>power:1, infinity</code>.</p>
        @for (var index = 0; index < ChestItems().Count; index++)
        {
          var at = index;
          <div class="chest-item">
            <input class="field-input" placeholder="minecraft:bow" value="@StackItem(at)"
                   @onchange="e => SetChestItem(at, ChestItemFields.Item, JsonValue.Create(e.Value?.ToString() ?? string.Empty))" />
            <NumberField Value="StackCount(at)" ValueChanged="v => SetChestItem(at, ChestItemFields.Count, JsonValue.Create(Math.Clamp((int)v, 1, 64)))" Min="1" Step="1" />
            <input class="field-input" placeholder="power:1" value="@EnchantmentText(at)"
                   @onchange="e => SetChestItem(at, ChestItemFields.Enchantments, Enchantments(e.Value?.ToString()))" />
            <button class="btn btn--ghost" title="Remove stack" @onclick="() => RemoveChestItem(at)"><i data-lucide="x"></i></button>
          </div>
        }
        @if (ChestItems().Count < 27)
        {
          <button class="btn btn--ghost" @onclick="AddChestItem"><i data-lucide="plus"></i> Add a stack</button>
        }
      }
      else if (kind == PropKinds.Tree)
      {
        @if (!IsGeneratedTree && WornTree is { Builder: { Length: > 0 } builder })
        {
          <p class="section-desc">Built by <strong>@builder</strong>, credited on maps that use it.</p>
        }
        @* The tree this one is, first and on its own, so the pick reads without a separate picture and without
           scrolling to find its card in the grids below. *@
        <div class="section-header section-header--ruled"><h2 class="section-title">In use</h2></div>
        <div class="prop-cards prop-cards--tall">
          @if (WornTree is { } worn) { @TreeCard(worn, inUse: true) }
          else { <span class="prop-card prop-card--empty">Nothing picked</span> }
        </div>
        <div class="section-header section-header--ruled"><h2 class="section-title">Generated</h2></div>
        <div class="prop-cards prop-cards--tall">
          @foreach (var tree in GeneratedTrees) { @TreeCard(tree) }
        </div>
        <div class="section-header section-header--ruled"><h2 class="section-title">Hand-built</h2></div>
        <div class="prop-cards prop-cards--tall">
          @foreach (var tree in ShownHandBuilt) { @TreeCard(tree) }
        </div>
        @if (HandBuiltTrees.Count > HandBuiltShown)
        {
          <button class="btn btn--ghost prop-cards-more" @onclick="() => showAllHandBuilt = !showAllHandBuilt">
            @(showAllHandBuilt ? "Show fewer" : $"… {HandBuiltTrees.Count - HandBuiltShown} more")
          </button>
        }
        @if (trees.Count == 0)
        {
          <p class="section-desc">No trees in the library yet.</p>
        }
        @if (IsGeneratedTree)
        {
          <Field Label="Height (blocks)"><LabelEnd><strong>@($"{heightDraft ?? TreeHeight:0}")</strong></LabelEnd>
            <ChildContent><RangeField Min="5" Max="30" Value="@(heightDraft ?? TreeHeight)"
                   ValueChanged="value => heightDraft = value" OnCommit="SetTreeHeight" /></ChildContent></Field>
        }
      }
      else if (kind == PropKinds.Boulder)
      {
        <div class="prop-cards">
          @foreach (var option in boulderForms)
          {
            <button class="prop-card @(BoulderForm == option.Key ? "prop-card--active" : null)"
                    title="@option.Label" @onclick="() => SetBoulder(recipe => recipe[BoulderFields.Form] = option.Key)">
              <span class="prop-card-art">@((MarkupString)option.Svg)</span>
              <span class="prop-card-label">@option.Label</span>
            </button>
          }
        </div>
        <Field Label="Size (blocks)"><LabelEnd><strong>@($"{sizeDraft ?? BoulderSize:0}")</strong></LabelEnd>
          <ChildContent><RangeField Min="2" Max="10" Value="@(sizeDraft ?? BoulderSize)"
                 ValueChanged="value => sizeDraft = value" OnCommit="SetBoulderSize" /></ChildContent></Field>
        <Field Label="Rock">
          <SlotSelect Styles="styles" Blocks="blocks" Value="@RockSlot.StyleId" Block="@RockSlot.Block"
                      Unbound="@(RockIsCustom ? "Custom" : "Default rock")" ValueChanged="FillRock" />
        </Field>
        <Field Label="Moss">
          <div class="chip-row">
            <Chip Active="BoulderMossy" OnClick="() => SetBoulder(recipe => recipe[BoulderFields.Mossy] = true)">Mossy</Chip>
            <Chip Active="!BoulderMossy" OnClick="() => SetBoulder(recipe => recipe[BoulderFields.Mossy] = false)">Bare</Chip>
          </div>
        </Field>
      }
      else if (kind == PropKinds.House)
      {
        <div class="section-header section-header--ruled"><h2 class="section-title">Shell</h2></div>
        <p class="section-desc">Picking one copies it to this building. Later library edits don't change it.</p>
        <div class="prop-cards">
          @foreach (var shell in shells)
          {
            <button class="prop-card @(Wears(shellName, shell.Name) ? "prop-card--active" : null)"
                    title="@shell.Name" @key="shell.Id" @onclick="() => PickShell(shell)">
              <span class="prop-card-art">@((MarkupString)shell.Preview)</span>
              <span class="prop-card-label">@shell.Name</span>
            </button>
          }
        </div>
        @if (shells.Count == 0)
        {
          <p class="section-desc">No room styles saved yet, so the building uses the bedrock box. Create one
            in the <strong>Library</strong> under Houses.</p>
        }

        @if (editingSelection && prop?["wings"] is System.Text.Json.Nodes.JsonArray wings)
        {
          <SketchHouseWings Wings="wings" Picked="pickedWing" OnPick="PickWing" OnDelete="DeleteWing" OnSpec="SetWingSpec" />
        }

        <div class="section-header section-header--ruled"><h2 class="section-title">Door</h2></div>

        <div class="chip-row">
          <Chip Active="@(Text(PropFields.Front, string.Empty).Length == 0)" OnClick="() => Set(PropFields.Front, null)">
            A long side
          </Chip>
          @foreach (var edge in Sides)
          {
            <Chip Active="@(Text(PropFields.Front, string.Empty) == edge.Key)" @key="edge.Key"
                  OnClick="() => Set(PropFields.Front, JsonValue.Create(edge.Key))">@edge.Label</Chip>
          }
        </div>
      }

      @* ── storey, seed, delete ──────────────────────────────────────────────────────────────────── *@
      @if ((editingSelection && Layers.Count > 1) || SeedMatters)
      {
        <div class="section-header section-header--ruled"><h2 class="section-title">Placement</h2></div>
      }
      @* The storey it rests on, offered from the canvas strip's own rows. A storey with no ground under the
         prop is not filtered out here: the dressing pass is the judge, and declines it DR-LAYER. *@
      @if (editingSelection && Layers.Count > 1)
      {
        <Field Label="Storey">
          <ChildContent>
            <div class="chip-row">
              @foreach (var layer in Layers)
              {
                <Chip Active="@(Text(PropFields.Layer) == layer.Id)" @key="layer.Id"
                      Title="@($"Place on '{layer.Name}' (base y {layer.BaseY})")"
                      OnClick="() => Set(PropFields.Layer, JsonValue.Create(layer.Id))">@layer.Name</Chip>
              }
            </div>
          </ChildContent>
        </Field>
      }
      @if (SeedMatters)
      {
        <SeedField Value="@((int)Num(PropFields.Seed))" ValueChanged="seed => Set(PropFields.Seed, JsonValue.Create(seed))" />
      }
    }
  </Section>
  @if (prop is not null && editingSelection)
  {
    <InspectorDelete Title="@($"Delete this {Info.One.ToLowerInvariant()}")" OnClick="Delete" />
  }

</Inspector>

@code {
    /// <summary>One share of the ground cover: its label, its percentage, and a slider that previews while dragged
    /// and writes on release.</summary>
    private RenderFragment ShareRow(string label, string field, double fallback, string? hint = null, bool half = true) => __builder =>
    {
        <Field Label="@label" Hint="@hint" Half="half">
          <LabelEnd><strong>@($"{Spec(field, fallback) * 100:0}%")</strong></LabelEnd>
          <ChildContent><RangeField Min="0" Max="100" Value="@((int)(Spec(field, fallback) * 100))"
                 ValueChanged="value => DraftSpec(field, JsonValue.Create(Share(value)))" OnCommit="Commit" /></ChildContent>
        </Field>
    };

    /// <summary>A tree's card in the picker, marked where the prop wears it; the <paramref name="inUse"/> copy at
    /// the picker's head shows the tree rather than marking a pick, so the grid holds the one mark.</summary>
    private RenderFragment TreeCard(TreeStyleSummary tree, bool inUse = false) => __builder =>
    {
        <button class="prop-card @(inUse ? "prop-card--in-use" : tree == WornTree ? "prop-card--active" : null)"
                title="@tree.Name" @key="@(inUse ? $"in-use-{tree.Id}" : tree.Id.ToString())" @onclick="() => PickTree(tree)">
          <span class="prop-card-art">@((MarkupString)tree.Preview)</span>
          <span class="prop-card-label">@tree.Name</span>
        </button>
    };
}
