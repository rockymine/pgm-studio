@namespace PgmStudio.Client.Features.Sketch
@using System.Text.Json.Nodes

@* The Dressing phase's inspector: the knobs of the prop under the cursor, and a picture of what they make.
   With nothing selected the same form edits the active tool's starting values, so the next prop placed is
   already aimed. Every picker is drawn by the pass itself, never by an icon. *@

@* Wide: this inspector hosts a whole MaterialEditor (a path's paving, a boulder's rock), not a property
   list, so it starts at the width that form is readable at rather than the shared inspector default. *@
<Inspector Class="workspace-inspector--wide">
  <Section>
    @if (prop is null)
    {
      <p class="section-desc">
        Pick a tool and place something: drag a <strong>route</strong>, an <strong>area</strong> or a
        <strong>building</strong>'s footprint, click to drop a <strong>tree</strong> or a
        <strong>boulder</strong>. Click a placed prop to change it.
      </p>
      <p class="section-desc">@propCount placed on this map.</p>
    }
    else
    {
      <DetailHeader Icon="@Info.Icon" Label="@Info.Title">
        <span class="detail-header-badges">
          @if (editingSelection) { <Badge Kind="neutral">selected</Badge> }
          else { <Badge Kind="dim">next one</Badge> }
          @if (kind is PropKinds.Tree or PropKinds.Boulder or PropKinds.House) { <Badge Kind="warning">affects play</Badge> }
          else if (kind == PropKinds.Flora) { <Badge Kind="dim">cosmetic</Badge> }
        </span>
      </DetailHeader>
      <p class="section-desc">@Info.Blurb</p>

      @* ── what the last canvas operation did, or would not do ─────────────────────────────────── *@
      @if (note is not null)
      {
        <p class="section-desc dressing-note">@note</p>
      }

      @* ── why this prop is not one the pass would take ─────────────────────────────────────────── *@
      @if (refusal is not null)
      {
        <p class="section-desc dressing-refusal">@refusal</p>
      }

      @* ── what it makes ───────────────────────────────────────────────────────────────────────── *@
      @if (preview is not null)
      {
        <div class="dressing-views">
          <figure class="theme-section-figure">@((MarkupString)preview.Plan)</figure>
          <figure class="theme-section-figure">@((MarkupString)preview.Section)</figure>
        </div>
      }

      @* ── the knobs, by kind ──────────────────────────────────────────────────────────────────── *@
      @if (kind == PropKinds.Stroke)
      {
        <Field Label="What it is">
          <label class="ctrl-row" style="cursor:pointer">
            <input type="checkbox" class="control-input control-input--hidden" checked="@Flag(PropFields.Route)"
                   @onchange="e => Set(PropFields.Route, JsonValue.Create(e.Value is true))" />
            <span class="plan-readout">@(Flag(PropFields.Route) ? "a route — trees and boulders keep clear"
                                          : "paint — anything may stand on it")</span>
          </label>
        </Field>
        <p class="section-desc">The style below is the brush and says nothing about this: a gravel tongue over
          a crag and a road between two spawns can be the same brush at the same width. Only a route is kept
          clear of, and a board where every stroke is one has nowhere left to plant.</p>
        <Field Label="Width (blocks)">
          <NumberField Value="Num(PropFields.Radius, 3) * 2" ValueChanged="v => Set(PropFields.Radius, JsonValue.Create(Math.Max(1, v / 2)))" Min="2" Step="2" />
        </Field>
        <div class="section-header section-header--ruled"><h2 class="section-title">Style</h2></div>
        <div class="prop-cards">
          @foreach (var option in pathStyles)
          {
            <button class="prop-card @(Text(PropFields.Style, PropFields.SolidStyle) == option.Key ? "prop-card--active" : null)"
                    title="@option.Label" @onclick="() => Pick(PropFields.Style, option)">
              <span class="prop-card-art">@((MarkupString)option.Svg)</span>
              <span class="prop-card-label">@option.Label</span>
            </button>
          }
        </div>
        @if (Text(PropFields.Style, PropFields.SolidStyle) == "worn")
        {
          <Field Label="How much of it is paved"><LabelEnd><strong>@($"{Num(PropFields.Coverage, 0.7) * 100:0}%")</strong></LabelEnd>
            <ChildContent><input type="range" class="field-range" min="10" max="100" step="1"
                   value="@((int)(Num(PropFields.Coverage, 0.7) * 100))"
                   @oninput="e => Set(PropFields.Coverage, JsonValue.Create(Share(e)))" /></ChildContent></Field>
        }
        <div class="section-header section-header--ruled"><h2 class="section-title">Paving</h2></div>
        <p class="section-desc">What the band is laid with — a full material, so a road can be one block, a
          cobbled fabric of several, or any pattern the theme offers. The style above shapes the band; this
          decides what fills it.</p>
        @if (Material(PropFields.Pave) is { } pave)
        {
          <MaterialEditor Node="pave" Blocks="blocks" Styles="styles" OnChanged="() => MaterialChanged(PropFields.Pave)" />
        }
      }
      else if (kind == PropKinds.Water)
      {
        <Field Label="Width (blocks)">
          <NumberField Value="Num(PropFields.Radius, 3) * 2" ValueChanged="v => Set(PropFields.Radius, JsonValue.Create(Math.Max(1, v / 2)))" Min="2" Step="2" />
        </Field>
        <Field Label="Depth (blocks)"><LabelHint>cut on the centerline; the bed rises to the banks</LabelHint>
          <LabelEnd><strong>@($"{Num(PropFields.Depth, 2):0}")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="1" max="8" step="1"
                 value="@((int)Num(PropFields.Depth, 2))"
                 @oninput="e => Set(PropFields.Depth, JsonValue.Create(Whole(e)))" /></ChildContent></Field>
        <Field Label="Beach (blocks)"><LabelHint>the bank the water meets the land through</LabelHint>
          <LabelEnd><strong>@($"{Num(PropFields.Shore, 2):0}")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="0" max="8" step="1"
                 value="@((int)Num(PropFields.Shore, 2))"
                 @oninput="e => Set(PropFields.Shore, JsonValue.Create(Whole(e)))" /></ChildContent></Field>
        <Field Label="Beach edge">
          <Chip Active="Flag(PropFields.ShoreWander, true)" OnClick="() => Set(PropFields.ShoreWander, JsonValue.Create(!Flag(PropFields.ShoreWander, true)))">
            @(Flag(PropFields.ShoreWander, true) ? "Wanders — widens and closes along the run" : "Even — one width the whole way")
          </Chip>
        </Field>
        <Field Label="Bank roughness"><LabelHint>how far a natural or stream edge wanders; a canal ignores it</LabelHint>
          <LabelEnd><strong>@($"{Num(PropFields.Edge, 0.8):0.0}")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="0" max="25" step="1"
                 value="@((int)(Num(PropFields.Edge, 0.8) * 10))"
                 @oninput="e => Set(PropFields.Edge, JsonValue.Create(Whole(e) / 10.0))" /></ChildContent></Field>
        <div class="section-header section-header--ruled"><h2 class="section-title">Form</h2></div>
        <div class="prop-cards">
          @foreach (var option in waterForms)
          {
            <button class="prop-card @(Text(PropFields.Form, PropFields.CanalForm) == option.Key ? "prop-card--active" : null)"
                    title="@option.Label" @onclick="() => Pick(PropFields.Form, option)">
              <span class="prop-card-art">@((MarkupString)option.Svg)</span>
              <span class="prop-card-label">@option.Label</span>
            </button>
          }
        </div>
        <div class="section-header section-header--ruled"><h2 class="section-title">Bank</h2></div>
        <p class="section-desc">The bed floor and the beach — a full material, the same the shallows show
          through and the shore meets the land with.</p>
        @if (Material(PropFields.Bank) is { } bank)
        {
          <MaterialEditor Node="bank" Blocks="blocks" Styles="styles" OnChanged="() => MaterialChanged(PropFields.Bank)" />
        }
      }
      else if (kind == PropKinds.Flora)
      {
        <Field Label="Coverage"><LabelEnd><strong>@($"{Spec(SpecFields.Coverage, 0.45) * 100:0}%")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="0" max="100" step="1"
                 value="@((int)(Spec(SpecFields.Coverage, 0.45) * 100))"
                 @oninput="e => SetSpec(SpecFields.Coverage, JsonValue.Create(Share(e)))" /></ChildContent></Field>
        <Field Label="Patch size"><LabelEnd><strong>@($"{Spec(SpecFields.Scale, 12):0}")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="4" max="30" step="1"
                 value="@((int)Spec(SpecFields.Scale, 12))"
                 @oninput="e => SetSpec(SpecFields.Scale, JsonValue.Create(Whole(e)))" /></ChildContent></Field>
        <Field Label="Fern share"><LabelEnd><strong>@($"{Spec(SpecFields.FernShare, 0.25) * 100:0}%")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="0" max="100" step="1"
                 value="@((int)(Spec(SpecFields.FernShare, 0.25) * 100))"
                 @oninput="e => SetSpec(SpecFields.FernShare, JsonValue.Create(Share(e)))" /></ChildContent></Field>
        <Field Label="Flower fields"><LabelEnd><strong>@($"{Spec(SpecFields.FlowerShare, 0.18) * 100:0}%")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="0" max="100" step="1"
                 value="@((int)(Spec(SpecFields.FlowerShare, 0.18) * 100))"
                 @oninput="e => SetSpec(SpecFields.FlowerShare, JsonValue.Create(Share(e)))" /></ChildContent></Field>
        <Field Label="Tall grass"><LabelHint>hides a player, so it is mirrored</LabelHint>
          <LabelEnd><strong>@($"{Spec(SpecFields.TallShare, 0) * 100:0}%")</strong></LabelEnd>
          <ChildContent><input type="range" class="field-range" min="0" max="100" step="1"
                 value="@((int)(Spec(SpecFields.TallShare, 0) * 100))"
                 @oninput="e => SetSpec(SpecFields.TallShare, JsonValue.Create(Share(e)))" /></ChildContent></Field>
      }
      else if (kind == PropKinds.Tree || kind == PropKinds.Boulder)
      {
        @* A tree and a boulder are put down with a click, so what is placed is a position and what stands
           there is a recipe from the library. The knobs live where the recipe is authored; here an author
           picks one, and the link is how they go and make another. *@
        <div class="section-header section-header--ruled">
          <h2 class="section-title">@(kind == PropKinds.Tree ? "Which tree" : "Which rock")</h2>
        </div>
        <p class="section-desc">
          Picked from the library and named on the placement, so retuning the recipe retunes every
          @(kind == PropKinds.Tree ? "tree" : "boulder") wearing it.
        </p>
        <div class="prop-cards prop-cards--tall">
          @foreach (var recipe in recipes)
          {
            <button class="prop-card @(recipeName == recipe.Name ? "prop-card--active" : null)"
                    title="@recipe.Name" @key="recipe.Id" @onclick="() => PickRecipe(recipe)">
              <span class="prop-card-art">@((MarkupString)recipe.Preview)</span>
              <span class="prop-card-label">@recipe.Name</span>
            </button>
          }
        </div>
        @if (recipes.Count == 0)
        {
          <p class="section-desc">No @(kind == PropKinds.Tree ? "trees" : "boulders") saved yet — author one
            on the <strong>Library</strong> tool.</p>
        }
        <div class="panel-actions">
          <Button OnClick="OpenLibrary">
            <i data-lucide="external-link"></i> @(recipes.Count == 0 ? "Author one" : "Author another")
          </Button>
        </div>
      }
      else if (kind == PropKinds.House)
      {
        <div class="section-header section-header--ruled"><h2 class="section-title">Shell</h2></div>
        <p class="section-desc">The building is raised in a room style from the library. Picking one copies it
          onto this building, so editing that library row later leaves what is already placed alone.</p>
        <div class="prop-cards">
          @foreach (var shell in shells)
          {
            <button class="prop-card @(shellName == shell.Name ? "prop-card--active" : null)"
                    title="@shell.Name" @key="shell.Id" @onclick="() => PickShell(shell)">
              <span class="prop-card-art">@((MarkupString)shell.Preview)</span>
              <span class="prop-card-label">@shell.Name</span>
            </button>
          }
        </div>
        @if (shells.Count == 0)
        {
          <p class="section-desc">No room styles saved yet — the building keeps the built-in shell until the
            library has one. Author one on the <strong>Library</strong> tool's Rooms tab.</p>
        }

        <div class="section-header section-header--ruled"><h2 class="section-title">Wings</h2></div>
        <p class="section-desc">A building is one rectangle or several touching ones — an L, a T or a U —
          stamped as a single shell under one roof. Shift-click a second building to pick both, then
          <kbd>@JoinChord</kbd> to join them; the same chord on a joined building takes it apart again.</p>
        <div class="panel-actions">
          <Button OnClick="Join" Disabled="@(!CanJoin)">
            <i data-lucide="@(Wings > 1 ? "ungroup" : "group")"></i> @JoinLabel
          </Button>
          <Badge Kind="dim">@Wings @(Wings == 1 ? "wing" : "wings")</Badge>
          @if (picked > 1) { <Badge Kind="neutral">@picked selected</Badge> }
        </div>

        <div class="section-header section-header--ruled"><h2 class="section-title">Door</h2></div>
        <p class="section-desc">Which wall the way in is cut through. It turns with the building at every
          mirror image, so a pair never both open toward the same half of the map.</p>
        <div class="chip-row">
          <Chip Active="@(Text(PropFields.Front, string.Empty).Length == 0)" OnClick="() => Set(PropFields.Front, null)">
            A long side
          </Chip>
          @foreach (var edge in HouseFronts)
          {
            <Chip Active="@(Text(PropFields.Front, string.Empty) == edge.Key)" @key="edge.Key"
                  OnClick="() => Set(PropFields.Front, JsonValue.Create(edge.Key))">@edge.Label</Chip>
          }
        </div>
      }

      @* ── seed + delete ───────────────────────────────────────────────────────────────────────── *@
      <div class="section-header section-header--ruled"><h2 class="section-title">This one</h2></div>
      <Field Label="Seed">
        <div class="panel-actions">
          <NumberField Value="Num(PropFields.Seed)" ValueChanged="v => Set(PropFields.Seed, JsonValue.Create((int)v))" Min="0" />
          <Button OnClick="Reroll"><i data-lucide="refresh-cw"></i> Reroll</Button>
        </div>
      </Field>
      <p class="section-desc">The same seed always makes the same thing, so a map exports identically.</p>
      @if (editingSelection)
      {
        <Button Full Variant="danger" OnClick="Delete"><i data-lucide="trash-2"></i> Delete</Button>
      }
    }
  </Section>
</Inspector>
