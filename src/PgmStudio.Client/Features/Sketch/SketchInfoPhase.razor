@namespace PgmStudio.Client.Features.Sketch
@inject HttpClient Http
@inject IJSRuntime JS

@* Sketch Identity phase — two steps: Details (display name + authors, saved to the map metadata via
   GET/PATCH api/map/{slug}, since sketches are map rows, as they are typed) and Symmetry (mode + centre, which
   drive the live canvas through the host's callbacks). The host's rail lists the steps and its bar's Back and
   Next move between them. *@

<div class="phase-body">
  <Workspace>
    <ContentColumn MaxWidth="720">
      @if (Step == 0)
      {
        <Section Title="Details">
          <Field Label="Map name" Required For="sk-name">
            <input id="sk-name" class="field-input" type="text"
                   value="@name" @oninput="e => { name = e.Value?.ToString() ?? string.Empty; Dirty(); }" />
          </Field>
        </Section>

        <AuthorsEditor Authors="authors" OnChanged="Dirty" />

        @if (loadError is not null) { <p class="field-error">@loadError</p> }
      }
      else
      {
        <Section Title="Symmetry">
          <Field Label="Mode">
            <Select Slim="false" Options="ModeOptions" Value="@Mode" ValueChanged="OnModeChange" />
          </Field>
          @* With no symmetry nothing turns about the centre, so there is no centre to state. *@
          @if (Mode != SymmetryModes.None)
          {
            <Field Label="Centre X">
              <NumberField Value="CenterX" ValueChanged="OnCenterX" />
            </Field>
            <Field Label="Centre Z">
              <NumberField Value="CenterZ" ValueChanged="OnCenterZ" />
            </Field>
          }
        </Section>
      }
    </ContentColumn>
  </Workspace>
</div>
