@namespace PgmStudio.Client.Features.Sketch

@* Sketch Layout tree — groups (collapsible parents) with their contributing shapes as indented
   children. Same geo-tree format as the region tree (geo-indent pipes + collapse chevrons). Selection
   only; per-item actions live in SketchInspector. Rendered inside the editor's workspace-sidebar. *@

<Section Title="Groups">
  <div class="region-tree">
    @if (!Groups.Any() && !Shapes.Any())
    {
      <div class="panel-empty-msg">Draw shapes to form groups.</div>
    }
    else
    {
      @foreach (var isl in Groups)
      {
        <div class="geo-row @(isl.Id == SelectedGroupId ? "geo-row--selected" : null)"
             @onclick="() => OnSelectGroup.InvokeAsync(isl.Id)">
          <span class="geo-indent">
            @if (isl.ShapeIds.Count > 0)
            {
              <button class="collapse-btn" @onclick="() => Toggle(isl.Id)" @onclick:stopPropagation="true">
                <Icon Name="@(collapsed.Contains(isl.Id) ? "chevron-right" : "chevron-down")" />
              </button>
            }
          </span>
          <span class="geo-type-icon" style="@(isl.Mirrors ? null : "color:var(--text-muted)")"><Icon Name="layers" /></span>
          <span class="geo-label" title="@isl.Name">@isl.Name</span>
          <span class="list-tag">@isl.ShapeIds.Count shape@(isl.ShapeIds.Count == 1 ? "" : "s")</span>
        </div>
        @if (!collapsed.Contains(isl.Id))
        {
          @foreach (var sid in isl.ShapeIds)
          {
            var s = ShapeById(sid);
            @if (s is not null)
            {
              <div class="geo-row @(s.Id == SelectedShapeId ? "geo-row--selected" : null)"
                   @onclick="() => OnSelectShape.InvokeAsync(s.Id)">
                <span class="geo-indent"><span class="indent-pipe"></span></span>
                <span class="geo-type-icon" style="@(s.Operation == "subtract" ? "color:var(--canvas-sub-fill)" : null)"><Icon Name="@TypeIcon(s.Type)" /></span>
                <span class="geo-label">@s.Type</span>
                <span class="list-tag">@s.Dim</span>
                @if (s.Override)
                {
                  <span class="geo-type-icon geo-type-icon--warning geo-type-icon--flush" title="Override"><Icon Name="shield" /></span>
                }
              </div>
            }
          }
        }
      }
      @foreach (var s in Unassigned())
      {
        <div class="geo-row @(s.Id == SelectedShapeId ? "geo-row--selected" : null)"
             @onclick="() => OnSelectShape.InvokeAsync(s.Id)">
          <span class="geo-indent"></span>
          <span class="geo-type-icon" style="@(s.Operation == "subtract" ? "color:var(--canvas-sub-fill)" : null)"><Icon Name="@TypeIcon(s.Type)" /></span>
          <span class="geo-label">@s.Type</span>
          <span class="list-tag">@s.Dim</span>
          @if (s.Override)
          {
            <span class="geo-type-icon geo-type-icon--warning geo-type-icon--flush" title="Override"><Icon Name="shield" /></span>
          }
        </div>
      }
    }
  </div>
</Section>
