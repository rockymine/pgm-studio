@page "/generator"
@layout StudioLayout
@implements IAsyncDisposable

@* Generator browse: page through the composed-board library and sieve it. Cards are server-rendered SVGs of the
   full fanned board; opening one makes a map of the stored board the descriptor names. *@

<PageTitle>Generator · PGM Studio</PageTitle>

<StudioShell Bare="true">
  <ChildContent>
  <div class="gen-body">
    <FilterSidebar>
      <FilterPanel Title="Layout settings">
        <FilterGroup Label="Team size">
          @foreach (var size in SizeBands.All)
          {
            <Chip Active="band == size" OnClick="() => PickBand(size)">@BandLabel(size)</Chip>
          }
        </FilterGroup>

        <FilterGroup Label="Symmetry">
          @foreach (var s in Symmetries)
          {
            <Chip Active="symmetry == s.Id" Disabled="!s.Supported"
                  Title="@(s.Supported ? null : "Not available yet")"
                  OnClick="() => PickSymmetry(s.Id)">@SymmetryInfo.Label(s.Id)</Chip>
          }
        </FilterGroup>

        <FilterGroup Label="Wools per team" Match="any of" Multi>
          @foreach (var count in WoolCounts.All)
          {
            <Chip Active="woolCounts.Contains(count)" OnClick="() => ToggleWoolCount(count)">@count</Chip>
          }
        </FilterGroup>
      </FilterPanel>

      <FilterPanel Title="Shape filters" Active="ShapeFiltered" OnClear="ClearShapeFilters">
          <FilterGroup Label="Approach" Match="has all" Multi>
            @foreach (var w in WoolChips)
            {
              <Chip Active="woolFilter.Contains(w.Token)" Disabled="!w.InMix"
                    Count="@(censusBoards > 0 && w.InMix ? seenWools.GetValueOrDefault(w.Token) : null)"
                    Class="@(w.InMix && Unseen(seenWools, w.Token) ? "filter-chip--unseen" : null)"
                    Title="@(w.InMix ? ChipTitle(seenWools, w.Token, w.Label) : "The generator doesn't use this shape")"
                    OnClick="() => ToggleWool(w.Token)">@w.Label</Chip>
            }
          </FilterGroup>

          <FilterGroup Label="Hub" Match="any of" Multi>
            @foreach (var h in HubChips)
            {
              <Chip Active="hubFilter.Contains(h.Token)"
                    Count="@(censusBoards > 0 ? seenHubs.GetValueOrDefault(h.Token) : null)"
                    Class="@(Unseen(seenHubs, h.Token) ? "filter-chip--unseen" : null)"
                    Title="@ChipTitle(seenHubs, h.Token, h.Label)"
                    OnClick="() => ToggleHub(h.Token)">@h.Label</Chip>
            }
          </FilterGroup>

          <FilterGroup Label="Front line" Match="any of" Multi>
            @foreach (var f in FrontChips)
            {
              <Chip Active="frontFilter.Contains(f.Token)"
                    Count="@(censusBoards > 0 ? seenFronts.GetValueOrDefault(f.Token) : null)"
                    Class="@(Unseen(seenFronts, f.Token) ? "filter-chip--unseen" : null)"
                    Title="@ChipTitle(seenFronts, f.Token, f.Label)"
                    OnClick="() => ToggleFront(f.Token)">@f.Label</Chip>
            }
          </FilterGroup>

          @if (censusBoards > 0 && CensusIsTelling)
          {
            <p class="filter-panel-note">A shape at 0 is never generated with these settings.</p>
          }
          <a class="gen-catalog-link" href="/catalog"><i data-lucide="shapes"></i><span>Every shape in the catalog</span></a>
      </FilterPanel>
    </FilterSidebar>

    <main class="gen-main">
      <PageHeading Title="Generator">
        <Lead>Layouts the generator has built, filtered by the layout settings and shape filters. Open one to make a map from it.</Lead>
      </PageHeading>
      <div class="gen-toolbar">
        @if (censusBoards > 0)
        {
          <p class="gen-scanned"><strong>@matching</strong> of @censusBoards layouts match</p>
        }
        <BoardKey Entries="key" />
      </div>

      <div class="gen-grid">
        @foreach (var card in cards)
        {
          <PictureCard @key="card.Descriptor.Seed" FigClass="lib-card-fig--board" Svg="@card.Svg" Name="@LayoutId(card)"
                       OnClick="() => OpenDetail(card)" />
        }
      </div>

      @if (feedError is not null) { <StatusLine>@feedError</StatusLine> }
      else if (loading) { <StatusLine /> }
      else if (cards.Count == 0 && censusBoards == 0)
      {
        <EmptyState>No layouts for these settings yet. They are still being generated.</EmptyState>
      }
      else if (cards.Count == 0 && NeverSeen() is { Length: > 0 } never)
      {
        <EmptyState>No layout for these settings has @never. These players and symmetry don't produce it.</EmptyState>
      }
      else if (cards.Count == 0)
      {
        <EmptyState>No layout of the @censusBoards for these settings matches these filters.</EmptyState>
      }
      else if (atEnd) { <p class="gen-status">No more layouts for these settings.</p> }

      <div @ref="sentinelRef" class="gen-sentinel"></div>
      @if (!atEnd && !loading && cards.Count > 0)
      {
        <Button Full Class="gen-more" OnClick="LoadMore">Load more</Button>
      }
    </main>
  </div>

  @if (detail is { } d)
  {
    <SideDrawer Open="true" Wide="true" Title="@LayoutId(d)" Icon="layout-grid" OnClose="CloseDetail">
      <Body>
        <div class="gen-detail-fig @HighlightClasses">@((MarkupString)d.Svg)</div>

        <div class="gen-detail-controls">
          <div class="gen-highlight" role="group" aria-label="Highlight">
            <span class="gen-highlight-label">Highlight</span>
            @foreach (var (role, label) in HighlightRoles)
            {
              <Chip Active="highlights.Contains(role)" OnClick="() => ToggleHighlight(role)">@label</Chip>
            }
          </div>
          <BoardKey Entries="key" />
        </div>

        <p class="gen-detail-desc">
          @foreach (var part in Describe(d))
          {
            if (part.Term is null) { @part.Text }
            else { <a class="gen-term" href="@($"/glossary#{Glossary.Slug(part.Term)}")" target="_blank" rel="noopener">@part.Text</a> }
          }
        </p>

        <dl class="gen-facts">
          <div><dt>Team size</dt><dd>@PlayersLabel(d)</dd></div>
          <div><dt>Wools per team</dt><dd>@d.WoolCount</dd></div>
          <div><dt>Symmetry</dt><dd>@SymmetryLabel(d.Descriptor.Symmetry)</dd></div>
        </dl>
      </Body>
      <Footer>
        <div class="gen-detail-foot">
          <p class="gen-detail-foot-note">@(openError ?? "Makes a new map of this layout and opens it in the Sketch tool, ready to shape.")</p>
          <Button Variant="primary" Writes Busy="@opening" BusyLabel="Making the map…" OnClick="() => OpenInSketch(d)">Make a map</Button>
        </div>
      </Footer>
    </SideDrawer>
  }
  </ChildContent>
</StudioShell>
