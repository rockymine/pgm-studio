@page "/generator"
@layout StudioLayout
@implements IAsyncDisposable

@* Generator browse (G117): page through the composed-board library, sieve it, and pin the keepers. Cards are
   server-rendered SVGs of the full fanned board; pin/open keep the stored board the descriptor names. *@

<PageTitle>Generator · PGM Studio</PageTitle>

<StudioShell Bare="true">
  <Bar>
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>Generator</Crumb></Crumbs>
    </Topbar>
  </Bar>
  <ChildContent>
  <div class="gen-body">
    <aside class="gen-filters">
      <Section Title="Filters">

        <Field Label="Players per team">
          <LabelEnd><strong>@players</strong></LabelEnd>
          <ChildContent>
            <input type="range" class="field-range" min="6" max="32" step="2" value="@players" @oninput="OnPlayers" />
          </ChildContent>
        </Field>

        <Field Label="Symmetry">
          <div class="filter-group-options">
            @foreach (var s in Symmetries)
            {
              <Chip Active="symmetry == s.Id" Disabled="!s.Supported"
                    Title="@(s.Supported ? s.Label : "Not available yet")"
                    OnClick="() => PickSymmetry(s.Id)">@s.Label</Chip>
            }
          </div>
        </Field>

        <Field Label="Max score">
          <LabelEnd><strong>@(maxScore >= ScoreCap ? "Any" : maxScore.ToString("0.0"))</strong></LabelEnd>
          <ChildContent>
            <input type="range" class="field-range" min="0" max="8" step="0.5" value="@maxScore" @oninput="OnMaxScore" />
          </ChildContent>
        </Field>

        <Field Label="Wool count">
          <div class="gen-wool">
            <input type="number" min="0" max="6" value="@woolMin" @oninput="OnWoolMin" title="Minimum (0 for any)" />
            <span>–</span>
            <input type="number" min="0" max="6" value="@woolMax" @oninput="OnWoolMax" title="Maximum (0 for any)" />
          </div>
        </Field>

        <Button Variant="primary" Full OnClick="Reload">Apply</Button>
        <p class="section-desc">Click Apply to use the settings above. The filters below apply right away.</p>
        @if (censusBoards > 0)
        {
          <p class="section-desc gen-census">
            Counts cover all @censusBoards saved layout@(censusBoards == 1 ? "" : "s") for these
            settings.@(CensusIsTelling ? " A shape at 0 is never generated with these settings." : "")
          </p>
        }

        <Field Label="Wool families">
          <LabelEnd><span class="text-xs text-muted">match all</span></LabelEnd>
          <ChildContent>
            <div class="filter-group-options">
              @foreach (var w in WoolChips)
              {
                <Chip Active="woolFilter.Contains(w.Token)" Disabled="!w.InMix"
                      Class="@(w.InMix && Unseen(seenWools, w.Token) ? "filter-chip--unseen" : null)"
                      Title="@(w.InMix ? ChipTitle(seenWools, w.Token, w.Label) : "The generator doesn't use this shape")"
                      OnClick="() => ToggleWool(w.Token)">@w.Label@if (censusBoards > 0 && w.InMix) { <span class="filter-chip-n">@(seenWools.GetValueOrDefault(w.Token))</span> }</Chip>
              }
            </div>
          </ChildContent>
        </Field>

        <Field Label="Hub form">
          <LabelEnd><span class="text-xs text-muted">match any</span></LabelEnd>
          <ChildContent>
            <div class="filter-group-options">
              @foreach (var h in HubChips)
              {
                <Chip Active="hubFilter.Contains(h.Token)"
                      Class="@(Unseen(seenHubs, h.Token) ? "filter-chip--unseen" : null)"
                      Title="@ChipTitle(seenHubs, h.Token, h.Label)"
                      OnClick="() => ToggleHub(h.Token)">@h.Label@if (censusBoards > 0) { <span class="filter-chip-n">@(seenHubs.GetValueOrDefault(h.Token))</span> }</Chip>
              }
            </div>
          </ChildContent>
        </Field>

        <Field Label="Front line">
          <LabelEnd><span class="text-xs text-muted">match any</span></LabelEnd>
          <ChildContent>
            <div class="filter-group-options">
              @foreach (var f in FrontChips)
              {
                <Chip Active="frontFilter.Contains(f.Token)"
                      Class="@(Unseen(seenFronts, f.Token) ? "filter-chip--unseen" : null)"
                      Title="@ChipTitle(seenFronts, f.Token, f.Label)"
                      OnClick="() => ToggleFront(f.Token)">@f.Label@if (censusBoards > 0) { <span class="filter-chip-n">@(seenFronts.GetValueOrDefault(f.Token))</span> }</Chip>
              }
            </div>
          </ChildContent>
        </Field>

      </Section>
    </aside>

    <main class="gen-main">
      @if (pinned.Count > 0)
      {
        <div class="gen-tray">
          <span class="gen-tray-label"><i data-lucide="pin"></i> Pinned · @pinned.Count</span>
          <div class="gen-tray-items">
            @foreach (var p in pinned)
            {
              <div class="gen-tray-chip">
                <a class="gen-tray-fig @(p.StaleComposer ? "gen-tray-fig--stale" : null)"
                   href="@($"/plan-editor?plan={p.Id}")" title="Open in plan editor">
                  @if (traySvg.TryGetValue(p.Id, out var s)) { @((MarkupString)s) }
                </a>
                @if (p.StaleComposer)
                {
                  <span class="gen-tray-stale" title="@StaleTitle(p)">@(p.ComposerVersion ?? "?")</span>
                }
                <span class="gen-tray-name" title="@p.Name">@p.Name</span>
                <button class="gen-tray-x" @onclick="() => Unpin(p.Id)" title="Unpin"><i data-lucide="x"></i></button>
              </div>
            }
          </div>
        </div>
      }

      @if (censusBoards > 0)
      {
        <p class="gen-scanned">@matching of @censusBoards layouts match</p>
      }

      <div class="gen-grid">
        @foreach (var card in cards)
        {
          <div class="gen-card @(IsPinned(card) ? "gen-card--pinned" : null)">
            <div class="gen-card-badges" title="Shapes in this layout. Filter by them in the sidebar.">
              @foreach (var w in card.Structure.Wools.Distinct())
              {
                <span class="gen-badge gen-badge--wool">@w</span>
              }
              <span class="gen-badge gen-badge--hub">@card.Structure.Hub</span>
              <span class="gen-badge gen-badge--front">@card.Structure.Frontline</span>
            </div>
            <button class="gen-card-fig" @onclick="() => OpenDetail(card)" title="Open details">
              @((MarkupString)card.Svg)
            </button>
            <div class="gen-card-foot">
              <span class="gen-card-score" title="Score (lower is better)">@card.Score.ToString("0.0")</span>
              <span class="gen-card-meta">@card.WoolCount wool · #@card.Descriptor.Seed</span>
              @if (card.Spend is { } spend)
              {
                <span class="gen-card-land" title="@SpendTitle(spend)">@SpendShort(spend)</span>
              }
              <button class="gen-pin @(IsPinned(card) ? "gen-pin--on" : null)" @onclick="() => TogglePin(card)"
                      title="@(IsPinned(card) ? "Unpin" : "Pin")"><i data-lucide="pin"></i></button>
            </div>
          </div>
        }
      </div>

      @if (feedError is not null) { <p class="gen-status">@feedError</p> }
      else if (loading) { <p class="gen-status">Loading…</p> }
      else if (cards.Count == 0) { <p class="gen-status">@EmptyFeedMessage()</p> }
      else if (atEnd) { <p class="gen-status">No more layouts for these settings.</p> }

      <div @ref="sentinelRef" class="gen-sentinel"></div>
      @if (!atEnd && !loading && cards.Count > 0)
      {
        <Button Full Class="gen-more" OnClick="LoadMore">Load more</Button>
      }
    </main>
  </div>

  @if (detail is { } d)
  {
    <SideDrawer Open="true" Title="Layout details" Icon="layout-grid" OnClose="CloseDetail">
      <Body>
        <div class="gen-detail-fig">@((MarkupString)d.Svg)</div>
        <div class="gen-detail-meta">
          Score <strong>@d.Score.ToString("0.00")</strong> · @d.WoolCount wool ·
          @d.Descriptor.Players players · @d.Descriptor.Symmetry · seed @d.Descriptor.Seed
        </div>
        <div class="gen-detail-meta">
          <strong>@string.Join(", ", d.Structure.Wools)</strong> wools · hub <strong>@d.Structure.Hub</strong> · front line <strong>@d.Structure.Frontline</strong>
        </div>
        @if (d.Spend is { } sp)
        {
          <div class="gen-spend">
            <div class="gen-spend-head">
              <span><strong>@sp.Band</strong> · land <strong>@sp.Unit.Cells</strong> / @sp.Unit.BudgetCells.ToString("0") cells
                @if (sp.Mid.Cells > 0)
                {
                  <text> · mid <strong>@sp.Mid.Cells</strong> / @sp.Mid.BudgetCells.ToString("0")</text>
                }
              </span>
              <span class="gen-spend-pct">@SpendPercent(sp.Unit)</span>
            </div>
            <table class="gen-spend-table">
              <thead><tr><th>Box</th><th>Land</th><th>Footprint</th></tr></thead>
              <tbody>
                @foreach (var k in sp.ByKind)
                {
                  <tr>
                    <td>@k.Kind@(k.Boxes > 1 ? $" ×{k.Boxes}" : string.Empty)</td>
                    <td>@k.LandCells</td>
                    <td>@k.FootprintCells</td>
                  </tr>
                }
              </tbody>
              <tfoot><tr><td>Total</td><td>@sp.Unit.Cells</td><td>@sp.FootprintCells</td></tr></tfoot>
            </table>
            <p class="section-desc">
              In cells, for <strong>one team's half</strong>. Footprint is each box's size. Land is the area the
              shapes actually cover, and is checked against the budget for this map size.
            </p>
          </div>
        }
        @if (d.HardTerms.Count > 0)
        {
          <div class="plan-compile-errors"><p class="section-desc">Failed hard checks: @string.Join(", ", d.HardTerms)</p></div>
        }
        @if (d.TopSoft.Count > 0)
        {
          <div class="plan-lint-list">
            @foreach (var t in d.TopSoft)
            {
              <div class="plan-lint-row plan-lint-row--static">
                <span class="plan-lint-chip">@t.TermId</span>
                <span class="plan-lint-msg">@t.Contribution.ToString("0.00")</span>
              </div>
            }
          </div>
        }
        <pre class="gen-descriptor">@DescriptorJson(d)</pre>
      </Body>
      <Footer>
        <Button Full Icon="clipboard" OnClick="() => CopyDescriptor(d)">Copy JSON</Button>
        <Button Full OnClick="() => TogglePin(d)">@(IsPinned(d) ? "Unpin" : "Pin")</Button>
        <Button Variant="primary" Full Icon="file-plus-2" OnClick="() => AuthorPlan(d)">Open in plan editor</Button>
      </Footer>
    </SideDrawer>
  }
  </ChildContent>
</StudioShell>
