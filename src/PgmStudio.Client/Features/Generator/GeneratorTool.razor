@page "/generator"
@layout StudioLayout
@implements IAsyncDisposable

@* Generator browse: page through the composed-board library, sieve it, and pin the keepers. Cards are
   server-rendered SVGs of the full fanned board; pin/open keep the stored board the descriptor names. *@

<PageTitle>Generator · PGM Studio</PageTitle>

<StudioShell Bare="true">
  <Bar>
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>Generator</Crumb></Crumbs>
    </Topbar>
  </Bar>
  <ChildContent>
  <div class="gen-body">
    <FilterSidebar>
      <FilterPanel Title="Layout settings">
        <FilterGroup Label="Players per team">
          @foreach (var size in SizeBands.All)
          {
            <Chip Active="band == size" Title="@BandTitle(size)" OnClick="() => PickBand(size)">@BandLabel(size)</Chip>
          }
        </FilterGroup>

        <FilterGroup Label="Symmetry">
          @foreach (var s in Symmetries)
          {
            <Chip Active="symmetry == s.Id" Disabled="!s.Supported"
                  Title="@(s.Supported ? s.Label : "Not available yet")"
                  OnClick="() => PickSymmetry(s.Id)">@s.Label</Chip>
          }
        </FilterGroup>

        <FilterGroup Label="Wools per team" Hint="any of" Multi>
          @foreach (var count in WoolCounts.All)
          {
            <Chip Active="woolCounts.Contains(count)" OnClick="() => ToggleWoolCount(count)">@count</Chip>
          }
        </FilterGroup>
      </FilterPanel>

      <FilterPanel Title="Filter by shape" Active="ShapeFiltered" OnClear="ClearShapeFilters">
          <FilterGroup Label="Wool approaches" Hint="has all" Multi>
            @foreach (var w in WoolChips)
            {
              <Chip Active="woolFilter.Contains(w.Token)" Disabled="!w.InMix"
                    Count="@(censusBoards > 0 && w.InMix ? seenWools.GetValueOrDefault(w.Token) : null)"
                    Class="@(w.InMix && Unseen(seenWools, w.Token) ? "filter-chip--unseen" : null)"
                    Title="@(w.InMix ? ChipTitle(seenWools, w.Token, w.Label) : "The generator doesn't use this shape")"
                    OnClick="() => ToggleWool(w.Token)">@w.Label</Chip>
            }
          </FilterGroup>

          <FilterGroup Label="Hub" Hint="any of" Multi>
            @foreach (var h in HubChips)
            {
              <Chip Active="hubFilter.Contains(h.Token)"
                    Count="@(censusBoards > 0 ? seenHubs.GetValueOrDefault(h.Token) : null)"
                    Class="@(Unseen(seenHubs, h.Token) ? "filter-chip--unseen" : null)"
                    Title="@ChipTitle(seenHubs, h.Token, h.Label)"
                    OnClick="() => ToggleHub(h.Token)">@h.Label</Chip>
            }
          </FilterGroup>

          <FilterGroup Label="Front line" Hint="any of" Multi>
            @foreach (var f in FrontChips)
            {
              <Chip Active="frontFilter.Contains(f.Token)"
                    Count="@(censusBoards > 0 ? seenFronts.GetValueOrDefault(f.Token) : null)"
                    Class="@(Unseen(seenFronts, f.Token) ? "filter-chip--unseen" : null)"
                    Title="@ChipTitle(seenFronts, f.Token, f.Label)"
                    OnClick="() => ToggleFront(f.Token)">@f.Label</Chip>
            }
          </FilterGroup>

          @if (censusBoards > 0 && CensusIsTelling)
          {
            <p class="section-desc">A shape at 0 is never generated with these settings.</p>
          }
          <a class="gen-catalog-link" href="/catalog"><i data-lucide="shapes"></i><span>Browse every shape in the catalog →</span></a>
      </FilterPanel>
    </FilterSidebar>

    <main class="gen-main">
      <PageHeading Title="Generator">
        <Lead>Layouts the composer has built, filtered by the settings on the left. Pin one to keep it, or start a map from it.</Lead>
      </PageHeading>
      @if (pinned.Count > 0)
      {
        <div class="gen-tray">
          <span class="gen-tray-label"><i data-lucide="pin"></i> Pinned · @pinned.Count</span>
          <div class="gen-tray-items">
            @foreach (var p in pinned)
            {
              <div class="gen-tray-chip">
                <a class="gen-tray-fig @(p.StaleComposer ? "gen-tray-fig--stale" : null)"
                   href="@($"/plans/{p.Id}")" title="Open in plan editor">
                  @if (traySvg.TryGetValue(p.Id, out var s)) { @((MarkupString)s) }
                </a>
                @if (p.StaleComposer)
                {
                  <span class="gen-tray-stale" title="@StaleTitle(p)">@(p.ComposerVersion ?? "?")</span>
                }
                <span class="gen-tray-name" title="@p.Name">@p.Name</span>
                <WriteGate Deletes Context="closed">
                  <button class="gen-tray-x" @onclick="() => Unpin(p.Id)" disabled="@(closed is not null)"
                          title="@(closed ?? "Unpin")"><i data-lucide="x"></i></button>
                </WriteGate>
              </div>
            }
          </div>
        </div>
      }

      <div class="gen-toolbar">
        @if (censusBoards > 0)
        {
          <p class="gen-scanned"><strong>@matching</strong> of @censusBoards layouts match</p>
        }
        <BoardKey Entries="key" />
      </div>

      <div class="gen-grid">
        @foreach (var card in cards)
        {
          <PictureCard @key="card.Descriptor.Seed" Class="@(IsPinned(card) ? "gen-card--pinned" : null)"
                       FigClass="lib-card-fig--board" Svg="@card.Svg" Name="@LayoutId(card)"
                       OnClick="() => OpenDetail(card)" Title="Open details">
            <Overlay>
              <WriteGate Deletes="@IsPinned(card)" Context="closed">
                <button class="gen-pin @(IsPinned(card) ? "gen-pin--on" : null)" @onclick="() => TogglePin(card)"
                        disabled="@(closed is not null)" title="@(closed ?? (IsPinned(card) ? "Unpin" : "Pin"))"
                        aria-label="@(IsPinned(card) ? "Unpin" : "Pin")"><i data-lucide="pin"></i></button>
              </WriteGate>
            </Overlay>
          </PictureCard>
        }
      </div>

      @if (feedError is not null) { <p class="gen-status">@feedError</p> }
      else if (loading) { <p class="gen-status">Loading…</p> }
      else if (cards.Count == 0) { <p class="gen-status">@EmptyFeedMessage()</p> }
      else if (atEnd) { <p class="gen-status">No more layouts for these settings.</p> }

      <div @ref="sentinelRef" class="gen-sentinel"></div>
      @if (!atEnd && !loading && cards.Count > 0)
      {
        <Button Full Class="gen-more" OnClick="LoadMore">Load more</Button>
      }
    </main>
  </div>

  @if (detail is { } d)
  {
    <SideDrawer Open="true" Wide="true" Title="Layout details" Icon="layout-grid" OnClose="CloseDetail">
      <Body>
        <div class="gen-detail-fig @HighlightClasses">@((MarkupString)d.Svg)</div>
        <div class="gen-highlight" role="group" aria-label="Highlight">
          <span class="gen-highlight-label">Highlight</span>
          @foreach (var (role, label) in HighlightRoles)
          {
            <Chip Active="highlights.Contains(role)" OnClick="() => ToggleHighlight(role)">@label</Chip>
          }
        </div>
        <BoardKey Entries="key" />
        <div class="gen-detail-meta">
          <strong>@LayoutId(d)</strong> · @d.WoolCount @(d.WoolCount == 1 ? "wool" : "wools") ·
          @BandLabel(SizeBands.Of(d.Descriptor.Players)) · @d.Descriptor.Symmetry · seed @d.Descriptor.Seed
        </div>
        <div class="gen-detail-meta">
          Wools <strong>@WoolLabels(d.Structure.Wools)</strong> · hub <strong>@Label(HubChips, d.Structure.Hub)</strong> · front line <strong>@Label(FrontChips, d.Structure.Frontline)</strong>
        </div>
        @if (d.Spend is { } sp)
        {
          <div class="gen-spend">
            <div class="gen-spend-head">
              <span><strong>@sp.Band</strong> · land <strong>@sp.Unit.Cells</strong> / @sp.Unit.BudgetCells.ToString("0") cells
                @if (sp.Mid.Cells > 0)
                {
                  <text> · mid <strong>@sp.Mid.Cells</strong> / @sp.Mid.BudgetCells.ToString("0")</text>
                }
              </span>
              <span class="gen-spend-pct">@SpendPercent(sp.Unit)</span>
            </div>
            <table class="gen-spend-table">
              <thead><tr><th>Box</th><th>Land</th><th>Footprint</th></tr></thead>
              <tbody>
                @foreach (var k in sp.ByKind)
                {
                  <tr>
                    <td>@k.Kind@(k.Boxes > 1 ? $" ×{k.Boxes}" : string.Empty)</td>
                    <td>@k.LandCells</td>
                    <td>@k.FootprintCells</td>
                  </tr>
                }
              </tbody>
              <tfoot><tr><td>Total</td><td>@sp.Unit.Cells</td><td>@sp.FootprintCells</td></tr></tfoot>
            </table>
            <p class="section-desc">
              In cells, for <strong>one team's half</strong>. Footprint is each box's size. Land is the area the
              shapes actually cover, and is checked against the budget for this map size.
            </p>
          </div>
        }
        @if (d.HardTerms.Count > 0)
        {
          <div class="plan-compile-errors"><p class="section-desc">Failed hard checks: @string.Join(", ", d.HardTerms)</p></div>
        }
        <details class="gen-descriptor-box">
          <summary>Layout code (JSON)</summary>
          <pre class="gen-descriptor">@DescriptorJson(d)</pre>
        </details>
      </Body>
      <Footer>
        <Button Full Icon="clipboard" OnClick="() => CopyDescriptor(d)">Copy JSON</Button>
        <Button Full Writes Deletes="@IsPinned(d)" OnClick="() => TogglePin(d)">@(IsPinned(d) ? "Unpin" : "Pin")</Button>
        <Button Variant="primary" Full Icon="file-plus-2" Writes OnClick="() => AuthorPlan(d)">Start a map</Button>
      </Footer>
    </SideDrawer>
  }
  </ChildContent>
</StudioShell>
