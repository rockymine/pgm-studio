@page "/tokens"
@layout StudioLayout

<PageTitle>Tokens · PGM Studio</PageTitle>

@* The tokens that sign in as the person looking: for an agent or a script that drives the studio over HTTP
   without a browser. A token is shown once, when it is issued; the list says what each is for and when it was
   last used, and revokes it. *@

<StudioShell>
  <Bar>
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>Tokens</Crumb></Crumbs>
    </Topbar>
  </Bar>
  <ChildContent>
    <Workspace>
      <ContentColumn MaxWidth="820">
        @if (me is null)
        {
          <div class="list-empty">Loading…</div>
        }
        else if (me.Mode == AccessModes.Open)
        {
          <div class="callout">
            <span class="callout-icon"><i data-lucide="shield"></i></span>
            <p>This studio is open to everyone as an admin, so no token is needed.</p>
          </div>
        }
        else if (me.Role is null)
        {
          <div class="callout">
            <span class="callout-icon"><i data-lucide="shield"></i></span>
            <p>Sign in with a whitelisted account to issue a token.</p>
          </div>
        }
        else
        {
          <Section Title="Issue a token">
            <Description>
              A token lets a script or an agent use this studio as @me.Name, with your role. Keep it secret, and
              revoke it when it is no longer needed.
            </Description>
            <ChildContent>
              <div class="invite-link">
                <input class="field-input" placeholder="e.g. Build server" maxlength="100"
                       @bind="label" @bind:event="oninput" />
                <Button Variant="primary" Icon="shield-check" OnClick="IssueAsync" Busy="issuing" BusyLabel="Issuing…">Issue</Button>
              </div>
              @if (me.Role == StudioRoles.Admin)
              {
                <label class="check-row">
                  <input type="checkbox" checked="@notes" @onchange="e => notes = e.Value is true" />
                  May read and answer map notes
                </label>
              }
              @if (error is not null) { <div class="field-error">@error</div> }
              @if (issued is not null)
              {
                <div class="invite-link">
                  <input class="field-input" readonly value="@issued.Token" />
                  <Button Icon="copy" OnClick="() => CopyAsync(issued.Token)">@(copied ? "Copied" : "Copy")</Button>
                </div>
                <p class="section-desc">
                  Copy it now. It is not shown again. Send it as <code>Authorization: Bearer &lt;token&gt;</code>, or
                  set <code>PGM_STUDIO_TOKEN</code> and <code>PGM_STUDIO_API=@ApiRoot</code> for the mapgen tools.
                </p>
              }
            </ChildContent>
          </Section>

          <Section Title="Your tokens">
            <Actions><Badge Kind="dim">@(tokens?.Count ?? 0)</Badge></Actions>
            <ChildContent>
              <div class="panel-list panel-list--separated">
                @if (tokens is null) { <div class="list-empty">Loading…</div> }
                else if (tokens.Count == 0) { <div class="list-empty">No tokens yet.</div> }
                else
                {
                  @foreach (var token in tokens)
                  {
                    <ListRow @key="token.Id">
                      <ChildContent>
                        <span class="list-label">@token.Label</span>
                        @if (token.Notes) { <Badge Kind="neutral">notes</Badge> }
                        <span class="list-tag">issued @token.IssuedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        <span class="list-tag">@LastUse(token)</span>
                      </ChildContent>
                      <Trailing>
                        <Button Variant="icon" Icon="trash-2" Title="Revoke" OnClick="() => RevokeAsync(token)" />
                      </Trailing>
                    </ListRow>
                  }
                }
              </div>
            </ChildContent>
          </Section>
        }
      </ContentColumn>
    </Workspace>
  </ChildContent>
</StudioShell>
