@page "/admin/users"
@layout StudioLayout

<PageTitle>Users · PGM Studio</PageTitle>

@* The whitelist: who may write to this studio, in which role, and the invitations that let them sign in.
   An admin's page; anyone else is told so and shown nothing of the list. *@

<StudioShell>
  <Bar>
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>Users</Crumb></Crumbs>
    </Topbar>
  </Bar>
  <ChildContent>
    <Workspace>
      <ContentColumn MaxWidth="820">
        <PageHeading Title="Users">
          <Lead>Who may sign in to this studio, and what each of them may change.</Lead>
        </PageHeading>
        @if (admin is null)
        {
          <div class="list-empty">Loading…</div>
        }
        else if (admin == false)
        {
          <div class="callout">
            <span class="callout-icon"><i data-lucide="shield"></i></span>
            <p>Only admins can manage the whitelist.</p>
          </div>
        }
        else
        {
          <Section Title="Add a player">
            <Description>
              Members can create maps and edit the ones they own or are credited on. Admins can edit every map
              and add or remove members. After adding someone, send them an invitation link so they can sign in.
            </Description>
            <ChildContent>
              <div class="player-add-row">
                <input class="field-input" placeholder="Minecraft name or uuid" @bind="newPlayer" @bind:event="oninput" />
                <Select Options="RolesToGive" Value="@newRole" ValueChanged="v => newRole = v" Title="Role" />
                <Button Variant="primary" Icon="user-plus" OnClick="AddAsync" Busy="adding" BusyLabel="Adding…"
                        Disabled="@string.IsNullOrWhiteSpace(newPlayer)">Add</Button>
              </div>
              @if (error is not null) { <div class="field-error">@error</div> }
            </ChildContent>
          </Section>

          <Section Title="Whitelist">
            <Actions>
              @if (Waiting > 0) { <Badge Kind="warning" title="People waiting for approval">@Waiting waiting</Badge> }
              <Badge Kind="dim">@(users?.Count ?? 0)</Badge>
            </Actions>
            <ChildContent>
              <div class="panel-list panel-list--separated">
                @if (users is null) { <div class="list-empty">Loading…</div> }
                else if (users.Count == 0) { <div class="list-empty">Nobody is on the whitelist yet. Add a player above.</div> }
                else
                {
                  @foreach (var user in users)
                  {
                    <ListRow @key="user.Uuid">
                      <ChildContent>
                        <PlayerHead Uuid="@user.Uuid" Name="@user.Name" Size="20" />
                        <span class="list-label">@user.Name</span>
                        <span class="list-label list-label--mono" title="Minecraft uuid">@user.Uuid</span>
                        @if (user.Owner) { <span class="list-tag" title="Set in the server configuration. Owners can only be changed there.">owner</span> }
                        @if (user.DiscordName is { } discord) { <span class="list-tag" title="Discord name">@discord</span> }
                        @if (user.Role == StudioRoles.Unapproved) { <span class="list-tag" title="Signed themselves up; may own up to 3 maps until approved">waiting for approval</span> }
                        <span class="list-tag">@SignInState(user)</span>
                      </ChildContent>
                      <Trailing>
                        <div class="user-actions">
                        @if (user.Role == StudioRoles.Unapproved && RoleLocked(user) is null)
                        {
                          <Button Variant="primary" Icon="check" OnClick="() => ApproveAsync(user)" Title="Approve: make them a member, with no map limit">Approve</Button>
                        }
                        <Select Options="@(RoleLocked(user) is null ? RolesToGive : Roles)" Value="@user.Role" ValueChanged="v => SetRoleAsync(user, v)"
                                Disabled="@(RoleLocked(user) is not null)" Title="@(RoleLocked(user) ?? "Role")" />
                        <Button Variant="icon" Icon="user-cog" OnClick="() => ToggleChange(user)"
                                Disabled="@(AccountLocked(user) is not null)"
                                Title="@(AccountLocked(user) ?? "Change Minecraft account")" />
                        <Button Variant="icon" Icon="link" OnClick="() => InviteAsync(user)"
                                Disabled="@(InviteLocked(user) is not null)"
                                Title="@(InviteLocked(user) ?? "Create invitation link")" />
                        <Button Variant="icon" Icon="trash-2" OnClick="() => RemoveAsync(user)"
                                Disabled="@(RemoveLocked(user) is not null)"
                                Title="@(RemoveLocked(user) ?? "Remove from whitelist")" />
                        </div>
                      </Trailing>
                    </ListRow>
                    @if (changing == user.Uuid)
                    {
                      <div class="invite-link">
                        <input class="field-input" placeholder="Their Minecraft name" @bind="account" @bind:event="oninput" />
                        <Button Variant="primary" Icon="user-cog" OnClick="() => ChangeAccountAsync(user)"
                                Disabled="@string.IsNullOrWhiteSpace(account)">Move to this account</Button>
                      </div>
                      <p class="section-desc">
                        Moves @user.Name's maps, credits, library entries and tokens to that account. They sign in
                        again with the same Discord account to use it.
                      </p>
                    }
                    @if (invites.TryGetValue(user.Uuid, out var invite))
                    {
                      <div class="invite-link">
                        <input class="field-input" readonly value="@invite.Link" />
                        <Button Icon="copy" OnClick="() => CopyAsync(invite.Link)">@(copied == invite.Link ? "Copied" : "Copy")</Button>
                      </div>
                      <p class="section-desc">
                        Works once, until @invite.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"). Copy it now; it is not shown again.
                        The first Discord account that signs in with it is linked to @user.Name.
                      </p>
                    }
                  }
                }
              </div>
            </ChildContent>
          </Section>
        }
      </ContentColumn>
    </Workspace>
  </ChildContent>
</StudioShell>
