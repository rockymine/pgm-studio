@page "/maps"
@layout StudioLayout
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject StudioAccess Access

<PageTitle>@StageTitle · PGM Studio</PageTitle>

@* Staged map collection — one overview, scoped by ?stage=sketch|configure|edit (default edit). The
   activity rail switches stage; each stage lists its maps with the matching resume target and a
   stage-appropriate "start" action. Reached from the landing cards. *@

<StudioShell>
  <Bar>
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>@StageTitle</Crumb></Crumbs>
    </Topbar>
  </Bar>
  <Rail>
    <NavRail>
      <NavButton Icon="layout-dashboard" Title="Plans" Href="maps?stage=plan" Active="CurrentStage == MapStage.Plan" />
      <NavButton Icon="pencil-ruler" Title="Sketches" Href="maps?stage=sketch" Active="CurrentStage == MapStage.Sketch" />
      <NavButton Icon="settings-2" Title="Configuring" Href="maps?stage=configure" Active="CurrentStage == MapStage.Configure" />
      <NavButton Icon="map" Title="Maps" Href="maps" Active="CurrentStage is null" />
    </NavRail>
  </Rail>
  <ChildContent>
      <Workspace>
        <ContentColumn MaxWidth="960">

          <Section Title="@StageTitle">
            <Actions>
              <Badge Kind="dim">@(maps?.Count ?? 0)</Badge>
              @if (CurrentStage == MapStage.Plan)
              {
                <Button Variant="primary" OnClick="NewPlan" Icon="plus" Class="action-btn--push-end" Disabled="@(creatingPlan || !mayWrite)" Title="@WriteTitle">New plan</Button>
              }
              else if (CurrentStage == MapStage.Sketch)
              {
                <Button Variant="primary" OnClick="NewSketch" Icon="plus" Class="action-btn--push-end" Disabled="@(creatingSketch || !mayWrite)" Title="@WriteTitle">New sketch</Button>
              }
              else if (CurrentStage == MapStage.Configure && mayWrite)
              {
                <Button Variant="primary" Href="maps/new" Icon="import" Class="action-btn--push-end">Import a world</Button>
              }
            </Actions>
            <Description>@StageBlurb</Description>
            <ChildContent>

            <input class="field-input field-input--separated" placeholder="Search…" @bind="filter" @bind:event="oninput" />

            @* --actions: every row reserves the layer column, so the list keeps one aligned edge whatever
               a given map has been through. *@
            <div class="panel-list panel-list--actions panel-list--separated">
              @if (loadError is not null)
              {
                <div class="list-empty">@loadError <Button OnClick="LoadAsync">Try again</Button></div>
              }
              else if (maps is null) { <div class="list-empty">Loading…</div> }
              else if (!Filtered.Any()) { <div class="list-empty">@EmptyMessage</div> }
              else
              {
                @foreach (var m in Filtered)
                {
                  <ListRow Href="@(Opens(m) is { } layer ? $"maps/{m.Slug}/{layer}" : null)" @key="m.Slug">
                    <ChildContent>
                      <span class="list-label map-row-name">@m.Name</span>
                      <span class="list-label list-label--mono map-row-slug">@m.Slug</span>
                      @if (CurrentStage is null) { <Badge Kind="neutral">@StageLabel(m.Stage)</Badge> }
                      @if (CurrentStage is null or MapStage.Edit)
                      {
                        @* one tag per gamemode: a map can be more than one, and a map with no objective
                           module we read carries none rather than a blank tag *@
                        @foreach (var g in m.Gamemodes) { <span class="list-tag">@g.ToUpperInvariant()</span> }
                        @if (!string.IsNullOrEmpty(m.Version)) { <span class="list-tag">@($"v{m.Version}")</span> }
                      }
                      <span class="list-go"><i data-lucide="arrow-right"></i></span>
                    </ChildContent>
                    @* Every layer the map holds, each a direct link into that tool. A map keeps its plan and
                       its sketch after it has been built and configured, so this is where they stay
                       reachable — the row's own link goes wherever the map has got to, and the one matching
                       that carries --now. The column is reserved on every row so the labels stay aligned. *@
                    <Trailing>
                      <span class="map-artifacts">
                        @foreach (var (id, label) in Layers(m))
                        {
                          <a class="map-layer @(Opens(m) == id ? "map-layer--now" : null)"
                             href="@($"maps/{m.Slug}/{id}")" title="@LayerTitle(m, id)">@label</a>
                        }
                      </span>
                    </Trailing>
                  </ListRow>
                }
              }
            </div>
            </ChildContent>
          </Section>
        </ContentColumn>
      </Workspace>
  </ChildContent>
</StudioShell>
