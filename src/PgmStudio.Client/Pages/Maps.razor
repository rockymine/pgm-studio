@page "/maps"
@layout StudioLayout
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Maps · PGM Studio</PageTitle>

@* Every map in the studio, in one table, with its filters open in the sidebar beside it. Stage, author and
   gamemode are kept in the address so a link or a landing card can open a view; each row links straight into
   every tool the map has a layer in. *@

<StudioShell>
  <Bar>
    <Topbar>
      <Crumbs><Crumb Sep="false" Dim>Maps</Crumb></Crumbs>
    </Topbar>
  </Bar>
  <ChildContent>
      <Workspace>
        <Sidebar Class="map-filters">
          <Section Title="Stage">
            <div class="filter-group-options">
              <Chip Active="@(CurrentStage is null)" OnClick='() => Go("stage", null)'>All<span class="filter-chip-n">@Count(skip: "stage")</span></Chip>
              @foreach (var (word, label) in StageWords)
              {
                <Chip Active="@(CurrentStage == word)" OnClick='() => Go("stage", word)'>
                  <span class="map-stage-dot map-stage-dot--@word"></span>@label<span class="filter-chip-n">@Count(skip: "stage", stage: word)</span>
                </Chip>
              }
            </div>
          </Section>

          <Section Title="Author">
            <input class="field-input" type="search" placeholder="Find an author" aria-label="Find an author"
                   @bind="authorSearch" @bind:event="oninput" />
            @foreach (var (title, agents) in AuthorGroups)
            {
              var group = AuthorsIn(agents);
              @if (group.Count == 0) { continue; }
              var allOn = group.All(name => Picked.Contains(name));
              <div class="map-author-group">
                <span>@title</span>
                <button type="button" class="map-author-all" @onclick="() => PickAll(group, !allOn)">@(allOn ? "Clear" : "Select all")</button>
              </div>
              <div class="filter-group-options filter-group-options--multi map-author-options">
                @foreach (var name in group)
                {
                  <Chip Active="@Picked.Contains(name)" OnClick="() => ToggleAuthor(name)" @key="name">
                    <AuthorMark Uuid="@CreditNamed(name)?.Uuid" Name="@name" Size="18" />
                    <span class="map-author-name">@name</span>
                    <span class="filter-chip-n">@Count(skip: "author", author: name)</span>
                  </Chip>
                }
              </div>
            }
          </Section>

          @if (GamemodesPresent.Count > 0)
          {
            <Section Title="Gamemode">
              <div class="filter-group-options filter-group-options--multi">
                @foreach (var gamemode in GamemodesPresent.Append(NoGamemode))
                {
                  <Chip Active="@PickedGamemodes.Contains(gamemode)" OnClick="() => ToggleGamemode(gamemode)">
                    @GamemodeLabel(gamemode)<span class="filter-chip-n">@Count(skip: "gamemode", gamemode: gamemode)</span>
                  </Chip>
                }
              </div>
            </Section>
          }

          @if (Filtering)
          {
            <Button Full OnClick="ClearFilters" Icon="x">Clear filters</Button>
          }
        </Sidebar>

        <ContentColumn MaxWidth="1180">
          <Section Title="Maps">
            <Actions>
              <Badge Kind="dim">@CountLabel</Badge>
              <Button Variant="primary" OnClick="NewPlan" Icon="plus" Class="action-btn--push-end" Writes Disabled="@creatingPlan">New plan</Button>
              <Button OnClick="NewSketch" Icon="plus" Writes Disabled="@creatingSketch">New sketch</Button>
              <Button Href="maps/new" Icon="import" Writes>Import a world</Button>
            </Actions>
            <ChildContent>

            <div class="map-search-row">
              <input class="field-input map-search" type="search" placeholder="Search name, slug or author"
                     aria-label="Search maps" @bind="search" @bind:event="oninput" />
              <Select Id="map-sort" Options="SortOptions" Value="@SortKey" ValueChanged="SetSort" Title="Sort by" />
            </div>

            @if (loadError is not null)
            {
              <div class="list-empty">@loadError <Button OnClick="LoadAsync">Try again</Button></div>
            }
            else if (maps is null) { <div class="list-empty">Loading…</div> }
            else if (maps.Count == 0) { <div class="list-empty">No maps yet. Plan one, draw a sketch, or import a world.</div> }
            else if (Shown.Count == 0)
            {
              <div class="list-empty">No map matches these filters. <Button OnClick="ClearFilters">Clear filters</Button></div>
            }
            else
            {
              <div class="map-table-box">
                <table class="map-table">
                  <thead>
                    <tr><th class="map-col-map">Map</th><th>Stage</th><th class="map-col-layers">Layers</th><th class="map-col-modes">Gamemode</th><th>Author</th><th>Last changed</th></tr>
                  </thead>
                  <tbody>
                    @foreach (var m in Shown)
                    {
                      var opens = Opens(m);
                      var credits = Credited(m);
                      var stage = StageOf(m);
                      <tr class="map-table-row" @key="m.Slug" @onclick="() => Open(m)">
                        <td class="map-col-map">
                          @if (opens is not null)
                          {
                            <a class="map-row-name" href="@($"maps/{m.Slug}/{opens}")" title="@m.Name" @onclick:stopPropagation>@m.Name</a>
                          }
                          else { <span class="map-row-name" title="@m.Name">@m.Name</span> }
                          <span class="map-row-slug" title="@m.Slug">@m.Slug</span>
                        </td>
                        <td><span class="map-stage"><span class="map-stage-dot map-stage-dot--@stage"></span>@StageLabel(stage)</span></td>
                        <td class="map-col-layers">
                          <span class="map-artifacts">
                            @foreach (var (id, label) in Layers(m))
                            {
                              <a class="map-layer @(opens == id ? "map-layer--now" : null)" @onclick:stopPropagation
                                 href="@($"maps/{m.Slug}/{id}")" title="@LayerTitle(id)">@label</a>
                            }
                          </span>
                        </td>
                        <td class="map-modes map-col-modes">
                          @if (m.Gamemodes.Count > 0) { @(string.Join(" ", m.Gamemodes).ToUpperInvariant()) }
                          else { <span class="map-empty" title="No gamemode yet">—</span> }
                        </td>
                        <td>
                          @if (credits.Count == 0) { <span class="map-empty" title="Nobody credited">—</span> }
                          else
                          {
                            <span class="map-author" title="@string.Join(", ", credits.Select(NameOf))">
                              <AuthorMark Uuid="@credits[0].Uuid" Name="@NameOf(credits[0])" Size="18" />
                              @NameOf(credits[0])
                              @if (credits.Count > 1) { <span class="map-author-more">+@(credits.Count - 1)</span> }
                            </span>
                          }
                        </td>
                        <td class="map-changed" title="@m.UpdatedAt.ToLocalTime().ToString("g")">@Moments.Ago(m.UpdatedAt)</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            }
            </ChildContent>
          </Section>
        </ContentColumn>
      </Workspace>
  </ChildContent>
</StudioShell>
