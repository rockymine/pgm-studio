@page "/maps"
@layout StudioLayout
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject StudioAccess Access

<PageTitle>Maps · PGM Studio</PageTitle>

@* Every map in the studio, in one table, with its filters open in the sidebar beside it. Stage, author and
   gamemode are kept in the address so a link or a landing card can open a view; each row links straight into
   every tool the map has a layer in. *@

<StudioShell>
  <ChildContent>
      <Workspace>
        <FilterSidebar>
          <FilterPanel Title="Filters" Active="Filtering" OnClear="ClearFilters">
            <FilterGroup Label="Stage">
              <Chip Active="@(CurrentStage is null)" Count='Count(skip: "stage")' OnClick='() => Go("stage", null)'>All</Chip>
              @foreach (var (word, label) in StageWords)
              {
                <Chip Active="@(CurrentStage == word)" Count='Count(skip: "stage", stage: word)' OnClick='() => Go("stage", word)'>
                  <span class="map-stage-dot map-stage-dot--@word"></span>@label
                </Chip>
              }
            </FilterGroup>

            <Field Label="Author">
              <input class="field-input" type="search" placeholder="Find an author" aria-label="Find an author"
                     @bind="authorSearch" @bind:event="oninput" />
            </Field>
            @foreach (var (title, agents) in AuthorGroups)
            {
              var group = AuthorsIn(agents);
              @if (group.Count == 0) { continue; }
              var allOn = group.All(name => Picked.Contains(name));
              <FilterGroup Label="@title" Multi Class="filter-group--authors">
                <End><button type="button" class="filter-group-action" @onclick="() => PickAll(group, !allOn)">@(allOn ? "Clear" : "Select all")</button></End>
                <ChildContent>
                  @foreach (var name in group)
                  {
                    <Chip Active="@Picked.Contains(name)" Count='Count(skip: "author", author: name)' OnClick="() => ToggleAuthor(name)" @key="name">
                      <AuthorMark Uuid="@CreditNamed(name)?.Uuid" Name="@name" Size="18" />
                      <span class="map-author-name">@name</span>
                    </Chip>
                  }
                </ChildContent>
              </FilterGroup>
            }

            @if (GamemodesPresent.Count > 0)
            {
              <FilterGroup Label="Gamemode" Multi>
                @foreach (var gamemode in GamemodesPresent.Append(NoGamemode))
                {
                  <Chip Active="@PickedGamemodes.Contains(gamemode)" Count='Count(skip: "gamemode", gamemode: gamemode)' OnClick="() => ToggleGamemode(gamemode)">
                    @GamemodeLabel(gamemode)
                  </Chip>
                }
              </FilterGroup>
            }
          </FilterPanel>
        </FilterSidebar>

        <ContentColumn MaxWidth="1180">
          <PageHeading Title="Maps">
            <Actions>
              <Badge Kind="dim">@CountLabel</Badge>
              <Button Variant="primary" OnClick="NewSketch" Icon="plus" Class="action-btn--push-end" Writes Disabled="@creatingSketch">New map</Button>
              <Button Href="maps/new" Icon="import" Writes>Import a world</Button>
            </Actions>
          </PageHeading>

            <div class="map-search-row">
              <input class="field-input map-search" type="search" placeholder="Search maps"
                     aria-label="Search maps" @bind="search" @bind:event="oninput" />
              <Select Id="map-sort" Options="SortOptions" Value="@SortKey" ValueChanged="SetSort" Title="Sort by" />
            </div>

            @if (loadError is not null)
            {
              <StatusLine>@loadError</StatusLine>
              <Button OnClick="LoadAsync">Try again</Button>
            }
            else if (maps is null) { <StatusLine /> }
            else if (maps.Count == 0) { <EmptyState>No maps yet. Start a new map, or import a world.</EmptyState> }
            else if (Shown.Count == 0)
            {
              <EmptyState>No map matches these filters. Clear them to see every map.</EmptyState>
              <Button OnClick="ClearFilters">Clear filters</Button>
            }
            else
            {
              <div class="map-table-box">
                <table class="map-table">
                  <thead>
                    <tr><th class="map-col-map">Map</th><th>Open in</th><th class="map-col-modes">Gamemode</th><th>Author</th><th>Last changed</th></tr>
                  </thead>
                  <tbody>
                    @foreach (var m in Shown)
                    {
                      var opens = MapLayers.Opens(m);
                      var credits = MapLayers.Credited(m);
                      <tr class="map-table-row" @key="m.Slug" @onclick="() => Open(m)">
                        <td class="map-col-map">
                          @if (opens is not null)
                          {
                            <a class="map-row-name" href="@($"maps/{m.Slug}/{opens}")" title="@m.Name" @onclick:stopPropagation>@m.Name</a>
                          }
                          else { <span class="map-row-name" title="@m.Name">@m.Name</span> }
                          <span class="map-row-slug" title="@m.Slug">@m.Slug</span>
                          @if (m.AgentMade)
                          {
                            <span class="list-tag" title="Seen by admins and its owner">Agent</span>
                          }
                          @if (admin)
                          {
                            <span class="map-row-mark" @onclick:stopPropagation>
                              <Button Variant="icon" Icon="bot" OnClick="() => MarkAgentMadeAsync(m, !m.AgentMade)"
                                      Title="@(m.AgentMade ? "Mark as made by a person" : "Mark as made by an agent")" />
                            </span>
                          }
                        </td>
                        <td>
                          <span class="map-artifacts">
                            @foreach (var (id, label) in MapLayers.All)
                            {
                              if (!MapLayers.Holds(m, id)) { <span class="map-layer-empty" title="@($"No {label.ToLowerInvariant()} yet")"></span> }
                              else if (opens == id)
                              {
                                <a class="map-layer map-layer--now" @onclick:stopPropagation href="@($"maps/{m.Slug}/{id}")"
                                   title="@LayerTitle(id)"><span class="map-stage-dot map-stage-dot--@m.Stage"></span>@label</a>
                              }
                              else
                              {
                                <a class="map-layer" @onclick:stopPropagation href="@($"maps/{m.Slug}/{id}")" title="@LayerTitle(id)">@label</a>
                              }
                            }
                          </span>
                        </td>
                        <td class="map-modes map-col-modes">
                          @if (m.Gamemodes.Count > 0) { @(string.Join(", ", m.Gamemodes.Select(GamemodeLabel))) }
                          else { <span class="map-empty" title="No gamemode yet">—</span> }
                        </td>
                        <td>
                          @if (credits.Count == 0) { <span class="map-empty" title="Nobody credited">—</span> }
                          else
                          {
                            <span class="map-author" title="@string.Join(", ", credits.Select(MapLayers.NameOf))">
                              <AuthorMark Uuid="@credits[0].Uuid" Name="@MapLayers.NameOf(credits[0])" Size="18" />
                              @MapLayers.NameOf(credits[0])
                              @if (credits.Count > 1) { <span class="map-author-more">+@(credits.Count - 1)</span> }
                            </span>
                          }
                        </td>
                        <td class="map-changed" title="@m.UpdatedAt.ToLocalTime().ToString("g")">@Moments.Ago(m.UpdatedAt)</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            }
        </ContentColumn>
      </Workspace>
  </ChildContent>
</StudioShell>
