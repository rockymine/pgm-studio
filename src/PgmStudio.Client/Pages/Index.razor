@page "/"
@layout StudioLayout
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>PGM Studio</PageTitle>

@* Landing — the studio entry. Three lifecycle cards (Sketch · Configure · Maps) over the staged map
   page: each opens /maps filtered to its stage, where a map can be started or resumed. *@

<StudioShell>
  <Bar><Topbar><Crumbs><Crumb Sep="false">Map Studio</Crumb></Crumbs></Topbar></Bar>
  <ChildContent>
      <div class="workspace">
        <div class="workspace-scroll"><div class="landing">
          <header class="landing-hero">
            <div class="nav-logo-box landing-logo">
              <span class="nav-logo-pgm">pgm</span>
              <span class="nav-logo-sub">STUDIO</span>
            </div>
            <h1 class="landing-title">Make a Capture the Wool map</h1>
            <p class="landing-lead">Go from a rough layout to a finished <code>map.xml</code>. Start something new,
              or continue where you left off.</p>
          </header>

          <div class="landing-choices">
            <a class="card card--action landing-plan" href="maps?stage=plan">
              <span class="card-icon"><i data-lucide="layout-grid"></i></span>
              <div class="landing-plan-body">
                <span class="card-title">Plan a layout</span>
                <p class="card-desc">Block out a map on a grid: its areas, symmetry, and objectives. Then build
                  it into a sketch.</p>
              </div>
              <span class="card-foot-go landing-plan-go">Open <i data-lucide="arrow-right"></i></span>
            </a>

            <a class="card card--action landing-plan" href="generator">
              <span class="card-icon"><i data-lucide="sparkles"></i></span>
              <div class="landing-plan-body">
                <span class="card-title">Browse generated layouts</span>
                <p class="card-desc">Generate whole layouts and filter them by size, symmetry, and score. Open
                  any of them in the plan editor.</p>
              </div>
              <span class="card-foot-go landing-plan-go">Open <i data-lucide="arrow-right"></i></span>
            </a>

            <a class="card card--action landing-plan" href="catalog">
              <span class="card-icon"><i data-lucide="shapes"></i></span>
              <div class="landing-plan-body">
                <span class="card-title">Shape catalog</span>
                <p class="card-desc">Every shape the generator can build, and whether generated layouts
                  use it.</p>
              </div>
              <span class="card-foot-go landing-plan-go">Open <i data-lucide="arrow-right"></i></span>
            </a>

            <a class="card card--action landing-plan" href="library">
              <span class="card-icon"><i data-lucide="paintbrush"></i></span>
              <div class="landing-plan-body">
                <span class="card-title">Library</span>
                <p class="card-desc">Patterns, palettes, buildings, trees, and biomes to reuse in any map.</p>
              </div>
              <span class="card-foot-go landing-plan-go">Open <i data-lucide="arrow-right"></i></span>
            </a>

            <div class="landing-divider">or continue a map by stage</div>

            <div class="card-grid landing-cards">
            <a class="card card--action" href="maps?stage=sketch">
              <div class="card-head">
                <span class="card-icon"><i data-lucide="pencil-ruler"></i></span>
                <span class="card-title">Sketch</span>
              </div>
              <p class="card-desc">The plan's grey map with as much detail as you want: ground shape, paint,
                trees, and buildings.</p>
              <span class="card-foot">
                <span class="card-foot-count">@CountLabel(counts?.Sketch, "sketch", "sketches")</span>
                <span class="card-foot-go">Browse <i data-lucide="arrow-right"></i></span>
              </span>
            </a>

            <a class="card card--action" href="maps?stage=configure">
              <div class="card-head">
                <span class="card-icon"><i data-lucide="settings-2"></i></span>
                <span class="card-title">Configure</span>
              </div>
              <p class="card-desc">Set up the game on a world: teams, spawns, protected areas, and
                objectives.</p>
              <span class="card-foot">
                <span class="card-foot-count">@CountLabel(counts?.Configure, "in progress", "in progress")</span>
                <span class="card-foot-go">Browse <i data-lucide="arrow-right"></i></span>
              </span>
            </a>

            <a class="card card--action" href="maps">
              <div class="card-head">
                <span class="card-icon"><i data-lucide="map"></i></span>
                <span class="card-title">Maps</span>
              </div>
              <p class="card-desc">Every map in the studio, with the stage it has reached. Open any stage a map
                still has.</p>
              <span class="card-foot">
                <span class="card-foot-count">@CountLabel(counts?.All, "map", "maps")</span>
                <span class="card-foot-go">Browse <i data-lucide="arrow-right"></i></span>
              </span>
            </a>
            </div>
          </div>
        </div></div>
      </div>
  </ChildContent>
</StudioShell>
