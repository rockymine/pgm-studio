@page "/"
@layout StudioLayout
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>PGM Studio</PageTitle>

@* The studio entry: a hero (what the studio makes, the way in, a themed board illustration), then the maps the
   reader changed last and the four levels a map is described at. The shell is given no Bar — the home page is
   not a tool — and every tool is reachable from the studio's own bar. *@

<StudioShell>
  <ChildContent>
      <div class="workspace">
        <div class="workspace-scroll"><div class="landing">
          <LandingHero MapCount="counts?.All" />

          <div class="landing-lower">
            <section class="landing-panel">
              <h2 class="landing-panel-title">@(mine ? "Continue where you left off" : "Latest maps")</h2>
              @if (recent.Count == 0)
              {
                <p class="landing-empty">No maps yet. Start one to see it here.</p>
              }
              else
              {
                <ul class="landing-recent">
                  @foreach (var item in recent)
                  {
                    <li>
                      <a class="landing-recent-row" href="@($"maps/{item.Map.Slug}/{item.Opens}")">
                        <span class="landing-recent-name">@item.Map.Name</span>
                        <span class="landing-recent-meta">
                          @if (item.Map.Gamemodes.Count > 0) { @(string.Join(" ", item.Map.Gamemodes).ToUpperInvariant() + " · ") }@LayerLabel(item.Opens) · @Moments.Ago(item.At)
                        </span>
                      </a>
                    </li>
                  }
                </ul>
              }
            </section>

            <section class="landing-panel">
              <h2 class="landing-panel-title">How a map is made</h2>
              <ol class="landing-levels">
                <li><b>Board</b><span>Rectangles on a grid: what each is for, where the objectives sit.</span></li>
                <li><b>Ground</b><span>Block-level shape, relief, paint and props.</span></li>
                <li><b>Play</b><span>Teams, spawns, protections and how objectives are won.</span></li>
                <li><b>Map</b><span>The world and the <code>map.xml</code> a server loads.</span></li>
              </ol>
            </section>
          </div>
        </div></div>
      </div>
  </ChildContent>
</StudioShell>
