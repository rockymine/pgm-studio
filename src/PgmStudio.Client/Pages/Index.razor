@page "/"
@layout StudioLayout
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>PGM Studio</PageTitle>

@* The studio entry: a hero (what the studio makes, the way in, a themed board illustration), then the maps the
   reader changed last and the four levels a map is described at. The shell is given no Bar — the home page is
   not a tool — and every tool is reachable from the studio's own bar. *@

<StudioShell>
  <ChildContent>
      <div class="workspace">
        <div class="workspace-scroll"><div class="landing">
          <section class="landing-hero">
            <div class="landing-hero-text">
              <h1 class="landing-title">Author PGM maps, from layout to <code>map.xml</code></h1>
              <p class="landing-lead">Plan a symmetric board, shape and paint its ground, state what it is played for, and
                export a world a server can load. Capture the Wool, Destroy the Monument and Destroy the Core,
                alone or combined.</p>
              <div class="landing-actions">
                <Button Variant="primary" Icon="plus" Href="maps?stage=plan">Start a map</Button>
                <Button Icon="map" Href="maps">Open maps@(counts is { } all ? $" ({all.All})" : "")</Button>
              </div>
            </div>
            <svg class="landing-board" viewBox="0 0 320 200" role="img" aria-label="A symmetric two-team map: two bases, wool rooms and a central lane">
              <rect class="lb-field" x="4" y="4" width="312" height="192" rx="8" />
              <rect class="lb-lane" x="132" y="4" width="56" height="192" />
              <rect class="lb-team lb-team--a" x="16" y="62" width="76" height="76" rx="4" />
              <rect class="lb-team lb-team--b" x="228" y="62" width="76" height="76" rx="4" />
              <rect class="lb-team lb-team--a" x="30" y="18" width="30" height="26" rx="3" />
              <rect class="lb-team lb-team--a" x="30" y="156" width="30" height="26" rx="3" />
              <rect class="lb-team lb-team--b" x="260" y="18" width="30" height="26" rx="3" />
              <rect class="lb-team lb-team--b" x="260" y="156" width="30" height="26" rx="3" />
              <path class="lb-path" d="M92 100 H228 M60 44 V62 M60 138 V156 M260 44 V62 M260 138 V156" />
              <line class="lb-axis" x1="160" y1="4" x2="160" y2="196" />
              <circle class="lb-point" cx="160" cy="100" r="9" />
            </svg>
          </section>

          <div class="landing-lower">
            <section class="landing-panel">
              <h2 class="landing-panel-title">@(mine ? "Continue where you left off" : "Latest maps")</h2>
              @if (recent.Count == 0)
              {
                <p class="landing-empty">No maps yet. Start one to see it here.</p>
              }
              else
              {
                <ul class="landing-recent">
                  @foreach (var item in recent)
                  {
                    <li>
                      <a class="landing-recent-row" href="@($"maps/{item.Map.Slug}/{item.Opens}")">
                        <span class="landing-recent-name">@item.Map.Name</span>
                        <span class="landing-recent-meta">
                          @if (item.Map.Gamemodes.Count > 0) { @(string.Join(" ", item.Map.Gamemodes).ToUpperInvariant() + " · ") }@LayerLabel(item.Opens) · @Moments.Ago(item.At)
                        </span>
                      </a>
                    </li>
                  }
                </ul>
              }
            </section>

            <section class="landing-panel">
              <h2 class="landing-panel-title">How a map is made</h2>
              <ol class="landing-levels">
                <li><b>Board</b><span>Rectangles on a grid: what each is for, where the objectives sit.</span></li>
                <li><b>Ground</b><span>Block-level shape, relief, paint and props.</span></li>
                <li><b>Play</b><span>Teams, spawns, protections and how objectives are won.</span></li>
                <li><b>Map</b><span>The world and the <code>map.xml</code> a server loads.</span></li>
              </ol>
            </section>
          </div>
        </div></div>
      </div>
  </ChildContent>
</StudioShell>
