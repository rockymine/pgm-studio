@namespace PgmStudio.Client.Components

@* The settings an objective states beside where it stands: a monument's or core's name and structure, a wool's
   colour, how a capture point is laid and taken. The
   sketch's picked piece shows these and writes them under the keys PieceSettings names. Only what differs
   from the default is stated: a field set back to its default writes null. *@

@if (Kind == "controlPoint")
{
  <Field Label="Name" Note="Auto: PGM numbers it.">
    <ChildContent>
      <input class="field-input" placeholder="Auto" value="@Values.Name"
             @onchange="@(e => SetText(PieceSettings.Name, e.Value?.ToString(), string.Empty))" />
    </ChildContent>
  </Field>
  <Field Label="Pad" Note="@PadNote">
    <div class="filter-group-options">
      @foreach (var shape in Vocabulary.ControlPoint.Shapes)
      {
        <Chip Active="@(PointShape == shape)" OnClick="@(() => SetText(PieceSettings.Shape, shape, Vocabulary.ControlPoint.Shape))">@Word(shape)</Chip>
      }
    </div>
  </Field>
  <Field Label="Taken by" Note="@TakenNote">
    <div class="filter-group-options">
      @foreach (var mode in Vocabulary.ControlPoint.CaptureModes)
      {
        <Chip Active="@(PointMode == mode)" OnClick="@(() => SetText(PieceSettings.CaptureMode, mode, Vocabulary.ControlPoint.CaptureMode))">@Word(mode)</Chip>
      }
    </div>
  </Field>
  @if (PointMode != "touch")
  {
    <Field Label="Capture time" Unit="seconds">
      <ChildContent>
        <NumberField Min="1" Max="600" Value="PointSeconds"
                     ValueChanged="@(value => SetNumber(PieceSettings.CaptureTime, (int)value, Vocabulary.ControlPoint.CaptureSeconds))" />
      </ChildContent>
    </Field>
  }
  <Field Label="Points per second" Note="Scored while the team holds it.">
    <ChildContent>
      <NumberField Min="1" Max="100" Value="PointPoints"
                   ValueChanged="@(value => SetNumber(PieceSettings.Points, (int)value, Vocabulary.ControlPoint.Points))" />
    </ChildContent>
  </Field>
}
@if (Kind is "destroyable" or "core")
{
  <Field Label="Name" Unit="optional" Note="@GoalNameNote">
    <ChildContent>
      <input class="field-input" value="@Values.Name" placeholder="@GoalNamePlaceholder"
             @onchange="@(e => SetText(PieceSettings.Name, e.Value?.ToString(), string.Empty))" />
    </ChildContent>
  </Field>
}
@if (Kind == "wool")
{
  @* A wool states a dye or states nothing. Nothing is not a default the inspector can show a value for: it is
     resolved against the owning team and the wools placed before this one, so the option reads as what it is
     rather than naming a colour. *@
  <Field Label="Colour">
    <div class="field-pick-row">
      <span class="field-swatch" style="--swatch: @WoolSwatch"></span>
      <Select Slim="false" Options="WoolColorOptions" Placeholder="Auto" Value="@WoolColor"
              ValueChanged="@(value => SetText(PieceSettings.Color, value, string.Empty))" />
    </div>
  </Field>
}
@if (Kind == "destroyable")
{
  <Field Label="Design">
    <Select Slim="false" Options="DestroyableStyleOptions" Value="@DestroyableStyle"
            ValueChanged="@(value => SetText(PieceSettings.Style, value, Vocabulary.Destroyable.Style))" />
  </Field>
  <Field Label="Material">
    <Select Slim="false" Options="DestroyableMaterialOptions" Value="@DestroyableMaterials"
            ValueChanged="@(value => SetText(PieceSettings.Materials, value, Vocabulary.Destroyable.Materials))" />
  </Field>
  <Field Label="Float" Unit="blocks" Note="Air left under the monument.">
    <ChildContent>
      <NumberField Min="0" Max="64" Value="DestroyableFloat"
                   ValueChanged="@(value => SetNumber(PieceSettings.Float, (int)value, Vocabulary.Destroyable.Float))" />
    </ChildContent>
  </Field>
}
else if (Kind == "core")
{
  @* A core is chosen, not designed: the author states the lava and the casing follows, so a casing with nothing
     in it cannot be typed. The readout is the obsidian those two imply. *@
  <Field Label="Lava footprint" Unit="blocks">
    <ChildContent>
      <Select Slim="false" Options="LavaOptions" Value="@CoreLava.ToString()"
              ValueChanged="@(value => SetNumber(PieceSettings.Lava, Num(value, CoreLava), Vocabulary.Core.Lava))" />
    </ChildContent>
  </Field>
  <Field Label="Lava height" Unit="blocks">
    <ChildContent>
      <Select Slim="false" Options="LavaHeightOptions" Value="@CoreLavaHeight.ToString()"
              ValueChanged="@(value => SetNumber(PieceSettings.LavaHeight, Num(value, CoreLavaHeight), Vocabulary.Core.LavaHeight))" />
    </ChildContent>
  </Field>
  <Field Label="Casing" Note="@(CoreOpenTop ? "Lava flush with the rim." : "A lid over the lava.")">
    <div class="filter-group-options">
      <Chip Active="@(!CoreOpenTop)" OnClick="@(() => Set(PieceSettings.OpenTop, null))">Capped</Chip>
      <Chip Active="@CoreOpenTop" OnClick="@(() => Set(PieceSettings.OpenTop, true))">Open</Chip>
    </div>
  </Field>
  <Readout>@CoreCasingReadout</Readout>
  <Field Label="Float" Unit="blocks" Note="Air left under the casing.">
    <ChildContent>
      <NumberField Min="0" Max="64" Value="CoreFloat"
                   ValueChanged="@(value => SetNumber(PieceSettings.Float, (int)value, Vocabulary.Core.Float))" />
    </ChildContent>
  </Field>
  <Field Label="Leak" Unit="blocks" Note="How far the lava falls before the core counts as leaked.">
    <ChildContent>
      <NumberField Min="0" Max="64" Value="CoreLeak"
                   ValueChanged="@(value => SetNumber(PieceSettings.Leak, (int)value, Vocabulary.Core.Leak))" />
    </ChildContent>
  </Field>
  <Readout>@CoreDigReadout</Readout>
}
