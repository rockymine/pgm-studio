@namespace PgmStudio.Client.Components
@inject IJSRuntime JS
@inject HttpClient Http
@implements IAsyncDisposable

@* Hybrid world canvas: Blazor renders the floating chrome and the svg shell, the reused WorldCanvas JS
   (via bridge/world-bridge.js interop) owns pan/zoom/render/selection. Cursor + zoom are written by JS
   straight into the readout's elements (hot path); only selection round-trips to C# (OnSelect). *@

<div class="workspace-canvas">
  <div @ref="wrapRef" class="svg-area">
    <svg @ref="svgRef" class="map-canvas-svg" xmlns="http://www.w3.org/2000/svg"></svg>
  </div>

  <CanvasReadout @ref="readout" />

  @* No projection toggle: this canvas is top-down only, so fit ends the row where the 2D/3D toggle ends
     Sketch's and Plan's. *@
  <CanvasLayerBar>
    @if (orbitMode is not null)
    {
      <LayerChip Icon="orbit" Active="orbitOn"
                 Title="Mirror drawn regions across the map's confirmed symmetry"
                 OnClick="ToggleOrbit">@OrbitLabel()</LayerChip>
    }
    @* Blocks overlay is a mode-independent visual aid (renders below the regions/markers); offered on every
       canvas so placement can be lined up against the real terrain. No-op when the map has no scan data. *@
    <LayerChip Icon="box" Active="blocksOn" Title="Overlay the top-surface block colours"
               OnClick="ToggleBlocks">Blocks</LayerChip>
    @if (ShowBuildable)
    {
      <LayerChip Icon="hammer" Active="buildableOn"
                 Title="Overlay the per-column buildability verdict (green buildable · orange void-denied · red never · yellow restricted)"
                 OnClick="ToggleBuildability">Buildable</LayerChip>
    }
    @if (islandIds.Count > 0)
    {
      <select class="canvas-select" title="Zoom to fit an island" value="@islandSel" @onchange="OnFitIslandSelect">
        <option value="">Fit island…</option>
        @foreach (var id in islandIds)
        {
          <option value="@id">Island @id</option>
        }
      </select>
    }
    <CanvasRoundButton Icon="scan" Title="Reset zoom (fit whole map)" OnClick="OnResetClick" />
  </CanvasLayerBar>

  <CanvasDock>
    <DockGroup>
      <DockButton Icon="mouse-pointer-2" Title="Select (S)" Active="@(tool == "select")"
                  OnClick='() => SetTool("select")' />
      <DockButton Icon="hand" Title="Move (M)" Active="@(tool == "move")"
                  OnClick='() => SetTool("move")' />
    </DockGroup>
    @if (DrawCategory is not null)
    {
      @* One region shape per button — a region is what it is by its type, and nothing here builds or carves,
         so the group takes no mode colour. *@
      <DockGroup>
        <DockButton Icon="rectangle-horizontal" Title="Rectangle" Active="@(tool == "rectangle")"
                    OnClick='() => SetTool("rectangle")' />
        <DockButton Icon="box" Title="Cuboid" Active="@(tool == "cuboid")"
                    OnClick='() => SetTool("cuboid")' />
        <DockButton Icon="cylinder" Title="Cylinder" Active="@(tool == "cylinder")"
                    OnClick='() => SetTool("cylinder")' />
        <DockButton Icon="circle" Title="Circle" Active="@(tool == "circle")"
                    OnClick='() => SetTool("circle")' />
        <DockButton Icon="square" Title="Block (single block)" Active="@(tool == "block")"
                    OnClick='() => SetTool("block")' />
        <DockButton Icon="dot" Title="Point" Active="@(tool == "point")"
                    OnClick='() => SetTool("point")' />
      </DockGroup>
    }
    else if (PointPick)
    {
      <DockGroup>
        <DockButton Icon="dot" Title="Point — place a spawn" Active="@(tool == "point")"
                    OnClick='() => SetTool("point")' />
      </DockGroup>
    }
    else if (RectDraw)
    {
      @* A host that draws two kinds of rectangle (the buildable layer's bridge and hole) supplies the word
         that names which, and the colour the group wears while it is armed. The canvas owns the shape; the
         step owns what the shape means. *@
      <DockGroup Accent="@DrawAccent">
        @DrawMode
        <DockButton Icon="rectangle-horizontal" Title="@RectDrawTitle" Active="@(tool == "rectangle")"
                    OnClick='() => SetTool("rectangle")' />
      </DockGroup>
    }
  </CanvasDock>
</div>
