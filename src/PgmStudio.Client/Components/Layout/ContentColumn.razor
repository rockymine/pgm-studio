@namespace PgmStudio.Client.Components

@* The "vertical content page": a centred column capped at MaxWidth, used by the info and review steps and
   the list views instead of a sidebar and canvas split. The page scrolls at its full width, so the scrollbar
   stands at the window's edge rather than the column's. On a read-only page its fields sit in a disabled
   fieldset. *@

<div class="workspace-scroll" @attributes="Extra">
    <div class="content-column" style="--column-width: @(MaxWidth)px">
        @if (ReadOnly)
        {
            <fieldset class="readonly-fieldset" disabled>@ChildContent</fieldset>
        }
        else
        {
            @ChildContent
        }
    </div>
</div>

@code {
    [Parameter] public int MaxWidth { get; set; } = 960;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }
    [CascadingParameter(Name = "StudioReadOnly")] public bool ReadOnly { get; set; }
}
