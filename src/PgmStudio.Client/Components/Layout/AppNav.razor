@namespace PgmStudio.Client.Components
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

@* The studio's own bar, the same on every page: home, a link to each tool, then the two reference pages —
   the rules a check can name and the glossary of the studio's words — and at the right the keyboard shortcuts,
   the design reference, the text size, the theme and the account. What belongs to the tool in front of it —
   its trail, its state, its actions — is the Topbar under it. *@

<nav class="app-nav" aria-label="Studio">
    <a class="app-nav-home" href="" title="Studio home">
        <span class="app-nav-pgm">pgm</span><span class="app-nav-sub">STUDIO</span>
    </a>
    <div class="app-nav-links">
        @foreach (var link in Links)
        {
            <a class="app-nav-link@(IsHere(link) ? " app-nav-link--active" : null)" href="@link.Href"
               aria-current="@(IsHere(link) ? "page" : null)">@link.Label</a>
        }
    </div>
    <div class="app-nav-right">
        <button type="button" class="topbar-icon-btn app-nav-icon" @onclick="ShowKeysAsync"
                title="Keyboard shortcuts (?)" aria-label="Keyboard shortcuts">
            <i data-lucide="keyboard"></i>
        </button>
        <a class="topbar-icon-btn app-nav-icon" href="@DesignLink.Href" title="Design" aria-label="Design"
           aria-current="@(IsHere(DesignLink) ? "page" : null)">
            <i data-lucide="palette"></i>
        </a>
        <TextSizeMenu />
        <ThemeToggle />
        <AccountMenu />
    </div>
</nav>

@code {
    /// <summary>One page link. <paramref name="Also"/> is a second path it is lit under besides the page it
    /// opens: plans are entered from the Maps page, so Maps is lit on every plan route too.</summary>
    private sealed record NavLink(string Href, string Label, string? Also = null);

    private static readonly NavLink[] Links =
    [
        new("maps", "Maps", Also: "plans"),
        new("generator", "Generator"),
        new("library", "Library"),
        new("rules", "Rules"),
        new("glossary", "Glossary"),
    ];

    private static readonly NavLink DesignLink = new("design", "Design");

    private Task ShowKeysAsync() => JS.InvokeVoidAsync("studio.showKeys").AsTask();

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("studio.icons");

    /// <summary>A link is lit on its own page and every page under it; a map's tools sit under Maps.</summary>
    private bool IsHere(NavLink link)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        return Under(path, link.Href) || (link.Also is not null && Under(path, link.Also));
    }

    private static bool Under(string path, string root) =>
        path == root || path.StartsWith(root + "/", StringComparison.Ordinal);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
