@namespace PgmStudio.Client.Components

@* The one heading a page opens on, under the tool bar: the page's name in the crumb's word, an optional line
   saying what the page is for, and the page's own actions on the right. The crumb navigates; this names. *@

<header class="page-heading">
  <div class="page-heading__text">
    <h1 class="page-heading__title">@Title</h1>
    @if (Lead is not null) { <p class="page-heading__lead">@Lead</p> }
  </div>
  @if (Actions is not null) { <div class="page-heading__actions">@Actions</div> }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public RenderFragment? Lead { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
