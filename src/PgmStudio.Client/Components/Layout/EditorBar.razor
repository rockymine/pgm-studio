@namespace PgmStudio.Client.Components
@inject IJSRuntime JS
@inject NavigationManager Nav

@* The one bar the editors draw, in place of the studio's own on a focused page. Left: the studio's mark, which opens
   the studio's menu (StudioShell's "StudioMenu"), then where the page is — Maps, the map's name and the stage
   switcher. Middle: the phase's name and its steps. Right: the read-only tag (for a visitor, the sign-in in its
   place), the state (State), Undo and Redo
   (History), the tool's other commands (Commands), a divider, and Back/Next. A page with no phase to show leaves
   PhaseTitle empty, and one with nothing to move between sets NoMove.

   The foot (.editor-bar-foot) holds the move: Back, History, the phase with its steps, and Next. On a wide window
   it and the end dissolve into the bar's row, ordered so the phase and its steps follow the crumb; below 960px the
   foot is pinned to the window's foot, where a thumb reaches it, and the bar above keeps
   only where the page is and what state the work is in. Below 600px the rail is not drawn, so the foot's middle
   is a button naming the phase and step, and it opens a sheet listing the rail's phases (StudioShell's
   "StudioRail") with the open phase's steps under it. A read-only page draws no History. *@

<div class="editor-bar">
  @if (Menu is not null)
  {
    <button type="button" class="topbar-icon-btn editor-studio-btn" aria-label="Open the studio menu" title="Open the studio menu"
            aria-controls="app-nav-panel" aria-expanded="@(Menu.Open ? "true" : "false")" @onclick="Menu.OpenIt">
      <StudioMark /><svg class="editor-studio-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6.5l4 4 4-4" /></svg>
    </button>
  }
  <nav class="editor-crumb" aria-label="Breadcrumb">
    <a class="editor-crumb-link" href="maps">Maps</a>
    <span class="editor-crumb-sep" aria-hidden="true">›</span>
    <span class="editor-crumb-name" title="@MapName" aria-current="page">@MapName</span>
    <StageSwitch Slug="@Slug" Stage="@Stage" Label="@StageLabel" />
  </nav>
  <span class="editor-bar-spacer" aria-hidden="true"></span>
  <div class="editor-bar-end">
    @if (ReadOnlyReason is not null && SignedIn)
    {
      <span class="readonly-tag" role="status" title="@ReadOnlyReason"><i data-lucide="eye"></i><span>View only</span></span>
    }
    else if (ReadOnlyReason is not null)
    {
      <a class="readonly-tag readonly-signin" title="@ReadOnlyReason"
         href="@StudioAccess.SignInHref(Nav.ToBaseRelativePath(Nav.Uri))"><DiscordMark /><span>Sign in</span></a>
    }
    @if (State is not null)
    {
      <div class="editor-bar-state">@State</div>
    }
    @if (Commands is not null)
    {
      <div class="@CommandsCls">@Commands</div>
    }
    @if (!NoMove && (State is not null || Commands is not null || DrawsHistory))
    {
      <span class="editor-bar-divider" role="separator" aria-orientation="vertical"></span>
    }
    @if (HasFoot)
    {
      <div class="editor-bar-foot">
        @if (!NoMove)
        {
          <Button Class="editor-bar-back" Icon="chevron-left" Disabled="@(!BackEnabled)" OnClick="OnBack" aria-label="Back"><span class="editor-bar-back-label">Back</span></Button>
        }
        @if (DrawsHistory)
        {
          <div class="editor-bar-history">@History</div>
        }
        @if (Rail is not null)
        {
          <button type="button" class="editor-bar-picker" aria-haspopup="dialog" aria-expanded="@(sheetOpen ? "true" : "false")"
                  @onclick="OpenSheet">
            <span class="editor-bar-picker-text">
              <small>@PickerCaption</small>
              <span>@PickerName</span>
            </span>
            <svg class="editor-stage-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 9.5l4-4 4 4" /></svg>
          </button>
        }
        @if (PhaseTitle.Length > 0)
        {
          <div class="editor-bar-steps">
            <span class="editor-bar-phase">@PhaseTitle</span>
            @if (Steps.Count > 0)
            {
              <div class="flow-steps">
                @for (var j = 0; j < Steps.Count; j++)
                {
                  var idx = j;
                  var cls = idx < CurrentStep ? "flow-step flow-step--done"
                          : idx == CurrentStep ? "flow-step flow-step--active"
                          : "flow-step";
                  @* Keyed by name, so a step inserted before it leaves this button this step's: a click landing as
                     the strip re-renders goes where it was aimed. *@
                  <button @key="Steps[idx]" class="@cls" disabled="@(idx > MaxStep)" aria-current="@(idx == CurrentStep ? "step" : null)"
                          @onclick="() => OnStep.InvokeAsync(idx)">@Steps[idx]</button>
                }
              </div>
            }
          </div>
        }
        @if (!NoMove)
        {
          <Button Class="editor-bar-next" Variant="primary" Disabled="@(!NextEnabled)" Busy="@NextBusy" BusyLabel="@NextBusyLabel"
                  Writes="@NextWrites" Builds="@NextBuilds" OnClick="OnNext">@NextLabel</Button>
        }
      </div>
    }
  </div>
</div>

@if (sheetOpen && Rail is not null)
{
  <div class="editor-sheet-scrim" @onclick="CloseSheet"></div>
  <div class="editor-sheet" role="dialog" aria-label="Phases and steps" tabindex="-1" @ref="sheet" @onkeydown="OnSheetKey">
    <div class="editor-sheet-phases" @onclick="CloseSheet">@Rail</div>
    @if (Steps.Count > 0)
    {
      <div class="editor-sheet-steps" role="list" aria-label="@($"{PhaseTitle} steps")">
        @for (var j = 0; j < Steps.Count; j++)
        {
          var idx = j;
          <button @key="Steps[idx]" type="button" class="editor-sheet-step" role="listitem" disabled="@(idx > MaxStep)"
                  aria-current="@(idx == CurrentStep ? "step" : null)" @onclick="() => PickStep(idx)">
            <span class="editor-sheet-step-n">@(idx + 1)</span>@Steps[idx]
          </button>
        }
      </div>
    }
  </div>
}

@code {
    /// <summary>The map's name as the crumb shows it.</summary>
    [Parameter] public string? MapName { get; set; }
    /// <summary>The map the page is open on; null where there is none, which leaves the stage word unswitchable.</summary>
    [Parameter] public string? Slug { get; set; }
    /// <summary>The tool this page is, a <see cref="MapStage"/> word of Sketch or Configure.</summary>
    [Parameter] public string Stage { get; set; } = MapStage.Configure;
    /// <summary>A word to show for the tool in place of its stage's name.</summary>
    [Parameter] public string? StageLabel { get; set; }

    [Parameter] public string PhaseTitle { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Steps { get; set; } = Array.Empty<string>();
    [Parameter] public int CurrentStep { get; set; }
    /// <summary>Highest step the user may jump to via the bar — later steps are locked/dimmed.
    /// Default unlimited (every step is freely navigable).</summary>
    [Parameter] public int MaxStep { get; set; } = int.MaxValue;

    /// <summary>What the page has to say about itself at the right: where a save stands, a note.</summary>
    [Parameter] public RenderFragment? State { get; set; }
    /// <summary>Undo and Redo: beside the move, so on a narrow window they sit in the foot with it.</summary>
    [Parameter] public RenderFragment? History { get; set; }
    /// <summary>The tool's other actions, drawn between the state and Back/Next.</summary>
    [Parameter] public RenderFragment? Commands { get; set; }
    /// <summary>Whether <see cref="Commands"/> are labelled buttons; icon-only commands sit closer together.</summary>
    [Parameter] public bool LabelledCommands { get; set; }
    /// <summary>The page has no Back and Next to offer.</summary>
    [Parameter] public bool NoMove { get; set; }

    [Parameter] public bool BackEnabled { get; set; }
    [Parameter] public bool NextEnabled { get; set; } = true;
    [Parameter] public string NextLabel { get; set; } = "Next";
    /// <summary>Next is running its own action — the last step's Next is a verb rather than a move, and a
    /// step that fetches something wants the control disabled and saying so while it does.</summary>
    [Parameter] public bool NextBusy { get; set; }
    [Parameter] public string? NextBusyLabel { get; set; }
    /// <summary>Next writes rather than moves — a finish that stores the map — so it is closed where the
    /// caller may not write.</summary>
    [Parameter] public bool NextWrites { get; set; }
    /// <summary>Next has the server build something on request, as Configure's Export does.</summary>
    [Parameter] public bool NextBuilds { get; set; }

    [Parameter] public EventCallback<int> OnStep { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }

    [CascadingParameter(Name = "StudioReadOnlyReason")] public string? ReadOnlyReason { get; set; }
    /// <summary>Whether the browser is signed in: a visitor is offered the sign-in where someone signed in is told
    /// the page is view only.</summary>
    [CascadingParameter(Name = "StudioSignedIn")] public bool SignedIn { get; set; }
    /// <summary>The studio's menu, on a focused page; elsewhere the studio bar carries it and this is null.</summary>
    [CascadingParameter(Name = "StudioMenu")] public StudioMenu? Menu { get; set; }
    /// <summary>The page's rail, which the phone's sheet lists in its place.</summary>
    [CascadingParameter(Name = "StudioRail")] public RenderFragment? Rail { get; set; }

    private bool sheetOpen;
    private bool sheetShown;
    private ElementReference sheet;

    private string CommandsCls => LabelledCommands ? "editor-bar-commands editor-bar-commands--labelled" : "editor-bar-commands";

    private bool DrawsHistory => History is not null && ReadOnlyReason is null;

    private bool HasFoot => !NoMove || DrawsHistory || Rail is not null;

    private string PickerCaption => PhaseTitle.Length == 0 ? "Phase"
        : Steps.Count > 0 ? $"{PhaseTitle} · {CurrentStep + 1} of {Steps.Count}"
        : "Phase";

    private string PickerName => PhaseTitle.Length == 0 ? "Choose a phase"
        : Steps.Count > 0 ? Steps[Math.Clamp(CurrentStep, 0, Steps.Count - 1)]
        : PhaseTitle;

    private void OpenSheet() => sheetOpen = true;

    private void CloseSheet() => sheetOpen = false;

    private void OnSheetKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") sheetOpen = false;
    }

    private async Task PickStep(int step)
    {
        sheetOpen = false;
        await OnStep.InvokeAsync(step);
    }

    /// <summary>The sheet takes focus when it opens and hands it back to its button when it closes.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (sheetOpen == sheetShown) return;
        sheetShown = sheetOpen;
        if (sheetOpen)
        {
            await JS.InvokeVoidAsync("studio.icons");
            await sheet.FocusAsync();
        }
        else await JS.InvokeVoidAsync("studio.focusFirst", ".editor-bar-picker");
    }
}
