@namespace PgmStudio.Client.Components

@* The left rail of a page that narrows a list, or lists the sections of one long page — a Sidebar ruled off
   from the content beside it. Its children are FilterPanels. On a narrow window the rail sits above the content
   and folds behind a button naming it (Title), so the list it narrows is what the page opens on. *@

<Sidebar Class="@Cls" @attributes="Extra">
    <ChildContent>
        <button type="button" class="filter-sidebar-toggle" aria-expanded="@(open ? "true" : "false")"
                @onclick="() => open = !open">
            <span>@Title</span><i data-lucide="chevron-down"></i>
        </button>
        <div class="filter-sidebar-body">@ChildContent</div>
    </ChildContent>
</Sidebar>

@code {
    [Parameter] public string? Class { get; set; }
    /// <summary>What the folded rail's button says on a narrow window.</summary>
    [Parameter] public string Title { get; set; } = "Filters";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private bool open;

    private string Cls => string.Join(' ', new[] { "filter-sidebar", open ? "filter-sidebar--open" : null, Class }.Where(c => !string.IsNullOrEmpty(c)));
}
