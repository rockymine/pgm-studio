@namespace PgmStudio.Client.Components

@* The studio entry's opening block: what the studio makes, the two ways in (a new map, made and opened, or the
   maps), and the studio's fixed header picture, the same for every reader whatever maps the studio holds. *@

<section class="landing-hero">
  <div class="landing-hero-text">
    <span class="landing-eyebrow">A map studio for PGM</span>
    <h1 class="landing-title">PGM maps from layout to <code>map.xml</code></h1>
    <p class="landing-lead">Draw a symmetric layout, shape and paint its ground, set what it is played for, and
      export a world a server can load.</p>
    <div class="landing-actions">
      <NewMapButton Size="lg" />
      <Button Size="lg" Icon="map" Href="@MapsHref">Browse maps</Button>
    </div>
  </div>
  <MapThumb Class="landing-hero-picture" />
</section>

@code {
    [Parameter] public string MapsHref { get; set; } = "maps";
}
