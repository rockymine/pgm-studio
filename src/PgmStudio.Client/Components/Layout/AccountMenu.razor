@namespace PgmStudio.Client.Components
@inject StudioAccess Access
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@* Who the browser is, at the right of the studio's bar, opening a menu. Signed in: the head, name and role,
   and in the menu the tokens that sign in as them, the whitelist and the API docs for an admin, and sign out.
   An open studio: "local admin" with the whitelist and the API docs. A visitor: the sign-in with Discord's mark,
   and no menu. *@

@if (me is not null)
{
    <div class="account">
        @if (me.Mode == AccessModes.Open)
        {
            <button type="button" class="account-button account-local" aria-haspopup="menu" aria-expanded="@(open ? "true" : "false")"
                    @onclick="() => open = !open">
                local <span class="account-role">admin</span>
                <i data-lucide="chevron-down"></i>
            </button>
        }
        else if (me.SignedIn)
        {
            <button type="button" class="account-button" aria-haspopup="menu" aria-expanded="@(open ? "true" : "false")"
                    @onclick="() => open = !open">
                <PlayerHead Uuid="@me.Uuid" Name="@me.Name" Size="22" />
                <span class="account-name">@me.Name</span>
                <span class="account-role">@RoleLabel</span>
                @if (waiting > 0) { <span class="account-waiting" title="Waiting for approval">@waiting</span> }
                <i data-lucide="chevron-down"></i>
            </button>
        }
        else
        {
            <a class="account-signin" href="@StudioAccess.SignInHref(Nav.ToBaseRelativePath(Nav.Uri))">
                <DiscordMark /><span>Sign in with Discord</span>
            </a>
        }
        @if (open)
        {
            <div class="account-scrim" @onclick="() => open = false"></div>
            <div class="account-menu" role="menu">
                @if (me.SignedIn && me.Mode != AccessModes.Open)
                {
                    <div class="account-menu-head">
                        <PlayerHead Uuid="@me.Uuid" Name="@me.Name" Size="40" />
                        <div class="account-menu-who">
                            <span class="account-name">@me.Name</span>
                            <span class="account-menu-note">
                                @(me.Role is null ? "not on the whitelist" : RoleLabel) · signed in with Discord
                            </span>
                        </div>
                    </div>
                    @if (me.Role is StudioRoles.Member or StudioRoles.Admin)
                    {
                        <a class="account-menu-item" role="menuitem" href="tokens" @onclick="() => open = false">
                            <i data-lucide="shield-check"></i><span>Tokens</span>
                        </a>
                    }
                }
                @if (me.Role == StudioRoles.Admin)
                {
                    <a class="account-menu-item" role="menuitem" href="admin/users" @onclick="() => open = false">
                        <i data-lucide="users"></i><span>Users</span>
                        @if (waiting > 0) { <span class="account-waiting" title="Waiting for approval">@waiting</span> }
                    </a>
                    <a class="account-menu-item" role="menuitem" href="/api-docs" target="_blank" rel="noopener"
                       @onclick="() => open = false">
                        <i data-lucide="file-code"></i><span>API docs</span><i data-lucide="external-link" class="account-menu-ext"></i>
                    </a>
                }
                @if (me.SignedIn && me.Mode != AccessModes.Open)
                {
                    <button type="button" class="account-menu-item" role="menuitem" @onclick="SignOutAsync">
                        <i data-lucide="log-out"></i><span>Sign out</span>
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private CallerDto? me;
    private bool open;

    /// <summary>How many people wait for an admin's approval, counted for an admin alone.</summary>
    private int waiting;

    private string RoleLabel => me?.Role switch
    {
        null => "guest",
        StudioRoles.Unapproved => "waiting for approval",
        var role => role,
    };

    protected override async Task OnInitializedAsync()
    {
        me = await Access.MeAsync();
        if (me.Role == StudioRoles.Admin && me.Mode != AccessModes.Open)
        {
            try
            {
                waiting = (await Http.GetFromJsonAsync<List<StudioUserDto>>("api/users") ?? [])
                    .Count(user => user.Role == StudioRoles.Unapproved);
            }
            catch (HttpRequestException) { waiting = 0; }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("studio.icons");

    private async Task SignOutAsync()
    {
        await Http.PostAsync("api/auth/sign-out", null);
        Access.Forget();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
