@namespace PgmStudio.Client.Components

@* The tool's bar, under the studio's own — the trail to where the page is (an optional home link, then
   the Crumbs slot composed from Crumb), a "view only" tag where the page opens read-only, and the tool's
   state and actions at the right (Right). What belongs to the studio rather than the tool — its pages,
   the theme, the account — is AppNav above it. *@

<div class="topbar">
    @if (HomeHref is not null)
    {
        <a class="topbar-breadcrumb-home" href="@HomeHref" title="@HomeTitle">
            @if (HomeIcon is not null) { <Icon Name="@HomeIcon" /> }
            <span>@HomeLabel</span>
        </a>
    }
    @Crumbs
    @if (ReadOnlyReason is not null)
    {
        <span class="readonly-tag" role="status" title="@ReadOnlyReason"><Icon Name="eye" /><span>View only</span></span>
    }
    @if (Right is not null)
    {
        <div class="topbar-right">@Right</div>
    }
</div>

@code {
    [Parameter] public string? HomeHref { get; set; }
    [Parameter] public string? HomeLabel { get; set; }
    [Parameter] public string? HomeIcon { get; set; } = "house";
    [Parameter] public string? HomeTitle { get; set; }
    [Parameter] public RenderFragment? Crumbs { get; set; }
    [Parameter] public RenderFragment? Right { get; set; }
    [CascadingParameter(Name = "StudioReadOnlyReason")] public string? ReadOnlyReason { get; set; }
}
