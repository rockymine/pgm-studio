@namespace PgmStudio.Client.Components

@* The bar of a page that is not an editor, under the studio's own — the trail to where the page is (the Crumbs
   slot composed from Crumb), a "view only" tag where the page opens read-only, and the page's state and
   actions at the right (Right). The editors draw EditorBar instead. What belongs to the studio rather than the
   page — its pages, the theme, the account — is AppNav above it. *@

<div class="topbar">
    @Crumbs
    @if (ReadOnlyReason is not null)
    {
        <span class="readonly-tag" role="status" title="@ReadOnlyReason"><i data-lucide="eye"></i><span>View only</span></span>
    }
    @if (Right is not null)
    {
        <div class="topbar-right">@Right</div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Crumbs { get; set; }
    [Parameter] public RenderFragment? Right { get; set; }
    [CascadingParameter(Name = "StudioReadOnlyReason")] public string? ReadOnlyReason { get; set; }
}
