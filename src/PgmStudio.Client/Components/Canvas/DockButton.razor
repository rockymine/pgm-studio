@namespace PgmStudio.Client.Components

@* One tool in the dock. A glyph when the thing it draws has a shape (rectangle, lasso, ruler); a colour
   swatch when the thing it draws is told apart by its colour on the canvas and not by its outline (a piece
   role, a box kind) — the palette then reads like the drawing does.

   The glyph is @keyed by its name because lucide replaces the <i> with an <svg> after render: a name that
   changes (the flyout group promotes a picked tool into the main slot) has to recreate the node rather than
   patch one the reconciler no longer owns. *@

<button class="@Cls" type="button" title="@Title" disabled="@Disabled" aria-pressed="@Active" @onclick="OnClick">
  @if (Swatch is not null || SwatchClass is not null)
  {
    <span class="@SwatchCls" style="@SwatchStyle"></span>
  }
  else if (!string.IsNullOrEmpty(Icon))
  {
    <i data-lucide="@Icon" @key="@Icon"></i>
  }
  @ChildContent
</button>

@code {
    /// <summary>Lucide glyph name. Ignored when a swatch is given.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Fill colour of a swatch button — the colour this tool draws in.</summary>
    [Parameter] public string? Swatch { get; set; }
    /// <summary>Modifier for a swatch whose canvas fill is a pattern rather than a flat colour
    /// (e.g. "canvas-dock-swatch--box"), so the palette matches what the canvas paints.</summary>
    [Parameter] public string? SwatchClass { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Cls => Active ? "canvas-dock-btn canvas-dock-btn--active" : "canvas-dock-btn";

    private string SwatchCls => SwatchClass is null ? "canvas-dock-swatch" : $"canvas-dock-swatch {SwatchClass}";

    private string? SwatchStyle => Swatch is null ? null : $"--swatch-color:{Swatch}";
}
