@namespace PgmStudio.Client.Components

@* Canonical action button — emits .action-btn plus the chosen variant/layout modifiers. Renders an
   <a> when Href is set (navigation), otherwise a <button>. Variant maps straight to the CSS modifier
   (primary · danger · warn · icon); Fill/Full add the layout modifiers; Class carries any extra
   (e.g. action-btn--push-end). Pass a Lucide glyph via Icon. Unmatched attributes pass through.

   Busy is the one state the button owns rather than reports: a control running its own action is
   disabled AND says what it is doing, and pairing the two here is what stops a call site doing one
   without the other. Busy replaces the icon and the child content with BusyLabel, because the verb a
   button offers and the verb it is performing are different words.

   The @key on the button is what makes that swap survive a Lucide glyph. Lucide replaces an
   <i data-lucide> with an <svg> of its own, which detaches the <i> the renderer still holds; diffing
   the children then removes a node whose parentNode is null. Keyed on Busy, the whole button is
   replaced instead of walked, and the detached <i> goes with its parent. *@

@if (Href is not null)
{
    <a class="@Cls" href="@Href" title="@Title" @attributes="Extra">
        @if (Icon is not null) { <i data-lucide="@Icon"></i> }
        @ChildContent
    </a>
}
else
{
    <button @key="Busy" class="@Cls" type="@Type" title="@Title" disabled="@(Disabled || Busy)"
            @onclick="OnClick" @attributes="Extra">
        @if (Busy && BusyLabel is not null)
        {
            @BusyLabel
        }
        else
        {
            @if (Icon is not null) { <i data-lucide="@Icon"></i> }
            @ChildContent
        }
    </button>
}

@code {
    [Parameter] public string? Variant { get; set; }        // primary | danger | warn | icon → action-btn--<v>
    [Parameter] public string? Icon { get; set; }           // Lucide glyph name
    [Parameter] public string? Href { get; set; }           // set → renders <a>
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }              // running its own action: disabled, and says so
    [Parameter] public string? BusyLabel { get; set; }      // what it shows while Busy, in place of Icon + content
    [Parameter] public bool Fill { get; set; }              // action-btn--fill
    [Parameter] public bool Full { get; set; }              // action-btn--full
    [Parameter] public string? Class { get; set; }          // extra modifiers
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string Cls => string.Join(' ', new[]
    {
        "action-btn",
        Variant is null ? null : $"action-btn--{Variant}",
        Fill ? "action-btn--fill" : null,
        Full ? "action-btn--full" : null,
        Class
    }.Where(c => !string.IsNullOrEmpty(c)));
}
