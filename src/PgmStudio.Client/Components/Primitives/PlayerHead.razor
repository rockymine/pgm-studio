@namespace PgmStudio.Client.Components
@inject NavigationManager Navigation

@* One person's mark: their initial on a neutral tile, and — for an account — the front of their head over
   it, as the studio serves it at /api/minecraft/player/{uuid}/head. The head comes from the studio's own
   origin, never from a third party; where the studio has none to give, nothing is drawn over the initial and
   the initial is the mark. *@

<span class="author-mark player-head@(HasAccount ? " author-mark--account" : null)" style="--head-size: @(Size)px" title="@Title"
      aria-hidden="true">
    @Initial
    @if (HasAccount)
    {
        <span class="player-head-face" style="@HeadStyle"></span>
    }
</span>

@code {
    /// <summary>The Minecraft uuid, where an account answered; empty or null for a pseudonym.</summary>
    [Parameter] public string? Uuid { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Title { get; set; }
    /// <summary>The mark's edge in pixels.</summary>
    [Parameter] public int Size { get; set; } = 16;

    private bool HasAccount => !string.IsNullOrEmpty(Uuid);

    private string Initial =>
        (Name ?? "").Trim() is { Length: > 0 } typed ? char.ToUpperInvariant(typed[0]).ToString() : "–";

    /// <summary>The head as an absolute address: a relative url() in a custom property would resolve against
    /// the stylesheet that reads it rather than the page.</summary>
    private string HeadStyle =>
        $"--head-image: url('{Navigation.ToAbsoluteUri($"api/minecraft/player/{Uri.EscapeDataString(Uuid!)}/head")}')";
}
