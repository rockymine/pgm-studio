@namespace PgmStudio.Client.Components

@* Toggleable filter option — emits .filter-chip (+ --active when on). A <button> so it is keyboard-
   reachable; Disabled greys it. Count appends how many items the option holds. Sits inside a FilterGroup's .filter-group-options row. *@

<button class="@Cls" type="button" title="@Title" disabled="@Disabled" @onclick="OnClick" @attributes="Extra">@ChildContent@if (Count is { } count) { <span class="filter-chip-n">@count</span> }</button>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>How many items choosing this option would show; omitted where nothing is counted.</summary>
    [Parameter] public int? Count { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string Cls => string.Join(' ', new[]
    {
        "filter-chip",
        Active ? "filter-chip--active" : null,
        Class
    }.Where(c => !string.IsNullOrEmpty(c)));
}
