@namespace PgmStudio.Client.Components

@* The canonical panel section — a .panel-section stack of an optional header (SectionHeader built
   from Title/Variant + the Actions right slot, or a full Header override), an optional Description
   paragraph, the body (ChildContent), and an optional Footer (.section-footer). panel-section is a
   flex column with gap, so header/desc/body/footer space themselves.

   Writes marks a section whose controls write and sit in no shell that greys them (a sidebar's). Where the
   shell's "StudioWriteReason" says the caller may not write, its content goes in a disabled fieldset, as an
   Inspector's does, with the reason on hover. *@

<section class="@Cls" @attributes="Extra">
    @if (Writes && WriteReason is not null)
    {
        <fieldset class="readonly-fieldset panel-section-fieldset" disabled title="@WriteReason">@Body</fieldset>
    }
    else
    {
        @Body
    }
</section>

@code {
    private RenderFragment Body => @<text>
    @if (Header is not null)
    {
        @Header
    }
    else if (!string.IsNullOrEmpty(Title) || Actions is not null || HasHelp)
    {
        <SectionHeader Variant="@Variant" Title="@Title" Required="@Required">
            <TitleEnd>
                @if (HasHelp)
                {
                    <HelpMark Open="helpOpen" Title="@($"About {Title}")" OnClick="() => helpOpen = !helpOpen" />
                }
            </TitleEnd>
            <ChildContent>@Actions</ChildContent>
        </SectionHeader>
    }
    @* Under the heading its mark sits in, and above everything the section holds — where a paragraph
       explaining the section would have gone, which is what it is. *@
    @if (HasHelp && helpOpen) { <HelpNote Help="@Help" Term="@Term" /> }
    @if (Description is not null) { <p class="section-desc">@Description</p> }
    @ChildContent
    @if (Footer is not null) { <div class="@FooterCls">@Footer</div> }
    </text>;

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Variant { get; set; } = "ruled";   // header context: ruled | list | plain
    [Parameter] public bool Required { get; set; }                // appends the field-required asterisk to the title
    /// <summary>What every reader of the section needs and no control says: sentences, at most 25 words.</summary>
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }      // header right slot
    /// <summary>What the section is, behind a "?" beside its heading, where the title is not a glossary term.</summary>
    [Parameter] public string? Help { get; set; }
    /// <summary>The glossary term the title names; its "?" shows the glossary's definition.</summary>
    [Parameter] public string? Term { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }       // overrides Title/Actions entirely
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string? FooterClass { get; set; }          // e.g. section-footer--end / --separated
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }
    /// <summary>Its controls write: grey them where the caller may not write.</summary>
    [Parameter] public bool Writes { get; set; }
    [CascadingParameter(Name = "StudioWriteReason")] public string? WriteReason { get; set; }

    private bool helpOpen;
    private bool HasHelp => Help is not null || HelpNote.Defined(Term) is not null;

    private string Cls => string.Join(' ', new[] { "panel-section", Class }.Where(c => !string.IsNullOrEmpty(c)));
    private string FooterCls => string.Join(' ', new[] { "section-footer", FooterClass }.Where(c => !string.IsNullOrEmpty(c)));
}
