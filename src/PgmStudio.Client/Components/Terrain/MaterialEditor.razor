@namespace PgmStudio.Client.Components

@* One terrain-paint material, edited as a form (docs/world-export/terrain-painting.md §3). A material is
   recursive — a pattern's palette entry, a tint's neutral fallback, a stack's layer are themselves materials —
   so this component nests inside itself. It edits the theme JSON node in place, which IS the wire format the
   painter deserializes, so there is no second model of a material to drift from it. *@

<div class="material-editor @(Nested ? "material-editor--nested" : null)">
  @* One row per material: what it is called, what kind it is, how far it reaches, and the way to remove it.
     The extent belongs to the list that owns the entry rather than to the material, so it arrives as
     HeadExtra — on its own line under the row it belonged to, it read as a second unrelated control. *@
  <div class="material-editor-head">
    @if (Label is not null) { <span class="material-editor-label">@Label</span> }
    <select class="field-input field-input--slim" value="@Kind" @onchange="ChangeKind">
      @foreach (var kind in MaterialKind.All)
      {
        <option value="@kind.Id" @key="kind.Id">@kind.Name</option>
      }
    </select>
    @HeadExtra
    @if (OnRemove.HasDelegate)
    {
      <Button Variant="icon" Icon="trash-2" Title="Remove" OnClick="OnRemove" />
    }
  </div>

  <div class="material-editor-body">
    @switch (Kind)
    {
      case MaterialKind.Solid:
        <BlockPicker Blocks="Blocks" Id="@Int(ThemeFields.Id, 1)" Data="@Int(ThemeFields.Data, 0)" OnPick="PickSolid" />
        break;

      case MaterialKind.TeamTint:
        <p class="material-editor-note">Takes the owning team's colour on the same 0–15 scale as wool, so the
          block has to be one that colours by damage. Land with no team falls through to the neutral material.</p>
        <BlockPicker Blocks="Blocks" Id="@Int(ThemeFields.BlockId, 159)" Data="0" ShowColors="false" OnPick="PickTintBlock" />
        <MaterialEditor Nested Label="Neutral land" Blocks="Blocks" Node="Neutral" OnChanged="Changed" />
        break;

      case MaterialKind.Layered:
        <p class="material-editor-note">A stack claimed downward from the top of the band — grass over two
          dirt. The last layer repeats past the bottom of the stack, so a deeper band never falls through.</p>
        @foreach (var layer in List(ThemeFields.Layers))
        {
          <MaterialEditor Nested Label="@($"Layer {layer.Index + 1}")" Blocks="Blocks" @key="layer.Node"
                          Node="@layer.Material" OnChanged="Changed" OnRemove="@layer.Remove">
            <HeadExtra>
              <Field Label="Courses" Class="material-entry-scalar">
                <input class="field-input field-input--slim" type="number" min="1" step="1"
                       value="@layer.Extent" @onchange="@layer.SetExtent" />
              </Field>
            </HeadExtra>
          </MaterialEditor>
        }
        <Button Icon="plus" OnClick="AddLayer">Add layer</Button>
        break;

      case MaterialKind.Voronoi:
        <p class="material-editor-note">Cells roughly one patch-size across, drawn as a <strong>ramp inward from
          the cell boundary</strong>. The first band sits on the boundary itself, so it draws the grid; each one
          after it is a ring further in, and the last takes the middle. A cell too small to reach a band never
          shows it, so small cells come out filled by whichever band they did reach. Deterministic — the same
          seed always paints it. @RiseNote</p>
        <div class="material-editor-scalars">
          <Field Label="Patch size">
            <input class="field-input field-input--slim" type="number" min="1" step="1"
                   value="@Int(ThemeFields.CellSize, 10)" @onchange="SetCellSize" />
          </Field>
          <Field Label="Rise">
            <input class="field-input field-input--slim" type="number" min="0" step="1"
                   title="Vertical period in blocks. 0 keeps the pattern flat."
                   value="@Int(ThemeFields.Rise, 0)" @onchange="SetRise" />
          </Field>
          <Field Label="Seed">
            <input class="field-input field-input--slim" type="number" min="0" step="1"
                   value="@Int(ThemeFields.Seed, 0)" @onchange="SetSeed" />
          </Field>
        </div>
        @foreach (var band in List(ThemeFields.Bands))
        {
          <MaterialEditor Nested Label="@BandLabel(band.Index)" Blocks="Blocks" @key="band.Node"
                          Node="@band.Material" OnChanged="Changed" OnRemove="@band.Remove">
            <HeadExtra>
              <Field Label="Blocks in" Class="material-entry-scalar">
                <input class="field-input field-input--slim" type="number" min="1" step="1"
                       value="@band.Extent" @onchange="@band.SetExtent" />
              </Field>
            </HeadExtra>
          </MaterialEditor>
        }
        <Button Icon="plus" OnClick="AddBand">Add a band</Button>
        break;

      case MaterialKind.Cell:
        <p class="material-editor-note">Patches of one material each, any two of which may meet — the fabric a
          voronoi's diagram is not. <strong>Jitter</strong> is how far a patch's seed strays from its grid
          square (0% is the grid itself, 100% is shards); <strong>edge wander</strong> is how many blocks the
          boundaries wobble, which is what makes the patches organic rather than straight-edged. @RiseNote</p>
        <div class="material-editor-scalars">
          <Field Label="Patch size">
            <input class="field-input field-input--slim" type="number" min="1" step="1"
                   value="@Int(ThemeFields.CellSize, 10)" @onchange="SetCellSize" />
          </Field>
          <Field Label="Jitter %">
            <input class="field-input field-input--slim" type="number" min="0" max="100" step="5"
                   value="@Int(ThemeFields.Jitter, 50)" @onchange="SetJitter" />
          </Field>
          <Field Label="Edge wander">
            <input class="field-input field-input--slim" type="number" min="0" step="1"
                   value="@Int(ThemeFields.Warp, 4)" @onchange="SetWarp" />
          </Field>
          <Field Label="Rise">
            <input class="field-input field-input--slim" type="number" min="0" step="1"
                   title="Vertical period in blocks. 0 keeps the pattern flat."
                   value="@Int(ThemeFields.Rise, 0)" @onchange="SetRise" />
          </Field>
          <Field Label="Seed">
            <input class="field-input field-input--slim" type="number" min="0" step="1"
                   value="@Int(ThemeFields.Seed, 0)" @onchange="SetSeed" />
          </Field>
        </div>
        @foreach (var entry in List(ThemeFields.Palette))
        {
          <MaterialEditor Nested Label="@($"Patch {entry.Index + 1}")" Blocks="Blocks" @key="entry.Node"
                          Node="@entry.Material" OnChanged="Changed" OnRemove="@entry.Remove" />
        }
        <Button Icon="plus" OnClick="AddPaletteEntry">Add a patch material</Button>
        break;

      case MaterialKind.Noise:
      case MaterialKind.Turbulence:
      case MaterialKind.Electric:
        <p class="material-editor-note">@FieldBlurb Cut into bands by the stops in order — the first takes the
          lowest slice of the field. Only neighbouring stops ever share a boundary, and the outermost two are
          accents rather than halves, so a stop list reads as a ramp from one material to the next. More octaves
          add finer detail without narrowing the field. @RiseNote</p>
        <div class="material-editor-scalars">
          <Field Label="Scale">
            <input class="field-input field-input--slim" type="number" min="1" step="1"
                   value="@Int(ThemeFields.Scale, 16)" @onchange="SetScale" />
          </Field>
          <Field Label="Octaves">
            <input class="field-input field-input--slim" type="number" min="1" max="8" step="1"
                   value="@Int(ThemeFields.Octaves, 3)" @onchange="SetOctaves" />
          </Field>
          <Field Label="Rise">
            <input class="field-input field-input--slim" type="number" min="0" step="1"
                   title="Vertical period in blocks. 0 keeps the pattern flat."
                   value="@Int(ThemeFields.Rise, 0)" @onchange="SetRise" />
          </Field>
          <Field Label="Seed">
            <input class="field-input field-input--slim" type="number" min="0" step="1"
                   value="@Int(ThemeFields.Seed, 0)" @onchange="SetSeed" />
          </Field>
        </div>
        @foreach (var entry in List(ThemeFields.Stops))
        {
          <MaterialEditor Nested Label="@($"Stop {entry.Index + 1}")" Blocks="Blocks" @key="entry.Node"
                          Node="@entry.Material" OnChanged="Changed" OnRemove="@entry.Remove" />
        }
        <Button Icon="plus" OnClick="AddStop">Add stop</Button>
        break;

      case MaterialKind.WallRun:
        <p class="material-editor-note">Stripes running along the wall that wrap the whole void-facing
          perimeter, corners included. Widths are in wall cells and the stripes repeat in order.</p>
        @foreach (var run in List(ThemeFields.Runs))
        {
          <MaterialEditor Nested Label="@($"Stripe {run.Index + 1}")" Blocks="Blocks" @key="run.Node"
                          Node="@run.Material" OnChanged="Changed" OnRemove="@run.Remove">
            <HeadExtra>
              <Field Label="Cells wide" Class="material-entry-scalar">
                <input class="field-input field-input--slim" type="number" min="1" step="1"
                       value="@run.Extent" @onchange="@run.SetExtent" />
              </Field>
            </HeadExtra>
          </MaterialEditor>
        }
        <Button Icon="plus" OnClick="AddStripe">Add stripe</Button>
        break;
    }
  </div>
</div>
