@namespace PgmStudio.Client.Components

@* Picks the block a solid material places. The sixteen-colour families (stained clay, wool, stained glass)
   are one entry in the list plus a row of colour swatches, so choosing "red stained clay" is a colour click
   rather than a hunt through forty-eight dropdown lines. Swatch colours come from the export's own palette.
   The id/data pair underneath is the block itself, editable: the offered list is a curated shortlist, not the
   set of legal blocks, so a variant it does not carry (andesite, 1:5) is typed rather than unreachable. *@

<div class="block-picker">
  @* Chip, name and pair on one row: the pair IS the block the name stands for, so a second row for it read
     as a separate setting rather than as the same one said exactly. Each half is a CoordField, which carries
     its own label inside the box — the only way two numbers fit beside a name without a heading each. *@
  <div class="block-picker-row">
    <span class="block-chip" style="background:@Hex" title="@Name"></span>
    <select class="field-input field-input--slim" value="@SelectedKey" @onchange="ChooseBlock">
      @if (IsOffList)
      {
        <option value="@SelectedKey">@Name</option>
      }
      @foreach (var group in Groups)
      {
        <optgroup label="@group.Key" @key="group.Key">
          @foreach (var block in group)
          {
            <option value="@Key(block)">@OptionLabel(block)</option>
          }
        </optgroup>
      }
    </select>
    <CoordField Prefix="id" Type="number" Value="@Id" OnChange="SetId"
                min="0" step="1" title="The block id this material places" />
    @if (ShowColors)
    {
      <CoordField Prefix="data" Type="number" Value="@Data" OnChange="SetData"
                  min="0" max="15" step="1" title="The block's data value — its shade, where it has one" />
    }
  </div>

  @if (ShowColors && Family is not null)
  {
    <div class="block-picker-colors">
      @foreach (var shade in Family)
      {
        <button type="button" class="block-swatch @(shade.Data == Data ? "block-swatch--on" : null)"
                style="background:@shade.Hex" title="@shade.Name" @key="shade.Data"
                @onclick="() => Pick(shade)"></button>
      }
    </div>
  }
</div>
