@namespace PgmStudio.Client.Components

@* One dropdown. The options arrive as values rather than as markup, so a field is grouped, labelled and
   explained in one place instead of once per site — and an option carrying a note says what it is on hover,
   which a bare <option> has nowhere to put. *@

<select class="@Cls" value="@Value" title="@Title" disabled="@Disabled" @onchange="Changed">
    @if (Placeholder is not null)
    {
        <option value="@PlaceholderValue">@Placeholder</option>
    }
    @foreach (var group in Options.GroupBy(option => option.Group))
    {
        @if (group.Key is null)
        {
            @foreach (var option in group)
            {
                <option value="@option.Value" title="@option.Note" @key="option.Value">@option.Label</option>
            }
        }
        else
        {
            <optgroup label="@group.Key" @key="group.Key">
                @foreach (var option in group)
                {
                    <option value="@option.Value" title="@option.Note" @key="option.Value">@option.Label</option>
                }
            </optgroup>
        }
    }
</select>
