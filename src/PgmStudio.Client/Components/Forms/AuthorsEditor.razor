@namespace PgmStudio.Client.Components
@using PgmStudio.Vocabulary
@inject HttpClient Http
@inject IJSRuntime JS

@* Author/contributor editor — rows of people, each of whom PGM takes as an account or as a pseudonym.
   A row shaped like a Minecraft account is resolved on blur to its canonical uuid and spelling; anything
   else that is a name at all stands as typed. Reusable across the map tools: the parent owns load/save
   (the metadata endpoint), this owns the rows + resolution and raises OnChanged on every edit. Pass
   Contributors to show a second list; omit it for an authors-only tool. *@

<Section Title="Authors">
  <Actions><Button Icon="plus" OnClick="() => Add(Authors)">Add an author</Button></Actions>
  <ChildContent>
    <div class="author-list">
      @foreach (var p in Authors) { @Row(p, Authors) }
      @if (Authors.Count == 0) { <EmptyState>No authors yet. Add one by Minecraft name or any name.</EmptyState> }
    </div>
  </ChildContent>
</Section>

@if (Contributors is not null)
{
  <Section Title="Contributors">
    <Actions><Button Icon="plus" OnClick="() => Add(Contributors)">Add a contributor</Button></Actions>
    <ChildContent>
      <div class="author-list">
        @foreach (var p in Contributors) { @Row(p, Contributors) }
        @if (Contributors.Count == 0) { <EmptyState>No contributors yet. Add people who helped but are not lead authors.</EmptyState> }
      </div>
    </ChildContent>
  </Section>
}

@code {
    // Markup template, shared by the authors + contributors lists.
    private RenderFragment Row(AuthorRow p, List<AuthorRow> list) => __builder =>
    {
        <Field Error="@(p.Error && AuthorNames.Refuse(p.Name.Trim()) is { } failed ? $"This name {failed}." : null)">
        <div class="author-row">
            <PlayerHead Uuid="@p.Uuid" Name="@p.Name" />
            <input class="field-input author-name @(p.Error ? "field-input--error" : null)" type="text"
                   placeholder="Minecraft name" aria-label="Name"
                   title="@(p.Uuid.Length > 0 ? p.Uuid : null)"
                   value="@p.Name"
                   @oninput="e => { p.Name = e.Value?.ToString() ?? string.Empty; NotifyChanged(); }"
                   @onblur="() => ResolveName(p)" />
            <input class="field-input author-contribution" type="text" placeholder="Contribution" aria-label="Contribution"
                   value="@p.Contribution" @oninput="e => { p.Contribution = e.Value?.ToString() ?? string.Empty; NotifyChanged(); }" />
            <Button Variant="icon" Icon="trash-2" Title="Delete this person" OnClick="() => Remove(list, p)" />
        </div>
        </Field>
    };
}
