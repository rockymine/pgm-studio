@namespace PgmStudio.Client.Components

@* The label+input atom — the field .label (with optional required mark and a right-aligned LabelEnd
   value), the control (ChildContent — an <input class="field-input">, a NumberField, a chip row, …),
   and an optional .field-error line. When LabelEnd is set the label row splits (label left, value
   right) via .field-label--split. Help is what the field is, behind a "?" after its label and opened under it —
   for a definition a reader needs once, which would otherwise sit open above the control every time. *@

<div class="@Cls">
    @if (!string.IsNullOrEmpty(Label) || LabelEnd is not null || LabelHint is not null || Hint is not null)
    {
        <label class="@LabelCls" for="@For">
            @* The hint is spaced and muted here rather than at each call site — see .field-hint for why the
               separator is a margin and not a space. *@
            <span>@Label @if (Required) { <span class="field-required">*</span> }@if (LabelHint is not null) { <span class="field-hint">@LabelHint</span> }@if (InlineHint is { } inline) { <span class="field-hint">(@inline)</span> }@if (HasHelp) { <HelpMark Open="helpOpen" Title="@(HelpTitle ?? $"About {Label}")" OnClick="() => helpOpen = !helpOpen" /> }</span>
            @if (LabelEnd is not null) { @LabelEnd }
        </label>
    }
    @if (HasHelp && helpOpen) { <div class="help-note-body">@(Help ?? (RenderFragment)(builder => builder.AddContent(0, Capitalized(Hint!))))</div> }
    @ChildContent
    @if (!string.IsNullOrEmpty(Error)) { <div class="field-error">@Error</div> }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? LabelHint { get; set; }  // inline helper markup after the label text (e.g. a muted note)
    [Parameter] public RenderFragment? LabelEnd { get; set; }   // right-aligned value in the label row
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? For { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>What the field is, behind a "?" beside its label.</summary>
    [Parameter] public RenderFragment? Help { get; set; }
    [Parameter] public string? HelpTitle { get; set; }
    /// <summary>What the label leaves unsaid, as plain words. A short one — a unit, a qualifier — reads after the
    /// label; a longer one is the field's help, with its unit kept after the label where it opens with one, so a
    /// column of fields shows its names and units and keeps its sentences a press away.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>The most words a hint may run to and still read after the label.</summary>
    private const int InlineWords = 5;

    private bool LongHint => Hint is not null && Hint.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length > InlineWords;
    private bool HasHelp => Help is not null || LongHint;
    private string? InlineHint => Hint is null ? null : LongHint ? UnitOf(Hint) : Hint;

    /// <summary>The unit a hint opens with, or none.</summary>
    private static string? UnitOf(string hint) =>
        hint.StartsWith("blocks", StringComparison.Ordinal) ? "blocks"
        : hint.StartsWith("the world y", StringComparison.Ordinal) ? "world y"
        : hint.StartsWith("degrees", StringComparison.Ordinal) ? "°"
        : null;

    private static string Capitalized(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..] + ".";

    private bool helpOpen;

    private string Cls => string.Join(' ', new[] { "field", Class }.Where(c => !string.IsNullOrEmpty(c)));
    private string LabelCls => LabelEnd is null ? "field-label" : "field-label field-label--split";
}
