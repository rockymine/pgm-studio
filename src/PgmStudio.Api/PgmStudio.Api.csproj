<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PgmStudio.Data\PgmStudio.Data.csproj" />
    <ProjectReference Include="..\PgmStudio.Pgm\PgmStudio.Pgm.csproj" />
    <ProjectReference Include="..\PgmStudio.Analysis\PgmStudio.Analysis.csproj" />
    <ProjectReference Include="..\PgmStudio.Minecraft\PgmStudio.Minecraft.csproj" />
    <ProjectReference Include="..\PgmStudio.Contracts\PgmStudio.Contracts.csproj" />
    <ProjectReference Include="..\PgmStudio.Export\PgmStudio.Export.csproj" />
    <ProjectReference Include="..\PgmStudio.Migrations\PgmStudio.Migrations.csproj" />
    <ProjectReference Include="..\PgmStudio.Client\PgmStudio.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.1.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The rule catalogue (GET /api/rules) reads each rule id's own docstring out of this file, so the
         sentence an author is shown is the one beside the constant and there is no second copy to rot.
         The doc-comment diagnostics are off with it: CS1591 is a demand to document every public member,
         CS1573/1574/1734/0419 flag pre-existing defects in comments nothing read until now (B220), and CS1587 is
         a docstring on a local function, which the compiler never emits and which is harmless where it is.
         The genuinely broken ones — CS1570/1584, malformed XML that truncates a member's entry in the file —
         were fixed rather than silenced, because those are what would corrupt what this reads. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1587</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4249fc15-7c58-46ac-82a7-128f030a6a0f</UserSecretsId>
  </PropertyGroup>

  <!-- A hosted publish leaves wwwroot/index.html with its placeholders unfilled
       (`_framework/blazor.webassembly#[.{fingerprint}].js`, an empty import map): the SDK fills them only when the
       client itself is published, and Development never notices because it serves the build's filled copy from the
       static web assets manifest. Production serves the file on disk, so the page asks for a name that does not
       exist and sits on "Loading". Publishing the client too and taking its host page closes that; the names it
       fills in are the same fingerprinted files this publish already carries. -->
  <Target Name="PublishClientHostPage" AfterTargets="Publish">
    <PropertyGroup>
      <_ClientPublishDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)client-publish/</_ClientPublishDir>
      <_HostPage>$(PublishDir)wwwroot/index.html</_HostPage>
    </PropertyGroup>
    <MSBuild Projects="../PgmStudio.Client/PgmStudio.Client.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_ClientPublishDir)" />
    <Copy SourceFiles="$(_ClientPublishDir)wwwroot/index.html" DestinationFiles="$(_HostPage)" />
    <Error Condition="$([System.IO.File]::ReadAllText('$(_HostPage)').Contains('{fingerprint}'))"
           Text="$(_HostPage) still carries an unfilled fingerprint placeholder; the published studio would never load." />
  </Target>

</Project>
