<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PgmStudio.Domain\PgmStudio.Domain.csproj" />
    <!-- Dependency-free spatial leaf: shared affine transforms (de-forces the local reflect/rotate copy). -->
    <ProjectReference Include="..\PgmStudio.Geom\PgmStudio.Geom.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Three of this project's records are answered directly by /api routes, so their docstrings are what
         the published schema says about those fields. Without the file the fields cross undescribed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1587</NoWarn>
  </PropertyGroup>

</Project>
