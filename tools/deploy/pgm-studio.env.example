# /etc/pgm-studio/pgm-studio.env — root:pgm-studio, mode 640. A value holding ';' stays quoted.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:7894
# Caddy terminates TLS; honour X-Forwarded-Proto/-For so the Discord callback is https:// and a signed-out
# caller is keyed on their own address.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
ConnectionStrings__PgmStudio="Server=localhost;Database=pgm_studio;Uid=pgm;Pwd=<password>;"
Access__Mode=invited
Access__Admins__0=<the first admin's Minecraft uuid>
Discord__ClientSecret=<the Discord application's secret>
# Setting this accepts Mojang's EULA on the operator's behalf: the studio downloads the 1.8.9 client jar once.
Textures__AcceptMojangEula=true
Textures__Cache=/var/lib/pgm-studio/textures
# Drawn pictures (library cards, world renders, the eye view); a cache, safe to delete.
Drawings__Folder=/var/lib/pgm-studio/drawings
# The pictures map notes carry, one file each, named by its hash. deploy.sh copies new ones beside the dumps.
Notes__Pictures=/var/lib/pgm-studio/pictures
# The agent the author hands notes to: a Claude Code Routine's API trigger, from the Routine's edit form at
# claude.ai/code/routines. Leave both out and In game offers no hand-off.
#Notes__Agent__Fire=https://api.anthropic.com/v1/claude_code/routines/<trig_…>/fire
#Notes__Agent__Token=<the Routine's token>
