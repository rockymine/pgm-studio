<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The export path itself: SketchWorldBuilder composes the world and the resolved intent, and pulls in
         Pgm (the rasterizer, the intent generator, the XML writer) and Minecraft (the stampers) with it. -->
    <ProjectReference Include="..\..\src\PgmStudio.Api\PgmStudio.Api.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PatternMap</RootNamespace>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

</Project>
