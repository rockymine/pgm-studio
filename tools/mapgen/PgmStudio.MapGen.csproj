<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The export path itself: SketchWorldBuilder composes the world and the resolved intent, and pulls in
         Pgm (the composer, the plan compiler, the rasterizer, the intent generator, the XML writer) and
         Minecraft (the stampers, the palette, the house presets) with it. -->
    <ProjectReference Include="..\..\src\PgmStudio.Export\PgmStudio.Export.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PgmStudio.MapGen</RootNamespace>
    <AssemblyName>mapgen</AssemblyName>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

</Project>
